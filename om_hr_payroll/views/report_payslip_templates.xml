                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
<!--                                    <th class="text-center" style="background-color:#893b74 !important;border: 1px !important; border-style: solid !important; border-color: #fff; color:#fff !important; ">Code</th>-->
                                    <th class="text-center" style="background-color:#893b74 !important;border: 1px !important; border-style: solid !important; border-color: #fff; color:#fff !important; ">Name</th>
                                    <th class="text-center" style="background-color:#893b74 !important;border: 1px !important; border-style: solid !important; border-color: #fff; color:#fff !important; ">Category</th>
                                    <th class="text-center" style="background-color:#893b74 !important;border: 1px !important; border-style: solid !important; border-color: #fff; color:#fff !important; ">Regular Amount</th>
                                    <th class="text-center" style="background-color:#893b74 !important;border: 1px !important; border-style: solid !important; border-color: #fff; color:#fff !important; ">Actual Amount</th>
                                </tr>
                            </thead>
                            <tbody>
<!--                                <tr t-foreach="o.line_ids.filtered(lambda line: line.appears_on_payslip)" t-as="line">-->
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <t t-if="line.total != 0.00 and line.code != 'GOSI_COMP'">
                                        <td style="font:14px lucida-console,sans-serif !important;">
                                            <t t-if="line.code in ['GROSS','NET','TOTAL_DED']">
                                                <b><span t-field="line.name"/></b>
                                            </t>
                                             <t t-if="line.code != 'GROSS' and line.code != 'NET' and line.code != 'TOTAL_DED' and line.code != 'GOSI_COMP'">
                                                 <span t-field="line.name"/>
                                            </t>
                                        </td>
                                        <td class="text-left" style="font:14px lucida-console,sans-serif !important;">

                                            <t t-if="line.code in ['GROSS','NET','TOTAL_DED']">
                                                <b><span t-field="line.category_id.name"/></b>
                                            </t>
                                             <t t-if="line.code != 'GROSS' and line.code != 'NET' and line.code != 'TOTAL_DED' and line.code != 'GOSI_COMP'">
                                                 <span t-field="line.category_id.name"/>
                                            </t>

                                        </td>
                                        <td class="text-right" style="font:14px lucida-console,sans-serif !important;">

                                            <t t-if="line.code in ['GROSS','NET','TOTAL_DED']">
                                                <b><span t-esc="line.amount"
                                                  t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></b>
                                            </t>
                                             <t t-if="line.code != 'GROSS' and line.code != 'NET' and line.code != 'TOTAL_DED' and line.code != 'GOSI_COMP'">
                                                 <span t-esc="line.amount"
                                                  t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                            </t>
                                        </td>
                                        <td class="text-right" style="font:14px lucida-console,sans-serif !important;">
                                            <!-- Initialize the gross_total -->
                                            <t t-set="gross_total" t-value="0.0"/>
                                            <t t-set="net_total" t-value="0.0"/>
                                            <t t-set="total_deduction" t-value="0.0"/>

                                            <!-- If the line.code is 'Gross', sum the amounts for ALW and BASIC categories -->
                                            <t t-if="line.code == 'GROSS'">
                                                <t t-foreach="o.line_ids" t-as="sum_line">
                                                    <t t-if="sum_line.category_id.code in ['ALW', 'BASIC']">
                                                        <t t-set="gross_total" t-value="gross_total + sum_line.total"/>
                                                    </t>
                                                </t>
                                                <!-- Display the summed gross_total -->
                                                <b><span t-esc="gross_total"
                                                      t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></b>
                                            </t>

                                            <!-- If the line.code is 'Gross', sum the amounts for ALW and BASIC and DED categories -->
                                            <t t-if="line.code == 'NET'">
                                                <t t-foreach="o.line_ids" t-as="sum_line">
                                                    <t t-if="sum_line.category_id.code in ['DED', 'ALW', 'BASIC' ]">
                                                        <t t-set="net_total" t-value="net_total + sum_line.total"/>
                                                    </t>
                                                </t>
                                                <!-- Display the summed net_total -->
                                                <b> <span t-esc="net_total"
                                                      t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></b>
                                            </t>

                                            <t t-if="line.code == 'TOTAL_DED'">
                                                <t t-foreach="o.line_ids" t-as="sum_line">
                                                    <t t-if="sum_line.category_id.code in ['DED']">
                                                        <t t-set="total_deduction" t-value="total_deduction + sum_line.total"/>
                                                    </t>
                                                </t>
                                                <!-- Display the summed net_total -->
                                                <b> <span t-esc="total_deduction"
                                                      t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></b>
                                            </t>

                                            <!-- If not Gross or Net, display the line.total -->
                                            <t t-if="line.code != 'GROSS' and line.code != 'NET' and line.code != 'TOTAL_DED' and line.code != 'GOSI_COMP'">
                                                <span t-esc="line.total"
                                                      t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                            </t>
                                        </td>
                                    </t>
                                </tr>

                            </tbody>
                        </table>

