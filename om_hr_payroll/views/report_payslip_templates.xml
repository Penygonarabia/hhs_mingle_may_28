                                </td>
                            </tr>
                             <tr>
                                <td style="background-color:#893b74 !important;border: 1px !important; border-style: solid !important; border-color: #fff; color:#fff !important; ">
                                    <strong>Address</strong>
                                </td>
                                <td colspan="12" style="font:14px lucida-console,sans-serif !important;">
                                    <div t-field="o.employee_id.address_home_id"
