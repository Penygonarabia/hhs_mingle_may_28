                        <t t-if="o.input_line_ids">
                            <h4 class="text-left">Transaction Details</h4>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th class="text-center" style="background-color:#893b74 !important;border: 1px !important; border-style: solid !important; border-color: #fff; color:#fff !important; ">Description</th>
                                        <th class="text-center" style="background-color:#893b74 !important;border: 1px !important; border-style: solid !important; border-color: #fff; color:#fff !important; ">Reference</th>
                                        <th class="text-center" style="background-color:#893b74 !important;border: 1px !important; border-style: solid !important; border-color: #fff; color:#fff !important; ">Date</th>
                                        <th class="text-center" style="background-color:#893b74 !important;border: 1px !important; border-style: solid !important; border-color: #fff; color:#fff !important; ">Units</th>
                                        <th class="text-center" style="background-color:#893b74 !important;border: 1px !important; border-style: solid !important; border-color: #fff; color:#fff !important; ">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.input_line_ids" t-as="line">
                                        <td style="font:14px lucida-console,sans-serif !important;">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td class="text-left" style="font:14px lucida-console,sans-serif !important;">
                                            <span t-field="line.reference"/>
                                        </td>
                                        <td class="text-center" style="font:14px lucida-console,sans-serif !important;">
                                            <span t-esc="line.date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                        </td>
                                        <td class="text-left" style="font:14px lucida-console,sans-serif !important;">
                                            <span t-esc="line.units"  />
                                        </td>
                                        <td class="text-right" style="font:14px lucida-console,sans-serif !important;">
    <!--                                        <span t-esc="'{:.2f}'.format(line.amount or 0.00)" />-->
                                            <span t-esc="line.amount" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}' />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <br/>

                        <p class="text-right">
                            <strong>Authorized signature</strong>
                        </p>
