<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--Payslip Line -->
        <record id="view_hr_payslip_line_tree" model="ir.ui.view">
            <field name="name">hr.payslip.line.tree</field>
            <field name="model">hr.payslip.line</field>
            <field name="arch" type="xml">
                <tree decoration-info="total == 0" editable="bottom" string="Salary Structure">
                    <field name="category_id"/>
                    <field invisible="1" name="employee_id"/>
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="quantity"/>
                    <field name="rate"/>
                    <field name="amount"/>
                    <field name="total"/>
                    <field invisible="1" name="amount_select"/>
                    <field invisible="1" name="register_id"/>
                </tree></field>
        </record>
        <record id="view_hr_payslip_line_form" model="ir.ui.view">
            <field name="name">hr.payslip.line.form</field>
            <field name="model">hr.payslip.line</field>
            <field name="arch" type="xml">
                <form string="Payslip Line">
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="slip_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group string="Calculations">
                            <field name="category_id"/>
                            <field name="amount_select"/>
                            <field name="amount_fix" readonly="not amount_select"/>
                            <field name="amount_percentage" readonly="not amount_select"/>
                            <field name="sequence"/>
                        </group>
                        <field name="note"/>
                    </group>
                </form></field>
        </record>
        <record id="view_hr_payslip_line_filter" model="ir.ui.view">
            <field name="name">hr.payslip.line.select</field>
            <field name="model">hr.payslip.line</field>
            <field name="arch" type="xml">
                <search string="Search Payslip Lines">
                    <field filter_domain="['|',('name','ilike',self),('code','ilike',self)]" name="name" string="Payslip Lines"/>
                    <field name="amount_select"/>
                    <field name="slip_id"/>
                    <group col="8" colspan="4" expand="0" string="Group By">
                        <filter context="{'group_by':'category_id'}" name="category_id" string="Salary Rule Category"/>
                        <filter context="{'group_by':'register_id'}" name="register_id" string="Contribution Register"/>
                        <filter context="{'group_by':'amount_select'}" name="amount_select" string="Amount Type"/>
                        <filter context="{'group_by':'employee_id'}" name="employee_id" string="Employees"/>
                    </group>
                </search></field>
        </record>
        <!-- payslip -->
        <record id="view_hr_payslip_tree" model="ir.ui.view">
            <field name="name">hr.payslip.tree</field>
            <field name="model">hr.payslip</field>
            <field name="arch" type="xml">
                <tree decoration-info="state in ('done')" decoration-muted="state == 'cancel'" string="Payslips">
                    <field name="number"/>
                    <field name="employee_number"/>
                    <field name="employee_id"/>
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="state"/>
                    <field groups="base.group_multi_company" name="company_id" options="{'no_create': True}"/>
                    <field column_invisible="1" name="payslip_run_id"/>
                </tree></field>
        </record>
        <record id="hr_payslip_view_kanban" model="ir.ui.view">
            <field name="name">hr.payslip.kanban</field>
            <field name="model">hr.payslip</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                                <div class="row">
                                    <div class="col-6">
                                        <strong>
                                            <field name="employee_id"/>
                                        </strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="float-right badge badge-secondary">
                                            <field name="state"/>
                                        </span>
                                    </div>
                                    <div class="col-12">
                                        <span>
                                            <field name="date_from"/>
                                            -
                                            <field name="date_to"/>
                                        </span>
                                    </div>
                                    <div class="col-12">
                                        <span>
                                            <field name="name"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban></field>
        </record>
        <record id="act_payslip_lines" model="ir.actions.act_window">
            <field name="name">Payslip Computation Details</field>
            <field name="res_model">hr.payslip.line</field>
            <field name="context">{'default_slip_id': active_id,'search_default_slip_id': active_id}</field>
        </record>
        <record id="view_hr_payslip_form" model="ir.ui.view">
            <field name="name">hr.payslip.form</field>
            <field name="model">hr.payslip</field>
            <field name="arch" type="xml">
                <form delete="0" string="Payslip">
                    <header>
                        <button class="oe_highlight" invisible="state not in ['draft','verify']" name="action_payslip_done" string="Confirm" type="object"/>
                        <button invisible="state not in ['confirm','done']" name="refund_sheet" string="Refund" type="object"/>
                        <button invisible="state not in ['cancel']" name="action_payslip_draft" string="Set to Draft" type="object"/>
                        <button class="oe_highlight" invisible="state not in ['draft']" name="compute_sheet" string="Compute Sheet" type="object"/>
                        <button invisible="state not in ['draft','verify']" name="action_payslip_cancel" string="Cancel Payslip" type="object"/>
                        <button class="oe_highlight" invisible="state not in ['done','verify']" name="action_send_email" string="Send E-Mail" type="object"/>
                        <field name="state" statusbar_visible="draft,confirm" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-money" name="%(act_payslip_lines)d" type="action">
                                <field help="Payslip Computation Details" name="payslip_count" string="Payslip" widget="statinfo"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label class="oe_edit_only" for="employee_id"/>
                            <h1>
                                <field name="employee_id" placeholder="Employee"/>
                            </h1>
                        </div>
                        <group col="4">
                            <label for="date_from" string="Period"/>
                            <div>
                                <field class="oe_inline" name="date_from"/>
                                -
                                <field class="oe_inline" name="date_to"/>
                            </div>
                            <field force_save="1" name="employee_number" readonly="1"/>
                            <field name="number" force_save="1"/>
                            <field force_save="1" context="{'default_employee_id': employee_id}" domain="[('employee_id','=',employee_id),('date_start','=',date_to),'|',('date_end','&lt;=',date_from),('date_end','=',False)]" name="contract_id"/>
                            <field name="name" force_save="1"/>
                            <field name="struct_id" force_save="1" required="contract_id"/>
                            <field force_save="1" name="is_terminated"/>
                            <field force_save="1" name="credit_note"/>
                            <field invisible="1" force_save="1" name="payroll_type"/>
                            <field invisible="1" force_save="1" name="employee_bool"/>
                            <field force_save="1" invisible="1" name="leave_vacation_payslip_bool" readonly="1"/>
                            <field force_save="1" invisible="1" name="leave_id"/>
                            <field force_save="1" invisible="1" name="av_loan_bool"/>
                            <field force_save="1" invisible="1" name="actual_arrival_date"/>
                            <field force_save="1" invisible="1" name="same_month_vacation" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Salary Computation">
                                <field colspan="4" context="{'default_amount': 'active'}" name="line_ids_filtered" nolabel="1">
                                    <!--  <field name="line_ids" colspan="4" nolabel="1"> -->
                                    <!--                                    <tree create="0" delete="0" string="Salary Structure" editable="bottom" decoration-bf="code in ['GROSS', 'NET', 'TOTAL_DED'] > 0">-->
                                    <tree create="0" decoration-bf="code in ['GROSS', 'NET', 'TOTAL_DED'] != 0" delete="0" editable="bottom" string="Salary Structure">
                                        <!--                                        <field name="name"/>-->
                                        <!--                                        <field name="code" optional="hide" />-->
                                        <!--                                        <field name="category_id"/>-->
                                        <!--                                        <field name="sequence" invisible="1"/>-->
                                        <!--                                        <field name="quantity" optional="hide"/>-->
                                        <!--                                        <field name="rate" optional="hide"/>-->
                                        <!--                                        <field name="salary_rule_id" optional="hide"/>-->
                                        <!--                                        <field name="amount"/>-->
                                        <!--                                        <field name="total"/>-->
                                        <field name="name" invisible="code == 'GOSI_COMP'"/>
                                        <field name="code" optional="hide" invisible="code == 'GOSI_COMP'"/>
                                        <field  name="category_id" invisible="code == 'GOSI_COMP'"/>
                                        <field column_invisible="1" name="sequence"/>
                                        <field  name="quantity" optional="hide" invisible="code == 'GOSI_COMP'"/>
                                        <field  name="rate" optional="hide" invisible="code == 'GOSI_COMP'"/>
                                        <field  name="salary_rule_id" optional="hide" invisible="code == 'GOSI_COMP'"/>
                                        <field  name="amount" invisible="code == 'GOSI_COMP'"/>
                                        <field  name="total" invisible="code == 'GOSI_COMP'"/>
                                    </tree>
                                    <form string="Payslip Line">
                                        <group col="4">
                                            <field name="name"/>
                                            <field name="code"/>
                                            <field name="category_id"/>
                                            <field name="sequence"/>
                                            <field name="quantity"/>
                                            <field name="rate"/>
                                            <field name="amount"/>
                                            <field name="total"/>
                                            <field name="salary_rule_id"/>
                                        </group>
                                    </form></field>
                            </page>
                            <page invisible="1" string="Details By Salary Rule Category">
                                <field context="{'search_default_category_id':1}" domain="[('appears_on_payslip', '=', True)]" name="details_by_salary_rule_category">
                                    <tree decoration-info="total == 0" string="Payslip Lines">
                                        <field name="category_id"/>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="total"/>
                                    </tree></field>
                            </page>
                            <page string="Worked Days &amp; Inputs">
                                <separator string="Worked Days"/>
                                <field name="worked_days_line_ids"><tree create="0" delete="0" editable="bottom" string="Worked Days">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="number_of_days" sum="Total Working Days"/>
                                        <field name="number_of_hours"/>
                                        <field name="contract_id"/>
                                        <field invisible="True" name="sequence"/>
                                    </tree>
                                    <form string="Worked Day">
                                        <group col="4">
                                            <field name="name"/>
                                            <field name="code"/>
                                            <field name="sequence"/>
                                            <field name="number_of_days"/>
                                            <field name="number_of_hours"/>
                                            <field name="contract_id"/>
                                        </group>
                                    </form></field>
                                <separator string="Other Inputs"/>
                                <field colspan="4" name="input_line_ids" nolabel="1">
                                    <tree create="0" delete="0" editable="bottom" string="Input Data">
                                        <field name="name" readonly="1"/>
                                        <field name="reference"/>
                                        <field name="date"/>
                                        <field name="code" optional="hide"/>
                                        <field name="units"/>
                                        <field name="amount" readonly="1"/>
                                        <field invisible="True" name="contract_id"/>
                                        <field invisible="True" name="sequence"/>
                                    </tree>
                                    <form string="Payslip Line">
                                        <group col="4">
                                            <field name="name"/>
                                            <field name="code"/>
                                            <field name="sequence"/>
                                            <field name="amount"/>
                                            <field name="contract_id"/>
                                        </group>
                                    </form></field>
                            </page>
                            <page string="Accounting Information">
                                <group>
                                    <group string="Miscellaneous">
                                        <field groups="base.group_multi_company" name="company_id"/>
                                        <field domain="[('state','=','draft')]" name="payslip_run_id"/>
                                    </group>
                                    <group name="accounting" string="Accounting">
                                        <field name="paid" readonly="1"/>
                                    </group>
                                </group>
                                <div colspan="4">
                                    <field name="note" placeholder="Add an internal note..."/>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field groups="base.group_user" name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form></field>
        </record>
        <record id="view_hr_payslip_filter" model="ir.ui.view">
            <field name="name">hr.payslip.select</field>
            <field name="model">hr.payslip</field>
            <field name="arch" type="xml">
                <search string="Search Payslips">
                    <field filter_domain="['|',('name','ilike',self),('number','ilike',self)]" name="name" string="Payslips"/>
                    <field name="date_from"/>
                    <filter domain="[('state','=','draft')]" help="Draft Slip" name="draft" string="Draft"/>
                    <filter domain="[('state','=','done')]" help="Done Slip" name="done" string="Done"/>
                    <field name="employee_id"/>
                    <field name="payslip_run_id"/>
                    <field name="employee_number"/>
                    <group expand="0" string="Group By">
                        <filter context="{'group_by':'employee_id'}" name="employee_id" string="Employees"/>
                        <filter context="{'group_by':'payslip_run_id'}" name="payslip_run_id" string="PaySlip Batch"/>
                        <filter context="{'group_by':'company_id'}" groups="base.group_multi_company" name="company_id" string="Companies"/>
                        <filter context="{'group_by':'state'}" name="state" string="States"/>
                    </group>
                </search></field>
        </record>
        <record id="action_view_hr_payslip_form" model="ir.actions.act_window">
            <field name="name">Employee Payslips</field>
            <field name="res_model">hr.payslip</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="search_view_id" ref="view_hr_payslip_filter"/>
            <field name="domain">[
		        ('employee_id.company_id', 'in', allowed_company_ids),
		        ('state', 'in', ['draft', 'verify', 'done','cancel'])
		    ]</field>
            <!-- <field name="domain">['|', ('employee_id.company_id', 'in', allowed_company_ids), '&amp;', ('multi_employee', '=', True), '&amp;', ('state', 'in', ['draft', 'confirm', 'validate1']),('employee_id.company_id', 'in', allowed_company_ids)]</field> -->
        </record>
        <menuitem action="action_view_hr_payslip_form" groups="om_hr_payroll.group_hr_payroll_user" id="menu_department_tree" parent="om_hr_payroll.menu_hr_payroll_root" sequence="30"/>
        <!--parent="menu_hr_payroll_root"-->
        <record id="act_hr_employee_payslip_list" model="ir.actions.act_window">
            <field name="res_model">hr.payslip</field>
            <field name="name">Payslips</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_employee_id': [active_id], 'default_employee_id': active_id}</field>
        </record>
        <!-- payslip runs -->
        <record id="hr_payslip_run_filter" model="ir.ui.view">
            <field name="name">hr.payslip.run.search</field>
            <field name="model">hr.payslip.run</field>
            <field name="arch" type="xml">
                <search string="Search Payslip Batches">
                    <field name="name" string="Payslip Batches"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <filter domain="[('state','=','draft')]" help="Draft Payslip Batches" name="draft" string="Draft"/>
                    <filter domain="[('state','=','close')]" help="Done Payslip Batches" name="done_filter" string="Done"/>
                </search></field>
        </record>
        <record id="hr_payslip_run_tree" model="ir.ui.view">
            <field name="name">hr.payslip.run.tree</field>
            <field name="model">hr.payslip.run</field>
            <field name="arch" type="xml">
                <tree string="Payslips Batches">
                    <field name="name"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="credit_note"/>
                    <field name="state"/>
                </tree></field>
        </record>
        <record id="hr_payslip_run_view_kanban" model="ir.ui.view">
            <field name="name">hr.payslip.run.kanban</field>
            <field name="model">hr.payslip.run</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                                <div class="row">
                                    <div class="col-6">
                                        <strong>
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="float-right badge badge-secondary">
                                            <field name="state"/>
                                        </span>
                                    </div>
                                    <div class="col-12">
                                        <span>
                                            <field name="date_start"/>
                                            -
                                            <field name="date_end"/>
                                        </span>
                                        <span class="float-right" title="Is a Blocking Reason?">
                                            <field name="credit_note" widget="boolean"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban></field>
        </record>
        <record id="hr_payslip_run_form" model="ir.ui.view">
            <field name="name">hr.payslip.run.form</field>
            <field name="model">hr.payslip.run</field>
            <field name="arch" type="xml">
                <form string="Payslips Batches">
                    <header>
                        <button class="oe_highlight" invisible="state not in ['draft']" name="%(action_hr_payslip_by_employees)d" string="Generate Payslips" type="action"/>
                        <button invisible="state not in ['close']" name="draft_payslip_run" string="Set to Draft" type="object"/>
                        <button class="oe_highlight" invisible="state not in ['draft']" name="done_payslip_run" string="Mark As Done" type="object"/>
                        <button invisible="state not in ['draft']" name="close_payslip_run" string="Close" type="object"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <label class="oe_edit_only" for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <group col="4">
                            <label for="date_start" string="Period"/>
                            <div>
                                <field class="oe_inline" name="date_start"/>
                                -
                                <field class="oe_inline" name="date_end"/>
                            </div>
                            <field name="credit_note"/>
                        </group>
                        <separator string="Payslips"/>
                        <field create="0" delete="0" name="slip_ids" readonly="1"/>
                    </sheet>
                </form></field>
        </record>
        <record id="action_hr_payslip_run_tree" model="ir.actions.act_window">
            <field name="name">Payslips Batches</field>
            <field name="res_model">hr.payslip.run</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="search_view_id" ref="hr_payslip_run_filter"/>
        </record>
        <menuitem action="action_hr_payslip_run_tree" id="menu_hr_payslip_run" parent="om_hr_payroll.menu_hr_payroll_root" sequence="40"/>
        <!--parent="menu_hr_payroll_root"-->
        <!--  Shortcuts -->
        <record id="act_contribution_reg_payslip_lines" model="ir.actions.act_window">
            <field name="name">Payslip Lines</field>
            <field name="res_model">hr.payslip.line</field>
            <field name="domain">[('register_id', '=', active_id)]</field>
            <field name="context">{'default_register_id': active_id, 'search_default_register_id': 1}</field>
        </record>
    </data>
</odoo>
