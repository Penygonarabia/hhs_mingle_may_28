    <record id="view_hr_holidays_filter_custom" model="ir.ui.view">
        <field name="name">hr.holidays.filter.custom</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter"/>
        <field name="arch" type="xml">
            <!-- Modify the "Approved Time Off" filter -->
            <xpath expr="//search/filter[@name='validated']" position="attributes">
                <attribute name="string">
                    Approved Leave</attribute>
            </xpath>
            <!-- Modify the "My Time Off" filter -->
            <xpath expr="//search/filter[@name='my_leaves']" position="attributes">
                <attribute name="string">
                    My Leave</attribute>
            </xpath>
            <xpath expr="//search/filter[@name='active_time_off']" position="attributes">
                <attribute name="string">
                    Active Leave</attribute>
            </xpath>
            <xpath expr="//search/filter[@name='archive']" position="attributes">
                <attribute name="string">
                    Archived Leave</attribute>
            </xpath></field>
    </record>
    <record id="view_hr_leave_allocation_filter_inherit" model="ir.ui.view">
        <field name="name">hr.holidays.filter_allocations</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.view_hr_leave_allocation_filter"/>
        <field name="arch" type="xml">
            <!-- Modify the "Time Off Type" group by -->
            <xpath expr="//search/group/filter[@name='group_type']" position="attributes">
                <attribute name="string">
                    Leave Type</attribute>
            </xpath></field>
    </record>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.timesheet</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_timesheet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='section_leaves']" position="replace">
                <div groups="base.group_no_one" name="section_leaves">
                    <h2>
                        Leave
                    </h2>
                    <div class="row mt16 o_settings_container" name="timesheet_control">
                        <div class="col-12 col-lg-6 o_setting_box" id="timesheet_off_validation_setting">
                            <div class="o_setting_left_pane">
                                <field name="module_project_timesheet_holidays"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="module_project_timesheet_holidays"/>
                                <span class="fa fa-lg fa-building-o" groups="base.group_multi_company" title="Values set here are company-specific."/>
                                <div class="text-muted">
                                    Generate timesheets upon leave validation
                                </div>
                                <div class="content-group">
                                    <div id="module_project_timesheet_holidays"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath></field>
    </record>
    
