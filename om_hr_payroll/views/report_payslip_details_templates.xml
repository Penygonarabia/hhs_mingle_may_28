                               <tr t-foreach="get_details_by_rule_category.get(o.id, [])" t-as="h" class="lighter" style="font-weight:lighter;">
                                   <t t-if="h['total'] != 0.00">
                                    <td>
                                        <b><span class="normal" style="font:17px lucida-console,sans-serif !important;" t-esc="h['code']"/></b>
                                    </td>
                                    <td>
                                        <span class="normal" style="font:14px lucida-console,sans-serif !important;" t-esc="'..'*h['level']"/>
                                        <span class="normal" style="font:14px lucida-console,sans-serif !important;" t-esc="h['rule_category']"/>
                                    </td>
                                    <td class="text-right">
                                        <span class="normal" style="font:14px lucida-console,sans-serif !important;" t-esc="h['total']"
                                              t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                    </td>
                                   </t>
                                </tr>
                            </tbody>
                        </table>

