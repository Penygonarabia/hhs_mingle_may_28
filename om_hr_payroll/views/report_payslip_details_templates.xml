                                         t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                                </td>
                            </tr>
                        </table>

                        <h3 class="text-center">Details by Salary Rule Category</h3>
                        <table class="table table-sm mb32 table-bordered">
                            <thead>
                                <style>
                                    p.normal {
                                      font-weight: normal;
                                    }

                                    p.light {
                                      font-weight: lighter;
                                    }
                                 </style>
                                <tr>
                                    <th class="text-center" style="background-color:#893b74 !important;border: 1px !important; border-style: solid !important; border-color: #fff; color:#fff !important; ">Code</th>
                                    <th class="text-center" style="background-color:#893b74 !important;border: 1px !important; border-style: solid !important; border-color: #fff; color:#fff !important; ">Salary Rule Category</th>
                                    <th class="text-center" style="background-color:#893b74 !important;border: 1px !important; border-style: solid !important; border-color: #fff; color:#fff !important; ">Total</th>
                                </tr>
                            </thead>

                            <tbody>
