<!--                &lt;!&ndash;                    <field name="vacation_utilised"  force_save="1" attrs="{'invisible': [('show_leave_fields', '=', False)], 'readonly': [('state', 'not in', ['draft', 'confirm'])]}"/>&ndash;&gt;-->
<!--                <field force_save="1" invisible="not show_leave_fields" name="vacation_utilised"/>-->
