<!--            </xpath>-->

            <xpath expr="//group[@name='col_left']" position="replace">
                   <group name="col_left">
                            <field name="employee_company_id" invisible="1"/>

                            <field name="holiday_status_id" force_save="1"
                                domain="[
                                    '|',
                                        ('requires_allocation', '=', 'no'),
                                        '&amp;',
                                            ('has_valid_allocation', '=', True),
                                            '&amp;',
                                                ('max_leaves', '>', '0'),
                                                '|',
                                                    ('allows_negative', '=', True),
                                                    '&amp;',
                                                        ('virtual_remaining_leaves', '&gt;', 0),
                                                        ('allows_negative', '=', False),
                                ]"
                                context="{'employee_id': employee_id, 'default_date_from': date_from, 'default_date_to': date_to}"
                                options="{'no_create': True, 'no_open': True, 'request_type': 'leave'}"
                                readonly="state in ['cancel', 'refuse', 'validate', 'validate1']"/>
                            <field name="employee_number"/>
                            <field name="date_from" invisible="1" readonly="state in ['cancel', 'refuse', 'validate', 'validate1']"/>
                            <field name="date_to" invisible="1" readonly="state in ['cancel', 'refuse', 'validate', 'validate1']"/>
                            <field name="request_date_from" invisible="0" widget="daterange" string="Leave Date From"/>
                            <field name="request_date_to" invisible="0" widget="daterange" string="Expected Return Date"/>

                        <label for="number_of_days_display" string="Duration" />
                        <div name="duration_display" >
                            <div >
                                <field name="number_of_days_display" class="oe_inline" />
                                <span class="ms-3">Days</span>
                                <field name="request_unit_hours" invisible="1" readonly="state not in ('draft', 'confirm')" class="ms-5" />
                                <field name="request_unit_half"  invisible="1" readonly="state not in ('draft', 'confirm')" />

                            </div>
                            <div invisible="1" class="o_row">
                                <field name="number_of_hours_text" />
                            </div>
                        </div>
                        <field invisible="1" name="show_leave_fields"/>
                        <field force_save="1" invisible="not show_leave_fields" name="vacation_entitle"/>
                        <field force_save="1" invisible="not show_leave_fields" name="national_holiday"/>
                        <!--                    <field name="vacation_utilised"  force_save="1" attrs="{'invisible': [('show_leave_fields', '=', False)], 'readonly': [('state', 'not in', ['draft', 'confirm'])]}"/>-->
                        <field force_save="1" invisible="not show_leave_fields" name="vacation_utilised"/>
                        <field force_save="1" invisible="not show_leave_fields" name="paid_leave"/>
                        <field force_save="1" invisible="not show_leave_fields" name="unpaid_leave"/>
                        <field force_save="1" invisible="not show_leave_fields" name="actual_return_date"/>



                        <field name="name" readonly="state not in ('draft', 'confirm')" widget="text" placeholder="Add a description..." />
                        <field name="user_id" invisible="1" />
                        <field name="leave_type_support_document" invisible="1" />
                        <label for="supported_attachment_ids" string="Supporting Document" invisible="not leave_type_support_document or state not in ('draft', 'confirm', 'validate1')" />
                        <field name="supported_attachment_ids" widget="many2many_binary" nolabel="1" invisible="not leave_type_support_document or state not in ('draft', 'confirm', 'validate1')" />
                   </group>
            </xpath>

            <xpath expr="//div[@name='duration_warning']" position="replace">
