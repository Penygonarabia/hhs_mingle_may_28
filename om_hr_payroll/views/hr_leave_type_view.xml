<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_holiday_status_form" model="ir.ui.view">
        <field name="name">hr.leave.type</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <field name="leave_validation_type" position="before">
                <field name="code"/></field></field>
    </record>
    <record id="view_holiday_status_normal_tree" model="ir.ui.view">
        <field name="name">hr.leave.type</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.view_holiday_status_normal_tree"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="code"/></field></field>
    </record>
    <record id="view_holidays_status_filter" model="ir.ui.view">
        <field name="name">hr.leave.type</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.view_holidays_status_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="code"/></field></field>
    </record>

    <record id="time_off_type_inherit_form" model="ir.ui.view">
    	<field name="name">hr.leave.accrual.plan.inherit.form</field>
    	<field name="model">hr.leave.accrual.plan</field>
    	<field name="inherit_id" ref="hr_holidays.hr_accrual_plan_view_form" />
    	<field name="arch" type="xml">
    		<xpath expr="//field[@name='is_based_on_worked_time']" position="after">
                <field name="time_off_type_id"  groups="base.group_multi_company"/>
    		</xpath>
    	</field>
    </record>

    <record id="view_employee_number_tree_inherit" model="ir.ui.view">
	   	<field name ="name">hr.leave.form.inherit</field>
	   	<field name="model">hr.leave</field>
	   	<field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
	   	<field name="arch" type="xml">
	   		<xpath expr="//field[@name='employee_id']" position="before">
	   				<field name="employee_number" />
	   		  </xpath>
	   	</field>
   </record>

   <record id="leave_employee_number_filter_search" model="ir.ui.view">

   		<field name="name">hr.holidays.filter</field>
		<field name="model">hr.leave</field>
		<field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='employee_id']" position="before">
				<field name="employee_number" />
			</xpath>
		</field>
      </record>


    <record id="view_send_mail_inherit" model="ir.ui.view">
        <field name="name">hr.leave.inherit.form</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_refuse']" position="after">
                <button class="oe_highlight" invisible="state in ['draft', 'confirm', 'refuse']" name="send_mail_leave_automatically" string="Send Mail" type="object"/>
            </xpath>
<!--            <xpath expr="//div[@name='duration_display']" position="after">-->
<!--                <field invisible="1" name="show_leave_fields"/>-->
<!--                <field force_save="1" invisible="not show_leave_fields" name="vacation_entitle"/>-->
