<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <record id="dev_inventory_wizard_view" model="ir.ui.view">
        <field name="name">Stock Ageing Report</field>
        <field name="model">inventory.age.wizard</field>
        <field name="arch" type="xml">
            <form string="Report Options">
                <separator string="Stock Ageing Report"/>
                <group>
                    <group>
                        <field name="period_length"/>
                        <field name="company_id"/>
                        <field domain="[('company_id','=',company_id)]" name="warehouse_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="filter_by"/>
                        <field invisible="filter_by != 'by_category'" name="category_id" required="filter_by == 'by_category'"/>
                    </group>
                </group>
                <group string="Location">
                    <field name="location_ids"/>
                </group>
                <group>
                    <field invisible="filter_by != 'by_product'" name="product_ids" required="filter_by == 'by_product'" widget="many2many_tags"/>
                </group>
                <footer>
                    <button class="oe_highlight" icon="fa-print" name="print_pdf" string="Print PDF" type="object"/>
                    or
                    <button class="oe_highlight" name="print_excel" string="Print Excel" type="object"/>
                    or
                    <button class="oe_link" special="cancel" string="Cancel"/>
                </footer>
            </form></field>
    </record>
    <record id="action_inventory_wizard_view" model="ir.actions.act_window">
        <field name="name">Stock Ageing Report</field>
        <field name="res_model">inventory.age.wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="dev_inventory_wizard_view"/>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>
    <menuitem action="action_inventory_wizard_view" id="menu_dev_inventory_wizard" name="Stock Ageing Report" parent="stock.menu_warehouse_report"/>
</openerp>
