<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- HR Advance-->
        <record id="view_hr_employee_advance_filter_ps" model="ir.ui.view">
            <field name="name">Advance</field>
            <field name="model">hr.employee.advance.ps</field>
            <field name="arch" type="xml">
                <search string="Advance">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="employee_number"/>
                    <field name="contract_id"/>
                    <field name="type_id"/>
                    <filter domain="[('state','=','request')]" icon="terp-camera_test" name="request" string="Waiting for Direct Manager approval"/>
                    <filter domain="[('state','=','progress')]" icon="terp-camera_test" name="progress" string="Waiting for HR Manager approval"/>
                    <filter domain="[('state','=','progress2')]" icon="terp-camera_test" name="progress2" string="Waiting for finance Manager approval"/>
                    <filter domain="[('state','=','approve')]" help="Approved" icon="terp-document-new" name="state" string="Approved"/>
                    <filter domain="[('state','=','refuse')]" help="Refused" icon="terp-document-new" name="state" string="Refused"/>
                    <group expand="0" string="Group By">
                        <filter context="{'group_by':'employee_id'}" domain="[]" icon="terp-personal" name="state" string="Employee"/>
                        <filter context="{'group_by':'contract_id'}" domain="[]" icon="terp-personal" name="state" string="Contract"/>
                        <filter context="{'group_by':'type_id'}" domain="[]" icon="terp-personal+" name="state" string="Advance Type"/>
                        <filter context="{'group_by':'state'}" icon="terp-stock_effects-object-colorize" name="state" string="States"/>
                    </group>
                </search></field>
        </record>
        <record id="view_hr_employee_advance_tree_ps" model="ir.ui.view">
            <field name="name">hr.employee.advance.tree.ps</field>
            <field name="model">hr.employee.advance.ps</field>
            <field name="arch" type="xml">
                <tree string="Advance">
                    <field name="name"/>
                    <field name="employee_number"/>
                    <field name="employee_id"/>
                    <field name="type_id"/>
                    <field name="contract_id"/>
                    <field name="advance_amount"/>
                    <field name="advance_month_ins"/>
                    <field name="advance_ins_start_date"/>
                    <field name="paid_amount"/>
                    <field name="balance_amount"/>
                    <field name="paid_installment"/>
                    <field name="unpaid_installment"/>
                    <field name="state"/>
                </tree></field>
        </record>
        <record id="view_hr_employee_advance_form_ps" model="ir.ui.view">
            <field name="name">hr.employee.advance.form.ps</field>
            <field name="model">hr.employee.advance.ps</field>
            <field name="arch" type="xml">
                <form string="HR Employee Advance" version="7.0">
                    <header>
                        <button invisible="state not in ['draft']" name="action_request" string="Request For DM Approval" type="object"/>
                        <!--                        <button string="Guarantor Confirm"-->
                        <!--                                name="action_guarantor_approve"-->
                        <!--                                class="oe_highlight"-->
                        <!--                                icon="gtk-yes"-->
                        <!--                                attrs="{'invisible':[('state','!=','request')]}"-->
                        <!--                                type="object"/>-->
                        <button groups="hr_saudi.group_dm" help="First Phase Approval" invisible="state not in ['request']" name="action_progress" string="DM Approve" type="object"/>
                        <button groups="hr_saudi.group_hrm" help="Second Phase Approval" invisible="state not in ['progress']" name="action_progress2" string="HR Manager Approve" type="object"/>
                        <button groups="hr_saudi.group_finance_manager" help="Finance Manager Approval" invisible="state not in ['progress2']" name="action_approve" string="FM Approve" type="object"/>
                        <button groups="hr_saudi.group_admin_approval" help="Admin &amp; Financial Director approval" invisible="state not in ['progress3']" name="action_progress3" string="Admin &amp; Financial Director approval" type="object"/>
                        <button groups="hr.group_hr_manager" invisible="state not in ['request']" name="action_refuse" string="Refuse" type="object"/>
                        <button groups="account.group_account_manager" invisible="state not in ['progress2','progress']" name="action_refuse" string="Refuse" type="object"/>
                        <button groups="hr.group_hr_manager" invisible="state not in ['request']" name="action_draft" string="Back to Draft" type="object"/>
                        <button groups="account.group_account_manager" invisible="state not in ['progress2','progress']" name="action_draft" string="Back to Draft" type="object"/>
                        <button colspan="2" invisible="is_progress3_clicked == True or state in ['draft','request']" name="compute_installment_board" string="Compute Installment" type="object"/>
                        <field name="state" statusbar_colors='{"draft":"red"}' statusbar_visible="draft,approve" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group string="Request Details">
                            <group>
                                <field domain="[('state','!=','exit')]" name="employee_id" options="{'no_create_edit': True, 'no_create': True}" readonly="state not in ('draft', False)"/>
                                <field force_save="1" name="employee_number" readonly="1"/>
                                <field name="type_id" readonly="state not in ('draft', False)"/>
                                <field invisible="request_date == False" name="request_date" readonly="1"/>
                            </group>
                            <group>
                                <field domain="[('employee_id','=',employee_id)]" name="contract_id" readonly="state not in ('draft', False)"/>
                                <div class="o_td_label" style="width:200px;">
                                    <label for="advance_amount_required" string="Advance Amount Required"/>
                                </div>
                                <field name="advance_amount_required" nolabel="1" readonly="state not in ('draft', False)"/>
                            </group>
                        </group>
                        <!--                        <field name="current_user" invisible='1'/>-->
                        <field invisible="1" name="advance_open"/>
                        <field invisible="1" name="currency_id"/>
                        <field invisible="1" name="is_progress3_clicked"/>
                        <field class="hr_loan_advance_warning" invisible="state not in ('progress2', 'progress', 'approve')" name="warning" readonly="1"/>
                        <notebook>
                            <page invisible="state not in ('progress2', 'progress', 'approve')" name="approval_details" string="Approval Details">
                                <group col="4">
                                    <div class="o_td_label" style="width:200px;">
                                        <label for="old_advance_remaining" string="Old Loan Remaining Amount"/>
                                    </div>
                                    <field name="old_advance_remaining" nolabel="1"/>
                                    <div class="o_td_label" style="width:200px;">
                                        <label for="advance_amount" string="Advance Amount Approved"/>
                                    </div>
                                    <field name="advance_amount" nolabel="1" readonly="state in ('approve', 'refuse')"/>
                                    <field invisible="account_manager_id == False" name="account_manager_id" readonly="1"/>
                                    <field invisible="old_advance_remaining &lt;= 0" name="allow_another_advance" readonly="state in ('approve', 'refuse')"/>
                                    <!--                                    <field name="is_direct_manager" invisible='1'/>-->
                                    <!--                                    <field name="is_coach" invisible='1'/>-->
<!--                                    <div class="o_td_label" style="width:200px;">-->
<!--                                        <label for="advance_month_ins" string="Number of Installments"/>-->
<!--                                    </div>-->
                                    <field name="advance_month_ins" readonly="state in ('approve', 'refuse')"/>
                                    <field name="advance_ins_start_date" readonly="state in ('approve', 'refuse')"/>
                                    <field invisible="move_id == False" name="move_id" readonly="1"/>
                                    <field invisible="account_manager_date == False" name="account_manager_date" readonly="1"/>
                                    <field groups="base.group_multi_company" name="company_id" readonly="1"/>
                                    <!--                                    <field name="is_show_dm_approve" invisible="1"/>-->
                                    <!--                                    <field name="is_show_hrm_approve" invisible="1"/>-->
                                    <!--                                    <field name="is_show_fm_approve" invisible="1"/>-->
                                    <!--                                    <field name="is_show_admin_approve" invisible="1"/>-->
                                </group>
                            </page>
                            <page invisible="state not in ('progress2', 'progress', 'approve')" name="payment_scheduler" string="Payment Scheduler">
                                <field colspan="4" name="hr_employee_advance_line_ps" nolabel="1" string="Advance List">
                                    <tree colors="blue:(state == 'notdeducted');black:(state == 'deducted')" create="0" delete="0" editable="bottom" string="Advance Lines">
                                        <field  name="sequence" column_invisible="parent.state not in ['draft']"/>
                                        <field name="name" readonly="state == 'deducted'"/>
                                        <field name="installment_date" readonly="state == 'deducted'"/>
                                        <field name="installment_value" readonly="state == 'deducted'" column_invisible="parent.state not in ['draft']"/>
                                        <field name="amount" readonly="state == 'deducted'"/>
                                        <field name="remaining_value" readonly="state == 'deducted'" column_invisible="parent.state not in ['draft']"/>
                                        <field name="confirm" readonly="state == 'deducted'"/>
                                        <field name="state"/>
                                    </tree></field>
                                <group class="oe_subtotal_footer oe_right" colspan="2">
                                    <field invisible="1" name="total_amount"/>
                                    <field invisible="1" name="paid_amount"/>
                                    <field name="balance_amount" readonly="1"/>
                                    <field invisible="1" name="paid_installment"/>
                                    <field invisible="1" name="unpaid_installment"/>
                                </group>
                            </page>
                            <page string="Comments">
                                <group col="4">
                                    <field colspan="4" name="employee_comment" placeholder="Write your comments" readonly="state not in ('draft', False)"/>
                                    <field colspan="4" invisible="state not in ('progress2', 'progress', 'approve')" name="dm_comment" placeholder="Direct Manager comments" readonly="state in ('approve', 'refuse')"/>
                                    <field colspan="4" invisible="state not in ('progress2', 'progress', 'approve')" name="hr_comment" placeholder="HR comments" readonly="state in ('approve', 'refuse')"/>
                                    <field colspan="4" invisible="state not in ('progress2', 'progress', 'approve', 'refuse')" name="account_comment" placeholder="Account Manager comments" readonly="state in ('approve', 'refuse')"/>
                                </group>
                            </page>
                            <page string="Approval Notes">
                                <group>
                                    <group>
                                        <field name="d_manager"/>
                                        <field name="d_manager_note" nolabel="1" placeholder="Direct Manager Note" readonly="state != 'request'"/>
                                        <field name="hr_manage_id"/>
                                        <field name="hr_manage_note" nolabel="1" placeholder="HR Manager Note" readonly="state != 'progress'"/>
                                    </group>
                                    <group>
                                        <field name="account_manage_id"/>
                                        <field name="account_manage_note" nolabel="1" placeholder="Admin Manager Note" readonly="state != 'progress2'"/>
                                        <field name="admin_manager_id"/>
                                        <field name="admin_manager_note" nolabel="1" placeholder="Accounting Manager Note" readonly="state != 'progress3'"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field groups="base.group_user" name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form></field>
        </record>
