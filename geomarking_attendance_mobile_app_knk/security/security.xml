<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="employees_own_record" model="ir.rule">
            <field name="name">hr.employee.officer</field>
            <field name="model_id" ref="hr.model_hr_employee" />
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <!-- <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_kiosk'))]" /> -->
        </record>
        <record id="employees_all_record" model="ir.rule">
            <field name="name">hr.employee.admin</field>
            <field name="model_id" ref="hr.model_hr_employee" />
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]" />
        </record>
    </data>
</odoo>