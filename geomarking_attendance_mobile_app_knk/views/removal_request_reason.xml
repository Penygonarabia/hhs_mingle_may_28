<?xml version="1.0" encoding="utf-8"?>

<odoo>
	
	<record id="removal_request_reason_form_view" model="ir.ui.view">
        <field name="name">removal.request.reason.form.view</field>
        <field name="model">removal.request.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <h1>
                                <field name="name" />
                            </h1>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="removal_request_reason_tree_view" model="ir.ui.view">
        <field name="name">removal.request.reason.tree.view</field>
        <field name="model">removal.request.reason</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="action_removal_request_reason" model="ir.actions.act_window">
    	<field name="name">Account Removal Request</field>
    	<field name="res_model">removal.request.reason</field>
    	<field name="view_mode">tree,form</field>
    </record>

</odoo>