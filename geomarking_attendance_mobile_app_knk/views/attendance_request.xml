<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="geomarking_attendance_request_form_view" model="ir.ui.view">
        <field name="name">geomarking.attendance.request.form</field>
        <field name="model">attendance.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button class="oe_highlight" invisible="not state" name="approve_request" string="Approve" type="object"/>
                    <button class="oe_highlight" invisible="not state" name="reject_request" string="Reject" type="object"/>
                    <button class="oe_highlight" invisible="not state" name="cancel_request" string="Cancel" type="object"/>
                    <field name="state" statusbar_visible="draft,approve,reject,cancel" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name" required="1" style="margin-right:10px;"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_type"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field invisible="request_type" name="attendance_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="check_in_datetime"/>
                        </group>
                        <group>
                            <field name="check_out_datetime"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="reason"/>
                        </group>
                    </group>
                </sheet>
            </form></field>
    </record>
    <record id="geomarking_attendance_request_tree_view" model="ir.ui.view">
        <field name="name">geomarking.attendance.request.tree.view</field>
        <field name="model">attendance.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="request_type"/>
                <field name="check_in_datetime"/>
                <field name="check_out_datetime"/>
                <field name="state" widget="badge"/>
            </tree></field>
    </record>
    <record id="action_attendance_request" model="ir.actions.act_window">
        <field name="name">Attendance Request</field>
        <field name="res_model">attendance.request</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
