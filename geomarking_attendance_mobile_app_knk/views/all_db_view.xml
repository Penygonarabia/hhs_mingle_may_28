<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="all_db_form_view" model="ir.ui.view">
        <field name="name">all.db.form</field>
        <field name="model">all.db</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name" required="1" style="margin-right:10px;"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="db_name"/>
                            <field name="url"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="geomarking_app" string="GeoMarking App"/>
                            <field name="odooshoppe_app" string="OdooShoppe App"/>
                        </group>
                        <group>
                            <field name="logo_img" widget="image" class="oe_avatar" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="all_db_tree_view" model="ir.ui.view">
        <field name="name">all.db.form</field>
        <field name="model">all.db</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="db_name"/>
                <field name="username"/>
                <field name="password" password="True"/>
                <field name="url"/>
                <field name="logo_img" widget="image" height="20" class="oe_avatar" />
            </tree>           
        </field>
    </record>
    <record id="all_db_actions" model='ir.actions.act_window'>
        <field name="name">All Database</field>
        <field name='res_model'>all.db</field>
        <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create an New Database
                </p>
            </field>
    </record>
</odoo>