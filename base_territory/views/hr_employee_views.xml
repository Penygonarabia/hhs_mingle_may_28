<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_form_view_iqama_comapny_inherit4" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr_saudi.hr_form_view_inherit3"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='iqama_professional']" position="after">
                    <field force_save="1" invisible="is_saudi == True" name="iqama_company_id" options="{'no_create': True, 'no_open': True}" groups="hr.group_hr_user"/>

                    <field force_save="1" name="iqama_company_id" options="{'no_create': True, 'no_open': True}" groups="!hr.group_hr_user" column_invisible="True"/>
                </xpath>
            </field>
        </record>
        <record id="hr_form_view_active_user_inherit4" model="ir.ui.view">
            <field name="name">hr.employee.form.active.user.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='active']" position="replace">
                    <field  name="active"  invisible="is_saudi == True"  groups="hr.group_hr_user"/>

                    <field name="active"  groups="!hr.group_hr_user" column_invisible="True"/>
                </xpath>
                  <xpath expr="//field[@name='user_id']" position="replace">
                    <field  name="user_id"  invisible="is_saudi == True"  roups="hr.group_hr_user"/>

                    <field name="user_id"  groups="!hr.group_hr_user" column_invisible="True"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
