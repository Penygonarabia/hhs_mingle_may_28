<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit the existing hr.work.location form view -->
    <record id="view_hr_work_location_form_inherit" model="ir.ui.view">
        <field name="name">hr.work.location.form.inherit</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_form_view"/>
        <field name="arch" type="xml">
            <!-- Add your new field below the existing fields -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="code" force_save="1" required="1"/>
            </xpath>
            <xpath expr="//field[@name='address_id']" position="before">
                 <field name="res_region_id" force_save="1" options="{'no_create': True, 'no_open': True}" />
            </xpath>
        </field>
    </record>
    <record id="view_hr_work_location_tree_inherit" model="ir.ui.view">
        <field name="name">hr.work.location.tree.inherit</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_tree_view"/>
        <field name="arch" type="xml">
            <!-- Add your new field below the existing fields -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="code"/>
            </xpath>
        </field>
    </record>
</odoo>
