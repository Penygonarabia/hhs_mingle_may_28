<?xml version ="1.0" encoding="utf-8" ?>
<odoo>
	
	<record id="res_config_settings_inherited_form_base" model="ir.ui.view">
		
		<field name = "name">res.config.settings.base.form</field>
		<field name ="model">res.config.settings</field>
	    <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
	    <field name="arch" type="xml">
	    
	    	<xpath expr="//setting[@id='iap_credits_setting']" position="attributes">
	    		
	    		<attribute name="string">CIELO IAP</attribute>
	    	
	    	
	    	</xpath>
	    	
	    	
	    	
	    </field>
		
	
	
	</record>
	
	<record id="res_config_settings_base_inherit_form_cielo" model="ir.ui.view">
		<field name="name">res.config.settings.base.form</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="website.res_config_settings_view_form"/>
		<field name="arch" type="xml">
					
			
			<xpath expr="//field[@name='website_domain']" position="attributes"> 
				<attribute name="placeholder"></attribute>
			</xpath>
		
			<xpath expr="//setting[@id='robots_setting'][2]" position="attributes">
                    <attribute name="help">
                    Sitemap.xml: Help search engine crawlers to find out what pages are present and which have recently changed, and to crawl your site accordingly. This file is automatically generated by Cielo.
                    </attribute>
                
            </xpath>
                
		
		</field>
		
		
	
	
	</record>
	
	 
        
</odoo>