<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_view_hr_payslip_form_inherit" model="ir.actions.act_window">
        <field name="name">Employee Payslips</field>
        <field name="res_model">hr.payslip</field>
        <field name="context">{}</field>
        <field name="view_mode">form</field>
    </record>
    <record id="attendance_sheet_form_view" model="ir.ui.view">
        <field name="name">attendance.sheet.form.view</field>
        <field name="model">hr.attendance.sheet</field>
        <field name="arch" type="xml">
            <form delete="0">
                <header>
                    <button class="oe_highlight" invisible="state not in ['draft']" name="get_attendance" string="Get Attendance" type="object"/>
                    <!-- 					 <button name="get_attendance_schedule" string="Get Attendance Schedule" type="object" class="oe_highlight" states="draft"/>
 -->
                    <button class="oe_highlight" invisible="state not in ['draft']" name="execute_send_to_manager" string="Submit To Manager" type="object"/>
<!--                    <button class="oe_highlight" invisible="state" name="compute_attendance_data" string="Compute Attendance Data" type="object"/>-->
                    <button class="oe_highlight" name="compute_attendance_data" string="Compute Attendance Data" type="object"/>
                    <button class="oe_highlight" groups="hr_attendance.group_hr_attendance_manager" invisible="state not in ['confirm','']" name="execute_set_to_approve" string="Approve" type="object"/>
                    <button class="oe_highlight" context="{'default_employee_id':employee_id}" groups="hr_attendance.group_hr_attendance_manager,om_hr_payroll.group_hr_payroll_manager" invisible="1 or state not in ['approved']" name="%(hr_attendances_overtime.action_view_hr_payslip_form_inherit)d" string="Create Payslip" type="action"/>
                    <button class="oe_highlight" groups="hr_attendance.group_hr_attendance_manager" invisible="state not in ['approved']" name="execute_set_to_draft" string="Set to Draft" type="object"/>
                    <button class="oe_highlight" groups="hr_attendance.group_hr_attendance_manager" invisible="state not in ['approve']" name="execute_set_to_export" string="Export" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="employee_id" readonly="state == 'approved'" required="1"/>
                        <field force_save="1" name="employee_number" readonly="1"/>
                    </group>
                    <group col="2">
                        <label for="request_date_from" string="Period"/>
                        <div>
                            <field invisible="1" name="date_from"/>
                            <field invisible="1" name="date_to"/>
                            <div class="o_row o_row_readonly o_hr_holidays_dates">
                                <field class="oe_inline" name="request_date_from" readonly="state == 'approved'" required="1"/>
                                <span class="oe_inline">
                                    -
                                </span>
                                <field class="oe_inline" name="request_date_to" readonly="state == 'approved'" required="1"/>
                            </div>
                        </div>
                    </group>
                    <group>
                        <field force_save="1" name="atte_required"/>
                    </group>
                    <group>
                        <field invisible="1" name="latein"/>
                        <field invisible="1" name="overtime"/>
                        <field invisible="1" name="time_different"/>
                        <field invisible="1" name="absent"/>
                        <field invisible="1" name="early_check_out_amount"/>
                    </group>
                    <group>
                        <field invisible="1" name="attendance_sheet_batch_id"/>
                        <field invisible="1" name="employee_policy_id"/>
                        <field invisible="1" name="export_sheet"/>
                        <field name = "late_in_calculation_bool" invisible = "1" />
                        <field name = "early_out_calculation_bool" invisible = "1"/>
                        <field name = "overtime_calculation_bool" invisible = "1" />
                        <field name = "absence_calculation_bool" invisible = "1" />
                    </group>
                    <notebook>
                        <page name="Attendances_line" string="Attendances">
                            <field name="attendance_sheet_ids" readonly="state == 'approved'">
                                <tree create="0" decoration-danger="status == 'absence'" decoration-success="status in ('leave','holiday')" default_order="date asc">
                                    <field name="date"/>
                                    <field name="day"/>
                                    <field name="psignin" widget="float_time"/>
                                    <field name="psignout" widget="float_time"/>
                                    <field name="asignin" widget="float_time"/>
                                    <field name="asignout" widget="float_time"/>
                                    <field decoration-danger="latein > 0.0" name="latein" widget="float_time"/>
                                    <field decoration-success="overtime > 0.0" name="overtime" widget="float_time"/>
                                    <field decoration-danger="difftime != 0.0" name="difftime" widget="float_time"/>
                                    <field decoration-danger="early_out_line != 0.0" name="early_out_line" widget="float_time"/>
                                    <field decoration-primary="total_attendance > 8.00" name="total_attendance" widget="float_time"/>
                                    <field decoration-danger="status == 'absence'" decoration-success="status in ('leave' , 'holiday')" name="status"/>
                                    <field column_invisible="1" name="late_times"/>
                                    <field name="holiday_status"/>
                                    <field force_save="1" column_invisible="1" name="overtime_transaction_id"/>
                                    <field force_save="1" column_invisible="1" name="absence_transaction_id"/>
                                    <field force_save="1" column_invisible="1" name="overtime_bool"/>
                                    <field force_save="1" column_invisible="1" name="absent_bool"/>
                                    <field name="note"/>
                                    <field force_save="1" column_invisible="1" name="export_bool"/>
                                    <field force_save="1" column_invisible="1" name="export"/>
                                    <field force_save="1" column_invisible="1" name="name_id"/>
                                    <field force_save="1" column_invisible="1" name="early_out_bool"/>
                                    <field force_save="1" column_invisible="1" name="early_out_transaction_id"/>
                                    <field force_save="1" column_invisible="1" name="latein_transaction_id"/>
                                    <field force_save="1" column_invisible="1" name="latein_bool"/>
                                    <field force_save="1" column_invisible="1" name="trans_bool"/>
                                    <field force_save="1" column_invisible="1" name="early_out_count"/>
                                    <field force_save="1" column_invisible="1" name="work_type"/>
                                    <button class="oe_highlight" column_invisible="parent.state in ['draft', 'confirm', 'approved']" name="insert_overtime_transaction" string="Overtime Payroll Insert" type="object"/>
                                    <button class="oe_highlight" column_invisible="parent.state in ['draft', 'confirm', 'approved']" name="insert_absence_transaction" string="Absence Payroll Insert" type="object"/>
                                    <button class="oe_highlight" column_invisible="parent.state in ['draft', 'confirm', 'approved']" name="insert_earlyout_transaction" string="Earlyout Payroll Insert" type="object"/>
                                    <button class="oe_highlight" column_invisible="parent.state in ['draft', 'confirm', 'approved']" name="insert_latein_transaction" string="Latein Payroll Insert" type="object"/>
                                    <button class="oe_highlight" column_invisible="not parent.state" name="open_wizard" string="Open" type="object"/>
                                </tree></field>
                        </page>
                        <page string="Calculated Attendance Data">
                            <group colspan="4">
                                <group string="OVER TIME">
                                    <div class="o_td_label" style="width:250px;">
                                        <label for="no_overtime"/>
                                    </div>
                                    <field name="no_overtime" nolabel="1" readonly="1"/>
                                    <field name="total_overtime" readonly="1" widget="float_time"/>
                                    <field invisible="1" name="overtime" readonly="1" string="Overtime Amount"/>
                                </group>
                                <group string="LATE IN">
                                    <div class="o_td_label" style="width:250px;">
                                        <label for="no_latein"/>
                                    </div>
                                    <!-- This is original one -->
                                    <field name="no_latein" nolabel="1" readonly="1"/>
                                    <field name="total_latein" readonly="1" widget="float_time"/>
                                    <field invisible="1" name="latein" readonly="1" string="Late in Amount"/>
                                </group>
                                <group string="ABSENCE">
                                    <div class="o_td_label" style="width:250px;">
                                        <label for="no_absence"/>
                                    </div>
                                    <field name="no_absence" nolabel="1" readonly="1"/>
                                    <field name="total_absence" readonly="1" widget="float_time"/>
                                    <field invisible="1" name="absent" readonly="1" string="Absence Amount"/>
                                </group>
                                <group string="DIFFRENCE TIME">
                                    <div class="o_td_label" style="width:250px;">
                                        <label for="no_difftime"/>
                                    </div>
                                    <field name="no_difftime" nolabel="1" readonly="1"/>
                                    <field name="total_difftime" readonly="1" widget="float_time"/>
                                    <field invisible="1" name="time_different" readonly="1" string="Difference Amount"/>
                                </group>
                                <group string="EARLY CHECKOUT">
                                    <div class="o_td_label" style="width:250px;">
                                        <label for="no_early_checkout"/>
                                    </div>
                                    <field name="no_early_checkout" nolabel="1" readonly="1"/>
                                    <field name="total_early_checkout" readonly="1" widget="float_time"/>
                                    <field invisible="1" name="early_check_out_amount" readonly="1" string="Early Checkout Amount"/>
                                </group>
                                <group invisible="1" string="Early out 15 min to 30 min">
                                    <field invisible="1" name="no_early_out_15min" readonly="1"/>
                                    <field invisible="1" name="total_early_out_15min" readonly="1" widget="float_time"/>
                                    <field invisible="1" name="final_total_early_out_15min" readonly="1"/>
                                </group>
                                <group invisible="1" string="Early out 30 min to 60 min">
                                    <field invisible="1" name="no_early_out_30min" readonly="1"/>
                                    <field invisible="1" name="total_early_checkout_30min" readonly="1" widget="float_time"/>
                                    <field invisible="1" name="final_total_early_out_30min" readonly="1"/>
                                </group>
                                <group invisible="1" string="Early out morethan 60 min">
                                    <field invisible="1" name="no_early_out_60min" readonly="1"/>
                                    <field invisible="1" name="total_early_out_60min" readonly="1" widget="float_time"/>
                                    <field invisible="1" name="final_total_early_out_60min" readonly="1"/>
                                </group>
                                <group invisible="1" string="LATE IN 15 min to 30 min">
                                    <field invisible="1" name="no_latein_15min" readonly="1"/>
                                    <field invisible="1" name="total_latein_15min" readonly="1" widget="float_time"/>
                                    <field invisible="1" name="final_total_late_15min" readonly="1" string="Late in Amount Greater than 1 hour"/>
                                </group>
                                <group invisible="1" string="LATE IN 30 min to less than 1 hour">
                                    <!--  <group string="LATE IN"> -->
                                    <field invisible="1" name="no_latein_30_min" readonly="1"/>
                                    <field invisible="1" name="total_late_30min" readonly="1" widget="float_time"/>
                                    <field invisible="1" name="final_total_late_30min" readonly="1" string="Late in Amount Less than 1 hour"/>
                                </group>
                                <group invisible="1" string="LATE IN Greater than 1 hour">
                                    <field invisible="1" name="no_latein_more_1hour" readonly="1"/>
                                    <field invisible="1" name="total_latein_more_1hour" readonly="1" widget="float_time"/>
                                    <field invisible="1" name="final_total_late_more_1hour" readonly="1" string="Late in Amount Greater than 1 hour"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form></field>
    </record>
    <record id="hr_attendance_sheets_tree_view" model="ir.ui.view">
        <field name="name">hr.attendance.sheets.tree.view</field>
        <field name="model">hr.attendance.sheet</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_number"/>
                <field name="employee_id"/>
                <field name="request_date_from" string="Date From"/>
                <field name="request_date_to" string="Date To"/>
            </tree></field>
    </record>
    <record id="hr_attendance_sheet_search_view" model="ir.ui.view">
        <field name="name">hr.attendance.sheet.search.view</field>
        <field name="model">hr.attendance.sheet</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_number"/>
                <field name="employee_id"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter context="{'group_by':'employee_id'}" domain="[]" name="employee_id" string="Employee Name"/>
                    <filter context="{'group_by':'attendance_sheet_batch_id'}" domain="[]" name="attendance_sheet_batch_id" string="Attendance Batch"/>
                </group>
            </search></field>
    </record>
    <record id="action_attendance_sheets1" model="ir.actions.act_window">
        <field name="name">Attendance Sheets</field>
        <field name="res_model">hr.attendance.sheet</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_attendance_sheet_batch_id":1}</field>
        <field name="domain">[('employee_id.company_id', 'in', allowed_company_ids)]</field>
    </record>
    <menuitem action="action_attendance_sheets1" id="hr_attendance_sheets" name="Attendance Sheets" parent="hr_attendance.menu_hr_attendance_root" sequence="15"/>
    <record id="hr_attendance_sheet_line_form_view" model="ir.ui.view">
        <field name="name">hr.attendance.sheet.line.form.view</field>
        <field name="model">hr.attendance.sheet.line</field>
        <field name="arch" type="xml">
            <form delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="psignin" widget="float_time"/>
                            <field name="asignin" widget="float_time"/>
                            <field name="latein" widget="float_time"/>
                            <field name="difftime" widget="float_time"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="day"/>
                            <field name="psignout" widget="float_time"/>
                            <field name="asignout" widget="float_time"/>
                            <field name="overtime" widget="float_time"/>
                            <field name="total_attendance" widget="float_time"/>
                            <field name="status"/>
                            <field name="holiday_status"/>
                        </group>
                    </group>
                </sheet>
            </form></field>
    </record>
