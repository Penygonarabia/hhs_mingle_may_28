<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="attendance_policies_form_view" model="ir.ui.view">
        <field name='name'>attendance.policies.form.view</field>
        <field name='model'>hr.attendance.policies</field>
        <field name='arch' type='xml'>
            <form>
                <sheet>
                    <group col="2">
                        <field name="name" required="1"/>
                        <field name="attendance_grace_time" required="1" force_save="1" widget="float_time"/>
                        <field name="additional_overtime" force_save="1"/>
                    </group>
                    <group string="Overtime Rules" name="overtime_id" >
                        <field name="overtime_id" required="1" context="{'attendance_policy':True}"/>
                    </group>
                    <group string="Difference Time Rules">
                    	<field name="diff_rule_id" required="1"/>
                    </group>
                    <group string="Late In Rules">
                    	<field name="late_id" required="1"/>
                    </group>
                    <group string="Absence Rules">
                    	<field name="absent_id"  required="1"/>
                    </group>
                    <group string="Early Checkout Rules">
                    	<field name="early_checkout_id"  required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model='ir.ui.view' id='attendance_policies_tree'>
        <field name='name'>attendance_policies.tree</field>
        <field name='model'>hr.attendance.policies</field>
        <field name='arch' type='xml'>
            <tree string='description'>
                <field name='name'/>
                <field name="overtime_id"/>
                <field name="diff_rule_id"/>
                <field name="late_id"/>
                <field name="absent_id"/>
                <field name="early_checkout_id"/>
            </tree>
        </field>
    </record>

	<record id="action_attendance_policies" model="ir.actions.act_window">
        <field name="name">Attendance Policies</field>
        <field name="res_model">hr.attendance.policies</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('create_uid.company_id', 'in', allowed_company_ids)]</field>
    </record>


