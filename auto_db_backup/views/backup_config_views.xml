<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_auto_db_backup_config_form" model="ir.ui.view">
            <field name="name">auto.db.backup.config.form</field>
            <field name="model">auto.db.backup.config</field>
            <field name="arch" type="xml">
                <form string="Backup Configuration">
                    <header>
                        <button name="action_test_connection" type="object"
                                string="🔌 Test DB Connection" class="btn-info"/>
                        <button name="action_test_gdrive" type="object"
                                string="☁️ Test Google Drive" class="btn-warning"
                                invisible="storage_type != 'google_drive'"/>
                        <button name="action_backup_now" type="object"
                                string="📦 Backup Now" class="btn-primary"
                                confirm="This will run an immediate backup. Continue?"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_logs" type="object"
                                    class="oe_stat_button" icon="fa-history">
                                <field name="backup_count" widget="statinfo" string="Backups"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Disabled" bg_color="text-bg-danger"
                                invisible="is_active"/>
                        <div class="oe_title">
                            <h1><field name="db_name" placeholder="Database name..."/></h1>
                        </div>

                        <group>
                            <group string="🗄️ Database Connection">
                                <field name="db_host"/>
                                <field name="db_port"/>
                                <field name="db_user"/>
                                <field name="db_password" password="True"/>
                            </group>
                            <group string="⚙️ Backup Settings">
                                <field name="backup_format"/>
                                <field name="retention_days"/>
                                <field name="is_active"/>
                            </group>
                        </group>

                        <separator string="📁 Storage Destination"/>
                        <group>
                            <group>
                                <field name="storage_type" widget="radio"/>
                            </group>
                        </group>

                        <!-- LOCAL STORAGE -->
                        <group string="📂 Local Path" invisible="storage_type != 'local'">
                            <group>
                                <field name="backup_path" placeholder="/mnt/backup/odoo"/>
                            </group>
                        </group>

                        <!-- GOOGLE DRIVE -->
                        <group string="☁️ Google Drive Configuration" invisible="storage_type != 'google_drive'">
                            <group>
                                <field name="gdrive_credentials_path"
                                       placeholder="/etc/odoo/gdrive_service_account.json"/>
                                <field name="gdrive_folder_id"
                                       placeholder="e.g. 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2bgMs"/>
                            </group>
                            <group>
                                <field name="backup_path" string="Temp Local Path"
                                       placeholder="/tmp/odoo_backups"
                                       help="Temporary folder to create the dump before uploading. Cleaned up after upload."/>
                            </group>
                        </group>

                        <group string="📊 Last Backup Info" invisible="not last_backup_date">
                            <group>
                                <field name="last_backup_date"/>
                            </group>
                            <group>
                                <field name="last_backup_size"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- LIST VIEW -->
        <record id="view_auto_db_backup_config_list" model="ir.ui.view">
            <field name="name">auto.db.backup.config.list</field>
            <field name="model">auto.db.backup.config</field>
            <field name="arch" type="xml">
                <tree string="Backup Configurations"
                      decoration-muted="not is_active"
                      decoration-success="is_active">
                    <field name="db_name"/>
                    <field name="db_host"/>
                    <field name="storage_type" widget="badge"
                           decoration-info="storage_type == 'local'"
                           decoration-success="storage_type == 'google_drive'"/>
                    <field name="backup_format"/>
                    <field name="retention_days"/>
                    <field name="last_backup_date"/>
                    <field name="last_backup_size"/>
                    <field name="is_active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_auto_db_backup_config" model="ir.actions.act_window">
            <field name="name">Backup Configurations</field>
            <field name="res_model">auto.db.backup.config</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
