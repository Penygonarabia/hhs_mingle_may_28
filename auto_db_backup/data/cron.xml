<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily Backup Cron Job — Runs at 2:00 AM every day -->
        <record id="ir_cron_auto_db_backup" model="ir.cron">
            <field name="name">Auto Database Backup (Daily)</field>
            <field name="model_id" ref="model_auto_db_backup_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_backup()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=23, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
