<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="stock_request_internal_report_wizard" model="ir.ui.view">
            <field name="name">stock.request.report.wizard.form</field>
            <field name="model">stock.request.report</field>
            <field name="arch" type="xml">
                <form string="Stock Transfer Request">
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group>
                        <group>
                              <field name = "source_location_id" options="{'no_create': True, 'no_create_edit':True}"/>
<!--                            <field name = "destination_location_id" options="{'no_create': True, 'no_create_edit':True}"/>
-->                            <field name = "category_ids" widget = "many2many_tags" options="{'no_create': True, 'no_create_edit':True}"/>
                            <field name = "product_ids"  widget = "many2many_tags" options="{'no_create': True, 'no_create_edit':True}"/>
                        </group>
                        <group>
							<field name = "company_id" invisible = "1"/>  
						</group>
                    </group>
                    <footer>
                        <button name="print_report_excel_internal" string = "Print Excel" type = "object" class = "oe_highlight" icon="fa-file-excel-o"/>
                        <button string="Cancel" class = "btn-secondary" special = "cancel" data-hotkey = "z" />
                    </footer>
                </form>
            </field>
        </record>
        
        <record id="action_stock_request_report" model="ir.actions.act_window">
	        <field name="name">Stock Transfer Request Report</field>
	        <field name="res_model">stock.request.report</field>
	        <field name="view_mode">form</field>
	        <field name="target">new</field>
    </record>

    <menuitem id="menu_stock_transfer_request_report" name="Stock Transfer Request Report" action="action_stock_request_report" parent="stock.menu_warehouse_report" sequence="1"/>
        
        
</odoo>