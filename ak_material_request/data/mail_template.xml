<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		
		<record id="mail_template_transfer_request" model="mail.template">
			<field name="name">Transfer Request Mail Template</field>
			<field name="model_id"  ref="ak_material_request.model_material_request"/>
			<field name="email_from">{{object.user_id.login or ''}}</field>
			<field name="email_to">{{','.join(map(str, object.approved_user_id.mapped('login')))}}</field>
			<field name="subject">Internal Stock Request : {{object.name}}</field>
			<field name="body_html" type="html">
				<div style="margin: 0px; padding: 0px;">
				<p> Dear <strong t-out="object.approved_user_id.name or ''"/>,</p>
				
				<p style="text-indent: 100px;">Reference Number is <strong t-out="object.name or ''"/> and Requested Date is  <strong t-out="object.request_date.strftime('%d-%m-%Y %H:%M:%S') or ''"></strong> Stock For Branch is <strong t-out="object.location_id.display_name or ''"/>  is needed from the  Stock From Branch is  <strong t-out="object.dest_location_id.display_name or ''"/>.</p>
                    <br/>
                    <br/>
                     <div>
	  	     			 <table class = "table table-sm o_main_table"  style="border: 1px solid black; border-collapse: collapse;">
		                    <tr>
		                        <t t-set = "colspan" t-value = "5"/>
		                        <th style="border: 1px solid black;text-align: center;font-weight: bold;">Product</th>
		                      	<th style="border: 1px solid black;text-align: center;font-weight: bold;">Description</th>

		                        <th style="border: 1px solid black;text-align: center;font-weight: bold;">Qty</th>
		                        <th style="border: 1px solid black;text-align: center;font-weight: bold;">O/H Qty</th>

		                        <th style="border: 1px solid black;text-align: center;font-weight: bold;">UOM</th>
		                    </tr>
	                <t t-foreach="object.request_line_ids" t-as = "line">
	                    <tr>
                             <td style="border: 1px solid black;text-align: center;font-weight: bold;"><span t-field = "line.product_id"></span></td>
                    	     <td style="border: 1px solid black;text-align: center;font-weight: bold;"><span t-field = "line.description"></span></td>
                    	     <td style="border: 1px solid black;text-align: center;font-weight: bold;"><span t-field = "line.qty"></span></td>
            				 <td style="border: 1px solid black;text-align: center;font-weight: bold;" ><t t-esc = "line.on_hand_qty"/></td>
            				 <td style="border: 1px solid black;text-align: center;font-weight: bold;" ><t t-esc = "line.uom_id.name"/></td>
	                    </tr>
	               </t>
	          </table>
	       </div> 
	       
	       <br/><br/>
                    <p>In case of any queries concerning this matter, do not hesitate to contact our team.</p>
                    <br/>
                 	  <strong>Best Regards,</strong> 
                    <br/>
                  	  <strong t-out="object.company_id.partner_id.name or ''"/>
                    <br/>
                     	<strong t-out="object.company_id.partner_id.street or ''"/>
                     <br/>
                     	<strong t-out="object.company_id.partner_id.phone or ''"/>
                     <br/>
                       	<strong t-out="object.company_id.partner_id.email or ''"/>
                     <br/>

					
				</div>
				
			</field>
		</record>
		
