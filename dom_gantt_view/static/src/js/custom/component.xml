<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="MyComponent" owl="1">
        <div class="o_my_component">

            <div class="row mb-3 pt-3">
                <div class="col-3"></div>
                <div class="d-flex gap-2 col-6">
                    <input type="text" class="form-control" style="width: 210px; height: 30px;" placeholder="Job Card#" t-model="state.jobCardNumber" t-att-readonly="true"/>
                    <input type="text" class="form-control" style="width: 210px; height: 30px;" placeholder="Customer name" t-model="state.customerName" t-att-readonly="true" />
                    <input type="text" class="form-control" style="width: 210px; height: 30px;" placeholder="Service Requested Appt Date-Time" t-model="state.service_requested_datetime_formatted" t-att-readonly="true" />
                </div>
                <div class="col-3"></div>
            </div>
        </div>
    </t>
</templates>
