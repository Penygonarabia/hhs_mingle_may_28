<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_employee_salary_report_form" model="ir.ui.view">
		 <field name="name">employee.salary.report.wizard</field>
		 <field name="model">employee.salary.report</field>
		 <field name="arch" type="xml">
		 	<form string="Employee Salary Report">
					<group>				
						<field name="employee_ids" widget="many2many_tags"/>
					</group>
					<group>
						<field name="company_id" invisible="1"/>
					</group>
				  <footer>
						 <button name="print_salary_report" string="Print Excel" type="object" class="oe_highlight"/>
						<button name="clear" string="Cancel" class="btn-secondary" special="cancel"/>
				</footer>
				 
			 </form>
		 
		 </field>	
	</record>
    
    
    <record id="action_employee_salary_report" model="ir.actions.act_window">
		<field name="name">Salary</field>
		<field name="res_model">employee.salary.report</field>
		<field name="view_mode">form</field>
         <field name="view_id" ref="view_employee_salary_report_form"/>
		<field name="target">new</field>
		 <field name="binding_model_id" ref="model_employee_salary_report"/>
        <field name="binding_type">report</field>
	</record>
	
<!--	<menuitem id="menu_action_employee_salary_report" name="Employee Salary Report" action="action_employee_salary_report"  parent="payroll_report.menu_payroll_report" sequence="201" />
-->    
<menuitem id="menu_action_employee_salary_report" 
              	name="Salary"
              	action="action_employee_salary_report"  
              	parent="om_hr_payroll.employee_reports_menu" 
              	sequence="20" />
    
</odoo>
