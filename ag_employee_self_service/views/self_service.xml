        </record> -->
        <!--        <menuitem name="Letters" id="menu_service" sequence="80"-->
        <!--                  web_icon="ag_employee_self_service,static/description/letters.png" />-->
        <menuitem id="menu_service" name="Letters" parent="hr.menu_hr_root" sequence="15"/>
        <menuitem action="action_employee_service" id="menu_service_main" name="Document Request" parent="ag_employee_self_service.menu_service" sequence="1"/>
        <menuitem groups="hr.group_hr_manager" id="menu_service_config" name="Configuration" parent="ag_employee_self_service.menu_service" sequence="2"/>
        <menuitem action="ag_employee_self_service.template_action" groups="hr.group_hr_manager" id="menu_service_template" name="Templates" parent="ag_employee_self_service.menu_service_config" sequence="1"/>
    </data>
</odoo>
