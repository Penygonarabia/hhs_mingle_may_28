		<template id="report_print_pack_new">
        <t t-call="web.html_container">
            <t t-call="ag_employee_self_service.report_print_pack_internal_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="header" t-att-style="report_header_style">
                            <div class="row mt32 mb32">
                                <div class="col-3 text-left" style="font:12px lucida-console,sans-serif !important;">
                                    <span t-field="res_company.partner_id"/>
                                    <br/>
                                    <span t-field="res_company.partner_id.street"/>
                                    <br/>
                                    <t t-if="res_company.partner_id.street2">
                                        <span t-field="res_company.partner_id.street2"/>
                                        <br/>
                                    </t>
                                    <span t-field="res_company.partner_id.city"/>
                                    <br/>
                                    <span t-field="res_company.partner_id.country_id"/>
                                    <br/>
                                    <span t-field="res_company.partner_id.vat"/>
                                    <br/>
                                     <span style="text-align:right;">Date: <t t-esc="doc.date"/></span><br/>
                                     <span style="text-align:right;">Ref: <span t-field="doc.seq_name"/></span>
                                </div>
                                <div class="col-6">
                                    <h2><center><t t-esc="doc.subject"/></center></h2>
    
                                </div>
                                <div class="col-3 text-right " style="vertical-align:text-top">
                                    <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="max-height: 100px; min-height:100px; min-width: 120px; max-width: 120px;" />
                                </div>
                            </div>
                        </div>
                    <div class="page">
                        <div class="col-12">
                            <span t-raw="doc.template"/>
                        </div>
                        <span t-field="doc.sign_man" /><br/>
                        <span t-field="doc.sign_man.job_id.name" />
                    </div>
                </t>
            </t>
        </t>
    </template>
	
</odoo>