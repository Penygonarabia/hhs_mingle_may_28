                <!--                                <field name="birth_date"/>-->
                <!--                            </tree>-->
                <!--</field>-->
                <!--                    </group>-->
                <!--                </xpath>-->
                <field name="identification_id" position="replace"/>
                <!--                <field name="passport_id" position="replace"/>-->
                <xpath expr="//page[@name='dependence_details']" position="after">
                    <!-- <xpath expr="//page[@name='personal_information']/group/group[1]" position="after"> -->
                    <page name="identification_no" string="Documents">
                        <group invisible="0" name="identification_id" string="Documents">
                            <field invisible="1" name="identification_id" readonly="0"/>
                            <field groups="hr.group_hr_user" invisible="identification_id in [None, False]" name="id_expiry_date"/>
                            <field class="oe_inline" groups="hr.group_hr_user" invisible="identification_id in [None, False]" name="id_attachment_id" widget="many2many_binary"/>
                        </group>
                    </page>
                    <!--                    <group name="passport_id" string="Passport ID">-->
