        <menuitem groups="hr.group_hr_manager,hr.group_hr_user" id="employee_report_menu" name="Reports" sequence="30"/>
        <menuitem groups="hr.group_hr_manager,hr.group_hr_user" id="menu_hr_management" name="HR Management" parent="hr.menu_hr_root" sequence="5"/>
        <record id="hr_employee_inherit_form_view4" model="ir.ui.view">
            <field name="name">hr.employee.form.view</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='department_id']" position="attributes">
                     <attribute name="required">1</attribute>
                </xpath>

                <xpath expr="//field[@name='birthday']" position="attributes">
                     <attribute name="required">1</attribute>
                </xpath>

                <xpath expr="//field[@name='department_id']" position="after">
                    <field invisible="1" name="joining_date"/>
                </xpath>
                <xpath expr="//field[@name='name']" position="replace">
                    <field name="name" placeholder="Employee's Name" required="True"/>
                </xpath>
                <xpath expr="//field[@name='coach_id']" position="after">
                    <field invisible="1" name="sequence" string="Code"/>
                </xpath>
<!--                <xpath expr="//h2" position="replace">-->
<!--                </xpath>-->
                <!--  <xpath expr="//page[@name='personal_information']/group/group[2]" position="after">

                    <group string="Work Experience">
                     <div class="o_td_label" style="width:250px;">
			                <label for="yrs_of_exp"/>
			            </div>
                        <field name="yrs_of_exp" nolabel="1"/>

                    </group>
                </xpath> -->
                <xpath expr="//group[@name='active_group']" position="after">
                    <group string="Work Experience">
                        <!-- <div class="o_td_label" style="width:250px;">
			                <label for="yrs_of_exp"/>
			            </div> -->
                        <field name="yrs_of_exp"/>
                    </group>
                </xpath>
                <xpath expr="//field[@name='category_ids']" position="replace">
                    <field groups="hr.group_hr_manager" invisible="1" name="category_ids" options="{'color_field': 'color', 'no_create_edit': True}" placeholder="Tags" widget="many2many_tags"/>
                </xpath>
                <!--                <xpath expr="//page[@name='personal_information']/group" position="after">-->
                <!--                    <group name="fam_ids" colspan="4" string="Dependence Details" invisible="1">-->
                <!--                        <field name="fam_ids">-->
