<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="project_role_tree" model="ir.ui.view">
        <field name="model">project.role</field>
        <field name="arch" type="xml">
            <tree editable="bottom" sample="1">
                <field name="code" placeholder="e.g. Dev" />
                <field name="name" placeholder="e.g. Developer" />
            </tree>
        </field>
    </record>

    <record id="action_project_role" model="ir.actions.act_window">
        <field name="name">Project Roles</field>
        <field name="res_model">project.role</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
              No roles found. Let's create one!
            </p><p>
              Define the roles which needed by your projects.
            </p>
        </field>
    </record>

    <menuitem
        name="Roles"
        id="menu_projects_role"
        parent="project.menu_project_config"
        action="action_project_role"
        sequence="5"
    />
</odoo>
