<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_dbmodel_jobcards_tree" model="ir.ui.view">
        <field name="name">dbmodel.jobcards.tree</field>
        <field name="model">dbmodel.jobcards</field>
        <field name="arch" type="xml">
            <tree string="Job Cards Analysis" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="user_id"/>
                <field name="service_warranty_id"/>
                <field name="work_center_group_id"/>
                <field name="work_center_id"/>
                <field name="job_card_state"/>
                <field name="service_created_datetime" widget="datetime"/>
                <field name="rtat_hours"/>
                <field name="service_grand_total_amount" sum="Service Total"/>
                <field name="parts_grand_total_amount" sum="Parts Total"/>
                <field name="grand_total_amount" sum="Grand Total"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_dbmodel_jobcards_pivot" model="ir.ui.view">
        <field name="name">dbmodel.jobcards.pivot</field>
        <field name="model">dbmodel.jobcards</field>
        <field name="arch" type="xml">
            <pivot string="Job Cards Analysis" sample="1">
                <field name="user_id" type="row"/>
                <field name="service_created_datetime" interval="month" type="col"/>
                <field name="grand_total_amount" type="measure"/>
                <field name="rtat_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_dbmodel_jobcards_graph" model="ir.ui.view">
        <field name="name">dbmodel.jobcards.graph</field>
        <field name="model">dbmodel.jobcards</field>
        <field name="arch" type="xml">
            <graph string="Job Cards Analysis" type="bar" sample="1">
                <field name="user_id" type="row"/>
                <field name="grand_total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_dbmodel_jobcards_search" model="ir.ui.view">
        <field name="name">dbmodel.jobcards.search</field>
        <field name="model">dbmodel.jobcards</field>
        <field name="arch" type="xml">
            <search string="Search Job Cards">
                <field name="name"/>
                <field name="user_id"/>
                <field name="work_center_group_id"/>
                <field name="work_center_id"/>
                <field name="job_card_state"/>
                
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="User" name="group_by_user" context="{'group_by':'user_id'}"/>
                    <filter string="Work Center Group" name="group_by_work_center_group" context="{'group_by':'work_center_group_id'}"/>
                    <filter string="Work Center" name="group_by_work_center" context="{'group_by':'work_center_id'}"/>
                    <filter string="Job Card State" name="group_by_state" context="{'group_by':'job_card_state'}"/>
                    <filter string="Service Month" name="group_by_month" context="{'group_by':'service_created_datetime:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dbmodel_jobcards" model="ir.actions.act_window">
        <field name="name">Job Cards Analysis</field>
        <field name="res_model">dbmodel.jobcards</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="search_view_id" ref="view_dbmodel_jobcards_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- Menu Item (Under existing root menu) -->
   <!--  <menuitem id="menu_dbmodel_jobcards_view" name="Job Cards Analysis" parent="menu_service_dashboard_root" action="action_dbmodel_jobcards" sequence="20"/> -->

</odoo>
