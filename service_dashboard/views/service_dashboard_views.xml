<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_service_dashboard_tree" model="ir.ui.view">
        <field name="name">service.dashboard.tree</field>
        <field name="model">service.dashboard</field>
        <field name="arch" type="xml">
            <tree string="Service Dashboard" default_order="service_created_datetime desc" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="service_created_datetime" widget="datetime"/>
                <field name="region"/>
                <field name="work_location"/>
                <field name="warranty_name"/>
                <field name="job_card_state" widget="badge" 
                       decoration-info="job_card_state == 'draft'" 
                       decoration-success="job_card_state == 'done'" 
                       decoration-warning="job_card_state == 'in_progress'"/>
                <field name="rtat_hours"/>
                <field name="service_grand_total_amount" sum="Total Service Amount"/>
                <field name="parts_grand_total_amount" sum="Total Parts Amount"/>
                <field name="grand_total_amount" sum="Total Amount"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_service_dashboard_pivot" model="ir.ui.view">
        <field name="name">service.dashboard.pivot</field>
        <field name="model">service.dashboard</field>
        <field name="arch" type="xml">
            <pivot string="Service Dashboard" sample="1">
                <field name="region" type="row"/>
                <field name="service_created_datetime" interval="month" type="col"/>
                <field name="grand_total_amount" type="measure"/>
                <field name="rtat_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_service_dashboard_graph" model="ir.ui.view">
        <field name="name">service.dashboard.graph</field>
        <field name="model">service.dashboard</field>
        <field name="arch" type="xml">
            <graph string="Service Dashboard" type="bar" sample="1">
                <field name="region" type="row"/>
                <field name="grand_total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_service_dashboard_search" model="ir.ui.view">
        <field name="name">service.dashboard.search</field>
        <field name="model">service.dashboard</field>
        <field name="arch" type="xml">
            <search string="Search Service Dashboard">
                <field name="name"/>
                <field name="region"/>
                <field name="work_location"/>
                <field name="warranty_name"/>
                <field name="job_card_state"/>
                
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Region" name="group_by_region" context="{'group_by':'region'}"/>
                    <filter string="Work Location" name="group_by_work_location" context="{'group_by':'work_location'}"/>
                    <filter string="Job Card State" name="group_by_state" context="{'group_by':'job_card_state'}"/>
                    <filter string="Service Month" name="group_by_month" context="{'group_by':'service_created_datetime:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_service_dashboard" model="ir.actions.act_window">
        <field name="name">Service Dashboard</field>
        <field name="res_model">service.dashboard</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="search_view_id" ref="view_service_dashboard_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- Menu Item (Will act as a top-level menu or under your existing app) -->
    <!-- <menuitem id="menu_service_dashboard_root" name="Service Dashboard" sequence="40"/>
    <menuitem id="menu_service_dashboard_view" name="Dashboard Overview" parent="menu_service_dashboard_root" action="action_service_dashboard" sequence="10"/>
 -->
</odoo>
