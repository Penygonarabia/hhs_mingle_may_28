            <xpath expr="//group[@name='vendor']/field[@name='partner_id']" position="replace">
                <field context="{'res_partner_search_mode': 'supplier', 'show_vat': True}" domain="[('type', '!=', 'private'), ('company_id', 'in', (False, company_id)),('partner_type', 'in', ['vendor','both'])]" name="partner_id" placeholder="Name, TIN, Email, or Reference" widget="res_partner_many2one"/>
                <!--                <attribute name="domain">[('partner_type', 'in', ['vendor','both'])]</attribute>-->
            </xpath></field>
    </record>
