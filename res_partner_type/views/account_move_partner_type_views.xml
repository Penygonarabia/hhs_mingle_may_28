    <record id="view_sale_order_partner_type_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='partner_details']" position="replace">
                <group name="partner_details">
                    <field context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}" domain="[('type', '!=', 'private'), ('company_id', 'in', (False, company_id)),('partner_type', 'in', ['customer','both'])]" name="partner_id" options='{"always_reload": True}' widget="res_partner_many2one"/>
                    <field context="{'default_type':'invoice'}" groups="sale.group_delivery_invoice_address" name="partner_invoice_id" options='{"always_reload": True}'/>
                    <field groups="!sale.group_delivery_invoice_address" name="partner_invoice_id" column_invisible="True"/>
                    <field context="{'default_type':'delivery'}" groups="sale.group_delivery_invoice_address" name="partner_shipping_id" options='{"always_reload": True}'/>
                    <field groups="!sale.group_delivery_invoice_address" name="partner_shipping_id" column_invisible="True"/>

                </group>
            </xpath></field>
    </record>
    <record id="view_purchase_order_partner_type_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/group[1]/field[@name='partner_id']" position="attributes">
                <!--                <field name="partner_id" widget="res_partner_many2one"  context="{'res_partner_search_mode': 'supplier', 'show_vat': True}" placeholder="Name, TIN, Email, or Reference"/>-->
                <attribute name="domain">
                    [('type', '!=', 'private'), ('company_id', 'in', (False, company_id)),('partner_type', 'in', ['vendor','both'])]</attribute>
            </xpath></field>
    </record>
    <record id="view_product_supplierinfo_partner_type_form" model="ir.ui.view">
        <field name="name">product.supplierinfo.form</field>
