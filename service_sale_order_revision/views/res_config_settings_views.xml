<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Inherited res_config_settings view of sale for adding the quotation revision feature  -->
    <record id="res_config_settings_revision_service_module_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.service.quotation.revision</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="machine_repair_management.res_config_settings_service_module_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='machine_repair_management']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="sale_revision_settings">
                    <div class="o_setting_left_pane">
                        <field name="is_quotation_revision"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="is_quotation_revision"/>
                        <div class="text-muted">
                            Revise and track the history of sales orders.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
