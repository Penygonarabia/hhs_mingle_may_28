<?xml version = "1.0" encoding = "utf-8" ?>
<odoo>

		<record id = "partner_classification_type_tree_view" model = 'ir.ui.view'>
			
			<field name = "name">partner.classification.tree.view</field>
			<field name = "model">partner.classification</field>
			<field name = "arch" type = "xml" >
			
				<tree delete = "0">
					<field name = "pc_code" />
					<field name = "pc_classification1" />
					<field name = 'pc_classification2' />
					<field name = "pc_partner_type" />
					<field name = "pc_partner_sub_type" />
				
				</tree>
			
			</field>
		
		</record>
	
		<record id = "partner_classification_type_form_view" model = "ir.ui.view">
			<field name = "name">partner.classification.form.view</field>
			<field name = "model">partner.classification</field>
			<field name = "arch" type = "xml">
			
				<form delete = "0">
					<sheet>
						<group>
							
							<field name = "pc_partner_type" required = "1"/>
							<field name = "pc_partner_sub_type"  required = "1"/>
							<field name = "pc_code"  required = "1"/>
							<field name = "pc_classification1" required = "1"/>
							<field name = 'pc_classification2' />
						
						</group>
					
					</sheet>
				
				</form>
			
			</field>
	
		</record>
		
		<record id = "action_partner_classification" model = "ir.actions.act_window">
			<field name = "name">Partner Classification</field>
			<field name = "res_model">partner.classification</field>
			<field name = "view_mode">tree,form</field>
		
		</record>
		
		
		<menuitem id = "menu_partner_classification" 
				  action = "action_partner_classification"	
				  parent = "sale.menu_sale_config"
				  sequence = "99"
				  
					/>
		
	
	
		



</odoo>