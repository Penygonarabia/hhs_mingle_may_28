<?xml version="1.0" encoding="utf-8" ?>
<odoo>
	<record id="view_payroll_advice_two_tree" model="ir.ui.view">
		<field name="name">payroll.advice.two.tree.view</field>
		<field name="model">payroll.advice.two</field>
		<field name="arch" type="xml">
			<tree string="Payroll Advice Two Tree">
				<field name="name" string = "Period Name" readonly="1" force_save='1'/>
			     <field name="from_date"/>
			</tree>
		</field>
	</record>

	<record id="view_payroll_advice_two_form" model="ir.ui.view">
		<field name="name">payroll.advice.two.form.view</field>
		<field name="model">payroll.advice.two</field>
		<field name="arch" type="xml">
			<form string="Payroll Advice Two" delete="0" >
				<sheet>
				<group>
		        <group col = "2">				          
                       <field name="name" string = "Period Name" readonly="1" force_save='1'/>
			   </group>		
					<group col = "2">
			    		<field name="from_date"/>
					</group>
					<group>
						<field name="company_id" invisible="1"/>
						<field name = "bank_format" invisible="1"/>
					</group>
				</group>	
			   <group>	
					<notebook>
					    <page string = "Payment Information" class="oe_highlight">
 					      <field name = "payroll_two_line_ids" readonly="1" force_save='1' options="{'no_create_edit':True,'no_create':True}">
					           <tree editable = "bottom">
					           	 <field name = "net_salary"  width="150px"  force_save='1' readonly="1"/>	
					           	  <field name = "bank_account_id"  width="225px" force_save='1' readonly="1"/>
					           	  <field name = "employee_id"  width="150px" force_save='1' readonly="1"/>
					           	  <field name = "employee_beneficiary" optional="hide" width="200px" force_save='1' readonly="1"/> 
					           	  <field name = "employee_beneficiary_address_two"  optional="hide"  width="200px" force_save='1' readonly="1"/>
					           	   <field name = "employee_beneficiary_address_three"  optional="hide"  width="200px" force_save='1' readonly="1"/>  
					           	  <field name = "bank_name" width="100px" force_save='1'  readonly="1"/>
					           	  <field name = "payment_description" optional="hide"  width="200px" force_save='1' readonly="1"/>
					              <field name = "basic_salary"  width="100px" force_save='1' readonly="1"/>
					          	  <field name = "housing_allowance"  width="150px" force_save='1' readonly="1"/>
					              <field name = "other_earning"  width="100px" force_save='1' readonly="1"/>	
					              <field name = "deduction"  width="100px" force_save='1' readonly="1"/> 
					              <field name = "beneficiary_id"  width="100px" force_save='1' readonly="1"/> 
					              <field name ="payroll_reference"  width="225px" force_save='1' readonly="1" invisible = "1"/>
					           	  <field name ="date_from" width="225px" force_save='1' readonly="1" invisible = "1"/>
					           	  <field name ="date_to" width="225px" force_save="1" readonly="1" invisible = "1"/>
      					        </tree>
					         </field>
					    </page>
					</notebook>
				</group>
			</sheet>	
			</form>
		</field>
		</record>

	<record id="action_view_payroll_advice_two"  model="ir.actions.act_window">
		<field name="name">Bank Transfer Report</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">payroll.advice.two</field>
		<field name="view_mode">tree,form</field>
		<field name="context">{}</field>
		<field name="domain">[]</field>
	</record>
