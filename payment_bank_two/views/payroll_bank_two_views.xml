              sequence="12"/>
               -->
              
              <!-- <menuitem id="menu_payroll_payment_adv"
               parent="om_hr_payroll.menu_hr_payroll_root"
           		name="Payment Advice"
            	
              sequence="10"/>-->
              
              
              <menuitem id="menu_payroll_payment_advice"
              name="Bank Transfer Report"
               parent="employee_payroll_report.menu_payroll_report_xlsx"
              action="action_view_payroll_advice_two"
            
              sequence="30"/>
              

</odoo>
