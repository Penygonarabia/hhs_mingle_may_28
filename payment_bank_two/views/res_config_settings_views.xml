<?xml version="1.0" encoding="utf-8" ?>
<odoo>
	
		<record id="sib_format_res_config_setings" model="ir.ui.view">
			<field name = "name">res.config.settings.payroll</field>
			<field name="model">res.config.settings</field>
			<field name="inherit_id" ref="tw_gosi.res_config_settings_view_form_gosi" />
			<field name="arch" type="xml">
				<xpath expr="//div[@id='hr_payroll_gosi_saudi_configuration']" position="after">
					<h2>Bank Transfer Format</h2>
					<div class="row mt16 o_settings_container" name="bank_transfer_format_container">
                		<div class="col-12 col-lg-6 o_setting_box" title="Bank Transfer Format">
                   
                    <div class="content-group">
                       <div class="mt16" >
                         <label string="Bank Transfer Format" for="bank_transfer_format" />
                           <field name="bank_transfer_format" class="oe_inline"/>
                       </div>
                   </div>
                    
                </div>
            </div>
					
				
				</xpath>
				
				
			
			</field>
		
		</record>
	

</odoo>