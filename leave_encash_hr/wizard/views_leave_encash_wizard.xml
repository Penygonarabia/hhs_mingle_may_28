<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="leave_encash_report_wizard" model="ir.ui.view">
            <field name="name">leave.encash.report.wizard</field>
            <field name="model">leave.encash.report</field>
            <field name="arch" type="xml">
                <form string="Leave Encash report">
                    <group col="4">
                        <field name="start_date" />
                        <field name="end_date" />
                    </group>
                    <group col="4">
                        <field name="employee_ids" widget="many2many_tags" options="{'no_create_edit': True}" />
                        <field name="leave_type_ids" widget="many2many_tags" options="{'no_create_edit': True}" />
                    </group>
                    <group>
                    	<field name="company_id" invisible="1"/>
                    </group>
                    <footer>
                        <button name='print_report_excel' string="Print Excel Report" type="object" style="color : white;background-color : #7c7bad;" />
                    	 <button name='print_report_pdf' string="Print PDF Report" type="object" style="color : white;background-color : #7c7bad;" /> 
                 		<button name="clear" string="Cancel" class="btn-secondary" special="cancel" style="color : white;background-color : #7c7bad;"/>
                    	
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_leave_encash_report" model="ir.actions.act_window">
            <field name="name">Leave Encash Report</field>
            <field name="res_model">leave.encash.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

<!--        <menuitem id="menu_leave_encash_report" name="Leave Encash Report" parent="om_hr_payroll.menu_leave_time_off_head" sequence="22"-->
<!--            action="action_leave_encash_report"  />-->
        <menuitem id="menu_leave_encash_report" name="Leave Encash Report" parent="hr_holidays.menu_hr_holidays_report" sequence="22"
            action="action_leave_encash_report"  />

    </data>
</odoo>