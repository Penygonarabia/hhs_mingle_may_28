<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record model="ir.ui.view" id="view_service_sale_order_form_inherited_for_unit_price">
        <field name="name">service.sale.order.inherited.unit.price.form</field>
        <field name="model">service.sale.order</field>
        <field name="inherit_id" ref="machine_repair_management.service_sale_order_form"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='customer_address']" position="after">
                <field name="is_cost_price" invisible="1" nolabel="1"/>
             </xpath>
           <xpath expr="//notebook/page/field[@name='service_sale_order_line_ids']/tree/field[@name='cost']" position="replace">
               <field name="cost" column_invisible="not parent.is_cost_price"/>
           </xpath>
            <xpath expr="//notebook/page/field[@name='service_sale_order_line_ids']/tree/field[@name='margin']" position="replace">
               <field name="margin" column_invisible="not parent.is_cost_price"/>
           </xpath>
            <xpath expr="//notebook/page/field[@name='service_sale_order_line_ids']/tree/field[@name='margin_percent']" position="replace">
               <field name="margin_percent" column_invisible="not parent.is_cost_price"/>
           </xpath>
        </field>
    </record>
</odoo>