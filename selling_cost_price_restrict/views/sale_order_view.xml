<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record model="ir.ui.view" id="view_sale_order_form_inherited_for_unit_price">
        <field name="name">sale.order.inherited.unit.price.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="is_selling_price" invisible="1" nolabel="1"/>
             </xpath>
            <xpath expr="//notebook/page/field[@name='order_line']/tree/field[@name='price_unit']" position="after">
                <field name="is_selling_price" invisible="1" nolabel="1"/>
            </xpath>

            <xpath expr="//notebook/page/field[@name='order_line']/tree/field[@name='price_unit']" position="attributes">
                <attribute name="readonly">is_selling_price == False</attribute>
            </xpath>

        </field>
    </record>
    <record model="ir.ui.view" id="view_account_move_form_inherited_for_unit_price">
        <field name="name">account.move.inherited.unit.price.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="is_invoice_selling_price" invisible="1" nolabel="1"/>
             </xpath>
             <xpath expr="//notebook/page/field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="after">
                <field name="is_invoice_selling_price" invisible="1" nolabel="1"/>
             </xpath>
              <xpath expr="//notebook/page/field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="attributes">
                  <attribute name="readonly">is_invoice_selling_price == False</attribute>
              </xpath>
            <xpath expr="//notebook/page/field[@name='line_ids']/tree/field[@name='tax_ids']" position="attributes">
                  <attribute name="optional">show</attribute>
             </xpath>
        </field>
    </record>
</odoo>