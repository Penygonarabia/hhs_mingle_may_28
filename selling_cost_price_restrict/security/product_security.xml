<odoo>
    <data noupdate="0">
        <record id="group_product_price_user" model="res.groups">
            <field name="name">Show Cost Price</field>
            <field name="comment">the user will have access to view product cost price.</field>
        </record>
        <record id="group_product_selling_price_user" model="res.groups">
            <field name="name">Restrict Selling Price</field>
            <field name="comment">the user can restrict Selling Price to make it readonly and editable.</field>
        </record>
        <record id="group_product_price_sales_manager" model="res.groups">
            <field name="name">Access Cost Price to Sales Manager</field>
            <field name="comment">The Manager will have access to view product cost price.</field>
        </record>
        <record id="group_product_price_sales_user" model="res.groups">
            <field name="name">Access Cost Price to Sales Team/User</field>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="comment">The Sales user will have access to view product cost price.</field>
        </record>
    </data>
</odoo>
