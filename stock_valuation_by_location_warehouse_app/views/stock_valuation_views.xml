<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

		<record id="stock_valuation_layer_view_tree" model="ir.ui.view">
			<field name="name">stock.valuation.layer.view.tree</field>
			<field name="model">stock.valuation.layer</field>
			<field name="inherit_id" ref="stock_account.stock_valuation_layer_tree"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='product_id']" position="after">
                    <field name="location_id"/>
                    <field name="warehouse_id"/>
            	</xpath>
			</field>
		</record>

		<record id="stock_valuation_layer_view_search_inherit" model="ir.ui.view">
			<field name="name">stock.valuation.layer.view.search</field>
			<field name="model">stock.valuation.layer</field>
			<field name="inherit_id" ref="stock_account.view_inventory_valuation_search"/>
			<field name="arch" type="xml">
				<search>
                	<group expand="0" string="Group By">
                    	<filter string="Location" name="locationgroup"  context="{'group_by': 'location_id'}" />
                    	<filter string="Warehouse" name="warehousegroup"  context="{'group_by': 'warehouse_id'}" />
               		</group>
           		</search>
			</field>
		</record>

	</data>
</odoo>