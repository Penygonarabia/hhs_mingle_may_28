<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_subscription_contract_pivot" model="ir.ui.view">
        <field name="name">visit.count.report.pivot</field>
        <field name="model">visit.count.report</field>
        <field name="arch" type="xml">
            <pivot string="AMC Visit Analysis">

                <!-- ROWS -->
                <field name="region" type="row"/>
                <field name="city" type="row"/>
                <field name="sales_person_user_id" type="row"/>

                <!-- PREVENTIVE -->
                <field name="entitlement_prevent" type="measure"/>
                <field name="actual_prevent_count" type="measure"/>
                <field name="balance_prevent" type="measure"/>

                <!-- CORRECTIVE -->
                <field name="entitlement_correct" type="measure"/>
                <field name="actual_correct_count" type="measure"/>
                <field name="balance_correct" type="measure"/>

            </pivot>
        </field>
    </record>

    <record id="view_subscription_contract_search" model="ir.ui.view">
        <field name="name">visit.count.report.search</field>
        <field name="model">visit.count.report</field>
        <field name="arch" type="xml">
            <search>

                <field name="project_id"/>
                <field name="work_center_group_id"/>
<!--                <field name="city"/>-->
                <field name="partner_id"/>
                <field name="sales_person_user_id"/>

                <group string="Group By">

                    <filter string="Project"
                            name="group_project"
                            context="{'group_by':'project_id'}"/>

                    <filter string="Region"
                            name="group_region"
                            context="{'group_by':'region'}"/>

                    <filter string="City"
                            name="group_city"
                            context="{'group_by':'city'}"/>

                    <filter string="Salesman"
                            name="group_salesman"
                            context="{'group_by':'sales_person_user_id'}"/>

                    <filter string="Customer"
                            name="group_customer"
                            context="{'group_by':'partner_id'}"/>

                </group>

            </search>
        </field>
    </record>

    <record id="view_subscription_contract_tree_analysis" model="ir.ui.view">
        <field name="name">visit.count.report.tree</field>
        <field name="model">visit.count.report</field>
        <field name="arch" type="xml">
            <tree>

                <field name="region"/>
                <field name="city"/>
                <field name="partner_id"/>
                <field name="sales_person_user_id"/>

                <field name="entitlement_prevent"/>
                <field name="actual_prevent_count"/>
                <field name="balance_prevent"/>

                <field name="entitlement_correct"/>
                <field name="actual_correct_count"/>
                <field name="balance_correct"/>

            </tree>
        </field>
    </record>
    <record id="view_subscription_contract_graph" model="ir.ui.view">
        <field name="name">visit.count.report.graph</field>
        <field name="model">visit.count.report</field>
        <field name="arch" type="xml">
            <graph string="AMC Visit Analysis" type="bar">

                <field name="project_id"/>

                <field name="entitlement_prevent" type="measure"/>
                <field name="actual_prevent_count" type="measure"/>
                <field name="balance_prevent" type="measure"/>

                <field name="entitlement_correct" type="measure"/>
                <field name="actual_correct_count" type="measure"/>
                <field name="balance_correct" type="measure"/>

            </graph>
        </field>
    </record>
    <record id="action_subscription_contract_visit_analysis"
            model="ir.actions.act_window">
        <field name="name">Visit Count Analysis</field>
        <field name="res_model">visit.count.report</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="view_subscription_contract_search"/>
    </record>
    <menuitem id="menu_visit_count_report"
          name="Visit Count Report"
          parent="crm.crm_menu_report"
          action="action_subscription_contract_visit_analysis"
          sequence="1000"/>


</odoo>