<?xml version = "1.0" encoding ="utf-8" ?>
<odoo>

    <record id="payment_receipt_search_form_view" model="ir.ui.view">
        <field name="name">payment.receipt.search.view</field>
        <field name="model">payment.receipt</field>
        <field name="arch" type="xml">
            <search>
                <field name="job_card_no_id" string="Job Card#"/>
                <field name="name" string="Reference Number"/>
                <field name="customer_name"/>
            </search>
        </field>
    </record>

    <record id="payment_receipt_tree_views" model="ir.ui.view">
        <field name="name">payment.receipt.tree.view</field>
        <field name="model">payment.receipt</field>
        <field name="arch" type="xml">
            <tree string="Payment Receipt" default_order="name Desc" create="0">
                <field name="name"/>
                <field name="date"/>
                <field name="job_card_no_id"/>
                <field name="customer_name"/>
                <!-- <field name = "partner_id" /> -->
                <field name="amount"/>
                <field name="journal_id"/>
                <field name="mode_of_payment"/>
                <field name="memo"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="payment_receipt_form_views" model="ir.ui.view">
        <field name="name">payment.receipt.form.view</field>
        <field name="model">payment.receipt</field>
        <field name="arch" type="xml">
            <form string="Payment Receipt" duplicate="0" delete="0" create="0">
                <header>
                    <button name="print_payment_receipt" string="Payment Receipt" class="oe_highlight" type="object"
                            invisible="1"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-pencil-square" name="show_journal_entry"
                                string="Journal Entry" type="object" invisible="id == False"
                        />
                        <button class="oe_stat_button" icon="fa-pencil-square" name="show_job_card" string="Job Card"
                                type="object"/>
                        <!--                           <button class="oe_stat_button" icon="fa-pencil-square" name="show_machine_diagnosys_task" string="Diagnosys" type="object"/>-->

                        <!-- <button class="oe_stat_button" icon="fa-pencil-square" name="show_machine_diagnosys_task" string="Machine Diagnosys" type="object"/> -->

                    </div>

                    <group>
                        <group>
                            <field name="name" readonly="1" force_save="1"/>
                            <field name="date" readonly="1" force_save="1"/>
                            <field name="job_card_no_id" readonly="1" force_save="1"
                                   options="{'no_create_edit':True,'no_open':True}"/>
                            <field name="customer_name" readonly="1" force_save="1"/>
                            <field name="amount" readonly="1" force_save="1"/>
                        </group>
                        <group>

                            <field name="journal_id" domain="[('type','=','bank')]" readonly="1" force_save="1"
                                   options="{'no_create_edit':True,'no_open':True}"/>
                            <field name="mode_of_payment" readonly="1" force_save="1"/>
                            <field name="payment_id" readonly="1" force_save="1"
                                   options="{'no_create_edit':True,'no_open':True}" invisible="1"/>
                            <field name="memo" readonly="1" force_save="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="account_move_id" invisible="1"/>
                            <field name="partner_id" readonly="1" force_save="1" invisible="1"
                                   options="{'no_create_edit':True,'no_open':True}"/>
                            <field name="inspection_charges_amount_received_bool" readonly="1" force_save="1"
                                   invisible="1"/>
                            <field name="balance_amount_received_bool" readonly="1" force_save="1" invisible="1"/>
                            <field name="online_transaction_date" invisible="1"/>
                            <field name="online_transaction_status" invisible="1"/>
                            <field name="online_transaction_reference" invisible="1"/>
                        </group>
                    </group>

                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_payment_receipt_form_view" model="ir.actions.act_window">
        <field name="name">Payment Receipt</field>
        <field name="res_model">payment.receipt</field>
        <field name="view_mode">tree,form</field>

    </record>

    <menuitem id="menu_payment_receipt_view" name="Payment Receipt" action="action_payment_receipt_form_view"
              parent="machine_repair_management.menu_machine_repair_support"
              sequence="150"
    />

</odoo>