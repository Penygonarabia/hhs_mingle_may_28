<?xml version = "1.0" encoding = "utf-8" ?>
<odoo>

    <record id="views_res_state_district_tree" model="ir.ui.view">
        <field name="name">res.state.district.tree.view</field>
        <field name="model">res.state.district</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="city_id"/>
                <field name="country_id" column_invisible="1"/>
                <field name="country_state_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="form_res_state_district_view" model="ir.ui.view">
        <field name="name">res.state.district.form.view</field>
        <field name="model">res.state.district</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code" required="1"/>
                        </group>
                        <group>
                            <field name="name" required="1"/>
                        </group>
                        <group>
                            <field name="city_id" required="1"
                                   options="{'no_create':True,'no_open':True,'no_edit':True}"
                            />
                        </group>
                        <group>
                            <field name="country_id" required="0" invisible="1"/>
                        </group>
                        <group>
                            <field name="country_state_id" required="0" invisible="1"/>
                        </group>
                        <!-- <group>
                            <field name ="available_city_ids" invisible="0" widget ="many2many_tags"/>
                        </group>
                        <group>
                            <field name ="current_user_id" invisible ="0"/>
                        </group> -->

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_res_state_district_form" model="ir.actions.act_window">
        <field name="name">District</field>
        <field name="res_model">res.state.district</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_res_district_form"
              action="action_res_state_district_form"
              parent="contacts.menu_localisation"
              sequence="59"/>

</odoo>