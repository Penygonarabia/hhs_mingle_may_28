<?xml version = "1.0" encoding = "utf-8" ?>
<odoo>

	<record id = "views_account_move_inherit_work_center" model = "ir.ui.view">
		
		<field name = "name" >account.move.inherit.work.center</field>
		<field name = "model">account.move</field>
		<field name = "inherit_id" ref= "account.view_move_form"/>
		<field name = "arch" type ="xml">
		
			<xpath expr = "//group[@id='header_right_group']" position = "inside">
			            <field name="subscription_contract_id" invisible="1"/>
            	<field name  = "customer_code" invisible = "1"/>
                 <field name = "warehouse_id" invisible = "1"/>
                 
                 <field name = "work_center_id" invisible = "1"/>
                 <field name = "work_center_group_id" invisible = "1"/>
                 <field name = "sales_person_user_id" invisible = "1"/>
                 <field name = "qr_image" invisible = "1"/>
                 <field name = "invoice_no" invisible = "1"/>
                 <field name = "inv_pvs_xmlhas" invisible = "1"/>
                 <field name = "inv_xmlhas" invisible = "1"/>
                 <field name = "inv_qrcode_has" invisible = "1"/>
            
            </xpath>
            
            <xpath expr = "//group[@id = 'header_left_group']/field[@name = 'partner_shipping_id']" position = "after" >
            	<field name = "invoice_txt"  widget="text"/>
            </xpath>
            
             <xpath expr = "//header/button[@name='action_invoice_sent']" position = "attributes">
            	<attribute name = "invisible">1</attribute>
            </xpath>
            
            <xpath expr = "//header/button[@name='action_register_payment']" position = "attributes">
            	<attribute name = "invisible">1</attribute>
            </xpath>
            
             <xpath expr = "//header/button[@name='action_reverse']" position = "attributes">
            	<attribute name = "invisible">1</attribute>
            </xpath>
            
            <xpath expr="//group[@id='header_left_group']/label[@for='partner_id'][1]" position="before">
	            <label for="partner_name" string="Company Name" invisible = "not subscription_contract_id"/>
	            <field name="partner_name" nolabel="1" readonly = "1"  invisible = "not subscription_contract_id"/>
	            
	            <field name = "customer_name" readonly ="1" invisible = "not subscription_contract_id"/>
	             <label for="street" string="Address" invisible = "not subscription_contract_id"/>
	                <div class="o_address_format" invisible = "not subscription_contract_id">
	                    <field name="street" placeholder="Street..." class="o_address_street" invisible = "not subscription_contract_id" readonly = "1"/>
	                    <field name="street2" placeholder="Street 2..." class="o_address_street" invisible = "not subscription_contract_id" readonly = "1"/>
	                    <field name="customer_city_id" placeholder="City" class="o_address_city" invisible = "not subscription_contract_id" readonly = "1"/>
	                    <field name = "district_id" placeholder="District" class="o_address_city" domain ="[('city_id','=',customer_city_id)]" invisible = "not subscription_contract_id" readonly = "1"/>
	                    <field name="state_id" class="o_address_state" placeholder="State" readonly = "1"
	                           options="{&quot;no_open&quot;: True}" invisible = "not subscription_contract_id"/>
	                    <field name="zip" placeholder="ZIP" class="o_address_zip" invisible = "not subscription_contract_id" readonly = "1"/>
	                    <field name="country_id" placeholder="Country" class="o_address_country" invisible = "not subscription_contract_id" readonly = "1"
	                           options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
	                </div>   
	            
	            
	        </xpath>
	        
	         <xpath expr = "//group[@id = 'header_left_group']/field[@name = 'partner_shipping_id']" position = "attributes" >
            	<attribute name = "invisible">subscription_contract_id != False</attribute>
            </xpath>
            
            <!-- Customer Label -->
			<xpath expr="//label[@for='partner_id']" position="attributes">
			    <attribute name="invisible">
			        move_type not in ('out_invoice', 'out_refund', 'out_receipt') or subscription_contract_id
			    </attribute>
			</xpath>
			
			<!-- Vendor Label -->
			<xpath expr="//label[@for='partner_id']" position="attributes">
			    <attribute name="invisible">
			        move_type not in ('in_invoice', 'in_refund', 'in_receipt') or subscription_contract_id
			    </attribute>
			</xpath>
			
			<!-- Partner Field Container -->
			<xpath expr="//div[field[@name='partner_id']]" position="attributes">
			    <attribute name="invisible">
			        move_type not in ('out_invoice', 'out_refund', 'out_receipt', 'in_invoice', 'in_refund', 'in_receipt') or subscription_contract_id
			    </attribute>
			</xpath>
	        
    
		</field>
	
	</record>
	
	    <record id="account_payment.action_invoice_order_generate_link" model="ir.actions.act_window">
          <field name="binding_model_id" eval="False"/>
     </record>
     
     <record model="ir.actions.server" id="account.action_move_switch_move_type">
     	  <field name="binding_model_id" eval="False"/>
     </record>
     
     	<record id="account.account_invoices" model="ir.actions.report">
     		<field name="binding_model_id" eval="False"/>
     	</record>
     
      <record id="account.account_invoices_without_payment" model="ir.actions.report">
      	<field name="binding_model_id" eval="False"/>
      </record>
      
      <record id="base_accounting_kit.report_multiple_invoice_copies" model="ir.actions.report">
      	<field name="binding_model_id" eval="False"/>
      </record>
      
      <record id="sale_timesheet.timesheet_report_account_move" model="ir.actions.report">
      	<field name="binding_model_id" eval="False"/>
      
      </record>
      
       <record id="account.model_account_move_action_share" model="ir.actions.server">
        	<field name="binding_model_id" eval="False"/>
    	</record>
    	
    	 <record id="sale.model_sale_order_action_share" model="ir.actions.server">
        	<field name="binding_model_id" eval="False"/>
        </record>
        
        
        <record id = "payment_state_hide_account_move" model = "ir.ui.view">
        	<field name = "name">payment.state.hide.account.move.inherit</field>
        	<field name = "model">account.move</field>
        	<field name = "inherit_id" ref="account.view_invoice_tree"/>
        	<field name = "arch" type = "xml">
        		
        		<xpath expr = "//field[@name = 'payment_state']" position = "attributes">
        			<attribute name = "column_invisible">1</attribute>
        		</xpath>
        		
        	</field>
        
        </record>
	
	
	
</odoo>
