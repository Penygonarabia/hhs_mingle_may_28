<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_cost_tree" model="ir.ui.view">
        <field name="name">service.cost.tree</field>
        <field name="model">service.cost</field>
        <field name="arch" type="xml">
            <tree string="Service Cost">
                <field name="name"/>
                <field name="standard_hours"/>
                <field name="cost_service_only"/>
            </tree>
        </field>
    </record>

    <record id="view_service_cost_form" model="ir.ui.view">
        <field name="name">service.cost.form</field>
        <field name="model">service.cost</field>
        <field name="arch" type="xml">
            <form string="Service Cost">
                <group>
                    <field name="name"/>
                    <field name="standard_hours"/>
                    <field name="cost_service_only"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_service_cost_list" model="ir.actions.act_window">
        <field name="name">Service Cost</field>
        <field name="res_model">service.cost</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_service_cost_config"
              name="Service Cost"
              parent="machine_repair_management.menu_machine_repair_configuration"
              sequence = "550"
              action="action_service_cost_list"/>
</odoo>
