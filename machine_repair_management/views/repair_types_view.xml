<?xml version="1.0"?>
<odoo>
    <data>

        <record id="search_repair_type_form" model="ir.ui.view">
            <field name="name">repair.type.search.form</field>
            <field name="model">repair.type</field>
            <field name="arch" type="xml">
                <search string="Repair type">
                    <field name="name"/>
                    <field name="code"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="repair_type_form_view">
            <field name="name">Repair Type form</field>
            <field name="model">repair.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group colspan="2">
                                <field name="service_product_category_id" domain="[('parent_id','=',False)]"
                                       required="1"/>
                            </group>
                            <group colspan="2">
                                <field name="service_id"/>
                            </group>
                            <group colspan="2">
                                <field name="code"/>
                            </group>
                            <group colspan="2">
                                <field name="name"/>
                            </group>
                            <group colspan = "2">
                            	<field name = "mins_required"  widget = "float_time"/>
                            </group>
                            <group colspan = "2">
                            	<field name = "service_required_applicable_bool" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="repair_type_tree_view">
            <field name="name">Repair type tree</field>
            <field name="model">repair.type</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="service_product_category_id"/>
                    <field name="service_id"/>
                    <field name="code"/>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="action_repair_type" model="ir.actions.act_window">
            <field name="name">Services</field>
            <field name="res_model">repair.type</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
