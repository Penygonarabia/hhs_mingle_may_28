<?xml version = "1.0" encoding = "utf-8" ?>
<odoo>

    <record id="view_property_type_maintenance_details_tree" model="ir.ui.view">
        <field name="name">property.type.maintenance.details.tree.view</field>
        <field name="model">property.type.maintenance.details</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="type_of_property"/>
            </tree>
        </field>
    </record>

    <record id="view_property_type_maintenance_details_form" model="ir.ui.view">
        <field name="name">property.type.maintenance.details.form.view</field>
        <field name="model">property.type.maintenance.details</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="type_of_property"/>
                            <field name="complete_name" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_property_type_maintenance_details" model="ir.actions.act_window">
        <field name="name">Property &amp; Maintenance Details</field>
        <field name="res_model">property.type.maintenance.details</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_property_type" name="Property &amp; Maintenance Details" action="action_property_type_maintenance_details" parent="machine_repair_management.menu_machine_repair_configuration" sequence="199" />

</odoo>