                                        <field name="tax_amount" column_invisible="1"/>
                                        <field name="total" column_invisible="not parent.job_task_id"/>
                                        <field name="total_amc" column_invisible="parent.job_task_id" digits="[16,2]"
                                               sum="Total" readonly="1"/>
                                        <field name="amc_quotation" column_invisible="1"/>
                                        <field name="days_require_rpm_round_off" column_invisible="True" readonly="1"
                                               width="210px"/>
                                        <field name="actual_prevent_count" column_invisible="True" readonly="1"
                                               width="210px"/>
                                        <field name="balance_prevent_count" column_invisible="True" readonly="1"
                                               width="210px"/>
                                        <field name="total_correct_count" column_invisible="True" readonly="1"
                                               width="210px"/>
                                        <field name="actual_correct_count" column_invisible="True" readonly="1"
                                               width="210px"/>
                                        <field name="balance_correct_count" column_invisible="True" readonly="1"
                                               width="210px"/>
                                        <field name="amc_quotation_id" column_invisible="1"/>
                                    </tree>
                                </field>
                                <group style="float:right;">
                                    <field name="untaxed_amount" style="text-align:right" readonly="1" force_save="1"/>
                                    <field name="total_discount" style="text-align:right" readonly="1" force_save="1"
                                           invisible="1"/>
                                    <field name="vat_amount" style="text-align:right" readonly="1" force_save="1"/>
                                    <field name="grand_total_amount" string="Grand Total" style="text-align:right"
                                           readonly="1" force_save="1"/>
                                    <field name="inspection_charges_amount" string="Inspection Charges Amount Received"
                                           style="text-align:right" readonly="1" force_save="1"
                                           invisible="amc_quotation"/>
                                    <field name="balance_paid" string="Balance To Be Paid" style="text-align:right"
                                           readonly="1" force_save="1" invisible="amc_quotation"/>
                                    <field name="parts_vat_totamount" invisible="1" readonly="1" force_save="1"/>
                                    <field name="parts_total_amount" invisible="1" readonly="1" force_save="1"/>
                                    <field name="service_vat_amount" invisible="1" readonly="1" force_save="1"/>
                                    <field name="service_charge_amount" invisible="1" readonly="1" force_save="1"/>
                                </group>
                            </page>
                        </notebook>
                    </div>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="service_sale_order_view_search" model="ir.ui.view">
        <field name="name">service.sale.order.view.search</field>
