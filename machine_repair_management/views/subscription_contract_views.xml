<?xml version = "1.0" encoding ="utf-8" ?>
<odoo>

	<record id="subscription_contracts_view_form_inherit_tax_customer" model="ir.ui.view">
        <field name="name">Subscription Contracts</field>
        <field name="model">subscription.contracts</field>
        <field name="inherit_id" ref="sales_contract_and_recurring_invoices.subscription_contracts_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='next_invoice_date']" position="after">
                <field name="customer_identification_scheme" string="Tax Type" force_save="1"/>
                <field name="customer_identification_number"
                    string="VAT No"
                    force_save="1"
                    required="customer_identification_scheme in ('TIN','CRN','IQA','NAT')"/>

                <field name="building_number"
                    force_save="1"
                    required="customer_identification_scheme == 'TIN'"/>

                <field name="plot_identification"
                    force_save="1"
                    required="customer_identification_scheme == 'TIN'"/>
                    
                  <label for="street" string="Address"/>
	                <div class="o_address_format">
	                    <field name="street" placeholder="Street..." class="o_address_street"/>
	                    <field name="street2" placeholder="Street 2..." class="o_address_street"/>
	                    <field name="customer_city_id" placeholder="City" class="o_address_city" options ="{'no_create':True,'no_edit':True,'no_open':True}"/>
	                    <field name = "district_id" placeholder="District" class="o_address_city" domain ="[('city_id','=',customer_city_id)]" options ="{'no_create':True,'no_edit':True,'no_open':True}"/>
	                    <field name="state_id" class="o_address_state" placeholder="State"
	                           options="{&quot;no_open&quot;: True}"/>
	                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>
	                    <field name="country_id" placeholder="Country" class="o_address_country"
	                           options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
	                </div>   
                    
                 <field name = "customer_code"  required = "0"/>
                 <field name = "warehouse_id" required = "0" domain ="[('id','in',warehouse_lst_ids)]"/>
                 <field name = "district" invisible = "1"/>
                 <field name = "work_center_id" invisible = "1" />
                 <field name = "work_center_group_id" invisible = "1" />
                 <field name = "sales_person_user_id" invisible = "1"/>
                 <field name = "invoice_txt" widget = "text"/>
                 <field name = "warehouse_lst_ids" invisible ="1" widget = "many2many_tags"/>
				 <field name = "original_name" invisible = "1"/>
				
            </xpath>
            
             <xpath expr="//group/field[@name='project_id']" position = "after">
            	   <field name = "notification_send_salesman"  />
            	   <field name = "notification_send_manager"  />
            	   <field name = "renewal_confirm_by_customer"  />
            	   <field name = "confirmation_date" />
            	   
            
            </xpath>
            
            <xpath expr = "//header/button[@name ='action_to_cancel']" position = "after">
            	<button name = "send_notification_salesman_for_sixty_day" string ="Send notification to Salesman" type = "object" class = "oe_highlight" invisible = "1"/>
            	<button name = "send_notification_manager" string = "Send notification to Manager" type = "object" class = "oe_highlight" invisible = "1"/>
            </xpath>
            
        </field>
       </record>
        
      <record id="subscription_contracts_view_form_inherit" model="ir.ui.view">
        <field name="name">Subscription Contracts</field>
        <field name="model">subscription.contracts</field>
        <field name="inherit_id" ref="sales_contract_and_recurring_invoices.subscription_contracts_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference']" position="after">
                <field name="amc_quotation_id" domain="[('amc_quotation', '=', True)]" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='amc_quotation_id']" position="after">
                <field name="partner_name"/>
            </xpath>
            <xpath expr="//group/field[@name='manual_next_invoice_date']" position="after">
                <field name="technician_id" domain="[('project_ids', 'in', [project_id])]"/>
                <field name="project_id" invisible="1"/>
            </xpath>
            
            <xpath expr  ="//field[@name = 'service_coordinator_person']" position = "before">
            	
            	<label for="site_street" string="Site Address"/>
                <div class="o_address_format">
                    <field name = "site_street" placeholder="Street..." class="o_address_street" readonly="state not in 'New' "/>
                    <field name = "site_street2" placeholder="Street 2..." class="o_address_street" readonly="state not in 'New' "/>
                    <field name = "site_customer_city_id" placeholder="City" class="o_address_city" readonly="state not in 'New' "/>
                    <field name = "site_district_id" placeholder="District" class="o_address_city" domain ="[('city_id','=',site_customer_city_id)]" readonly="state not in 'New' "/>
                    <field name = "site_state_id" class="o_address_state" placeholder="State"
                           options="{&quot;no_open&quot;: True}" readonly="state not in 'New' "/>
                    <field name = "site_zip" placeholder="ZIP" class="o_address_zip" readonly="state not in 'New' "/>
                    <field name = "site_country_id" placeholder="Country" class="o_address_country"
                           options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}" readonly="state not in 'New' "/>
                </div>
            	
            </xpath>
            
            
        </field>
    </record>
    
    	<record id = "subscription_contract_partner_name_search" model = "ir.ui.view">
    	<field name = "name">subscription.contracts.view.inherit.tree</field>
    	<field name = "model">subscription.contracts</field>
    	<field name = "inherit_id" ref = "sales_contract_and_recurring_invoices.subscription_contracts_view_tree" />
    	<field name = "arch" type = "xml" >
    		<xpath expr = "//field[@name ='partner_id']" position = "after">
    			<field name = "partner_name" optional="hide"/>
    			
    		
    		</xpath>
    	
    	</field>
    </record>
    
    
    <record id = "subscription_contract_partner_search_form_inherit" model = "ir.ui.view">
    	<field name = "name">subscription.contracts.view.inherit.search</field>
    	<field name = "model">subscription.contracts</field>
    	<field name = "inherit_id" ref = "sales_contract_and_recurring_invoices.subscription_contracts_view_search" />
    	<field name = "arch" type = "xml" >
    		<xpath expr = "//field[@name ='partner_id']" position = "after">
    			<field name = "partner_name"/>
    		
    		</xpath>
    	
    	</field>
    </record>
    
        


</odoo>
