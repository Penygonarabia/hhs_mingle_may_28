<?xml version = "1.0" encoding = "utf-8" ?>
<odoo>

	<record id = "view_dashboard_rights_tree" model= "ir.ui.view">
		<field name = "name">dashoard.rights.user.tree.view</field>
		<field name = "model">dashboard.user.rights</field>
		<field name = "arch" type = "xml">
			<tree>
				<field name = "name" />
				<field name="id" string=" " invisible="1"/>
			</tree>
		</field>
	</record>
	
	<record id = "view_dashboard_rights_form" model= "ir.ui.view">
		<field name = "name">dashoard.rights.user.form.view</field>
		<field name = "model">dashboard.user.rights</field>
		<field name = "arch" type = "xml">
			<form>
				<sheet>
					<group>
						
						<field name = "name" />
					
					</group>
					
				</sheet>
				
			</form>
		</field>
	</record>
	
	<record id = "action_dashboard_user_rights" model="ir.actions.act_window">
		
		<field name = "name">Dashboard User Rights</field>
		<field name = "res_model">dashboard.user.rights</field>
		<field name = "view_mode">tree,form</field>
	
	</record>
	
	
	
	<menuitem 
			id = "menu_dashboard_user_rights"
			name = "Dashboard User Rights"
			action = "action_dashboard_user_rights"
			parent = "machine_repair_management.menu_machine_repair_configuration"
			sequence = "159"
		
		/>
	

</odoo>