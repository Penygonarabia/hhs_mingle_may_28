<?xml version = "1.0" encoding ="utf-8" ?>
<odoo>

    <record id="payment_receipt_tree_views" model="ir.ui.view">
        <field name="name">payment.receipt.tree.view</field>
        <field name="model">payment.receipt</field>
        <field name="arch" type="xml">
            <tree string="Payment Receipt" default_order="name Desc" create="0">
                <field name="name"/>
                <field name="date"/>
                <field name="job_card_no_id"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="journal_id"/>
                <field name="payment_id"/>
                <field name="memo"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="payment_receipt_form_views" model="ir.ui.view">
        <field name="name">payment.receipt.form.view</field>
        <field name="model">payment.receipt</field>
        <field name="arch" type="xml">
            <form string="Payment Receipt" duplicate="0" delete="0" create="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1" force_save="1"/>
                            <field name="date" readonly="1" force_save="1"/>
                            <field name="job_card_no_id" readonly="1" force_save="1"
                                   options="{'no_create_edit':True,'no_open':True}"/>
                            <field name="partner_id" readonly="1" force_save="1"
                                   options="{'no_create_edit':True,'no_open':True}"/>
                            <field name="amount" readonly="1" force_save="1"/>
                        </group>
                        <group>
                            <field name="journal_id" domain="[('type','=','bank')]" readonly="1" force_save="1"
                                   options="{'no_create_edit':True,'no_open':True}"/>
                            <field name="payment_id" readonly="1" force_save="1"
                                   options="{'no_create_edit':True,'no_open':True}"/>
                            <field name="memo" readonly="1" force_save="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_payment_receipt_form_view" model="ir.actions.act_window">
        <field name="name">Payment Receipt</field>
        <field name="res_model">payment.receipt</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_payment_receipt_view" name="Payment Receipt" action="action_payment_receipt_form_view"
              parent="machine_repair_management.menu_machine_repair_support"
              sequence="22"
    />

</odoo>