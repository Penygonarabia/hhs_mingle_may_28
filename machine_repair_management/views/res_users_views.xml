<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_inherited_users" model="ir.ui.view">
        <field name="name">default_loaction_dept_form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="sale_stock.res_users_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name = 'property_warehouse_id']" position="before">
                <field name="project_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//field[@name='property_warehouse_id']" position="after">
                <!-- <field name = "warehouse_id" /> -->
                <field name="def_location_id"/>
                <field name="def_department_id"/>
                <field name="default_work_center_id" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherited_users_city" model="ir.ui.view">
        <field name="name">default_workenter_tree</field>
        <field name="model">res.city</field>
        <field name="inherit_id" ref="base_address_extended.view_city_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='zipcode']" position="after">
                <field name="def_work_center_id" groups='machine_repair_management.group_machine_repair_manager_work_center'/>
                <field name="country_district_id" column_invisible="1"/>
            </xpath>
            
            <xpath expr = "//field[@name = 'name']" position = "before">
            	 <field name = "code" />
            	
            </xpath>
            <xpath expr = "//field[@name = 'state_id']" position = "after">
            	<field name = "report_region" />
            </xpath>
            
        </field>
    </record>

    <record id="code_view_res_user_inherit" model="ir.ui.view">
        <field name="name">res.users.inherit.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class ='oe_title']/group/field[@name ='share']" position="after">
                <field name="user_code"/>
            </xpath>
            <!-- <xpath expr="//page[@name='preferences']/group[@name='messaging']" position="before">
                <group string="Discount Limit" colspan="1" col="2">
                    <label for="discount_limit"/>
                    <div class="o_row" style="width: 100px !important;">
                        <field name="discount_limit"/>
                        <span>%</span>
                    </div> -->
            <!--<label for="spare_parts_discount_limit" />
           <div class="o_row" style="width: 100px !important;">
            <field name="spare_parts_discount_limit"/>
            <span>%</span>
           </div>-->
            <!-- </group>
            </xpath> -->
            <xpath expr="//notebook" position="inside">
                <page string = "Allowed Warehouse" id = "allowed_warehouse_uid">
                    <field name = "warehouse_category_user_line_ids">
                        <tree editable = "bottom">
                            <field name = "product_category_line_id" domain ="[('parent_id','=',False)]"/>
                            <field name = "warehouse_line_id" domain="[('id','in',warehouse_lst_ids)]"/>
                            <field name = "warehouse_lst_ids" column_invisible= "1"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
