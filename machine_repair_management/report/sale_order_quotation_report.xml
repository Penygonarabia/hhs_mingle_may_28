<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="paperformat_saleorder_hhs" model="report.paperformat">
            <field name="name">Sale Order HHS Format</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">40</field>
            <field name="margin_bottom">32</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">35</field>
            <field name="dpi">125</field>
        </record>

        <!-- Internal Layout Template -->
        <template id="sale_order_document_template_internal_layout">
            <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-raw="0"/>
            </div>
        </template>

        <!-- Custom Report Template -->
        <template id="report_saleorder_document_hhs">
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"/>
            </t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"/>
            </t>
            <div class="header" t-att-style="report_header_style">
                <div class="row mt32 mb32">
                    <div class="col-4 text-left">
                        <img src="/machine_repair_management/static/src/img/HHS_Header_Left.png" alt="img"
                             style="height: 120px; width: 350px; image-rendering: crisp-edges;"/>
                    </div>
                    <div class="col-4 text-center" style="vertical-align:text-top">
                        <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)"
                             style="max-height: 100px; min-height:100px; min-width: 200px; max-width: 200px; image-rendering: crisp-edges;"/>
                    </div>
                    <div class="col-4 text-right" style="vertical-align:text-top; text-align:right">
                        <img src="/machine_repair_management/static/src/img/HHS_Header_Right.png" alt="img"
                             style="height: 120px; width: 350px; image-rendering: crisp-edges;"/>
                    </div>
                </div>
                <h2>
                    <center>
                        <t t-if="env.context.get('proforma', False) or is_pro_forma">Pro-Forma Invoice</t>
                        <t t-elif="doc.state in ['draft','sent']">Sales Quotation</t>
                        <t t-else="">Service Quotation</t>
                    </center>
                </h2>
            </div>

            <t t-set="doc" t-value="doc.with_context({'lang': doc.partner_id.lang or 'en_US'})"/>
            <div class="page" style="page-break-after: always;">
                <div class="row mt32 mb32">
                    <div class="col-6">
                        <table class="table table-bordered border-dark">
                            <colgroup>
                                <col width='30%'/>
                                <col width='40%'/>
                                <col width='30%'/>
                            </colgroup>
                            <tbody>
                                <tr>
                                    <td><strong>Warehouse:</strong></td>
                                    <td><span t-field="doc.warehouse_id.name"/></td>
                                    <td style="text-align:right"><strong>:مستودع</strong></td>
                                </tr>
                                <tr>
                                    <td><strong>Customer Name:</strong></td>
                                    <td><span t-field="doc.customer_name"/></td>
                                    <td style="text-align:right"><strong>:اسم العميل</strong></td>
                                </tr>
                                <tr>
                                    <td><strong>Customer Address:</strong></td>
                                   <!--  <td>
                                        <div t-field="doc.partner_id"
                                             t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                                    </td> -->
                                    <td>
                                    	<span t-field="doc.address"/>
                                    </td>
                                    <td style="text-align:right"><strong>:عنوان العميل</strong></td>
                                </tr>
                                <tr>
                                    <td><strong>VAT #:</strong></td>
                                    <td><span t-field="doc.partner_id.vat"/></td>
                                    <td style="text-align:right"><strong>:ضريبة القيمة المضافة</strong></td>
                                </tr>
                                <tr>
                                    <td><strong>Client Reference:</strong></td>
                                    <td><span t-field="doc.client_order_ref"/></td>
                                    <td style="text-align:right"><strong>:رقم المرجع</strong></td>
                                </tr>
<!--                                <tr>-->
<!--                                    <td><strong>Order No.:</strong></td>-->
<!--                                    <td><span t-field="doc.name"/></td>-->
<!--                                    <td style="text-align:right"><strong>:رقم الطلب</strong></td>-->
<!--                                </tr>-->
                                <tr>
                                    <td><strong>Remarks:</strong></td>
                                    <td colspan="5"></td>
<!--                                    <td style="text-align:right"><strong>:ملاحظات</strong></td>-->
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-6">
                        <table class="table table-bordered border-dark">
                            <colgroup>
                                <col width='30%'/>
                                <col width='28%'/>
                                <col width='42%'/>
                            </colgroup>
                            <tbody>
                                <tr>
                                    <td><strong>Quotation No:</strong></td>
                                    <td><span t-field="doc.name"/></td>
                                    <td style="text-align:right"><strong>:رقم عرض السعر</strong></td>
                                </tr>
                                <tr>
                                    <td><strong>Quotation Date :</strong></td>
                                    <td>
                                        <span t-field="doc.date_order"
                                              t-options='{"widget": "date", "format": "dd-MM-yyyy"}'/>
                                    </td>
                                    <td style="text-align:right"><strong>:تاريخ عرض السعر</strong></td>
                                </tr>
                                <tr>
                                    <td><strong>Quotation Expiry Date:</strong></td>
                                    <td>
                                        <span t-field="doc.validity_date"
                                              t-options='{"widget": "date", "format": "dd-MM-yyyy"}'/>
                                    </td>
                                    <td style="text-align:right"><strong>:تاريخ انتهاء صلاحية عرض السعر</strong></td>
                                </tr>
                                <tr>
                                    <td><strong>Sales Man:</strong></td>
                                    <td><span t-field="doc.user_id.name"/></td>
                                    <td style="text-align:right">
                                   		<strong>: اسم الفني</strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>VAT Registration:</strong></td>
                                    <td><span t-field="doc.company_id.vat"/></td>
                                    <td style="text-align:right"><strong>:ضريبة القيمة المضافة</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
                <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>
                <table class="table table-bordered border-dark">
                    <thead>
                        <tr style="text-align:center; color:black;">
                            <th width="2%" style="vertical-align:text-top"><strong>قم</strong><br/><strong>No</strong></th>
                            <th width="29%" style="vertical-align:text-top"><strong>الوصف</strong><br/><strong>Description</strong></th>
                            <th width="5%" style="vertical-align:text-top"><strong>الكمية</strong><br/><strong>Qty</strong></th>
                            <th width="6%" style="vertical-align:text-top"><strong>سعر الوحدة</strong><br/><strong>Unit Price</strong></th>
                            <th width="6%" style="vertical-align:text-top"><strong>خصم الوحدة</strong><br/><strong>Unit Discount</strong></th>
                            <th width="7%" style="vertical-align:text-top"><strong>سعر الوحدة الصافي</strong><br/><strong>Net Unit Price</strong></th>
                            <th width="7%" style="vertical-align:text-top"><strong>السعر الإجمالي</strong><br/><strong>Extended Price</strong></th>
                            <th width="6%" style="vertical-align:text-top"><strong>نسبة الضريبة</strong><br/><strong>Vat %</strong></th>
                            <th width="7%" style="vertical-align:text-top"><strong>قيمة الضريبة</strong><br/><strong>Vat Amount</strong></th>
                            <th width="7%" style="vertical-align:text-top"><strong>الإجمالي</strong><br/><strong>Amount</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="counter" t-value="1"/>
                        <t t-foreach="lines_to_report" t-as="line">
                            <t t-if="not line.display_type">
                                <tr>
                                    <td style="text-align:right"><span t-esc="counter"/></td>
                                    <td><span t-field="line.product_id.display_name"/></td>
                                    <td style="text-align:right">
                                        <span t-field="line.product_uom_qty"/>
                                        <span t-field="line.product_uom"/>
                                    </td>
                                    <td style="text-align:right">
                                        <span t-field="line.price_unit"
                                              t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                    <td style="text-align:right">
                                        <span t-field="line.discount"
                                              t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                    <td style="text-align:right">
                                        <span t-esc="line.price_unit * (1 - line.discount / 100)"
                                              t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                    <td style="text-align:right">
                                        <span t-esc="line.product_uom_qty * line.price_unit * (1 - line.discount / 100)"
                                              t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                    <td style="text-align:right">
                                        <span t-esc="', '.join([str(tax.name) for tax in line.tax_id])"/>
                                    </td>
                                    <td style="text-align:right">
                                        <span t-esc="line.price_tax"
                                              t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                    <td style="text-align:right">
                                        <span t-esc="line.price_subtotal + line.price_tax"
                                              t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                </tr>
                                <t t-set="counter" t-value="counter + 1"/>
                            </t>
                            <t t-elif="line.display_type == 'line_section'">
                                <tr class="bg-200 fw-bold o_line_section">
                                    <td colspan="10"><span t-field="line.name"/></td>
                                </tr>
                            </t>
                            <t t-elif="line.display_type == 'line_note'">
                                <tr class="fst-italic o_line_note">
                                    <td colspan="10"><span t-field="line.name"/></td>
                                </tr>
                            </t>
                        </t>
                        <t t-set="tax_totals" t-value="doc.tax_totals"/>
                        <tr>
                            <td colspan="6" style="text-align:right"><strong>Total</strong></td>
                            <td style="text-align:right">
                                <strong>
                                    <span t-esc="sum(line.product_uom_qty * line.price_unit * (1 - line.discount / 100) for line in lines_to_report if not line.display_type)"
                                          t-options="{'widget': 'float', 'precision': 2}"/>
                                </strong>
                            </td>
                            <td style="text-align:right">
<!--                                <strong>-->
<!--                                    <span t-esc="tax_totals['amount_tax']"-->
<!--                                          t-options="{'widget': 'float', 'precision': 2}"/>-->
<!--                                </strong>-->
                            </td>
                             <td style="text-align:right">
                                <strong>
                                    <span t-esc="doc.amount_tax"
                                          t-options="{'widget': 'float', 'precision': 2}"/>
                                </strong>
                            </td>
                            <td style="text-align:right">
                                <strong>
                                    <span t-esc="tax_totals['amount_total']"
                                          t-options="{'widget': 'float', 'precision': 2}"/>
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="10" style="text-align:right">
                                <strong>
                                    <span t-esc="doc.currency_id.amount_to_text(tax_totals['amount_total'])"/>
                                    Only
                                </strong>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="row mt32 mb32">
                    <div class="col-4 text-left">
                        <p style="font-size:18px;">المستلم</p>
                        <p style="font-size:18px;">Receiver</p>
                    </div>
                    <div class="col-4">
                        <p style="font-size:18px;">المحاسب / أمين الصندوق</p>
                        <p style="font-size:18px;">Accountant/Cashier</p>
                    </div>
                    <div class="col-4 text-right">
                        <p style="font-size:18px;">البـــائــع</p>
                        <p style="font-size:18px;">Salesman</p>
                    </div>
                </div>

                <t t-if="doc.signature">
                    <div class="mt-4 ml64 mr4" name="signature">
                        <div class="offset-8">
                            <strong>Signature</strong>
                        </div>
                        <div class="offset-8">
                            <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm; image-rendering: crisp-edges;"/>
                        </div>
                        <div class="offset-8 text-center">
                            <span t-field="doc.signed_by"/>
                        </div>
                    </div>
                </t>

                <t t-if="not is_html_empty(doc.payment_term_id.note) or not is_html_empty(doc.fiscal_position_id.sudo().note)">
                    <div class="mt32">
                        <p t-if="not is_html_empty(doc.payment_term_id.note)">
                            <strong>Payment Terms:</strong>
                            <span t-field="doc.payment_term_id.note"/>
                        </p>
                        <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)">
                            <strong>Fiscal Position Remark:</strong>
                            <span t-field="doc.fiscal_position_id.sudo().note"/>
                        </p>
                    </div>
                </t>
            </div>
            <div class="footer">
                <div>
                    <img src="/machine_repair_management/static/src/img/Arabic_Text.png" alt="img"
                         style="height:60px; width:100%; image-rendering: crisp-edges;"/>
                </div>
                <br/>
                <div>
                    <img src="/machine_repair_management/static/src/img/Footer_Address.png" alt="img"
                         style="height:80px; width:100%; image-rendering: crisp-edges;"/>
                </div>
            </div>
        </template>

        <!-- Inherit and Replace Default Report Template -->
        <template id="custom_report_saleorder_hhs" inherit_id="sale.report_saleorder_document">
            <xpath expr="//t[1]" position="replace">
                <t t-call="web.html_container">
                    <t t-foreach="docs" t-as="doc">
                        <t t-call="machine_repair_management.sale_order_document_template_internal_layout">
                            <t t-call="machine_repair_management.report_saleorder_document_hhs"
                               t-lang="doc.partner_id.lang"/>
                        </t>
                    </t>
                </t>
            </xpath>
        </template>

        <!-- Override Default Report Action -->
        <record id="sale_pdf_quote_builder.action_report_saleorder_raw" model="ir.actions.report">
            <field name="name">Quotation / Order</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">machine_repair_management.custom_report_saleorder_hhs</field>
            <field name="report_file">machine_repair_management.custom_report_saleorder_hhs</field>
            <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.name)) or 'Order - %s' % (object.name)</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="machine_repair_management.paperformat_saleorder_hhs"/>
        </record>

        
        
    </data>
</odoo>