<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- INTERNAL LAYOUT: ONE RECORD WRAPPER ONLY -->
    <template id="preventive_job_card_template_internal_layout_firstpage">
        <t t-set="o" t-value="o or doc"/>
        <div class="article"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">

            <!-- Vertical line in the background -->
            <div style="position: fixed; left: 50%; top: 0; bottom: 0;
                        border-left: 1px solid #002060; height: 100%; z-index: -1;"></div>

            <t t-raw="0"/>
        </div>
    </template>

    <!-- MAIN TEMPLATE -->
    <template id="preventive_job_card_template">
        <!-- Standard Odoo pattern: iterate over docs -->
        <t t-foreach="docs" t-as="doc">
            <t t-call="machine_repair_management.preventive_job_card_template_internal_layout_firstpage">

                <!-- Make 'doc' available inside -->
                <t t-set="o" t-value="doc"/>

                <!-- Custom CSS Styling optimized for PDF rendering in wkhtmltopdf -->
                <style>
                    @page {
                        margin: 0;
                    }
                    html, body {
                        margin: 0;
                        padding: 0;
                    }
                    .report-container {
                        font-family: 'Arial', sans-serif;
                        color: #1F2937;
                        font-size: 11px;
                        line-height: 1.4;
                        padding: 5px;
                    }
                    .report-header {
                        width: 100%;
                        border-bottom: 2px solid #1E3A8A;
                        padding-bottom: 8px;
                        margin-bottom: 15px;
                    }
                    .report-header-table {
                        width: 100%;
                        border-collapse: collapse;
                    }
                    .report-header-table td {
                        vertical-align: middle;
                    }
                    .report-title-box {
                        text-align: center;
                    }
                    .report-title-en {
                        font-size: 18px;
                        font-weight: bold;
                        color: #1E3A8A;
                        margin: 0;
                    }
                    .report-title-ar {
                        font-size: 16px;
                        font-weight: bold;
                        color: #1E3A8A;
                        margin: 2px 0 0 0;
                    }
                    .info-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-bottom: 12px;
                        margin-top: 0;
                    }
                    .info-table td {
                        padding: 5px 8px;
                        vertical-align: middle;
                        border: 1px solid #E5E7EB;
                    }
                    .label-cell {
                        font-weight: bold;
                        color: #374151;
                        background-color: #F9FAFB;
                        width: 18%;
                    }
                    .value-cell {
                        color: #111827;
                        width: 32%;
                    }
                    .section-header {
                        background-color: #203864;
                        padding: 6px 10px;
                        margin-bottom: 8px;
                        border-radius: 3px;
                        color: white;
                        font-size: 13px;
                        font-weight: bold;
                    }
                    .section-header-table {
                        width: 100%;
                    }
                    .section-header-en {
                        float: left;
                        color: white;
                    }
                    .section-header-ar {
                        float: right;
                        color: white;
                    }
                    .data-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-bottom: 12px;
                    }
                    .data-table th {
                        background-color: #F3F4F6;
                        color: #374151;
                        font-weight: bold;
                        padding: 6px 8px;
                        border: 1px solid #D1D5DB;
                        font-size: 10px;
                    }
                    .data-table td {
                        padding: 6px 8px;
                        border: 1px solid #E5E7EB;
                        vertical-align: middle;
                    }
                    .photo-grid-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 10px;
                    }
                    .photo-grid-table td {
                        width: 50%;
                        padding: 8px;
                        vertical-align: top;
                    }
                    .photo-box {
                        border: 1px solid #E5E7EB;
                        padding: 8px;
                        background-color: #F9FAFB;
                        text-align: center;
                        border-radius: 4px;
                    }
                    .photo-img {
                        max-height: 160px;
                        max-width: 100%;
                        object-fit: contain;
                        border-radius: 3px;
                        margin-bottom: 6px;
                    }
                    .photo-caption {
                        font-weight: bold;
                        color: #374151;
                        font-size: 10px;
                        margin-top: 5px;
                    }
                    .photo-desc {
                        color: #6B7280;
                        font-size: 9px;
                        margin-top: 2px;
                    }
                    .text-center {
                        text-align: center;
                    }
                    .text-right {
                        text-align: right;
                    }
                    .text-left {
                        text-align: left;
                    }
                    .clearfix::after {
                        content: "";
                        clear: both;
                        display: table;
                    }
                    .header {
                        position: fixed;
                        top:10px !important;
                        margin-bottom:50px;
                        left: 0px;
                        right: 0px;
                        height: 170px;
                        overflow: hidden;
                    }
                    .footer {
                        position: fixed;
                        bottom: -145px;
                        left: 0px;
                        right: 0px;
                        height: 140px;
                        overflow: hidden;
                    }
                    .report-container {
                        margin-top: 0 !important;
                        margin-bottom: 0 !important;
                        padding: 0 !important;
                    }
                </style>

                <div class="report-container">

                    <!-- HEADER -->
                    <div class="header"
                             style="border-bottom:1px solid #002060;font-size:17pt;padding:5px 0; width:100%;">
                        
                         <div class="row" style="font-size:17pt !important;">
                            <div class="col-5 text-left"
                                 style="font-size:17pt !important; line-height: 1.3 !important;">
                                <strong>
                                    <span style="color:#002060; font-size:17pt !important;">
                                        Hussein and Al Hassan G. Shaker Bros.
                                    </span>
                                </strong>
                                <br/>
                                <strong>
                                    <span style="color:#002060; font-size:17pt !important;">
                                        For Modern Trading Co. Ltd.
                                    </span>
                                </strong>
                            </div>
                            <div class="col-2 text-center" style="margin:0; padding:0;">
                                <img src="/machine_repair_management/static/src/img/HHS_Header_Middle.png"
                                     style="max-height:100px; max-width:175px; margin:0; padding:0;"/>
                            </div>
                            <div class="col-5 text-right" dir="rtl"
                                 style="font-size:17pt !important; line-height: 1.3 !important;">
                                <strong>
                                    <span style="color:#002060; font-size:17pt !important;">
                                        شركة الأخوان حسين و الحسن غازي شاكر
                                    </span>
                                </strong>
                                <br/>
                                <strong>
                                    <span style="color:#002060; font-size:17pt !important;">
                                        للتجارة الحديثة المحدودة
                                    </span>
                                </strong>
                            </div>
                        </div> 
                    </div>

                    <!-- BLUE HEADER BAR -->
                    <div style="background-color: #0070C0; color: white; text-align: center;
                                font-weight: bold; font-size: 16px; padding: 5px;
                                margin-bottom: 10px; width: 100%;">
                        Preventive Job Card
                    </div>

                    <!-- MAIN CUSTOMER & JOB DETAILS -->
                    <table class="info-table"
                           style="width:100%; border-collapse:collapse; border: 1px solid black;
                                  table-layout: fixed; word-wrap: break-word;">
                        <tbody>
                        <!-- Row 1 -->
                        <tr>
                            <td class="label-cell"
                                style="width:15%; border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                CIC Ref No:
                            </td>
                            <td class="value-cell"
                                style="width:25%; border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                <span t-out="doc.name or ''"/>
                            </td>
                            <td class="label-cell"
                                style="width:10%; text-align:right; border: 1px solid black;
                                       background-color: white; font-size: 11px; padding: 4px;"
                                dir="rtl">
                                رقم المرجع:
                            </td>
                            <td class="label-cell"
                                style="width:15%; border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                Date:
                            </td>
                            <td class="value-cell"
                                style="width:25%; border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                <span t-out="(doc.call_date and doc.call_date.strftime('%d-%m-%Y')) or (doc.create_date and doc.create_date.strftime('%d-%m-%Y')) or ''"/>
                            </td>
                            <td class="label-cell"
                                style="width:10%; text-align:right; border: 1px solid black;
                                       background-color: white; font-size: 11px; padding: 4px;"
                                dir="rtl">
                                التاريخ:
                            </td>
                        </tr>
                        <!-- Row 2 -->
                        <tr>
                            <td class="label-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                Customer Name:
                            </td>
                            <td class="value-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                <span t-out="doc.partner_id.name or ''"/>
                            </td>
                            <td class="label-cell"
                                style="text-align:right; border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;"
                                dir="rtl">
                                اسم العميل:
                            </td>
                            <td class="label-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                Promised Date/Time:
                            </td>
                            <td class="value-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                <span t-out="(doc.service_requested_datetime and doc.service_requested_datetime.strftime('%d-%m-%Y %H:%M:%S')) or (doc.planned_date_begin and doc.planned_date_begin.strftime('%d-%m-%Y %H:%M:%S')) or ''"/>
                            </td>
                            <td class="label-cell"
                                style="text-align:right; border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;"
                                dir="rtl">
                                تاريخ و وقت إتمام العمل:
                            </td>
                        </tr>
                        <!-- Row 3 -->
                        <tr>
                            <td class="label-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                Customer Address:
                            </td>
                            <td class="value-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                <span t-out="doc.partner_id.contact_address or doc.partner_id.street or ''"/>
                            </td>
                            <td class="label-cell"
                                style="text-align:right; border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;"
                                dir="rtl">
                                عنوان العميل:
                            </td>
                            <td class="label-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                Technician:
                            </td>
                            <td class="value-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                <span t-out="doc.technician_id.name or (doc.user_ids and doc.user_ids[0].name) or ''"/>
                            </td>
                            <td class="label-cell"
                                style="text-align:right; border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;"
                                dir="rtl">
                                اسم الفني:
                            </td>
                        </tr>
                        <!-- Row 4 -->
                        <tr>
                            <td class="label-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                Customer Mob No:
                            </td>
                            <td class="value-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                <span t-out="doc.phone or doc.partner_id.phone or doc.partner_id.mobile or ''"/>
                            </td>
                            <td class="label-cell"
                                style="text-align:right; border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;"
                                dir="rtl">
                                رقم هاتف العميل:
                            </td>
                            <td class="label-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                Branch:
                            </td>
                            <td class="value-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                <span t-out="doc.region_id.name or (doc.technician_id.employee_id.branch_id.name) or ''"/>
                            </td>
                            <td class="label-cell"
                                style="text-align:right; border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;"
                                dir="rtl">
                                الفرع:
                            </td>
                        </tr>
                        <!-- Row 5 -->
                        <tr>
                            <td class="label-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                Customer VAT No:
                            </td>
                            <td class="value-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                <span t-out="doc.partner_id.vat or ''"/>
                            </td>
                            <td class="label-cell"
                                style="text-align:right; border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;"
                                dir="rtl">
                                رقم بطاقة العمل:
                            </td>
                            <td class="label-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                Dealer:
                            </td>
                            <td class="value-cell"
                                style="border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;">
                                <span t-out="doc.dealer_id.name or ''"/>
                            </td>
                            <td class="label-cell"
                                style="text-align:right; border: 1px solid black; background-color: white;
                                       font-size: 11px; padding: 4px;"
                                dir="rtl">
                                المورد:
                            </td>
                        </tr>
                        </tbody>
                    </table>

                    <!-- MACHINE DETAILS -->
                    <div class="section-header clearfix">
                        <span class="section-header-en">MACHINE DETAILS</span>
                        <span class="section-header-ar">تفاصيل الجهاز</span>
                    </div>
                    <table class="info-table" style="width:100%; border-collapse:collapse;">
                        <tr>
                            <td class="label-cell" style="width:22%; font-weight:bold;">Contract No:</td>
                            <td class="value-cell" style="width:56%;"><span t-out="doc.contract_id.name or ''"/></td>
                            <td class="label-cell" style="width:22%; text-align:right; font-weight:bold;" dir="rtl">
                                رقم العقد:
                            </td>
                        </tr>
                        <tr>
                            <td class="label-cell" style="font-weight:bold;">Asset Tag No:</td>
                            <td class="value-cell"><span t-out="doc.asset_id.name or ''"/></td>
                            <td class="label-cell" style="text-align:right; font-weight:bold;" dir="rtl">
                                رقم أصل الجهاز:
                            </td>
                        </tr>
                        <tr>
                            <td class="label-cell" style="font-weight:bold;">Service Unit Type:</td>
                            <td class="value-cell"><span t-out="doc.service_products_code_id.name or ''"/></td>
                            <td class="label-cell" style="text-align:right; font-weight:bold;" dir="rtl">
                                نوع وحدة الخدمة:
                            </td>
                        </tr>
                        <tr>
                            <td class="label-cell" style="font-weight:bold;">Job Type:</td>
                            <td class="value-cell">
                                <t t-if="doc.maintenance_type == 'preventive'">
                                    <span>Preventive Maintenance / صيانة وقائية</span>
                                </t>
                                <t t-elif="doc.maintenance_type == 'corrective'">
                                    <span>Corrective Maintenance / صيانة تصحيحية</span>
                                </t>
                                <t t-else="">
                                    <span t-out="doc.maintenance_type or ''"/>
                                </t>
                            </td>
                            <td class="label-cell" style="text-align:right; font-weight:bold;" dir="rtl">
                                نوع الوظيفة:
                            </td>
                        </tr>
                    </table>

                    <!-- PRODUCT DETAILS -->
                    <table class="data-table">
                        <thead>
                        <tr>
                            <th>
                                <div>Brand</div>
                                <div style="font-size: 9px; color: #6B7280; font-weight: normal;">الماركة</div>
                            </th>
                            <th>
                                <div>Model</div>
                                <div style="font-size: 9px; color: #6B7280; font-weight: normal;">الموديل</div>
                            </th>
                            <th>
                                <div>Serial No</div>
                                <div style="font-size: 9px; color: #6B7280; font-weight: normal;">الرقم التسلسلي</div>
                            </th>
                            <th>
                                <div>Invoice No</div>
                                <div style="font-size: 9px; color: #6B7280; font-weight: normal;">رقم الفاتورة</div>
                            </th>
                            <th>
                                <div>Date</div>
                                <div style="font-size: 9px; color: #6B7280; font-weight: normal;">التاريخ</div>
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr>
                            <td><span t-out="doc.brand or ''"/></td>
                            <td><span t-out="doc.model or ''"/></td>
                            <td><span t-out="doc.product_slno or ''"/></td>
                            <td><span t-out="doc.purchase_invoice_no or ''"/></td>
                            <td><span t-out="doc.purchase_date or ''"/></td>
                        </tr>
                        </tbody>
                    </table>

                    <!-- CHECKLISTS -->
                    <t t-set="all_checklist_lines" t-value="doc.checklist_line_ids.filtered(
                                lambda l:
                                    l.check_item
                                    and l.check_item.strip()
                                    and (
                                        l.answer_selection_id
                                        or l.answer_numeric
                                        or l.answer_text
                                    )
                        )"/>
                    <t t-if="all_checklist_lines">
                        <div class="section-header clearfix">
                            <span class="section-header-en">POST SERVICE CHECKLIST</span>
                            <span class="section-header-ar">قائمة فحص ما بعد الخدمة</span>
                        </div>
                        <table class="data-table">
                            <thead>
                            <tr>
                                <th style="width: 6%;" class="text-center">
                                    <div>SL No</div>
                                    <div style="font-size: 8px; color: #6B7280; font-weight: normal;">الرقم</div>
                                </th>
                                <th style="width: 15%;">
                                    <div>Section</div>
                                    <div style="font-size: 8px; color: #6B7280; font-weight: normal;">القسم</div>
                                </th>
                                <th style="width: 39%;">
                                    <div>Checklist Description</div>
                                    <div style="font-size: 8px; color: #6B7280; font-weight: normal;">
                                        وصف بند الفحص
                                    </div>
                                </th>
                                <th style="width: 20%;" class="text-center">
                                    <div>Reading / Value</div>
                                    <div style="font-size: 8px; color: #6B7280; font-weight: normal;">
                                        القراءة / القيمة
                                    </div>
                                </th>
                                <th style="width: 20%;">
                                    <div>Remarks</div>
                                    <div style="font-size: 8px; color: #6B7280; font-weight: normal;">
                                        الملاحظات
                                    </div>
                                </th>
                            </tr>
                            </thead>
                            <tbody>
                            <t t-set="sl_idx_all" t-value="1"/>
                            <t t-foreach="all_checklist_lines.filtered(lambda l: l.check_item and l.check_item.strip()
                                and (
                                l.answer_selection_id
                                or l.answer_numeric
                                or l.answer_text
                            )
                            )"
                               t-as="line">
                                <tr>
                                    <td class="text-center">
                                        <t t-esc="sl_idx_all"/>
                                        <t t-set="sl_idx_all" t-value="sl_idx_all + 1"/>
                                    </td>
                                    <td><span t-out="line.section_group or ''"/></td>
                                    <td><span t-out="line.check_item or ''"/></td>
                                    <td class="text-center">
                                        <t t-if="line.field_type in ('yes_no', 'condition', 'multiple')">
                                            <span t-out="line.answer_selection_id.name or ''"/>
                                        </t>
                                        <t t-elif="line.field_type in ('numeric', 'calculated')">
                                            <t t-if="line.answer_numeric">
                                                <span t-out="line.answer_numeric"/>
                                            </t>
                                            <t t-else="">
                                                <span style="color: red;" t-out="line.remark or ''"/>
                                            </t>
                                        </t>
                                        <t t-elif="line.field_type == 'text'">
                                            <t t-if="line.answer_text">
                                                <span t-out="line.answer_text"/>
                                            </t>
                                            <t t-else="">
                                                <span style="color: red;" t-out="line.remark or ''"/>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <span t-out="line.answer_selection_id.name or line.answer_text or line.answer_numeric or ''"/>
                                        </t>
                                    </td>
                                    <td>
                                        <t t-if="line.field_type in ('numeric', 'calculated', 'text')
                                                 and not line.answer_numeric and not line.answer_text">
                                            <!-- Remark shown in Value column -->
                                        </t>
                                        <t t-else="">
                                            <span t-out="line.remark or ''"/>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- BEFORE / AFTER / OTHER PHOTOS -->
                    <t t-set="before_photos"
                       t-value="doc.checklist_photo_ids.filtered(lambda p: (p.section or '').lower() == 'before' and p.photo)"/>
                    <t t-set="after_photos"
                       t-value="doc.checklist_photo_ids.filtered(lambda p: (p.section or '').lower() == 'after' and p.photo)"/>
                    <t t-set="other_photos"
                       t-value="doc.checklist_photo_ids.filtered(lambda p: (p.section or '').lower() not in ('before', 'after') and p.photo)"/>

                    <!-- Before Photos -->
                    <t t-if="before_photos">
                        <div class="section-header clearfix" style="page-break-before: always;">
                            <span class="section-header-en">BEFORE MAINTENANCE PHOTOS</span>
                            <span class="section-header-ar">صور العمل قبل الصيانة</span>
                        </div>
                        <table class="photo-grid-table"
                               style="width: 100%; border-collapse: collapse; border: 1px solid black;">
                            <t t-foreach="before_photos" t-as="photo">
                                <tr>
                                    <td style="width: 50%; border: 1px solid black; padding: 10px;
                                               vertical-align: middle; text-align: center;">
                                        <div style="font-weight: bold; font-size: 13px;">
                                            <span t-out="photo.caption or 'Before Photo'"/>
                                        </div>
                                        <div style="color: #6B7280; font-size: 12px; margin-top: 4px;"
                                             t-if="photo.template_photo_id">
                                            <span t-out="photo.template_photo_id.caption or ''"/>
                                        </div>
                                    </td>
                                    <td style="width: 50%; border: 1px solid black; padding: 10px;
                                               text-align: center; vertical-align: middle;">
                                        <t t-if="photo.photo">
                                            <img t-att-src="image_data_uri(photo.photo)"
                                                 style="max-height: 200px; max-width: 100%;"
                                                 alt="Before Maintenance Photo"/>
                                        </t>
                                        <t t-else="">
                                            <div style="height: 100px; color: #D1D5DB; display: flex;
                                                        align-items: center; justify-content: center;">
                                                <span>No Photo</span>
                                            </div>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </table>
                    </t>

                    <!-- After Photos -->
                    <t t-if="after_photos">
