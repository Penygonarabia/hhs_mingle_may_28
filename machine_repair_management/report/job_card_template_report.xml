                        <table class="table table-bordered border-dark">
                            <thead>
                                <tr style="text-align:center">
                                    <th width="2%" style="vertical-align:text-top">
                                        <strong>قم</strong>
                                        <br/>
                                        <strong>No</strong>
                                    </th>
                                    <th width="8%" style="vertical-align:text-top">
                                        <strong>الفئة</strong>
                                        <br/>
                                        <strong>Stock Group</strong>
                                    </th>
                                    <th width="10%" style="vertical-align:text-top">
                                        <strong>رقم الصنف</strong>
                                        <br/>
                                        <strong>Stock Number</strong>
                                    </th>
                                    <th width="29%" style="vertical-align:text-top">
                                        <strong>الوصف</strong>
                                        <br/>
                                        <strong>Description</strong>
                                    </th>
                                    <th width="5%" style="vertical-align:text-top">
                                        <strong>الكمية</strong>
                                        <br/>
                                        <strong>Qty</strong>
                                    </th>
                                    <th width="6%" style="vertical-align:text-top">
                                        <strong>سعر الوحدة</strong>
                                        <br/>
                                        <strong>Unit Price</strong>
                                    </th>
                                    <th width="6%" style="vertical-align:text-top">
                                        <strong>خصم الوحدة</strong>
                                        <br/>
                                        <strong>Unit Discount</strong>
                                    </th>
                                    <th width="7%" style="vertical-align:text-top">
                                        <strong>سعر الوحدة الصافي</strong>
                                        <br/>
                                        <strong>Net Unit Price</strong>
                                    </th>
                                    <th width="7%" style="vertical-align:text-top">
                                        <strong>السعر الإجمالي</strong>
                                        <br/>
                                        <strong>Extended Price</strong>
                                    </th>
                                    <th width="6%" style="vertical-align:text-top">
                                        <strong>نسبة الضريبة</strong>
                                        <br/>
                                        <strong>Vat %</strong>
                                    </th>
                                    <th width="7%" style="vertical-align:text-top">
                                        <strong>قيمة الضريبة</strong>
                                        <br/>
                                        <strong>Vat Amount</strong>
                                    </th>
                                    <th width="7%" style="vertical-align:text-top">
                                        <strong>الإجمالي</strong>
                                        <br/>
                                        <strong>Amount</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="counter" t-value="1"/>
                                <t t-foreach="product_lines" t-as="product">
                                    <tr>
                                        <td class="text-right">
                                            <span t-esc="counter"/>
                                        </td>
                                        <td>
                                            <span t-esc="product['stock_group']"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="product['stock_number']"/>
                                        </td>
                                        <td>
                                            <span t-esc="product['description']"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <span t-esc="product['qty']"/>
                                        </td>
                                        <td style="text-align: right;">
                                            <span t-esc="product['unit_price']"
                                                  t-options="{'widget': 'float', 'precision': 2}"/>
                                        </td>
                                        <td>
                                            <span t-esc="product['unit_discount']"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <span t-esc="product['net_unit_price']"
                                                  t-options="{'widget': 'float', 'precision': 2}"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <span t-esc="product['extended_price']"
                                                  t-options="{'widget': 'float', 'precision': 2}"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <span t-esc="product['vat_percent']"/>
                                            %
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <span t-esc="product['vat_amount']"
                                                  t-options="{'widget': 'float', 'precision': 2}"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <span t-esc="product['total']"
                                                  t-options="{'widget': 'float', 'precision': 2}"/>
                                        </td>
                                    </tr>

                                    <t t-set="counter" t-value="counter+1"/>
                                </t>
                                <t t-foreach="totals" t-as="total">
                                    <tr>
                                        <td colspan="8" style="text-align:right">
                                            <strong>Total</strong>
                                        </td>
                                        <td style="text-align:right">
                                            <strong>
                                                <span t-esc="total['total_extended_price']"
                                                      t-options="{'widget': 'float', 'precision': 2}"/>
                                            </strong>
                                        </td>
                                        <td/>
                                        <td style="text-align:right">
                                            <strong>
                                                <span t-esc="total['total_vat_amt']"
                                                      t-options="{'widget': 'float', 'precision': 2}"/>
                                            </strong>
                                        </td>
                                        <td  rowspan="2" style="text-align:right">
                                            <strong>
                                                <span t-esc="total['grand_total']"
                                                      t-options="{'widget': 'float', 'precision': 2}"/>
                                            </strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="11"   style="text-align:right">
                                            <strong>
                                                <span t-esc="total['amount_words']"/>
                                                Only
                                            </strong>
                                        </td>
                                       
                                    </tr>
                                </t>
                            </tbody>

                        </table>


                        <!--                        <p style="margin-left:60%">Amount in words : <span t-field="o.amount_words"/> </p>-->
                        <div class="row mt32 mb32">
                            <div class="col-4 text-left">
                                <p style="font-size:18px;">المستلم</p>
                                <P style="font-size:18px;">Receiver</P>
                            </div>
                            <div class="col-4">
                                <p style="font-size:18px;">المحاسب / أمين الصندوق</p>
                                <P style="font-size:18px;">Accountant/Cashier</P>
                            </div>
                            <div class="col-4" align="right">
		                        <p style="font-size:18px;">اسم الفني</p>
		                        <p style="font-size:18px;">Technician Name</p>
		                    </div>
                        </div>
                    </div>
                    
                     <div class="footer">
                        <img src="machine_repair_management/static/src/img/JobCard_Footer_img.png"
                             style="width:100%;"/>
                    </div>
                    <!-- <div class="footer">
                        <div>
                            <img src="machine_repair_management/static/src/img/Arabic_Text_1.png" alt="img"
                                 style="height:60px; width:100%;"/>
                        </div>
                        <br/>
                        <div>
                            <img src="machine_repair_management/static/src/img/Footer.jpg" alt="img"
                                 style="height:80px; width: 100%"/>
                        </div>
                    </div> -->
                </t>
            </t>
        </t>
    </template>

