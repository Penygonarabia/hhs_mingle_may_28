<?xml version="1.0" encoding ="utf-8" ?>
<odoo>
		<record id="job_card_report_paperformat_id" model="report.paperformat">
            <field name="name">Custom Paper Format - Job Card Quotation Report</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">40</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">35</field>
            <field name="dpi">140</field>
             <!-- <field name="dpi">125</field> -->
        </record>
		 <record id="print_job_card_template_document" model="ir.actions.report">
             <field name="name">Service Quotation</field>
             <field name="model">project.task</field>
             <field name="report_type">qweb-pdf</field>
             <field name="report_name">machine_repair_management.job_card_document_template</field>
             <field name="report_file">machine_repair_management.job_card_document_template</field>
			 <field name="paperformat_id" ref="machine_repair_management.job_card_report_paperformat_id"/>
             <field name="binding_type">report</field>
        </record>

    <template id="job_card_print_document_template_internal_layout">
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
          <t t-raw="0"/>
        </div>
    </template>
    
    
