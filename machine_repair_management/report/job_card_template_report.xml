<?xml version="1.0" encoding ="utf-8" ?>
<odoo>
		<record id="job_card_report_paperformat_id" model="report.paperformat">
            <field name="name">Custom Paper Format - Job Card Quotation Report</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">40</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">35</field>
            <field name="dpi">140</field>
             <!-- <field name="dpi">125</field> -->
        </record>
		 <record id="print_job_card_template_document" model="ir.actions.report">
             <field name="name">Service Quotation</field>
             <field name="model">project.task</field>
             <field name="report_type">qweb-pdf</field>
             <field name="report_name">machine_repair_management.job_card_document_template</field>
             <field name="report_file">machine_repair_management.job_card_document_template</field>
			 <field name="paperformat_id" ref="machine_repair_management.job_card_report_paperformat_id"/>
             <field name="binding_type">report</field>
        </record>

    <template id="job_card_print_document_template_internal_layout">
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
          <t t-raw="0"/>
        </div>
    </template>
    
    
    <template id="job_card_document_template">
        <t t-call="web.html_container">
            <t t-foreach="jobs" t-as="doc">
                <t t-call="machine_repair_management.job_card_print_document_template_internal_layout">
                    <div class="header" t-att-style="report_header_style">
                        <div class="row mt32 mb32">
                            <div class="col-4 text-left">
                                <img src="machine_repair_management/static/src/img/HHS_Header_Left.png" alt="img"
                                     style="height: 120px; width: 350px; "/>
                            </div>
                            <div class="col-4 text-center " style="vertical-align:text-top">
                                <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)"
                                     style="max-height: 100px; min-height:100px; min-width: 200px; max-width: 200px;"/>
                            </div>
                            <div class="col-4 text-right " style="vertical-align:text-top;text-align:right">
                                <img src="machine_repair_management/static/src/img/HHS_Header_Right.png" alt="img"
                                     style="height: 120px; width: 350px;"/>
                            </div>
                        </div>
                        <h2>
                            <center style="font-size:35px;">Service Quotation / عرض سعر الخدمة</center>
                        </h2>
                    </div>
                    <div class="page" style="page-break-after: always; font-size:16px !important;">
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <table class="table table-bordered border-dark">
                                    <colgroup>
                                        <col width='30%'/>
                                        <col width='40%'/>
                                        <col width='30%'/>
                                    </colgroup>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <strong style="font-size:18px !important; font-weight:bold !important;">Warehouse :</strong>
                                            </td>
                                            <td>
                                                <span style="font-size:16px !important;" t-if="doc['warehouse_id']" t-esc="doc['warehouse_id']"/>
                                            </td>
                                            <td style="text-align:right">
                                                <strong style="font-size:18px !important; font-weight:bold !important;">: مستودع</strong>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <strong style="font-size:18px !important; font-weight:bold !important;">Customer Name:</strong>
                                            </td>
                                            <td>
                                                <span style="font-size:16px !important;" t-if="doc['customer_name']"
                                                      t-esc="doc['customer_name']"/>
                                            </td>
                                            <td style="text-align:right">
                                                <strong style="font-size:18px !important; font-weight:bold !important;">:اسم العميل</strong>
                                            </td>

                                        </tr>
                                        <tr>
                                            <td>
                                                <strong style="font-size:18px !important; font-weight:bold !important;">Customer Address :</strong>
                                            </td>
                                            <td>
                                                <span style="font-size:16px !important;" t-if="doc['address']"
                                                      t-esc="doc['address']"/>
                                            </td>
                                            <td style="text-align:right">
                                                <strong style="font-size:18px !important; font-weight:bold !important;">: اسم العميل</strong>
                                            </td>

                                        </tr>
                                        <tr>
                                            <td>
                                                <strong style="font-size:18px !important; font-weight:bold !important;">VAT No.:</strong>
                                            </td>
                                            <td>
                                                <span style="font-size:16px !important;" t-if="doc['vat']"
                                                      t-esc="doc['vat']"/>
                                            </td>
                                            <td style="text-align:right">
<!--                                                <strong style="font-size:18px !important; font-weight:bold !important;">:ضريبة القيمة المضافة</strong>-->
                                                <strong style="font-size:18px !important; font-weight:bold !important;">:الرقم الضريبي</strong>
                                            </td>

                                        </tr>
                                       
                                        <tr>
                                            <td>
                                                <strong style="font-size:18px !important; font-weight:bold !important;">Job Card No.:</strong>
                                            </td>
                                            <td>
                                                <span style="font-size:16px !important;" t-if="doc['job_card_no']"
                                                      t-esc="doc['job_card_no']"/>
                                            </td>
                                            <td colspan="3" style="text-align:right">
                                                <strong style="font-size:18px !important; font-weight:bold !important;">:رقم بطاقة العمل</strong>
                                            </td>

                                        </tr>
                                    
                                    </tbody>
                                </table>
                            </div>
                            <!--								<div class="col-2"/>-->
                            <div class="col-6">
                                <table class="table table-bordered border-dark">
                                    <colgroup>
                                        <col width='30%'/>
                                        <col width='28%'/>
                                        <col width='42%'/>
                                    </colgroup>

                                    <tbody>
                                        <tr>
                                            <td>
                                                <strong style="font-size:18px !important; font-weight:bold !important;">Quotation No:</strong>
                                            </td>
                                            <td>
                                                <span style="font-size:16px !important;" t-if="doc['quotation_no']"
                                                      t-esc="doc['quotation_no']"/>
                                            </td>
                                            <td style="text-align:right">
<!--                                                <strong style="font-size:18px !important; font-weight:bold !important;">: رقم الاقتباس</strong>-->
                                                <strong style="font-size:18px !important; font-weight:bold !important;">:رقم عرض السعر</strong>
                                            </td>

                                        </tr>
                                        <tr>
                                            <td>
                                                <strong style="font-size:18px !important; font-weight:bold !important;">Date Quotation:</strong>
                                            </td>
                                            <td>
                                                <span style="font-size:16px !important;" t-if="doc['quotation_date']"
                                                      t-esc="doc['quotation_date']"
                                                      t-options='{"widget": "date","format": "dd-MM-yyyy"}'/>
                                            </td>
                                            <td style="text-align:right">
                                                <strong style="font-size:18px !important; font-weight:bold !important;">:تاريخ عرض سعر الخدمة</strong>
                                            </td>

                                        </tr>
                                       <!--  <tr>
                                            <td>
                                                <strong style="font-size:18px !important; font-weight:bold !important;">Quotation Expiry Date:</strong>
                                            </td>
                                            <td>
                                                <span style="font-size:16px !important;" t-if="doc['quotation_expiry_date']"
                                                      t-esc="doc['quotation_expiry_date']"
                                                      t-options='{"widget": "date","format": "dd-MM-yyyy"}'/>
                                            </td>
                                            <td style="text-align:right">
                                                <strong style="font-size:18px !important; font-weight:bold !important;">:تاريخ انتهاء صلاحية عرض السعر</strong>
                                            </td>

                                        </tr> -->
                                        <tr>
                                            <td>
                                                <strong style="font-size:18px !important; font-weight:bold !important;">Technician Name:</strong>
                                            </td>
                                            <td>
                                                <span style="font-size:16px !important;" t-if="doc['technician_name']"
                                                      t-esc="doc['technician_name']"/>
                                            </td>
                                            <td style="text-align:right">
                                                <strong style="font-size:18px !important; font-weight:bold !important;">:اسم الفني</strong>
                                            </td>

                                        </tr>
                                         <tr>
                                            <td>
                                                <strong style="font-size:18px !important; font-weight:bold !important;">Model No:</strong>
                                            </td>
                                            <td>
                                                <span style="font-size:16px !important;" t-if="doc['model_no']"
                                                      t-esc="doc['model_no']"/>
                                            </td>
                                            <td style="text-align: right;">
                                              <strong style="font-size:18px !important; font-weight:bold !important;">:رقم الموديل</strong>

                                            </td>
                                            

                                        </tr>
                                        
                                         <tr>
                                            <td>
                                                <strong style="font-size:18px !important; font-weight:bold !important;">Serial No:</strong>
                                            </td>
                                            <td>
                                                <span style="font-size:16px !important;" t-if="doc['serial_no']"
                                                      t-esc="doc['serial_no']"/>
                                            </td>
                                            <td style="text-align: right;">
                                              <strong style="font-size:18px !important; font-weight:bold !important;">:الرقم التسلسلي</strong>

                                            </td>
                                            

                                        </tr>
                                        
                                        <tr>
                                            <td>
                                                <strong style="font-size:18px !important; font-weight:bold !important;">VAT Registration:</strong>
                                            </td>
                                            <td>
                                                <span style="font-size:16px !important;" t-if="doc['company_vat']"
                                                      t-esc="doc['company_vat']"/>
                                            </td>
                                            <td style="text-align: right;">
                                                <strong style="font-size:18px !important; font-weight:bold !important;">: ضريبة القيمة المضافة</strong>
                                            </td>

                                        </tr>
                                      

                                    </tbody>
                                </table>

                            </div>


                        </div>


                        <table class="table table-bordered border-dark">
                            <thead style="font-size:17px !important; font-weight:bold !important;">
                            
                            	 <tr style="text-align:center">
							        <th style="font-size:17px !important; font-weight:bold !important;vertical-align:text-top;" width="3%" >
							            <strong style="font-size:18px !important; font-weight:bold !important;">تسلسل</strong>
							            <br/>
							            <strong style="font-size:18px !important; font-weight:bold !important;">S/N</strong>
							        </th>
							
							        <th style="font-size:17px !important; font-weight:bold !important;vertical-align:text-top;" width="10%" >
							            <strong style="font-size:18px !important; font-weight:bold !important;">فئة الصنف</strong>
							            <br/>
							            <strong style="font-size:18px !important; font-weight:bold !important;">Stock Group</strong>
							        </th>
							
							        <th style="font-size:17px !important; font-weight:bold !important; vertical-align:text-top;" width="35%" >
							            <strong style="font-size:18px !important; font-weight:bold !important;">الوصف</strong>
							            <br/>
							            <strong style="font-size:18px !important; font-weight:bold !important;">Description</strong>
							        </th>
							
							        <th style="font-size:17px !important; font-weight:bold !important;vertical-align:text-top;" width="5%" >
							            <strong style="font-size:18px !important; font-weight:bold !important;">الكمية</strong>
							            <br/>
							            <strong style="font-size:18px !important; font-weight:bold !important;">Qty</strong>
							        </th>
							
							        <th style="font-size:17px !important; font-weight:bold !important;vertical-align:text-top;" width="7%" >
							            <strong style="font-size:18px !important; font-weight:bold !important;">سعر الوحدة</strong>
							            <br/>
							            <strong style="font-size:18px !important; font-weight:bold !important;">Unit Price</strong>
							        </th>
							
							        <th style="font-size:17px !important; font-weight:bold !important;vertical-align:text-top;" width="7%" >
							            <strong style="font-size:18px !important; font-weight:bold !important;">خصم الوحدة</strong>
							            <br/>
							            <strong style="font-size:18px !important; font-weight:bold !important;">Unit Discount</strong>
							        </th>
							
							        <th style="font-size:17px !important; font-weight:bold !important;vertical-align:text-top;" width="8%" >
							            <strong style="font-size:18px !important; font-weight:bold !important;">سعر الوحدة الصافي</strong>
							            <br/>
							            <strong style="font-size:18px !important; font-weight:bold !important;">Net Unit Price</strong>
							        </th>
							
							        <th style="font-size:17px !important; font-weight:bold !important;vertical-align:text-top;" width="8%">
							            <strong style="font-size:18px !important; font-weight:bold !important;">السعر الإجمالي</strong>
							            <br/>
							            <strong style="font-size:18px !important; font-weight:bold !important;">Extended Price</strong>
							        </th>
							
							        <th style="font-size:17px !important; font-weight:bold !important;vertical-align:text-top;" width="5%">
							            <strong style="font-size:18px !important; font-weight:bold !important;">نسبة الضريبة</strong>
							            <br/>
							            <strong style="font-size:18px !important; font-weight:bold !important;">Vat %</strong>
							        </th>
							
							        <th style="font-size:17px !important; font-weight:bold !important;vertical-align:text-top;" width="6%" >
							            <strong style="font-size:18px !important; font-weight:bold !important;">قيمة الضريبة</strong>
							            <br/>
							            <strong style="font-size:18px !important; font-weight:bold !important;">Vat Amount</strong>
							        </th>
							
							        <th style="font-size:17px !important; font-weight:bold !important;vertical-align:text-top;" width="6%">
							            <strong style="font-size:18px !important; font-weight:bold !important;">الإجمالي</strong>
							            <br/>
							            <strong style="font-size:18px !important; font-weight:bold !important;">Amount</strong>
							        </th>
							    </tr>
                            	
                                
                            </thead>
                            <tbody>
                                <t t-set="counter" t-value="1"/>
                                <t t-foreach="product_lines" t-as="product">
                                    <tr>
                                        <td class="text-right">
                                            <span style="font-size:16px !important;" t-esc="counter"/>
                                        </td>
                                        <td>
                                            <span style="font-size:16px !important;" t-esc="product['stock_group']"/>
                                        </td>
                                        <!-- <td class="text-right">
                                            <span style="font-size:16px !important;" t-esc="product['stock_number']"/>
                                        </td> -->
                                        <td>
                                            <span style="font-size:16px !important;" t-esc="product['description']"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <span style="font-size:16px !important;" t-esc="product['qty']"/>
                                        </td>
                                        <td style="text-align: right;">
                                            <span style="font-size:16px !important;" t-esc="product['unit_price']"
                                                  t-options="{'widget': 'float', 'precision': 2}"/>
                                        </td>
                                        <td>
                                            <span style="font-size:16px !important;" t-esc="product['unit_discount']"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <span style="font-size:16px !important;" t-esc="product['net_unit_price']"
                                                  t-options="{'widget': 'float', 'precision': 2}"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <span style="font-size:16px !important;" t-esc="product['extended_price']"
                                                  t-options="{'widget': 'float', 'precision': 2}"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <span style="font-size:16px !important;" t-esc="product['vat_percent']"/>
                                            %
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <span style="font-size:16px !important;" t-esc="product['vat_amount']"
                                                  t-options="{'widget': 'float', 'precision': 2}"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <span style="font-size:16px !important;" t-esc="product['total']"
                                                  t-options="{'widget': 'float', 'precision': 2}"/>
                                        </td>
                                    </tr>

                                    <t t-set="counter" t-value="counter+1"/>
                                </t>
                                <t t-foreach="totals" t-as="total">
                                
                                	<tr>
									    <td colspan="7" style="text-align:right">
									        <strong style="font-size:18px !important; font-weight:bold !important;">Total</strong>
									    </td>
									    <td style="text-align:right">
									        <strong style="font-size:18px !important; font-weight:bold !important;">
									            <span style="font-size:16px !important;" t-esc="total['total_extended_price']"
									                  t-options="{'widget': 'float', 'precision': 2}"/>
									        </strong>
									    </td>
									    <td/>
									    <td style="text-align:right">
									        <strong style="font-size:18px !important; font-weight:bold !important;">
									            <span style="font-size:16px !important;" t-esc="total['total_vat_amt']"
									                  t-options="{'widget': 'float', 'precision': 2}"/>
									        </strong>
									    </td>
									    <td rowspan="2" style="text-align:right">
									        <strong style="font-size:18px !important; font-weight:bold !important;">
									            <span style="font-size:16px !important;" t-esc="total['grand_total']"
									                  t-options="{'widget': 'float', 'precision': 2}"/>
									        </strong>
									    </td>
									</tr>
									
									<tr>
									    <td colspan="10" style="text-align:right">
									        <strong style="font-size:18px !important; font-weight:bold !important;">
									            <span style="font-size:16px !important;" t-esc="total['amount_words']"/>
									            Only
									        </strong>
									    </td>
									</tr>
                                    
                                </t>
                            </tbody>

                        </table>
                        
                        <br/>
						<br/>
						
						    <table width="100%" style="border-collapse: collapse; border: 1px solid #000;">
						        <tbody>
						    
						            <tr>
						    
						                <!-- English -->
						                <td style="text-align: left; width: 50%; padding: 5px;">
						                    <strong style="font-size:18px !important; font-weight:bold !important;">Quotation Validity:</strong>
						                    <!-- <span style="font-size:16px !important;" t-esc="quotation_expiry_date"/> -->
						                </td>
						    
						                <!-- Arabic -->
						                <td style="text-align: right; width: 50%; padding: 5px;" dir="rtl">
						                    <strong style="font-size:18px !important; font-weight:bold !important;">صلاحية عرض السعر :</strong>
						    
						                    <!--
						                    <span style="font-size:16px !important;" dir="ltr" style="display:inline-block;">
						                        <span style="font-size:16px !important;" t-esc="quotation_expiry_date"/>
						                    </span>
						                    -->
						                </td>
						    
						            </tr>
						    
						         
						            <tr>
										
										    <td style="text-align: left; padding: 5px;">
										        <span style="font-size:15px !important; ">
										            This quotation is valid for 2 weeks from the date of issuance.
										        </span>
										    </td>
										
										    <td style="text-align: right; padding: 5px;" dir="rtl">
										        <span style="font-size:15px !important; ">
										            صلاحية عرض السعر سارية لمدة أسبوعين من تاريخ إصدار عرض السعر.
										        </span>
										    </td>
										
										</tr>
						    
						        </tbody>
						    </table>
						    <br/>
						  <br/>
						  <table width="100%" style="border-collapse: collapse; border: 1px solid #000;">
				                <tr>
				                    <td style="text-align: left; width: 50%; padding: 5px;">
				                        <strong style="font-size:18px !important; font-weight:bold !important;">Payment Terms: 100% Advance</strong> 
				                    </td>
				                    <td style="text-align: right; width: 50%; padding: 5px;" dir="rtl">
				                        <strong style="font-size:18px !important; font-weight:bold !important;">شروط الدفع: 100% دفعة مقدمة
				                    	</strong>
				                    </td>
				                </tr>
				              
				                <tr>

							    <td style="text-align: left; padding: 5px;">
							        <span style="font-size:15px !important; ">
							            Repair work will commence only after the full payment has been received.
							        </span>
							    </td>
							
							    <td style="text-align: right; padding: 5px;" dir="rtl">
							        <span style="font-size:15px !important;">
							            سيبدأ تنفيذ أعمال الإصلاح فقط بعد استلام المبلغ بالكامل.
							        </span>
							    </td>
							
							</tr>
				            </table>
                        
						
						

                    </div>
                    
                     <div class="footer">
                        <img src="machine_repair_management/static/src/img/JobCard_Footer_img.png"
                             style="width:100%;"/>
                    </div>
                   
                </t>
            </t>
        </t>
    </template>

	

</odoo>