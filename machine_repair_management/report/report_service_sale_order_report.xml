        <!-- Override Default Report Action -->
    <record id="service_sale_order_quotation_report" model="ir.actions.report">
        <field name="name">Quotation</field>
        <field name="model">service.sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">machine_repair_management.report_service_saleorder_document_hhs</field>
        <field name="report_file">machine_repair_management.report_service_saleorder_document_hhs</field>

        <!-- <field name="binding_model_id" ref="machine_repair_management.model_service_sale_order"/> -->
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>
            
        
        
        
