<?xml version = "1.0" encoding = "utf-8" ?>
<odoo>
	
	<data>

        <record id="paperformat_service_saleorder_hhs" model="report.paperformat">
            <field name="name">Service Sale Order HHS</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">40</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">35</field>
            <field name="dpi">140</field>
        </record>
        
        
        <template id="service_sale_order_document_template_internal_layout">
            <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-raw="0"/>
            </div>
        </template>

        <!-- Custom Report Template -->
      <template id="report_service_saleorder_document_hhs">

    <t t-call="web.html_container">

        <t t-foreach="docs" t-as="doc">

            <!-- SAME INTERNAL LAYOUT AS WORKING JOB CARD -->
            <t t-call="machine_repair_management.job_card_print_document_template_internal_layout">

                <div class="header" t-att-style="report_header_style">

                    <div class="row mt32 mb32">

                        <div class="col-4 text-left">
                            <img src="machine_repair_management/static/src/img/HHS_Header_Left.png"
                                 alt="img"
                                 style="height:120px; width:350px;"/>
                        </div>

                        <div class="col-4 text-center"
                             style="vertical-align:text-top">

                            <img t-if="res_company.logo"
                                 t-att-src="image_data_uri(res_company.logo)"
                                 style="max-height:100px;
                                        min-height:100px;
                                        min-width:200px;
                                        max-width:200px;"/>

                        </div>

                        <div class="col-4 text-right"
                             style="vertical-align:text-top;text-align:right">

                            <img src="machine_repair_management/static/src/img/HHS_Header_Right.png"
                                 alt="img"
                                 style="height:120px; width:350px;"/>

                        </div>

                    </div>

                    <h2>
                        <center style="font-size:35px;">
                            Quotation / عرض سعر
                        </center>
                    </h2>

                </div>


                <!-- SAME FONT LOGIC AS JOB CARD -->
                <div class="page"
                     style="page-break-after:always; font-size:16px !important;">

                    <div class="row mt32 mb32">

                        <!-- LEFT INFORMATION -->
                        <div class="col-6">

                            <table class="table table-bordered border-dark">

                                <colgroup>
                                    <col width="30%"/>
                                    <col width="40%"/>
                                    <col width="30%"/>
                                </colgroup>

                                <tbody>

                                    <tr>
                                        <td>
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                Warehouse:
                                            </strong>
                                        </td>

                                        <td>
                                            <span style="font-size:16px !important;"
                                                  t-field="doc.job_task_id.warehouse_id.name"/>
                                        </td>

                                        <td style="text-align:right">
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                :مستودع
                                            </strong>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td>
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                Customer Name:
                                            </strong>
                                        </td>

                                        <td>
                                            <span style="font-size:16px !important;"
                                                  t-field="doc.customer_name"/>
                                        </td>

                                        <td style="text-align:right">
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                :اسم العميل
                                            </strong>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td>
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                Customer Address:
                                            </strong>
                                        </td>

                                        <td>
                                            <span style="font-size:16px !important;"
                                                  t-field="doc.customer_address"/>
                                        </td>

                                        <td style="text-align:right">
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                :عنوان العميل
                                            </strong>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td>
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                VAT #:
                                            </strong>
                                        </td>

                                        <td>
                                            <span style="font-size:16px !important;"
                                                  t-field="doc.job_task_id.customer_identification_number"/>
                                        </td>

                                        <td style="text-align:right">
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                :ضريبة القيمة المضافة
                                            </strong>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td>
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                Client Reference:
                                            </strong>
                                        </td>

                                        <td>
                                            <span style="font-size:16px !important;"
                                                  t-field="doc.job_task_id.customer_identification_number"/>
                                        </td>

                                        <td style="text-align:right">
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                :رقم المرجع
                                            </strong>
                                        </td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>


                        <!-- RIGHT INFORMATION -->
                        <div class="col-6">

                            <table class="table table-bordered border-dark">

                                <colgroup>
                                    <col width="30%"/>
                                    <col width="28%"/>
                                    <col width="42%"/>
                                </colgroup>

                                <tbody>

                                    <tr>
                                        <td>
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                Quotation No:
                                            </strong>
                                        </td>

                                        <td>
                                            <span style="font-size:16px !important;"
                                                  t-field="doc.name"/>
                                        </td>

                                        <td style="text-align:right">
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                :رقم عرض السعر
                                            </strong>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td>
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                Quotation Date:
                                            </strong>
                                        </td>

                                        <td>
                                            <span style="font-size:16px !important;"
                                                  t-field="doc.service_sale_quotation_date"
                                                  t-options='{"widget":"date","format":"dd-MM-yyyy"}'/>
                                        </td>

                                        <td style="text-align:right">
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                :تاريخ عرض السعر
                                            </strong>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td>
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                Technician Name:
                                            </strong>
                                        </td>

                                        <td>
                                            <span style="font-size:16px !important;"
                                                  t-field="doc.job_task_id.team_id.name"/>
                                        </td>

                                        <td style="text-align:right">
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                :اسم الفني
                                            </strong>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td>
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                VAT Registration:
                                            </strong>
                                        </td>

                                        <td>
                                            <span style="font-size:16px !important;"
                                                  t-field="doc.company_id.vat"/>
                                        </td>

                                        <td style="text-align:right">
                                            <strong style="font-size:18px !important;
                                                          font-weight:bold !important;">
                                                :ضريبة القيمة المضافة
                                            </strong>
                                        </td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>


                    <!-- PRODUCT TABLE -->

                    <t t-set="lines_to_report"
                       t-value="doc.service_sale_order_line_ids"/>

                    <table class="table table-bordered border-dark">

                        <thead style="font-size:17px !important;
                                      font-weight:bold !important;">

                            <tr style="text-align:center">

                                <th width="2%"
                                    style="font-size:17px !important;
                                           font-weight:bold !important;
                                           vertical-align:text-top;">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        قم
                                    </strong>
                                    <br/>
                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        No
                                    </strong>

                                </th>


                                <th width="29%"
                                    style="font-size:17px !important;
                                           font-weight:bold !important;
                                           vertical-align:text-top;">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        الوصف
                                    </strong>
                                    <br/>
                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        Description
                                    </strong>

                                </th>


                                <th width="5%"
                                    style="font-size:17px !important;
                                           font-weight:bold !important;
                                           vertical-align:text-top;">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        الكمية
                                    </strong>
                                    <br/>
                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        Qty
                                    </strong>

                                </th>


                                <th width="6%"
                                    style="font-size:17px !important;
                                           font-weight:bold !important;
                                           vertical-align:text-top;">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        سعر الوحدة
                                    </strong>
                                    <br/>
                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        Unit Price
                                    </strong>

                                </th>


                                <th width="7%"
                                    style="font-size:17px !important;
                                           font-weight:bold !important;
                                           vertical-align:text-top;">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        سعر الوحدة الصافي
                                    </strong>
                                    <br/>
                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        Net Unit Price
                                    </strong>

                                </th>


                                <th width="7%"
                                    style="font-size:17px !important;
                                           font-weight:bold !important;
                                           vertical-align:text-top;">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        السعر الإجمالي
                                    </strong>
                                    <br/>
                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        Extended Price
                                    </strong>

                                </th>


                                <th width="6%"
                                    style="font-size:17px !important;
                                           font-weight:bold !important;
                                           vertical-align:text-top;">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        نسبة الضريبة
                                    </strong>
                                    <br/>
                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        Vat %
                                    </strong>

                                </th>


                                <th width="7%"
                                    style="font-size:17px !important;
                                           font-weight:bold !important;
                                           vertical-align:text-top;">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        قيمة الضريبة
                                    </strong>
                                    <br/>
                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        Vat Amount
                                    </strong>

                                </th>


                                <th width="7%"
                                    style="font-size:17px !important;
                                           font-weight:bold !important;
                                           vertical-align:text-top;">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        الإجمالي
                                    </strong>
                                    <br/>
                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        Amount
                                    </strong>

                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <t t-set="counter" t-value="1"/>

                            <t t-foreach="lines_to_report" t-as="line">

                                <tr>

                                    <td style="text-align:right">
                                        <span style="font-size:16px !important;"
                                              t-esc="counter"/>
                                    </td>

                                    <!-- <td>
                                        <span style="font-size:16px !important;"
                                              t-field="line.product_id.display_name"/>
                                    </td> -->
                                    
                                     <td>
                                    	<t t-if = "line.product_description">
										    <span style="font-size:16px !important;"
										          t-esc="'[%s] %s' % (line.product_id.default_code or '', line.product_description or '')"/>
										</t>
										<t t-else ="">
											<span style="font-size:16px !important;"
                                              t-field="line.product_id.display_name"/>
										
										</t>
										
									</td>
                                    

                                    <td style="text-align:right">
                                        <span style="font-size:16px !important;"
                                              t-esc="int(line.product_qty) if line.product_qty else 0"/>
                                    </td>

                                    <td style="text-align:right">
                                        <span style="font-size:16px !important;"
                                              t-esc="'%.2f' % line.price_unit"/>
                                    </td>

                                    <td style="text-align:right">
                                        <span style="font-size:16px !important;"
                                              t-esc="'%.2f' % line.price_unit"/>
                                    </td>

                                    <td style="text-align:right">
                                        <span style="font-size:16px !important;"
                                              t-esc="'%.2f' % (line.product_qty * line.price_unit)"/>
                                    </td>

                                    <td style="text-align:right">
                                        <span style="font-size:16px !important;"
                                              t-esc="int(line.vat)"/>
                                        %
                                    </td>

                                    <td style="text-align:right">
                                        <span style="font-size:16px !important;"
                                              t-esc="'%.2f' % (line.total - line.price_unit)"/>
                                    </td>

                                    <td style="text-align:right">
                                        <span style="font-size:16px !important;"
                                              t-esc="'%.2f' % line.total"/>
                                    </td>

                                </tr>

                                <t t-set="counter" t-value="counter + 1"/>

                            </t>


                            <!-- TOTAL -->

                            <tr>

                                <td colspan="5"
                                    style="text-align:right">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        Total
                                    </strong>

                                </td>

                                <td style="text-align:right">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">

                                        <span style="font-size:16px !important;"
                                              t-esc="'%.2f' % sum(
                                                  line.product_qty * line.price_unit
                                                  for line in lines_to_report
                                              )"/>

                                    </strong>

                                </td>

                                <td/>

                                <td style="text-align:right">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">

                                        <span style="font-size:16px !important;"
                                              t-esc="'%.2f' % doc['vat_amount']"/>

                                    </strong>

                                </td>

                                <td style="text-align:right">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">

                                        <span style="font-size:16px !important;"
                                              t-esc="'%.2f' % doc['grand_total_amount']"/>

                                    </strong>

                                </td>

                            </tr>


                            <!-- INSPECTION CHARGES -->

                            <tr>

                                <td colspan="5"
                                    style="text-align:right">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        Inspection Charges Amount Received
                                    </strong>

                                </td>

                                <td colspan="10"
                                    style="text-align:right">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">

                                        <span style="font-size:16px !important;"
                                              t-esc="'%.2f' % doc['inspection_charges_amount']"/>

                                    </strong>

                                </td>

                            </tr>


                            <!-- BALANCE -->

                            <tr>

                                <td colspan="5"
                                    style="text-align:right">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        Balance To Be Paid
                                    </strong>

                                </td>

                                <td colspan="10"
                                    style="text-align:right">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">

                                        <span style="font-size:16px !important;"
                                              t-esc="'%.2f' % doc['balance_paid']"/>

                                    </strong>

                                </td>

                            </tr>


                            <!-- AMOUNT IN WORDS -->

                            <tr>

                                <t t-if="doc['balance_paid'] > 0">

                                    <td colspan="10"
                                        style="text-align:right">

                                        <strong style="font-size:18px !important;
                                                       font-weight:bold !important;">

                                            <span style="font-size:16px !important;"
                                                  t-esc="doc.company_id.currency_id.amount_to_text(doc['balance_paid'])"/>

                                            Only

                                        </strong>

                                    </td>

                                </t>

                                <t t-elif="doc['inspection_charges_amount'] > 0">

                                    <td colspan="10"
                                        style="text-align:right">

                                        <strong style="font-size:18px !important;
                                                       font-weight:bold !important;">

                                            <span style="font-size:16px !important;"
                                                  t-esc="doc.company_id.currency_id.amount_to_text(doc['inspection_charges_amount'])"/>

                                            Only

                                        </strong>

                                    </td>

                                </t>

                                <t t-elif="doc['grand_total_amount'] > 0">

                                    <td colspan="10"
                                        style="text-align:right">

                                        <strong style="font-size:18px !important;
                                                       font-weight:bold !important;">

                                            <span style="font-size:16px !important;"
                                                  t-esc="doc.company_id.currency_id.amount_to_text(doc['grand_total_amount'])"/>

                                            Only

                                        </strong>

                                    </td>

                                </t>

                            </tr>

                        </tbody>

                    </table>


                    <br/>
                    <br/>


                    <!-- QUOTATION VALIDITY -->

                    <table width="100%"
                           style="border-collapse:collapse;border:1px solid #000;">

                        <tbody>

                            <tr>

                                <td style="text-align:left;width:50%;padding:5px;">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        Quotation Validity:
                                    </strong>

                                </td>

                                <td style="text-align:right;width:50%;padding:5px;"
                                    dir="rtl">

                                    <strong style="font-size:18px !important;
                                                   font-weight:bold !important;">
                                        صلاحية عرض السعر :
                                    </strong>

                                </td>

                            </tr>

                            <tr>

                                <td style="text-align:left;padding:5px;">
                                    <span style="font-size:16px !important;">
                                        This quotation is valid for 2 weeks from the date of issuance.
                                    </span>
                                </td>

                                <td style="text-align:right;padding:5px;"
                                    dir="rtl">

                                    <span style="font-size:16px !important;">
                                        صلاحية عرض السعر سارية لمدة أسبوعين من تاريخ إصدار عرض السعر.
                                    </span>

                                </td>

                            </tr>

                        </tbody>

                    </table>


                    <br/>
                    <br/>


                    <!-- PAYMENT TERMS -->

                    <table width="100%"
                           style="border-collapse:collapse;border:1px solid #000;">

                        <tr>

                            <td style="text-align:left;width:50%;padding:5px;">

                                <strong style="font-size:18px !important;
                                               font-weight:bold !important;">
                                    Payment Terms:
                                </strong>

                                <span style="font-size:16px !important;">
                                    100% Advance
                                </span>

                            </td>

                            <td style="text-align:right;width:50%;padding:5px;"
                                dir="rtl">

                                <strong style="font-size:18px !important;
                                               font-weight:bold !important;">
                                    شروط الدفع:
                                </strong>

                                <span style="font-size:16px !important;">
                                    100% دفعة مقدمة
                                </span>

                            </td>

                        </tr>

                        <tr>

                            <td style="text-align:left;padding:5px;">

                                <span style="font-size:16px !important;">
                                    Repair work will commence only after the full payment has been received.
                                </span>

                            </td>

                            <td style="text-align:right;padding:5px;"
                                dir="rtl">

                                <span style="font-size:16px !important;">
                                    سيبدأ تنفيذ أعمال الإصلاح فقط بعد استلام المبلغ بالكامل.
                                </span>

                            </td>

                        </tr>

                    </table>

                </div>


                <!-- SAME FOOTER AS WORKING TEMPLATE -->

                <div class="footer">

                    <img src="machine_repair_management/static/src/img/JobCard_Footer_img.png"
                         style="width:100%;"/>

                </div>

            </t>

        </t>

    </t>

</template>  
 
        <!-- Override Default Report Action -->
   <!--  <record id="service_sale_order_quotation_report" model="ir.actions.report">
        <field name="name">Quotation</field>
        <field name="model">service.sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">machine_repair_management.report_service_saleorder_document_hhs</field>
        <field name="report_file">machine_repair_management.report_service_saleorder_document_hhs</field>

        <field name="binding_model_id" ref="machine_repair_management.model_service_sale_order"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record> -->
            
            
      <record id="service_sale_order_quotation_report" model="ir.actions.report">
	    <field name="name">Quotation</field>
	    <field name="model">service.sale.order</field>
	    <field name="report_type">qweb-pdf</field>
	    <field name="report_name">machine_repair_management.report_ssorder_dynamic</field>
	    <field name="report_file">machine_repair_management.report_ssorder_dynamic</field>
	
	    <field name="binding_model_id"
	           ref="machine_repair_management.model_service_sale_order"/>
	    <field name="binding_type">report</field>
	</record>    
	
	
	<template id="report_ssorder_dynamic">

	    <t t-call="web.html_container">
	
	        <t t-foreach="docs" t-as="doc">
	
	            <t t-if="doc.job_task_id">
	
	                <t t-call="machine_repair_management.report_service_saleorder_document_hhs"/>
	
	            </t>
	
	            <t t-else="">
	
	                <t t-call="machine_repair_management.report_saleorder_amcquotation"/>
	
	            </t>
	
	        </t>
	
	    </t>
	
