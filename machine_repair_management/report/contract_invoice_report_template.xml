<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="contract_invoice_report_paperformat_landscape_id" model="report.paperformat">
        <field name="name">Custom Paper Format - Invoice Landscape Report</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">37</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">130</field>
    </record>
    <record id="print_contract_invoice_template_document" model="ir.actions.report">
        <field name="name">Contract Invoice Document</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">machine_repair_management.contract_invoice_report</field>
        <field name="report_file">machine_repair_management.contract_invoice_report</field>
        <field name="paperformat_id" ref="machine_repair_management.contract_invoice_report_paperformat_landscape_id"/>
        <field name="print_report_name">'Invoice_details_' + object.name</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
    </record>

    <template id="contract_invoice_print_document_template_internal_layout">
