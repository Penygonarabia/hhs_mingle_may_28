                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <span t-esc="line.quantity"/>
                                        </td>
                                        <td style="text-align: right;">
                                            <span t-esc="'{0:.2f}'.format(line.price_unit)"/>
                                        </td>
                                        <td>
                                            <span t-esc="'{0:.2f}'.format(line.discount)"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <t t-set="net_price"
                                               t-value="line.price_unit - (line.price_unit * line.discount / 100)"/>
                                            <span t-esc="'{0:.2f}'.format(net_price)"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <t t-set="extended"
                                               t-value="(line.price_unit - (line.price_unit * line.discount / 100)) * line.quantity"/>
                                            <span t-esc="'{0:.2f}'.format(extended)"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <t t-set="vat_percent" t-value="sum(line.tax_ids.mapped('amount'))"/>
                                            <span t-esc="'{0:.2f}'.format(vat_percent)"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <t t-set="vat_amount" t-value="(extended * vat_percent / 100)"/>
                                            <span t-esc="'{0:.2f}'.format(vat_amount)"/>
                                        </td>
                                        <td class="text-right" style="text-align: right;">
                                            <span t-esc="'{0:.2f}'.format(extended + vat_amount)"/>
                                        </td>
                                    </tr>
                                    <t t-set="counter" t-value="counter+1"/>
                                </t>
                                <tr style="border-bottom:none !important;">
                                    <td colspan="8" style="text-align:right">
                                        <strong>Total</strong>
                                    </td>
                                    <td style="text-align:right">
                                        <strong>
                                            <t t-set="total_extended"
                                               t-value="sum([(l.price_unit - (l.price_unit * l.discount / 100)) * l.quantity for l in move.invoice_line_ids])"/>
                                            <span t-esc="'{0:.2f}'.format(total_extended)"/>
                                        </strong>
                                    </td>
                                    <td/>
                                    <td style="text-align:right">
                                        <strong>
                                            <t t-set="total_vat"
                                               t-value="sum([((l.price_unit - (l.price_unit * l.discount / 100)) * l.quantity * sum(l.tax_ids.mapped('amount')) / 100) for l in move.invoice_line_ids])"/>
                                            <span t-esc="'{0:.2f}'.format(total_vat)"/>
                                        </strong>
                                    </td>
                                    <td style="text-align:right; border:0 !important;">
                                        <strong>
                                            <span t-esc="'{0:.2f}'.format(move.amount_total)"/>
                                        </strong>
                                    </td>
                                </tr>
                                <!--                                <tr>-->
                                <!--                                    <td colspan="12" style="text-align:center">-->
                                <!--                                        <strong>-->
                                <!--                                            <t t-esc="amount_words_en"/>-->
                                <!--                                        </strong>-->
                                <!--                                    </td>-->
                                <!--                                </tr>-->

                                <tr style="border-top:1">

                                    <td colspan="11" style="text-align:right;padding-right:25%">
                                        <strong>
                                            <t t-esc="amount_words_ar"/>
                                        </strong>
                                    </td>
                                    <td style="text-align:right;">

                                    </td>

                                </tr>
                            </tbody>
                        </table>
                        <div style="width:100%; margin-top:40px; text-align:center;">

                            <div style="width:32%; display:inline-block; vertical-align:top;">
                                <div style="direction:rtl; font-size:14px;">المستلم</div>
                                <div style="font-size:16px; font-weight:bold;">Receiver</div>
                                <div style="margin:12px auto 0 auto; width:170px; border-bottom:1px solid #000;"></div>
                            </div>

                            <div style="width:32%; display:inline-block; vertical-align:top;">
                                <div style="direction:rtl; font-size:14px;">المحاسب / أمين الصندوق</div>
                                <div style="font-size:16px; font-weight:bold;">Accountant/Cashier</div>
                                <div style="margin:12px auto 0 auto; width:210px; border-bottom:1px solid #000;"></div>
                            </div>

                            <div style="width:32%; display:inline-block; vertical-align:top;">
                                <div style="direction:rtl; font-size:14px;">البائع</div>
                                <div style="font-size:16px; font-weight:bold;">Salesman</div>
                                <div style="margin:12px auto 0 auto; width:170px; border-bottom:1px solid #000;"></div>
                            </div>

                        </div>

                    </div>


                    <div class="footer">
                        <img src="machine_repair_management/static/src/img/hhs_foot.png" alt="img" style="width=100%;"/>
