<?xml version="1.0" encoding ="utf-8" ?>
<odoo>
	 <record id="print_job_card_receipt_template_document" model="ir.actions.report">
		 <field name="name">Proforma Invoice</field>
		 <field name="model">project.task</field>
		 <field name="report_type">qweb-pdf</field>
		 <field name="report_name">machine_repair_management.job_card_receipt_document_template</field>
		 <field name="report_file">machine_repair_management.job_card_receipt_document_template</field>
		 <field name="paperformat_id" ref="machine_repair_management.job_card_report_paperformat_id"/>
		 <field name="binding_type">report</field>
	</record>

    <template id="job_card_receipt_print_document_template_internal_layout">
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
          <t t-raw="0"/>
        </div>
    </template>

   <template id="job_card_receipt_document_template">
    <t t-call="web.html_container">
        <t t-foreach="jobs" t-as="doc">

            <t t-call="machine_repair_management.job_card_receipt_print_document_template_internal_layout">

                <!-- ========================= HEADER ========================= -->
                <div class="header" t-att-style="report_header_style">

                    <div class="row mt32 mb32">

                        <div class="col-4 text-left">
                            <img
                                src="machine_repair_management/static/src/img/HHS_Header_Left.png"
                                alt="img"
                                style="height: 120px; width: 350px;"
                            />
                        </div>

                        <div class="col-4 text-center"
                             style="vertical-align:text-top;">

                            <img
                                t-if="res_company.logo"
                                t-att-src="image_data_uri(res_company.logo)"
                                style="
                                    max-height: 100px;
                                    min-height:100px;
                                    min-width: 200px;
                                    max-width: 200px;
                                "
                            />

                        </div>

                        <div class="col-4 text-right"
                             style="
                                vertical-align:text-top;
                                text-align:right;
                             ">

                            <img
                                src="machine_repair_management/static/src/img/HHS_Header_Right.png"
                                alt="img"
                                style="height: 120px; width: 350px;"
                            />

                        </div>

                    </div>

                    <h2>
                        <center style="font-size:35px;">
                            Proforma Invoice / الفاتورة المبدئية
                        </center>
                    </h2>

                </div>


                <!-- ========================= PAGE ========================= -->

                <div class="page"
                     style="
                        page-break-after: always;
                        font-size:16px !important;
                     ">

                    <!-- ===================================================== -->
                    <!-- SAME FONT STYLE AS PREVIOUS XML                      -->
                    <!-- ===================================================== -->

                    <style>

                        .job-card-receipt-page,
                        .job-card-receipt-page table,
                        .job-card-receipt-page tbody,
                        .job-card-receipt-page thead,
                        .job-card-receipt-page tr,
                        .job-card-receipt-page td,
                        .job-card-receipt-page th,
                        .job-card-receipt-page span,
                        .job-card-receipt-page strong {
                            font-family: inherit !important;
                        }

                        .job-card-receipt-page,
                        .job-card-receipt-page td,
                        .job-card-receipt-page span {
                            font-size:16px !important;
                        }

                        .job-card-receipt-page strong,
                        .job-card-receipt-page td strong,
                        .job-card-receipt-page th strong {
                            font-size:18px !important;
                            font-weight:bold !important;
                        }

                        .job-card-receipt-page th {
                            font-size:17px !important;
                            font-weight:bold !important;
                        }

                    </style>


                    <div class="job-card-receipt-page">


                        <!-- ================= CUSTOMER DETAILS ================= -->

                        <div class="row mt32 mb32">

                            <!-- LEFT COLUMN -->

                            <div class="col-6">

                                <table class="table table-bordered border-dark"
                                       style="
                                           margin:0;
                                           border-collapse:collapse;
                                       ">

                                    <colgroup>
                                        <col width="30%"/>
                                        <col width="40%"/>
                                        <col width="30%"/>
                                    </colgroup>

                                    <tbody>

                                        <tr>

                                            <td>
                                                <strong>
                                                    Warehouse:
                                                </strong>
                                            </td>

                                            <td>
                                                <span
                                                    t-if="doc['warehouse_id']"
                                                    t-esc="doc['warehouse_id']"
                                                />
                                            </td>

                                            <td style="text-align:right;">
                                                <strong>
                                                    : مستودع
                                                </strong>
                                            </td>

                                        </tr>


                                        <tr>

                                            <td>
                                                <strong>
                                                    Customer Name:
                                                </strong>
                                            </td>

                                            <td>
                                                <span
                                                    t-if="doc['customer_name']"
                                                    t-esc="doc['customer_name']"
                                                />
                                            </td>

                                            <td style="text-align:right;">
                                                <strong>
                                                    :اسم العميل
                                                </strong>
                                            </td>

                                        </tr>


                                        <tr>

                                            <td>
                                                <strong>
                                                    Customer Address:
                                                </strong>
                                            </td>

                                            <td>
                                                <span
                                                    t-if="doc['address']"
                                                    t-esc="doc['address']"
                                                />
                                            </td>

                                            <td style="text-align:right;">
                                                <strong>
                                                    : عنوان العميل
                                                </strong>
                                            </td>

                                        </tr>


                                        <tr>

                                            <td>
                                                <strong>
                                                    VAT No.:
                                                </strong>
                                            </td>

                                            <td>
                                                <span
                                                    t-if="doc['vat']"
                                                    t-esc="doc['vat']"
                                                />
                                            </td>

                                            <td style="text-align:right;">
                                                <strong>
                                                    :الرقم الضريبي
                                                </strong>
                                            </td>

                                        </tr>


                                        <tr>

                                            <td>
                                                <strong>
                                                    Job Card No.:
                                                </strong>
                                            </td>

                                            <td>
                                                <span
                                                    t-if="doc['job_card_no']"
                                                    t-esc="doc['job_card_no']"
                                                />
                                            </td>

                                            <td style="text-align:right;">
                                                <strong>
                                                    :رقم بطاقة العمل
                                                </strong>
                                            </td>

                                        </tr>


                                        <tr>

                                            <td>
                                                <strong>
                                                    Remarks:
                                                </strong>
                                            </td>

                                            <td colspan="5">
                                                <span
                                                    t-if="doc['remarks']"
                                                    t-esc="doc['remarks']"
                                                />
                                            </td>

                                        </tr>

                                    </tbody>

                                </table>

                            </div>


                            <!-- RIGHT COLUMN -->

                            <div class="col-6">

                                <table class="table table-bordered border-dark"
                                       style="
                                           margin:0;
                                           border-collapse:collapse;
                                       ">

                                    <colgroup>
                                        <col width="38%"/>
                                        <col width="32%"/>
                                        <col width="30%"/>
                                    </colgroup>

                                    <tbody>


                                        <tr>

                                            <td>
                                                <strong>
                                                    Proforma Invoice No:
                                                </strong>
                                            </td>

                                            <td>
                                                <span
                                                    t-if="doc['invoice_no']"
                                                    t-esc="doc['invoice_no']"
                                                />
                                            </td>

                                            <td style="text-align:right;">
                                                <strong>
                                                    :رقم الفاتورة المبدئية
                                                </strong>
                                            </td>

                                        </tr>


                                        <tr>

                                            <td>
                                                <strong>
                                                    Proforma Invoice Date:
                                                </strong>
                                            </td>

                                            <td>
                                                <span
                                                    t-if="doc['invoice_date']"
                                                    t-esc="doc['invoice_date']"
                                                    t-options='{"widget": "date","format": "dd-MM-yyyy"}'
                                                />
                                            </td>

                                            <td style="text-align:right;">
                                                <strong>
                                                    :تاريخ الفاتورة المبدئية
                                                </strong>
                                            </td>

                                        </tr>


                                        <tr>

                                            <td>
                                                <strong>
                                                    Technician Name:
                                                </strong>
                                            </td>

                                            <td>
                                                <span
                                                    t-if="doc['technician_name']"
                                                    t-esc="doc['technician_name']"
                                                />
                                            </td>

                                            <td style="text-align:right;">
                                                <strong>
                                                    :اسم الفني
                                                </strong>
                                            </td>

                                        </tr>


                                        <tr>

                                            <td>
                                                <strong>
                                                    Model No:
                                                </strong>
                                            </td>

                                            <td>
                                                <span
                                                    t-if="doc['model_no']"
                                                    t-esc="doc['model_no']"
                                                />
                                            </td>

                                            <td style="text-align:right;">
                                                <strong>
                                                    :رقم الموديل
                                                </strong>
                                            </td>

                                        </tr>


                                        <tr>

                                            <td>
                                                <strong>
                                                    Serial No:
                                                </strong>
                                            </td>

                                            <td>
                                                <span
                                                    t-if="doc['serial_no']"
                                                    t-esc="doc['serial_no']"
                                                />
                                            </td>

                                            <td style="text-align:right;">
                                                <strong>
                                                    :الرقم التسلسلي
                                                </strong>
                                            </td>

                                        </tr>


                                        <tr>

                                            <td>
                                                <strong>
                                                    Customer A/c:
                                                </strong>
                                            </td>

                                            <td>
                                                <span
                                                    t-if="doc['customer_no']"
                                                    t-esc="doc['customer_no']"
                                                />
                                            </td>

                                            <td style="text-align:right;">
                                                <strong>
                                                    رقم حساب العميل
                                                </strong>
                                            </td>

                                        </tr>


                                        <tr>

                                            <td>
                                                <strong>
                                                    VAT Registration:
                                                </strong>
                                            </td>

                                            <td>
                                                <span
                                                    t-if="doc['company_vat']"
                                                    t-esc="doc['company_vat']"
                                                />
                                            </td>

                                            <td style="text-align:right;">
                                                <strong>
                                                    : ضريبة القيمة المضافة
                                                </strong>
                                            </td>

                                        </tr>


                                    </tbody>

                                </table>

                            </div>

                        </div>


                        <!-- ================= PRODUCT TABLE ================= -->

                        <table class="table table-bordered border-dark"
                               style="
                                   margin-bottom:2px;
                                   padding-bottom:2px;
                               ">

                            <thead>

                                <tr style="text-align:center;">

                                    <th width="2%"
                                        style="vertical-align:text-top;">
                                        <strong>
                                            تسلسل
                                        </strong>
                                        <br/>
                                        <strong>
                                            S/N
                                        </strong>
                                    </th>


                                    <th width="8%"
                                        style="vertical-align:text-top;">
                                        <strong>
                                            فئة الصنف
                                        </strong>
                                        <br/>
                                        <strong>
                                            Stock Group
                                        </strong>
                                    </th>


                                    <th width="10%"
                                        style="vertical-align:text-top;">
                                        <strong>
                                            رقم الصنف
                                        </strong>
                                        <br/>
                                        <strong>
                                            Stock Number
                                        </strong>
                                    </th>


                                    <th width="29%"
                                        style="vertical-align:text-top;">
                                        <strong>
                                            الوصف
                                        </strong>
                                        <br/>
                                        <strong>
                                            Description
                                        </strong>
                                    </th>


                                    <th width="5%"
                                        style="vertical-align:text-top;">
                                        <strong>
                                            الكمية
                                        </strong>
                                        <br/>
                                        <strong>
                                            Qty
                                        </strong>
                                    </th>


                                    <th width="6%"
                                        style="vertical-align:text-top;">
                                        <strong>
                                            سعر الوحدة
                                        </strong>
                                        <br/>
                                        <strong>
                                            Unit Price
                                        </strong>
                                    </th>


                                    <th width="6%"
                                        style="vertical-align:text-top;">
                                        <strong>
                                            خصم الوحدة
                                        </strong>
                                        <br/>
                                        <strong>
                                            Unit Discount
                                        </strong>
                                    </th>


                                    <th width="7%"
                                        style="vertical-align:text-top;">
                                        <strong>
                                            سعر الوحدة الصافي
                                        </strong>
                                        <br/>
                                        <strong>
                                            Net Unit Price
                                        </strong>
                                    </th>


                                    <th width="7%"
                                        style="vertical-align:text-top;">
                                        <strong>
                                            السعر الإجمالي
                                        </strong>
                                        <br/>
                                        <strong>
                                            Extended Price
                                        </strong>
                                    </th>


                                    <th width="6%"
                                        style="vertical-align:text-top;">
                                        <strong>
                                            نسبة الضريبة
                                        </strong>
                                        <br/>
                                        <strong>
                                            Vat %
                                        </strong>
                                    </th>


                                    <th width="7%"
                                        style="vertical-align:text-top;">
                                        <strong>
                                            قيمة الضريبة
                                        </strong>
                                        <br/>
                                        <strong>
                                            Vat Amount
                                        </strong>
                                    </th>


                                    <th width="7%"
                                        style="vertical-align:text-top;">
                                        <strong>
                                            الإجمالي
                                        </strong>
                                        <br/>
                                        <strong>
                                            Amount
                                        </strong>
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                <t t-set="counter" t-value="1"/>


                                <t t-foreach="product_lines" t-as="product">

                                    <tr>

                                        <td class="text-right">
                                            <span t-esc="counter"/>
                                        </td>


                                        <td>
                                            <span
                                                t-esc="product['stock_group']"
                                            />
                                        </td>


                                        <td class="text-right">
                                            <span
                                                t-esc="product['stock_number']"
                                            />
                                        </td>


                                        <td>
                                            <span
                                                t-esc="product['description']"
                                            />
                                        </td>


                                        <td class="text-right"
                                            style="text-align:right;">
                                            <span
                                                t-esc="product['qty']"
                                            />
                                        </td>


                                        <td style="text-align:right;">
                                            <span
                                                t-esc="product['unit_price']"
                                                t-options="{'widget': 'float', 'precision': 2}"
                                            />
                                        </td>


                                        <td>
                                            <span
                                                t-esc="product['unit_discount']"
                                            />
                                        </td>


                                        <td class="text-right"
                                            style="text-align:right;">
                                            <span
                                                t-esc="product['net_unit_price']"
                                                t-options="{'widget': 'float', 'precision': 2}"
                                            />
                                        </td>


                                        <td class="text-right"
                                            style="text-align:right;">
                                            <span
                                                t-esc="product['extended_price']"
                                                t-options="{'widget': 'float', 'precision': 2}"
                                            />
                                        </td>


                                        <td class="text-right"
                                            style="text-align:right;">

                                            <span
                                                t-esc="product['vat_percent']"
                                            />
                                            %

                                        </td>


                                        <td class="text-right"
                                            style="text-align:right;">

                                            <span
                                                t-esc="product['vat_amount']"
                                                t-options="{'widget': 'float', 'precision': 2}"
                                            />

                                        </td>


                                        <td class="text-right"
                                            style="text-align:right;">

                                            <span
                                                t-esc="product['total']"
                                                t-options="{'widget': 'float', 'precision': 2}"
                                            />

                                        </td>

                                    </tr>


                                    <t t-set="counter"
                                       t-value="counter+1"/>

                                </t>


                                <!-- ================= TOTALS ================= -->

                                <t t-foreach="totals" t-as="total">

                                    <tr>

                                        <td colspan="8"
                                            style="text-align:right;">

                                            <strong>
                                                Total
                                            </strong>

                                        </td>


                                        <td style="text-align:right;">

                                            <strong>

                                                <span
                                                    t-esc="total['total_extended_price']"
                                                    t-options="{'widget': 'float', 'precision': 2}"
                                                />

                                            </strong>

                                        </td>


                                        <td/>


                                        <td style="text-align:right;">

                                            <strong>

                                                <span
                                                    t-esc="total['total_vat_amt']"
                                                    t-options="{'widget': 'float', 'precision': 2}"
                                                />

                                            </strong>

                                        </td>


                                        <td rowspan="2"
                                            style="text-align:right;">

                                            <strong>

                                                <span
                                                    t-esc="total['grand_total']"
                                                    t-options="{'widget': 'float', 'precision': 2}"
                                                />

                                            </strong>

                                        </td>

                                    </tr>


                                    <tr>

                                        <td colspan="8"
                                            style="text-align:right;">

                                            <strong>
                                                Inspection Charges Amount Received/المبلغ المستلم مقابل رسوم الفحص
                                            </strong>

                                        </td>


                                        <td colspan="10"
                                            style="text-align:right;">

                                            <strong>

                                                <span
                                                    t-esc="total['inspection_charges_amount_received']"
                                                    t-options="{'widget': 'float', 'precision': 2}"
                                                />

                                            </strong>

                                        </td>

                                    </tr>


                                    <tr>

                                        <td colspan="8"
                                            style="text-align:right;">

                                            <strong>
                                                Balance To Be Paid/الرصيد المستحق
                                            </strong>

                                        </td>


                                        <td colspan="10"
                                            style="text-align:right;">

                                            <strong>

                                                <span
                                                    t-esc="total['balance_paid']"
                                                    t-options="{'widget': 'float', 'precision': 2}"
                                                />

                                            </strong>

                                        </td>

                                    </tr>


                                    <tr>

                                        <td colspan="12"
                                            style="text-align:right;">

                                            <strong>

                                                <span
                                                    t-esc="total['amount_words']"
                                                />

                                                Only

                                            </strong>

                                        </td>

                                    </tr>

                                </t>

                            </tbody>

                        </table>

                    </div>

                </div>


                <!-- ========================= FOOTER ========================= -->

                <div class="footer">

                    <img
                        src="machine_repair_management/static/src/img/JobCard_Footer_img.png"
                        style="width:100%;"
                    />

                </div>

            </t>

        </t>
    </t>
</template>

	
</odoo>
