<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- "Loyalty Dashboards" container menu under PBI Dashboards root -->
        <menuitem id="menu_pbi_loyalty_dashboards"
                  name="Loyalty Dashboards"
                  parent="pbi_dashboards.pbi_dashboards_app_root"
                  sequence="30"/>

        <!-- Loyalty Analysis -->
        <record id="action_pbi_loyalty_dashboard" model="ir.actions.client">
            <field name="name">Loyalty Analysis</field>
            <field name="tag">pbi_dashboards.loyalty_dashboard</field>
        </record>

        <menuitem id="menu_pbi_loyalty_analysis"
                  name="Loyalty Analysis"
                  parent="pbi_loyalty_dashboards.menu_pbi_loyalty_dashboards"
                  sequence="10"
                  action="pbi_loyalty_dashboards.action_pbi_loyalty_dashboard"/>

        <!-- Loyalty Customers Sales Analysis -->
        <record id="action_pbi_sales_analysis" model="ir.actions.client">
            <field name="name">Loyalty Customers Sales Analysis</field>
            <field name="tag">pbi_dashboards.sales_analysis_dashboard</field>
        </record>

        <menuitem id="menu_pbi_sales_analysis"
                  name="Loyalty Customers Sales Analysis"
                  parent="pbi_loyalty_dashboards.menu_pbi_loyalty_dashboards"
                  sequence="20"
                  action="pbi_loyalty_dashboards.action_pbi_sales_analysis"/>
    </data>
</odoo>
