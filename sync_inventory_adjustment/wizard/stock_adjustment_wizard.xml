<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="stock_adjustment_report_views" model="ir.ui.view">
            <field name="name">stock.adjustment.report.wizard.form</field>
            <field name="model">stock.adjustment.report</field>
            <field name="arch" type="xml">
                <form string="Stock Adjustment Report">
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group>
                        <group>
<!--                            <field name = "warehouse_ids"   domain="[('company_id', '=', company_id)]"/>-->
                            <field name = "company_id" invisible = "1"/>
                            <field name = "location_id" options="{'no_create': True, 'no_create_edit':True}"/>
                            <field name = "category_id" options="{'no_create': True, 'no_create_edit':True}"/>
                            <field name = "product_ids"  widget = "many2many_tags" options="{'no_create': True, 'no_create_edit':True}"/>
                        </group>
					<!--<group>
                            <field name="to_collapse"/>
                        </group> -->
                    </group>
                    <footer>
                        <button name="pdf_generate_report" string = "PDF" type = "object" class = "btn-primary" data-hotkey="q"/>
<!--
                        <button name="print_report_xls" string = "XLS" type = "object" class = "oe_highlight" />
-->
                        <button string="Cancel" class = "btn-secondary" special = "cancel" data-hotkey = "z" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_stock_adjustment_report" model="ir.actions.act_window">
            <field name="name">Stock Adjustment Report</field>
            <field name="res_model">stock.adjustment.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_stock_adjustment_report" name="Stock Adjustment Report" action="action_stock_adjustment_report" parent="stock.menu_warehouse_report" sequence="2"/>

</odoo>
