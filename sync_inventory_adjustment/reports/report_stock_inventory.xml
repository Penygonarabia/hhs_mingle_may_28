<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_inventory_internal_layout">
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
          <t t-raw="0"/>
        </div>
    </template>

    <template id="report_inventory">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="sync_inventory_adjustment.report_inventory_internal_layout" style="margin-top:0px;padding-top:0px;display:inline;">
                   
                   
                    <div class="header" t-att-style="report_header_style">
                        <div class="o_boxed_header">
                            <table width="100%">
                                <tr>
                                    <div>
                                        <h1 style="font-weight:bold;text-align:center;font-size:15px"><span t-esc="res_company.name"/></h1>
                                        <img t-if="res_company.logo" t-att-src="'data:image/png;base64,%s' %res_company.logo"/>

<!--
                                        <img class="img" src="/sync_inventory_adjustment/static/img/image.png"
                                            style="max-height: 90px; min-height:90px;float:right" alt="Logo"/>
-->
                                    </div>
                                    <div class="col-6">
                                        <h3 style="font-weight:bold;font-size:22px">Stock Adjustment</h3>
                                    </div>
                                    <div class="row">
                                        <div class="col-3">
                                            <strong style="font-weight:bold;"><b>Reference : </b><span t-field="o.name"/></strong>
                                        </div>
                                        <div class="col-3">
                                            <strong style="font-weight:bold;"><b>Date : </b><span t-field="o.date" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/></strong>
                                        </div>
                                        <div class="col-3">
                                            <strong style="font-weight:bold;"><b>Created by : </b><span t-field="o.create_uid"/></strong>
                                        </div>
<!--                                        <t t-if="o.remarks">-->
<!--                                            <div class="col-3">-->
<!--                                                <strong><b>Remarks: </b><span t-field="o.remarks"/></strong>-->
<!--                                            </div>-->
<!--                                        </t>-->
                                    </div>
<!--                                    <div class="row col-9">-->
<!--                                        <t t-if="o.remarks">-->
<!--                                            <strong><b>Remarks :&#160;</b><span t-field="o.remarks" style="white-space: normal;"/></strong>-->
<!--                                        </t>-->
<!--                                    </div>-->
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="page">
<!--                        <br/>-->
<!--                        <h2>Stock Inventory</h2>-->

<!--                        <table class="table table-sm">-->
<!--                        <thead>-->
<!--                            <tr>-->
<!--                                <th><strong>Inventory</strong></th>-->
<!--                                <th><strong>Date</strong></th>-->
<!--                            </tr>-->
<!--                        </thead>-->
<!--                        <tbody>-->
<!--                            <tr>-->
<!--                                <td>-->
<!--                                    <span t-field="o.name"/>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <span t-field="o.date"/>-->
<!--                                </td>-->
<!--                            </tr>-->
<!--                        </tbody>-->
<!--                        </table>-->

                        <t t-set="locations" t-value="o.line_ids.mapped('location_id')"/>
                        <table class="table table-sm table-bordered" style="table-layout: fixed;">
                            <thead>
                                <tr style="background-color:#464343;color:white;text-align:center;">
                                    <th style="vertical-align: text-top;" width="9%"  class="text-center" groups="stock.group_stock_multi_locations"><strong>Location</strong></th>
                                    <th style="vertical-align: text-top;" width="20%" class="text-center"><strong>Product</strong></th>
                                    <th style="vertical-align: text-top;" width="11%" class="text-center" groups="stock.group_production_lot"><strong>Production<br/> Lot</strong></th>
                                    <th style="vertical-align: text-top;" width="11%" class="text-center" groups="stock.group_tracking_lot"><strong>Package</strong></th>
                                    <th style="vertical-align: text-top;" width="8%"  class="text-center"><strong>UOM</strong></th>
                                    <th style="vertical-align: text-top;" width="10%" class="text-center"><strong>On Hand <br/>Qty</strong></th>
                                    <th style="vertical-align: text-top;" width="10%" class="text-center"><strong>Counted<br/> Qty</strong></th>
                                    <th style="vertical-align: text-top;" width="10%" class="text-center"><strong>Adjusted<br/> Qty</strong></th>
                                    <th style="vertical-align: text-top;" width="10%" class="text-center"><strong>Reason</strong></th>
                                    <th style="vertical-align: text-top;" width="10%" class="text-center"><strong>Remarks</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="locations" t-as="location">
                                    <tr groups="stock.group_stock_multi_locations">
                                        <td colspan="3"><strong t-esc="location.display_name"/></td>
<!--                                        <td groups="stock.group_production_lot"></td>-->
<!--                                        <td groups="stock.group_tracking_lot"></td>-->
                                    </tr>
                                    <tr style="font-size:13px"  t-foreach="o.line_ids.filtered(lambda line: line.location_id.id == location.id)" t-as="line">
<!--                                        <td groups="stock.group_stock_multi_locations"></td>-->
                                        <td colspan="2"><span t-field="line.product_id"/></td>
                                        <td groups="stock.group_production_lot"><span t-field="line.prod_lot_id"/></td>
                                        <td groups="stock.group_tracking_lot"><span t-field="line.package_id"/></td>
                                        <td class="text-left"> <span t-field="line.product_uom_id"/></td>
                                        <td class="text-right"><span t-field="line.theoretical_qty"/></td>
                                        <td class="text-right"><span t-field="line.product_qty"/> </td>
                                        <td class="text-right">
                                            <span t-esc="line.product_qty - line.theoretical_qty" t-if="line.product_qty or line.theoretical_qty" t-options='{"widget": "float", "precision": 2}'/>
                                        </td>
                                        <td class="text-left"><span t-field="line.reason_id"/> </td>
                                        <td class="text-left"><span t-field="line.remarks"/> </td>


                                    </tr>
                                </t>
                                <t>
                                    <tr style="font-size:13px">
                                        <td><b>Remarks</b></td>
                                        <td colspan="8"><span t-field="o.remarks" style="white-space: normal;"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-if="o.filter == 'product' and o.product_id">
                          <div class="row justify-content-end">
                            <div class="col-4">
                                 <table class="table table-sm">
                                    <tr class="border-black">
                                        <td><strong>Total Quantity</strong></td>
                                        <td class="text-right">
                                            <span t-field="o.total_qty"/> <span t-field="o.product_id.uom_id"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                          </div>
                        </t>
                    </div>
                    <div class="footer o_background_footer">
                        <div class="text-center">
                            <ul class="list-inline">
                                    <li><strong>Printed by : </strong><span t-esc="request.env.user.name"/><span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')" style="padding-left:2em;"/></li>
                                </ul>
                            <div t-if="report_type == 'pdf'" class="text-muted">
                                Page:
                                <span class="page"/>
                                of
                                <span class="topage"/>
                            </div>
                        </div>
                    </div>
                </t>
             </t>
         </t>
    </template>

    <record id="action_report_inventory" model="ir.actions.report">
        <field name="name">Inventory</field>
        <field name="model">stock.inventory</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sync_inventory_adjustment.report_inventory</field>
        <field name="report_file">sync_inventory_adjustment.report_inventory</field>
        <field name="print_report_name">'Inventory - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_stock_inventory"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
