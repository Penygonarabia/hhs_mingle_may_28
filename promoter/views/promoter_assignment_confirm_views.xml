<!-- views/promoter_assignment_confirm_views.xml -->
<record id="view_promoter_assignment_confirm_form" model="ir.ui.view">
    <field name="name">promoter.assignment.confirm.form</field>
    <field name="model">promoter.assignment.confirm</field>
    <field name="arch" type="xml">
        <form string="Override Assignment?">
            <group>
                <field name="overlapping_ids" readonly="1"/>
                <field name="new_assignment_id" invisible="1"/>
            </group>
            <footer>
                <button string="Yes, Override" type="object" name="action_confirm_override" class="btn-primary"/>
                <button string="No" special="cancel" class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>
