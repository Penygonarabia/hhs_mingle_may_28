<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_promoter" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.promoter</field>
        <field name="model">res.config.settings</field>

        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Promoter" string="Promoter" name="promoter_settings"
                     data-key="promoter" logo="/promoter/static/description/location_maker.png" >
        <!-- <field name="inherit_id" ref="machine_repair_management.res_config_settings_service_module_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside"> -->
            <!-- <xpath expr="//div[contains(@class,'settings_tab')]" position="inside"> -->
                <div class="app_settings_block" data-string="Promoter Settings" string="Promoter Settings">
                    <h2>Promoter Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="validate_geo_location"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="validate_geo_location"/>
                                <div class="text-muted">
                                    Enable this option to validate geo-location during promoter sales operations.
                                </div>
                            </div>
                               <!-- Promoter WFO Radius -->
                               <div class="row mt16">
                                    <label for="promoter_wfo_radius"/>
                                    <field name="promoter_wfo_radius"/>
                               </div>                            
                            <div class="o_setting_box">
                            <div class="o_setting_left_pane">
                            <field name="show_promoter_menu"/>
                            </div>
                           <div class="o_setting_right_pane">
                                <label for="show_promoter_menu"/>
                                <div class="text-muted">
                                    Tick this to show or hide the Promoter menu in the backend.
                                </div>
                            </div>
                            </div>
                        </div>
                    </div>
                </div>
               </app>
            </xpath>
        </field>
    </record>
</odoo>
