<odoo>
    <!-- Tree View -->
    <record id="view_promoter_shop_status_tree" model="ir.ui.view">
        <field name="name">promoter.shop.status.tree</field>
        <field name="model">promoter.shop.status</field>
        <field name="arch" type="xml">
            <tree>
                <!-- <field name="name"/> -->
                <field name="dealer_id"/>
                <field name="showroom_id" />
                <field name="assignment_id" />
                <field name="date_time"/>
                <field name="notes"/>
                <field name="priority"/>
            </tree>
        </field>
    </record>

    <!-- 2️⃣ Search View -->
<record id="view_promoter_shop_status_search" model="ir.ui.view">
    <field name="name">promoter.shop.status.search</field>
    <field name="model">promoter.shop.status</field>
    <field name="arch" type="xml">
        <search string="Search Shop Status">
            <field name="dealer_id" string="Dealer"/>
            <field name="showroom_id" string="Showroom"/>
            <field name="assignment_id" string="Promoter"/>

            <separator/>

            <group expand="0" string="Group By">
                <filter name="group_dealer" string="Dealer" context="{'group_by': 'dealer_id'}"/>
                <filter name="group_showroom" string="Showroom" context="{'group_by': 'showroom_id'}"/>
                <filter name="group_promoter" string="Promoter" context="{'group_by': 'assignment_id'}"/>
            </group>
        </search>
    </field>
</record>

    <!-- Form View -->
    <record id="view_promoter_shop_status_form" model="ir.ui.view">
        <field name="name">promoter.shop.status.form</field>
        <field name="model">promoter.shop.status</field>
        <field name="arch" type="xml">
            <form js_class="promoter_sales_redirect_form">
             <sheet>
                <group class="deskvw">                    
                    <field name="dealer_id" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                    <field name="showroom_id" domain="[('dealer_id', '=', dealer_id)]" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                    <field name="assignment_id" domain="[('dealer_id', '=', dealer_id), ('showroom_id', '=', showroom_id)]" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>                 
                </group>
                <group  class="deskvw">                
                    <field name="date_time"/>                    
                    <field name="notes"/>
                    <field name="priority"/>
                    <field name="attachment_ids" widget="many2many_binary"/>                   
                    <field name ="promoter_mobile_user_bool" invisible="1"/>
                    <field name ="promoter_access_bool" invisible="1" />
                </group>
                 <group  class="mobvw">                
                    <field name="date_time"/>                    
                    <!-- <field name="notes"/>
                    <field name="priority"/>
                    <field name="attachment_ids" widget="many2many_binary"/>     -->
                    <div style="font-size:15px;font-weight:bold;color: #070808ff;">Notes</div>
                    <div class="o_attachment col-12" width="100%">
                        <field name="notes" style="background-color: #f6fbfd; border-radius: 8px; padding: 6px;"/>
                    </div>
                    <field name="priority"/>
                    <div style="font-size:15px;font-weight:bold;color: #070808ff;">Attachments</div>
                    <div  width="70%" height="400px">
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </div>               
                    <field name ="promoter_mobile_user_bool" invisible="1"/>
                    <field name ="promoter_access_bool" invisible="1" />
                </group>
                 </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

        <!-- Kanban View -->
    <record id="view_promoter_shop_status_kanban" model="ir.ui.view">
        <field name="name">promoter.shop.status.kanban</field>
        <field name="model">promoter.shop.status</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="dealer_id"/>
                <field name="showroom_id"/>
                <field name="assignment_id"/>
                <field name="date_time"/>
                <field name="priority"/>
                <field name="notes"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_card">
                            <div>
                                <strong><field name="assignment_id"/></strong>
                            </div>
                            <div>
                                Dealer: <field name="dealer_id"/>
                            </div>
                            <div>
                                Showroom: <field name="showroom_id"/>
                            </div>
                            <div>
                                Date/Time: <field name="date_time"/>
                            </div>
                            <div>
                                Priority: <field name="priority"/>
                            </div>
                            <div>
                                Notes:<small><field name="notes"/></small>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


     <!-- Kanban View -->
    <record id="view_promoter_shop_status_kanban_mob" model="ir.ui.view">
        <field name="name">promoter.shop.status.kanban</field>
        <field name="model">promoter.shop.status</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_card  oe_kanban_global_click">
                            <div>
                                <strong><field name="date_time"/></strong>
                            </div>
                            <div>
                                Notes: <field name="notes"/>
                            </div>                            
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

           <record id="view_promoter_shop_status_form_noduplicate" model="ir.ui.view">
                <field name="name">promoter.shop.status.form.noduplicate</field>
                <field name="model">promoter.shop.status</field>
                <field name="inherit_id" ref="promoter.view_promoter_shop_status_form"/>
                <field name="arch" type="xml">
                    <xpath expr="//form" position="attributes">
                        <attribute name="duplicate">false</attribute>
                    </xpath>
                </field>
            </record>

    <!-- Action Window -->
    <record id="action_promoter_shop_status" model="ir.actions.act_window">
        <field name="name">Review Shop Status</field>
        <field name="res_model">promoter.shop.status</field>
        <field name="view_mode">tree,form,kanban</field>   
        <field name="search_view_id" ref="view_promoter_shop_status_search"/>        
    </record>


    <menuitem id="menu_promoter_shop_status_root"
              name="Review Shop Status"
              parent="menu_promoter_root"
              action="action_promoter_shop_status"
              sequence="30"/>

    <!-- =====================
         ACTION & MENU
    ====================== -->
    <record id="action_promoter_status_mobile" model="ir.actions.act_window">
        <field name="name">Update Shop Status</field>
        <field name="res_model">promoter.shop.status</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="view_promoter_shop_status_kanban_mob"/> 
         <field name="domain">[('user_id', '=', uid)]</field>       
    </record>

    <menuitem id="menu_promoter_status_mobile"
              name="Update Shop Status"
              parent="menu_promoter_root"
              action="action_promoter_status_mobile"
              groups="promoter.group_promoter_user"
              sequence="70"/>


        <!-- =========================
         RECORD RULES
    ========================== -->
    <!-- Mobile users: only own records -->
    <record id="promoter_showroom_status_rule_user" model="ir.rule">
        <field name="name">Promoter Status: only own records</field>
        <field name="model_id" ref="model_promoter_shop_status"/>
        <field name="groups" eval="[(4, ref('promoter.group_promoter_user'))]"/>
       
    </record>

    <!-- Back-office users: all records -->
    <record id="promoter_showroom_status_rule_backoffice" model="ir.rule">
        <field name="name">Promoter Status: all records</field>
        <field name="model_id" ref="model_promoter_shop_status"/>
        <field name="groups" eval="[(4, ref('promoter.group_promoter_backoffice_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
