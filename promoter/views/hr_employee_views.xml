<odoo>
    <record id="view_hr_employee_form_inherit_promoter" model="ir.ui.view">
        <field name="name">hr.employee.form.promoter</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Add Is Promoter checkbox after Manager -->
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="is_promoter"/>                
            </xpath>
        </field>
    </record>
</odoo>
