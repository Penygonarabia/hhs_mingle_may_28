        <!--                                <t t-foreach="doc.expense_ids" t-as="expense">-->
        <!--                                    <tr>-->
        <!--                                        <td><span t-esc="forloop.counter"/></td>-->
        <!--                                        <td><span t-esc="expense.product_id.name"/></td>-->
        <!--                                        <td><span t-esc="expense.date"/></td>-->
        <!--                                        <td><span t-esc="expense.name"/></td>-->
        <!--                                        <td><span t-esc="expense.total_amount"/></td>-->
        <!--                                        <td><span t-esc="expense.payment_mode"/></td>-->
        <!--                                        <td><span t-esc="expense.state"/></td>-->
        <!--                                    </tr>-->
        <!--                                </t>-->
        <!--                            </tbody>-->
        <!--                        </table>-->

                        </t>
                    </div>
        </t>
        </t>
    </template>
</odoo>
