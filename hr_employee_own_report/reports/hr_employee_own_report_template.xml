<!-- custom_addons/hr_employee_own_report/reports/hr_employee_own_report_template.xml -->
<odoo>
        <template id="employee_own_report_template_internal_layout">
            <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
              <t t-raw="0"/>
            </div>
        </template>

        <!-- Report Template -->
        <template id="employee_own_report_template">
            <t t-call="web.html_container">
                <t t-call="hr_employee_own_report.employee_own_report_template_internal_layout" style="margin-top:0px;padding-top:0px;display:inline;">
                    <div class="header" t-att-style="report_header_style">
                        <div class="row mt32 mb32">
                            <div class="col-3 text-left" style="font:12px lucida-console,sans-serif !important;">
                                <span t-field="res_company.partner_id"/>
                                <br/>
                                <span t-field="res_company.partner_id.street"/>
                                <br/>
                                <span t-field="res_company.partner_id.street2"/>
                                <br/>
                                <span t-field="res_company.partner_id.city"/>
                                <br/>
                                <span t-field="res_company.partner_id.country_id"/>
                                <br/>
                                <span t-field="res_company.partner_id.vat"/>
                                <br/>
                            </div>
                            <div class="col-6">
                                <h2><center>Employee Information</center></h2>

                            </div>
                            <div class="col-3 text-right " style="vertical-align:text-top">
               				    <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="max-height: 100px; min-height:100px; min-width: 150px; max-width: 150px;" />
            			    </div>
                        </div>
                    </div>
                    <div class="page">
        <!--                <h2>Employee Information</h2>-->
                        <t t-foreach="docs" t-as="doc">
                            <table class="table table-sm table-bordered" style="font-size:12px">
                                <tr style="background-color:gray;color:white;font-weight:bold;font-size:14px">

                                    <th colspan="12" class="text-center"><strong>PERSONAL INFORMATION</strong></th>
                                </tr>
                                <tr>
                                    <strong><th colspan="2" width="20%" class="text-left">Personal number</th></strong>
                                    <td colspan="2" width="20%" class="text-left"><span t-esc="doc.phone or ''"/></td>
                                    <th colspan="2" width="20%" class="text-left"><strong>Name</strong></th>
                                    <td colspan="2" width="20%" class="text-left"><span t-esc="doc.name or ''"/></td>
                                    <th colspan="1" width="10%" class="text-left"><strong>D.O.B</strong></th>
                                    <td colspan="3" width="30%" class="text-left"><span t-esc="doc.birthday or ''" t-options="{'widget': 'date'}"/></td>
                                </tr>
                                <tr>
                                    <th colspan="2" width="20%" class="text-left"><strong>Gender</strong></th>
                                    <td colspan="2" width="20%" class="text-left"><span t-esc="doc.gender or ''"/></td>
                                    <th colspan="2" width="20%" class="text-left"><strong>Nationality</strong></th>
                                    <td colspan="2" width="20%" class="text-left"><span t-esc="doc.country_id.name or ''"/></td>
                                    <th colspan="1" width="10" class="text-left"><strong>Marital Status</strong></th>
                                    <td colspan="3" width="30%" class="text-left"><span t-esc="doc.marital or ''"/></td>
                                </tr>
                                <tr>
                                    <th colspan="2" width="20%" class="text-left"><strong>Identification No</strong></th>
                                    <td colspan="2" width="20%" class="text-left"><span t-esc="doc.identification_id or ''"/></td>
                                    <th colspan="2" width="20%" class="text-left"><strong>Bank</strong></th>
                                    <td colspan="2" width="20%" class="text-left"><span t-esc="doc.bank_account_id.bank_id.name or ''"/></td>
                                    <th colspan="1" width="10%" class="text-left"><strong>Bank Account</strong></th>
                                    <td colspan="3" width="30%" class="text-left"><span t-esc="doc.bank_account_id.acc_number or ''"/></td>
                                </tr>
                            </table>
                            <table class="table table-sm table-bordered" style="font-size:12px">
                                <tr style="background-color:gray;color:white;font-weight:bold;font-size:14px">
                                    <th colspan="12" class="text-center"><strong>WORK INFORMATION</strong></th>
                                </tr>
                                <tr>
                                    <th colspan="1" width="10%" class="text-left"><strong>Report to</strong></th>
                                    <td colspan="3" width="30%" class="text-left"><span t-esc="doc.parent_id.name or ''"/></td>
                                    <th colspan="1" width="10%" class="text-left"><strong>Department</strong></th>
                                    <td colspan="3" width="25%" class="text-left"><span t-esc="doc.department_id.name or ''"/></td>
                                    <th colspan="1" width="10%" class="text-left"><strong>Job Position</strong></th>
                                    <td colspan="3" width="35%" class="text-left"><span t-esc="doc.job_id.name or ''"/></td>
                                </tr>
                                <tr>
                                    <th colspan="1" width="10%" class="text-left"><strong>Joining Date</strong></th>
                                    <td colspan="3" width="30%" class="text-left"><span t-esc="doc.joining_date or ''" t-options="{'widget': 'date'}"/></td>
                                    <th colspan="1" width="10%" class="text-left"><strong>Length of Service</strong></th>
                                    <td colspan="3" width="25%" class="text-left"><span t-esc="doc.contract_id.duration or ''"/></td>
                                    <th colspan="1" width="10%" class="text-left"><strong>Working Hours</strong></th>
                                    <td colspan="3" width="35%" class="text-left"><span t-esc="doc.resource_calendar_id.name or ''"/></td>
                                </tr>
                            </table>

                            <table class="table table-sm table-bordered" style="font-size:12px">
                                <tr style="background-color:gray;color:white;font-weight:bold;font-size:14px">
                                    <th colspan="12"  class="text-center"><strong>CONTACT INFORMATION</strong></th>
                                </tr>
                                <tr>
                                    <th colspan="2" width="20%" class="text-left"><strong>Work Email</strong></th>
                                    <td colspan="2" width="20%" class="text-left"><span t-esc="doc.work_email"/></td>
                                    <th colspan="2" width="20%" class="text-left"><strong>Work Phone</strong></th>
                                    <td colspan="2" width="20%" class="text-left"><span t-esc="doc.work_phone or ''"/></td>
                                    <th colspan="1" width="10%" class="text-left"><strong>Work Mobile</strong></th>
                                    <td colspan="3" width="30%" class="text-left"><span t-esc="doc.mobile_phone or ''"/></td>
                                </tr>
                                <tr>
                                    <th colspan="3" width="30%" class="text-left"><strong>Working Address:</strong></th>
                                    <td colspan="3" width="30%" class="text-left"><span t-esc="doc.address_id.name or ''"/></td>
                                    <th colspan="3" width="30%" class="text-left"><strong>Work Location</strong></th>
                                    <td colspan="3" width="30%" class="text-left"><span t-esc="doc.work_location_id.name or ''"/></td>
                                </tr>
                            </table>

                            <table class="table table-sm table-bordered" style="font-size:12px">
                                <tr style="background-color:gray;color:white;font-weight:bold;font-size:14px">
                                    <th colspan="12"  width="50%" class="text-center"><strong>ANNUAL LEAVE SUMMARY</strong></th>
                                </tr>
                                <tr>
                                    <th colspan="2" width="20%" class="text-left"><strong>Allocated Balance</strong></th>
                                    <td colspan="1" width="10%" class="text-right"><span  t-esc="doc.allocated_leaves"></span></td>
                                    <th colspan="2" width="20%" class="text-left"><strong>Taken Leaves</strong></th>
                                    <td colspan="2" width="20%" class="text-right"><span  t-esc="doc.taken_leaves"></span></td>
                                    <th colspan="2" width="20%" class="text-left"><strong>Remaining Balance</strong></th>
                                    <td colspan="3" width="30%" class="text-right"><span  t-esc="doc.remaining_leaves"/></td>
                                </tr>
                            </table>
                            <h4>Employee Transactions</h4>

                                <table class="table table-sm table-bordered" style="font-size:12px">
                                    <thead>
                                        <tr>
                                            <th style="background-color:gray;color:white;font-weight:bold;font-size:14px" colspan="12" class="text-center">Work History</th>
                                        </tr>
                                        <tr class="text-center">
        <!--                                    <th>#</th>-->
                                            <th>Name</th>
                                            <th>From</th>
                                            <th>To</th>
                                            <th>Department</th>
                                            <th>Job Position</th>
                                            <th>Wage</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.contract_ids" t-as="contract">
                                            <tr>
        <!--                                        <td><span t-esc="forloop.counter"/></td>-->
                                                <td><span t-esc="contract.name"/></td>
                                                <td><span t-esc="contract.date_start" t-options="{'widget': 'date'}"/></td>
                                                <td><span t-esc="contract.date_end" t-options="{'widget': 'date'}"/></td>
                                                <td><span t-esc="contract.department_id.name"/></td>
                                                <td><span t-esc="contract.job_id.name"/></td>
                                                <td class="text-right"><span t-esc="contract.wage"/></td>
                                                <td><span t-esc="contract.state"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>

                                <table class="table table-sm table-bordered" style="font-size:12px">
                                    <thead>
                                         <tr>
                                            <th style="background-color:gray;color:white;font-weight:bold;font-size:14px" colspan="12" class="text-center">Leaves History</th>
                                        </tr>
                                        <tr class="text-center">
                                            <th>#</th>
                                            <th>Type</th>
                                            <th>From</th>
                                            <th>To</th>
                                            <th>No of Days</th>
                                            <th>Description</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.leave_ids" t-as="leave">
                                            <tr>
                                                <td class="text-right"><span t-esc="leave_index+1"/></td>
                                                <td><span t-esc="leave.holiday_status_id.name"/></td>
                                                <td><span t-field="leave.date_from" t-options="{'widget': 'date'}"/></td>
                                                <td><span t-field="leave.date_to" t-options="{'widget': 'date'}"/></td>
                                                <td class="text-right"><span t-esc="leave.number_of_days"/></td>
                                                <td><span t-esc="leave.name"/></td>
                                                <td><span t-esc="leave.state"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>

                                <table class="table table-sm table-bordered" style="font-size:12px">
                                    <thead>
                                        <tr>
                                            <th style="background-color:gray;color:white;font-weight:bold;font-size:14px" colspan="12" class="text-center">Payslips History</th>
                                        </tr>
                                        <tr class="text-center">
                                            <th>#</th>
                                            <th>Name</th>
                                            <th>From</th>
                                            <th>To</th>
                                            <th>Wage</th>
                                            <th>Gross</th>
                                            <th>Net</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.slip_ids" t-as="slip">
                                            <tr>
                                                <td class="text-right"><t t-esc="slip_index+1"/></td>
                                                <td><span t-esc="slip.name"/></td>
                                                <td><span t-esc="slip.date_from" t-options="{'widget': 'date'}"/></td>
                                                <td><span t-esc="slip.date_to" t-options="{'widget': 'date'}"/></td>
                                                <td class="text-right"><span t-esc="slip.contract_id.wage"/></td>
                                                <td class="text-right">
                                                    <t t-foreach="slip.details_by_salary_rule_category" t-as="line">
                                                        <t t-if="line.code == 'GROSS'">
                                                            <span t-esc="line.total"/>
                                                        </t>
                                                    </t>
                                                </td>
                                                <td class="text-right">
                                                    <t t-foreach="slip.details_by_salary_rule_category" t-as="line">
                                                        <t t-if="line.code == 'NET'">
                                                            <span t-esc="line.total"/>
                                                        </t>
                                                    </t>
                                                </td>
                                                <td><span t-esc="slip.state"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>

        <!--                        <h5>Expenses History</h5>-->
        <!--                        <table class="table table-bordered">-->
        <!--                            <thead>-->
        <!--                                <tr>-->
        <!--                                    <th>#</th>-->
        <!--                                    <th>Category</th>-->
        <!--                                    <th>Date</th>-->
        <!--                                    <th>Description</th>-->
        <!--                                    <th>Amount</th>-->
