<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cus_desc_form" model="ir.ui.view">
        <field name="name">customerdesc.form</field>
        <field name="model">customerdesc</field>
        <field name="arch" type="xml">
            <form string="Custom Language">
                <sheet>
                    <group>                      
                        <field name="cst_add"/>
                        <field name="cst_add2"/>
                        <field name="cst_cityname"/>
                        <field name="cst_cname"/>
                        <field name="cst_countname"/>
                        <field name="cst_ctitle"/>
                        <field name="cst_lang" readonly="1"/>
                        <field name="cst_message"/>
                        <field name="cst_name"/>
                        <field name="cst_no"/>
                        <field name="lang_flag"/>
                        <field name="user_lmd"/>    
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cus_desc_tree" model="ir.ui.view">
        <field name="name">customerdesc.custom.tree</field>
        <field name="model">customerdesc</field>
        <field name="arch" type="xml">
            <tree string="Custom Language List">
                <field name="cst_add"/>
                <field name="cst_add2"/>
                <field name="cst_cityname"/>
                <field name="cst_cname"/>
                <field name="cst_countname"/>
                <field name="cst_ctitle"/>
                <field name="cst_lang" readonly="1"/>
                <field name="cst_message"/>
                <field name="cst_name"/>
                <field name="cst_no"/>
                <field name="lang_flag"/>
                <field name="user_lmd"/>  
            </tree>
        </field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom_main" name="Languages" sequence="10"/> -->

    <record id="action_cus_desc_custom" model="ir.actions.act_window">
        <field name="name">customerdesc</field>
        <field name="res_model">customerdesc</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom" name="Regular" action="action_res_lang_custom"  sequence="10"/> -->

</odoo>