<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_salesman_desc_form" model="ir.ui.view">
        <field name="name">salesmandesc.form</field>
        <field name="model">sl.salesmandesc</field>
        <field name="arch" type="xml">
            <form string="Custom Language">
                <sheet>
                    <group>                      
                        <field name="lang_flag"/>
                        <field name="sm_code"/>
                        <field name="sm_lang"/>
                        <field name="sm_name"/>
                        <field name="user_lmd"/>     
                                          
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_salesman_desc_tree" model="ir.ui.view">
        <field name="name">salesmandesc.custom.tree</field>
        <field name="model">sl.salesmandesc</field>
        <field name="arch" type="xml">
            <tree string="Custom Language List">
                        <field name="lang_flag"/>
                        <field name="sm_code"/>
                        <field name="sm_lang"/>
                        <field name="sm_name"/>
                        <field name="user_lmd"/> 
            </tree>
        </field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom_main" name="Languages" sequence="10"/> -->

    <record id="action_salesman_desc_custom" model="ir.actions.act_window">
        <field name="name">Salesmandesc Custom Model</field>
        <field name="res_model">sl.salesmandesc</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom" name="Regular" action="action_res_lang_custom"  sequence="10"/> -->

</odoo>