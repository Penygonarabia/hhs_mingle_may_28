<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_groupsdesc_custom_form" model="ir.ui.view">
        <field name="name">groupsdesc.form</field>
        <field name="model">t.groupsdesc</field>
        <field name="arch" type="xml">
            <form string="Custom Language">
                <sheet>
                    <group>
                        <field name="detail1"/>
                        <field name="detail2"/>
                        <field name="detail3" />
                        <field name="grpd_code"/>
                        <field name="grpd_comments"/>
                        <field name="grpd_desc"/>
                        <field name="grpd_lang"/>
                        <field name="grpd_splname"/>
                        <field name="lang_flag"/>
                        <field name="user_lmd"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_groupsdesc_custom_tree" model="ir.ui.view">
        <field name="name">groupsdesc.custom.tree</field>
        <field name="model">t.groupsdesc</field>
        <field name="arch" type="xml">
            <tree string="Custom Language List">
                        <field name="detail1"/>
                        <field name="detail2"/>
                        <field name="detail3" />
                        <field name="grpd_code"/>
                        <field name="grpd_comments"/>
                        <field name="grpd_desc"/>
                        <field name="grpd_lang"/>
                        <field name="grpd_splname"/>
                        <field name="lang_flag"/>
                        <field name="user_lmd"/>
            </tree>
        </field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom_main" name="Languages" sequence="10"/> -->

    <record id="action_groupsdesc_custom" model="ir.actions.act_window">
        <field name="name">groupsdesc Custom Languages</field>
        <field name="res_model">t.groupsdesc</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom" name="Regular" action="action_res_lang_custom"  sequence="10"/> -->

</odoo>