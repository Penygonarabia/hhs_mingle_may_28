<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cstclassification_form" model="ir.ui.view">
        <field name="name">cstclassification.form</field>
        <field name="model">t.cstclassification</field>
        <field name="arch" type="xml">
            <form string="Custom Language">
                <sheet>
                    <group>                      
                        <field name="cc_code"/>
                        <field name="cc_cstclasstype"/>
                        <field name="user_id"/>
                        <field name="user_lmd"/>
                        <field name="user_lmt"/>  
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cstclassification_tree" model="ir.ui.view">
        <field name="name">cstclassification.custom.tree</field>
        <field name="model">t.cstclassification</field>
        <field name="arch" type="xml">
            <tree string="Custom Language List">
                        <field name="cc_code"/>
                        <field name="cc_cstclasstype"/>
                        <field name="user_id"/>
                        <field name="user_lmd"/>
                        <field name="user_lmt"/>
            </tree>
        </field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom_main" name="Languages" sequence="10"/> -->

    <record id="action_cstclassification_custom" model="ir.actions.act_window">
        <field name="name">cstclassification Custom Model</field>
        <field name="res_model">t.cstclassification</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom" name="Regular" action="action_res_lang_custom"  sequence="10"/> -->

</odoo>