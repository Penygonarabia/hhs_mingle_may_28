<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_productsdesc_custom_form" model="ir.ui.view">
        <field name="name">Productsdesc.form</field>
        <field name="model">t.productsdesc</field>
        <field name="arch" type="xml">
            <form string="Custom Language">
                <sheet>
                    <group>
                        <field name="p_code"/>
                        <field name="p_desc"/>
                        <field name="p_grp" />
                        <field name="p_lang"/>
                        <field name="user_lmd"/>
                        <field name="lang_flag"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_productsdesc_custom_tree" model="ir.ui.view">
        <field name="name">Productsdesc.custom.tree</field>
        <field name="model">t.productsdesc</field>
        <field name="arch" type="xml">
            <tree string="Custom Language List">
                        <field name="p_code"/>
                        <field name="p_desc"/>
                        <field name="p_grp" />
                        <field name="p_lang"/>
                        <field name="user_lmd"/>
                        <field name="lang_flag"/>
            </tree>
        </field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom_main" name="Languages" sequence="10"/> -->

    <record id="action_productsdesc_custom" model="ir.actions.act_window">
        <field name="name">Productsdesc Custom Languages</field>
        <field name="res_model">t.productsdesc</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom" name="Regular" action="action_res_lang_custom"  sequence="10"/> -->

</odoo>