<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_warehousedesc_custom_form" model="ir.ui.view">
        <field name="name">Warehousedesc.form</field>
        <field name="model">t.warehousedesc</field>
        <field name="arch" type="xml">
            <form string="Custom Language">
                <sheet>
                    <group>
                        <field name="lang_flag"/>
                        <field name="user_lmd"/>
                        <field name="wh_code" />
                        <field name="wh_desc"/>
                        <field name="wh_lang"/>                        
                        <field name="wh_pmessage"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_warehousedesc_custom_tree" model="ir.ui.view">
        <field name="name">Warehousedesc.custom.tree</field>
        <field name="model">t.warehousedesc</field>
        <field name="arch" type="xml">
            <tree string="Custom Language List">                
                         <field name="lang_flag"/>
                        <field name="user_lmd"/>
                        <field name="wh_code" />
                        <field name="wh_desc"/>
                        <field name="wh_lang"/>                        
                        <field name="wh_pmessage"/>
            </tree>
        </field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom_main" name="Languages" sequence="10"/> -->

    <record id="action_warehousedesc_custom" model="ir.actions.act_window">
        <field name="name">Warehousedesc Custom Languages</field>
        <field name="res_model">t.warehousedesc</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom" name="Regular" action="action_res_lang_custom"  sequence="10"/> -->

</odoo>