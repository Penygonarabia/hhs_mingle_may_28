<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_Subregions_custom_form" model="ir.ui.view">
        <field name="name">Subregions.form</field>
        <field name="model">t.subregions</field>
        <field name="arch" type="xml">
            <form string="Custom Language">
                <sheet>
                    <group>
                        <field name="sr_code"/>
                        <field name="sr_disable"/>
                        <field name="sr_region" />
                        <field name="sr_sort"/>
                        <field name="user_id"/>
                        <field name="user_lmd"/>
                        <field name="user_lmt"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_Subregions_custom_tree" model="ir.ui.view">
        <field name="name">Subregions.custom.tree</field>
        <field name="model">t.subregions</field>
        <field name="arch" type="xml">
            <tree string="Custom Language List">
                <field name="sr_code"/>
                        <field name="sr_disable"/>
                        <field name="sr_region" />
                        <field name="sr_sort"/>
                        <field name="user_id"/>
                        <field name="user_lmd"/>
                        <field name="user_lmt"/>
            </tree>
        </field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom_main" name="Languages" sequence="10"/> -->

    <record id="action_Subregions_custom" model="ir.actions.act_window">
        <field name="name">Subregions Custom Languages</field>
        <field name="res_model">t.subregions</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom" name="Regular" action="action_res_lang_custom"  sequence="10"/> -->

</odoo>