<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_quant_form" model="ir.ui.view">
        <field name="name">stock_quant.form</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <form string="Custom Language">
                <sheet>
                    <group>                      
                        <field name="product_id"/>
                        <field name="company_id"/>
                        <field name="location_id"/>
                        <field name="storage_category_id"/>
                        <field name="lot_id"/>
                        <field name="package_id"/>
                        <field name="owner_id"/>
                        <field name="user_id"/>
                        <field name="inventory_date"/>
                        <field name="quantity"/>
                        <field name="reserved_quantity"/>
                        <field name="inventory_quantity"/>
                        <field name="inventory_diff_quantity"/>
                        <field name="inventory_quantity_set"/>
                        <field name="in_date"/>
                        <field name="accounting_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_quant_tree" model="ir.ui.view">
        <field name="name">stock_quant.custom.tree</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <tree string="Custom Language List">
                        <field name="product_id"/>
                        <field name="company_id"/>
                        <field name="location_id"/>
                        <field name="storage_category_id"/>
                        <field name="lot_id"/>
                        <field name="package_id"/>
                        <field name="owner_id"/>
                        <field name="user_id"/>
                        <field name="inventory_date"/>
                        <field name="quantity"/>
                        <field name="reserved_quantity"/>
                        <field name="inventory_quantity"/>
                        <field name="inventory_diff_quantity"/>
                        <field name="inventory_quantity_set"/>
                        <field name="in_date"/>
                        <field name="accounting_date"/>
            </tree>
        </field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom_main" name="Languages" sequence="10"/> -->

    <record id="action_stock_quant_custom" model="ir.actions.act_window">
        <field name="name">stock_quant Custom Model</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom" name="Regular" action="action_res_lang_custom"  sequence="10"/> -->

</odoo>