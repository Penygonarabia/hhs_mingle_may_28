<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_lang_custom_form" model="ir.ui.view">
        <field name="name">regionsdesc.form</field>
        <field name="model">t.regionsdesc</field>
        <field name="arch" type="xml">
            <form string="Custom Language">
                <sheet>
                    <group>
                        <field name="r_lang"/>
                        <field name="r_code"/>
                        <field name="lang_flag" />
                        <field name="r_desc"/>
                        <field name="user_lmd" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_lang_custom_tree" model="ir.ui.view">
        <field name="name">regionsdesc.custom.tree</field>
        <field name="model">t.regionsdesc</field>
        <field name="arch" type="xml">
            <tree string="Custom Language List">
                <field name="r_lang"/>
                <field name="r_code"/>
                <field name="lang_flag"/>
                <field name="user_lmd"/>
            </tree>
        </field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom_main" name="Languages" sequence="10"/> -->

    <record id="action_res_lang_custom" model="ir.actions.act_window">
        <field name="name">regionsdesc Custom Languages</field>
        <field name="res_model">t.regionsdesc</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- <menuitem id="menu_res_lang_custom" name="Regular" action="action_res_lang_custom"  sequence="10"/> -->

</odoo>