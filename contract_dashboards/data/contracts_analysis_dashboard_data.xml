        <!-- ============================================================
             Chart 6: Maintenance Service Analysis vs Contract Value
                      (per Contract)
             Filter   : contract_type = 'maintenance'
             Group by : Contract (name)
             Measure 1 (bar): Contract Value   (amount_total)
             Measure 2 (bar): Maintenance Service Value (untaxed_amount)
             Drill Level-1: Customer (partner_id)
             Drill Level-2: Region  (work_center_group_id)
             Drill Level-3: City    (work_center_id)
             ============================================================ -->
        <record id="ca_chart_maint_service_vs_contract_value" model="ks_dashboard_ninja.item">
            <field name="name">Maintenance Service Analysis vs Contract Value</field>
            <field name="ks_dashboard_ninja_board_id" ref="contracts_analysis_dashboard_board"/>
            <field name="ks_dashboard_item_type">ks_bar_chart</field>
            <field name="ks_chart_data_count_type">sum</field>
            <field name="ks_model_id" ref="sales_contract_and_recurring_invoices.model_subscription_contracts"/>
            <field name="ks_chart_measure_field" eval="[(6, 0, [ref('contract_dashboards.field_subscription_contracts__service_amount'), ref('contract_dashboards.field_subscription_contracts__contract_amount')])]"/>
            <field name="ks_chart_relation_groupby" ref="sales_contract_and_recurring_invoices.field_subscription_contracts__name"/>
            <field name="ks_domain">[("contract_type", "=", "maintenance")]</field>
            <field name="ks_chart_item_color">custom-1</field>
            <field name="ks_show_data_value">1</field>
            <field name="ks_hide_legend">1</field>
            <field name="ks_bar_chart_stacked">0</field>
            <field name="ks_record_data_limit_visibility">1</field>
            <field name="ks_record_data_limit">20</field>
            <field name="ks_date_filter_field" ref="sales_contract_and_recurring_invoices.field_subscription_contracts__date_start"/>
        </record>

        <!-- Drill-down actions for Chart 6 -->
        <record id="ca_chart_maint_service_drill_1" model="ks_dashboard_ninja.item_action">
            <field name="ks_dashboard_item_id" ref="ca_chart_maint_service_vs_contract_value"/>
            <field name="ks_item_action_field" ref="sales_contract_and_recurring_invoices.field_subscription_contracts__partner_id"/>
            <field name="ks_chart_type">ks_bar_chart</field>
