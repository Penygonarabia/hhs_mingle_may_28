<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             Dashboard Board: Contracts Analysis
             ============================================================ -->
        <record id="contracts_analysis_dashboard_board" model="ks_dashboard_ninja.board">
            <field name="name">Contract Analysis</field>
            <field name="ks_dashboard_menu_name">Contract Analysis</field>
            <field name="ks_dashboard_top_menu_id" ref="contract_dashboards.contract_dashboards_menu_root"/>
            <field name="ks_dashboard_active">1</field>
            <field name="ks_dashboard_default_template" ref="ks_dashboard_ninja.ks_blank"/>
            <field name="ks_dashboard_group_access" eval="False"/>
            <field name="ks_date_filter_selection">t_year</field>
        </record>

        <!-- ============================================================
             KPI Tiles: top-of-dashboard summary numbers
             ============================================================ -->
        <!-- ============================================================
             Chart 1: Contract Analysis - Amount (Region wise)
             Main groupby: Region (work_center_group_id)
             Drill Level-1: City (work_center_id)
             Drill Level-2: Salesman (sales_person_user_id)
             Drill Level-3: Monthly (date_start)
             ============================================================ -->
        <record id="ca_chart_amount_by_region" model="ks_dashboard_ninja.item">
            <field name="name">Contract Analysis - Amount</field>
            <field name="ks_dashboard_ninja_board_id" ref="contracts_analysis_dashboard_board"/>
            <field name="ks_dashboard_item_type">ks_bar_chart</field>
            <field name="ks_chart_data_count_type">sum</field>
            <field name="ks_model_id" ref="sales_contract_and_recurring_invoices.model_subscription_contracts"/>
            <field name="ks_chart_measure_field" eval="[(6, 0, [ref('sales_contract_and_recurring_invoices.field_subscription_contracts__amount_total')])]"/>
            <field name="ks_chart_relation_groupby" ref="machine_repair_management.field_subscription_contracts__work_center_group_id"/>
            <field name="ks_chart_item_color">custom-1</field>
            <field name="ks_show_data_value">1</field>
            <field name="ks_date_filter_field" ref="sales_contract_and_recurring_invoices.field_subscription_contracts__date_start"/>
        </record>

        <!-- Drill-down actions for Chart 1 -->
        <record id="ca_chart_amount_region_drill_1" model="ks_dashboard_ninja.item_action">
            <field name="ks_dashboard_item_id" ref="ca_chart_amount_by_region"/>
            <field name="ks_item_action_field" ref="machine_repair_management.field_subscription_contracts__work_center_id"/>
            <field name="ks_chart_type">ks_bar_chart</field>
            <field name="sequence">0</field>
        </record>
        <record id="ca_chart_amount_region_drill_2" model="ks_dashboard_ninja.item_action">
            <field name="ks_dashboard_item_id" ref="ca_chart_amount_by_region"/>
            <field name="ks_item_action_field" ref="machine_repair_management.field_subscription_contracts__sales_person_user_id"/>
            <field name="ks_chart_type">ks_bar_chart</field>
            <field name="sequence">1</field>
        </record>
        <record id="ca_chart_amount_region_drill_3" model="ks_dashboard_ninja.item_action">
            <field name="ks_dashboard_item_id" ref="ca_chart_amount_by_region"/>
            <field name="ks_item_action_field" ref="sales_contract_and_recurring_invoices.field_subscription_contracts__date_start"/>
            <field name="ks_item_action_date_groupby">month</field>
            <field name="ks_chart_type">ks_bar_chart</field>
            <field name="sequence">2</field>
        </record>

