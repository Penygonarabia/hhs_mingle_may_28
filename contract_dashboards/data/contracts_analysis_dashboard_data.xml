        <!-- ============================================================
             Chart 7: Visits Comparison - Preventive & Corrective
                      (Estimated vs Actual per Contract)
             Type: List View (matrix-style table)
             Columns: Region, City, Contract No, Customer, Salesman,
                      Preventive Est / Actual / Balance,
                      Corrective Est / Actual / Balance
             ============================================================ -->
        <record id="ca_chart_visits_estimated_vs_actual" model="ks_dashboard_ninja.item">
            <field name="name">Visits Comparison - Preventive &amp; Corrective (Est vs Actual)</field>
            <field name="ks_dashboard_ninja_board_id" ref="contracts_analysis_dashboard_board"/>
            <field name="ks_dashboard_item_type">ks_list_view</field>
            <field name="ks_list_view_type">ungrouped</field>
            <field name="ks_model_id" ref="sales_contract_and_recurring_invoices.model_subscription_contracts"/>
            <field name="ks_list_view_fields" eval="[(6, 0, [
                ref('contract_dashboards.field_subscription_contracts__region'),
                ref('contract_dashboards.field_subscription_contracts__city'),
                ref('sales_contract_and_recurring_invoices.field_subscription_contracts__name'),
                ref('sales_contract_and_recurring_invoices.field_subscription_contracts__partner_id'),
                ref('machine_repair_management.field_subscription_contracts__sales_person_user_id'),
                ref('contract_dashboards.field_subscription_contracts__preventive_estimated'),
                ref('contract_dashboards.field_subscription_contracts__preventive_actual'),
                ref('contract_dashboards.field_subscription_contracts__preventive_balance'),
                ref('contract_dashboards.field_subscription_contracts__corrective_estimated'),
                ref('contract_dashboards.field_subscription_contracts__corrective_actual'),
                ref('contract_dashboards.field_subscription_contracts__corrective_balance'),
            ])]"/>
            <field name="ks_domain">[("contract_type", "=", "maintenance")]</field>
            <field name="ks_chart_item_color">custom-1</field>
            <field name="ks_record_data_limit_visibility">1</field>
            <field name="ks_record_data_limit">50</field>
            <field name="ks_date_filter_field" ref="sales_contract_and_recurring_invoices.field_subscription_contracts__date_start"/>
        </record>

    </data>
</odoo>
