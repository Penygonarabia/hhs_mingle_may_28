<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <template id="employee_loan_internal_layout">
            <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
              <t t-raw="0"/>
            </div>
        </template>

        <!-- Report Template -->
        <template id="report_employee_loan_details_pdf">
            <t t-call="web.html_container">
                <t t-call="employee_loan_report.employee_loan_internal_layout" style="margin-top:0px;padding-top:0px;display:inline;">
                    <div class="header" t-att-style="report_header_style">
                        <div class="row mt32 mb32">
                            <div class="col-3 text-left" style="font:12px lucida-console,sans-serif !important;">
                                <span t-field="res_company.partner_id"/>
                                <br/>
                                <span t-field="res_company.partner_id.street"/>
                                <br/>
                                <span t-field="res_company.partner_id.street2"/>
                                <br/>
                                <span t-field="res_company.partner_id.city"/>
                                <br/>
                                <span t-field="res_company.partner_id.country_id"/>
                                <br/>
                                <span t-field="res_company.partner_id.vat"/>
                                <br/>
                            </div>
                            <div class="col-6">
                                <h2><center>Employee Loan Report</center></h2>

                            </div>
                            <div class="col-3 text-right " style="vertical-align:text-top">
               				    <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="max-height: 100px; min-height:100px; min-width: 150px; max-width: 150px;" />
            			    </div>

                        </div>
                    </div>
                    <div class="page">
                        <table class="table table-sm table-bordered">
                        <thead>
                            <tr style="background-color:#464343;color:white;text-align:center">
                                <th width="2%" style="vertical-align:text-top">S.No</th>
                                <th width="10%" style="vertical-align:text-top">Emp.No</th>
                                <th width="15%" style="vertical-align:text-top">Emp.Name</th>
                                <th width="12%" style="vertical-align:text-top">Loan type</th>
                                <th width="12%" style="vertical-align:text-top">Loan Reference</th>
                                <th width="9%" style="vertical-align:text-top">Loan start Date</th>
                                <th width="8%" style="vertical-align:text-top">Loan Amount</th>
                                <th width="11%" style="vertical-align:text-top">Loan Installment<br/> Rate</th>
                                <th width="11%" style="vertical-align:text-top">Last Repayment<br/>Date</th>
                                <th width="10%" style="vertical-align:text-top">Balance Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="counter" t-value="1"/>
                            <t t-foreach="selection" t-as="employee">
                                <tr>
                                    <td class="text-right"><span t-esc="counter"/></td>
                                    <td><span t-esc="employee['emp_no']"/></td>
                                    <td><span t-esc="employee['employee_name']"/></td>
                                    <td><span t-esc="employee['type_name']"/></td>
                                    <td><span t-esc="employee['loan_name']"/></td>
                                    <td><span t-esc="employee['loan_start_date']"/></td>
                                    <td class="text-right"><span t-esc="employee['loan_amount']"/></td>
                                    <td class="text-right"><span t-esc="employee['ins_rate']"/></td>
                                    <td><span t-esc="employee['ins_date']"/></td>
                                    <td class="text-right"><span t-esc="employee['ins_remaining_amount']"/></td>
                                </tr>
                                <t t-set="counter" t-value="counter+1"/>
                            </t>
                        </tbody>
                    </table>
                    </div>
                    <div class="footer o_background_footer">
                        <div class="text-center">
                            <ul class="list-inline">
                                <li><strong>Printed by : </strong><span t-esc="request.env.user.name"/><span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')" style="padding-left:2em;"/></li>
                            </ul>
                            <div t-if="report_type == 'pdf'" class="text-muted">
                                Page:
                                <span class="page"/>
                                of
                                <span class="topage"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>
</odoo>
