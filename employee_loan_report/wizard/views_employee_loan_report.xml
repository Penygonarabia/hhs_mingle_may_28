<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_loan_report_form" model="ir.ui.view">
		 <field name="name">employee.loan.report.wizard</field>
		 <field name="model">employee.loan.report</field>
		 <field name="arch" type="xml">
		 	<form string="Employee Loan and Advances Report">
					<group>
					<group>
					<div class="o_td_label" style="width:175px;">
			                <label for="employee_ids" string="Employee name"/>
			            </div>
						<field name="employee_ids" nolabel="1" widget="many2many_tags" options="{'no_create': True, 'no_create_edit':True}" />
						<field name="department_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit':True}" />
						<field name="job_title_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit':True}" />
						<field name="nationality_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit':True}" />
						<field name="branch_location_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit':True}" />
						<field name="sort_by"/>
					</group>
					<group>
						<div class="o_td_label" style="width:150px;">
			                <label for="type" string="Type"/>
			            </div>
						<field name="type" nolabel="1"/>
						<field name="from_date"/>
						<field name="to_date" />
						<field name="payment_status"  />
						<field name="approval_status" />
						<field name="employee_status" />
						<field name="company_id" invisible="1"/>
					</group>
				</group>	
				  <footer>
						 <button name="print_salary_report" string="Print Excel" type="object" class="oe_highlight"/>
						 <button name="print_detail_report" invisible="1" string="Print PDF" type="object" class="oe_highlight"/>
						<button name="clear" string="Cancel" class="btn-secondary" special="cancel"/>
				</footer>

			 </form>

		 </field>
	</record>


    <record id="action_employee_loan_report" model="ir.actions.act_window">
		<field name="name">Employee Loan and Advances Report</field>
		<field name="res_model">employee.loan.report</field>
		<field name="view_mode">form</field>
         <field name="view_id" ref="view_employee_loan_report_form"/>
		<field name="target">new</field>
		 <field name="binding_model_id" ref="model_employee_loan_report"/>
        <field name="binding_type">report</field>
	</record>

<!--	<menuitem id="menu_action_employee_loan_report" name="Employee Loan Report" action="action_employee_loan_report"  parent="hr.menu_hr_employee_payroll"-->
<!--              sequence="40"/>-->

	<menuitem action="action_employee_loan_report" name="Employee Loan and Advances Report" id="menu_action_employee_loan_report" sequence="20"
                  parent="hr_loan_advance.menu_hr_employee_advance_report_ps" />

	<record id="action_employee_loan_pdf" model="ir.actions.report">
        <field name="name">Employee Loan and Advances Report</field>
        <field name="model">employee.loan.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_loan_report.report_employee_loan_details_pdf</field>
        <field name="report_file">employee_loan_report.report_employee_loan_details_pdf</field>
        <field name="binding_model_id" ref="model_employee_loan_report"/>
        <field name="binding_type">report</field>
    </record>
<!--	         <field name="paperformat_id" ref="employee_details_report.custom_branch_paperformat_id" />-->



</odoo>
