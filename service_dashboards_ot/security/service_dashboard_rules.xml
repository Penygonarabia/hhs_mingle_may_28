<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="rule_jobcards_analysis_technician" model="ir.rule">
            <field name="name">Job Cards Analysis: Technician sees only own tasks</field>
            <field name="model_id" ref="model_dbmodel_jobcards_analysis"/>
            <field name="groups" eval="[(4, ref('machine_repair_management.group_job_card_mobile_user'))]"/>
            <field name="domain_force">[
                '|', '|',
                ('technician_id', '=', user.id),
                ('scheduled_uid', '=', user.id),
                ('closed_jobcard_user_id', '=', user.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
