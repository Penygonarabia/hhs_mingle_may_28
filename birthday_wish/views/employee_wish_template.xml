<?xml version="1.0" encoding="utf-8" ?>
<odoo>
	

	 <record id="employee_birthday_wish_mail" model="mail.template">
            <field name="name">Birthday Wish For an Employee</field>
            <field name="email_from">{{ object.user_id.email }}</field>
            <field name="email_to">{{ object.work_email }}</field>
            <field name="subject">Happy Birthday - {{object.name}}</field>
            <field name="body_html"><![CDATA[
                    <p><b style="color:#0000FF">Happy Birthday Dear <t t-out="object.name"></t></b>,</p>
                    
                     <p style="color:#0000FF">
                         Your dedication to creating a positive work environment is truly appreciated...
                   
                    </p>
                    <div t-if="not ctx.get('birthday_image') and object.attachment_ids" 
                     style="text-align: center; margin: 20px 0;">
                    <img t-att-src="'/web/image/%s?access_token=%s' % (
                             object.attachment_ids[0].id, 
                             object.attachment_ids[0].access_token
                         )" 
                         alt="Happy Birthday" 
                         style="max-width: 100%; border-radius: 8px;"/>
                </div>
                   
                    <b style="color:#0000FF">Best Regards</b><br>
                    <b style="color:#0000FF">Human Resource Dept</b><br>
                     <b style="color:#0000FF">HH-Shaker</b>
                ]]>
            </field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="auto_delete" eval="True"/>
        </record>
	
