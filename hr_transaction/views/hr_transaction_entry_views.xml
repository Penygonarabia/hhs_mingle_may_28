<odoo>
  <data>
    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="view_hr_transaction_entry_list">
      <field name="name">Transaction list</field>
      <field name="model">hr.transaction.entry</field>
      <field name="arch" type="xml">
        <tree string="Transaction">
          <field name="description"/>
          <field name="transaction_type_id" />
          <field name="name" />
          <field name="code"/>
          <field name="rule_type"/>
          <field name="unit_type"/>
          <field name="fixed_amount"/>



        </tree>
      </field>
    </record>
    <record model="ir.ui.view" id="view_hr_transaction_entry_form">
      <field name="name">Transaction Form</field>
      <field name="model">hr.transaction.entry</field>
      <field name="arch" type="xml">
        <form string="Transaction">

          <sheet>
            <group>
            <group>
              <field name="name" readonly="1"/>
              <field name="transaction_type_id"/>
              <field name="code"/>
               <field name="description"/>
                <field name="complete_name" invisible="1" readonly="1"/>

            </group>
            <group>
              <field name="rule_type"/>
              <field name="unit_type" />
              <field name="calculate_based_on_allowance" invisible="unit_type == 'amount'"/>
              <field name="transact_visibility" invisible="1"/>
              <field name="fixed_amount" invisible="unit_type != 'amount'"/>
              <field name="rate" invisible="unit_type == 'amount'"/>

            </group>
          </group>
          </sheet>
          <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
        </form>
      </field>
    </record>
    <record id="view_hr_transaction_entry" model="ir.ui.view">
            <field name="name">rhr.transaction.entry.search</field>
            <field name="model">hr.transaction.entry</field>
            <field name="arch" type="xml">
                <search string="Transactions">
                    <field name="description" string="Description"/>
                    <field name="transaction_type_id" string="Transaction Type"/>
                </search>
            </field>
        </record>


    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="action_windows_hr_transaction_entry_form">
      <field name="name">Transaction Definition</field>
      <field name="res_model">hr.transaction.entry</field>
      <field name="view_mode">tree,form,search</field>
    </record>

