<odoo>
  <data>
    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="view_hr_transaction_list">
      <field name="name">Transaction Types list</field>
      <field name="model">hr.transaction.rule</field>
      <field name="arch" type="xml">
        <tree string="Transaction Types" create="1" editable="bottom">

          <field name="code" />
          <field name="name" />
          <field name="rule_type"/>
          <field name="unit_type"/>

        </tree>
      </field>
    </record>
        <record model="ir.ui.view" id="view_hr_transaction_form">
      <field name="name">Transaction Types Form</field>
      <field name="model">hr.transaction.rule</field>
      <field name="arch" type="xml">
        <form string="Transaction Types">
          <sheet>
            <field name="code"/>
          <field name="name"/>
          <field name="rule_type"/>
          <field name="unit_type"/>
          </sheet>


        </form>
      </field>
    </record>


    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="action_window_hr_transaction">
      <field name="name">Transaction Types</field>
      <field name="res_model">hr.transaction.rule</field>
      <field name="view_mode">tree,form</field>
    </record>

