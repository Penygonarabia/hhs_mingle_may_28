<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sub_category_tree" model="ir.ui.view">
        <field name="name">sub_category.tree</field>
        <field name="model">sub_category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="subcat_ref"/>
                <field name="subcat_name"/>
                <field name="subcat_name2"/>
                <field name="subcat_maincategory_id"/>
            </tree>
        </field>
    </record>

    <record id="view_sub_category_form" model="ir.ui.view">
        <field name="name">sub_category.form</field>
        <field name="model">sub_category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="subcat_ref"/>
                            <field name="subcat_name"/>
                            <field name="subcat_name2"/>
                            <field name="subcat_maincategory_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sub_category_search" model="ir.ui.view">
        <field name="name">sub_category.search</field>
        <field name="model">sub_category</field>
        <field name="arch" type="xml">
            <search>
                <field name="subcat_name"/>
                <field name="subcat_ref"/>
            </search>
        </field>
    </record>

    <record id="action_sub_category" model="ir.actions.act_window">
        <field name="name">Sub Category</field>
        <field name="res_model">sub_category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
