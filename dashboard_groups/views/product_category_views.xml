<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_category_form_inherit" model="ir.ui.view">
        <field name="name">product.category.form.inherit.dashboard_groups</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <br/>
                <field name="name_ar" placeholder="e.g. مصابيح" class="oe_inline"/>
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="sub_category"/>
                <field name="merged_subcategory"/>
            </xpath>
        </field>
    </record>
</odoo>
