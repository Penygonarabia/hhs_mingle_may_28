<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        "PBI Dashboards > Sales Dashboards > Sales Dashboard" — a custom OWL
        dashboard (not a ks_dashboard_ninja board), nested under the
        "Sales Dashboards" container alongside "Sales Analysis" (KPI tiles).

        WHY NOT UNDER My Dashboard: it was originally nested under
        ks_dashboard_ninja.board_menu_root ("My Dashboard"), but the
        now-removed module_rights_ninja_bridge treated ANY menu under
        board_menu_root whose action is the shared dashboard_action_window
        placeholder as an "empty dashboard category" (awaiting board import,
        like Beta Dashboards) and hid it unconditionally since it will never
        have accessible ks_dashboard_ninja.board children. Since this
        category will never contain a real board, that rule made it
        permanently invisible no matter what access was granted. It was
        first made its own top-level app to sidestep that My-Dashboard-
        specific rule, then later moved under "Sales Dashboards" (a plain
        pbi_dashboards container). The bridge is gone now, but the placement
        is kept: it is a better fit regardless. It is governed normally by
        menu.access.rights' flat per-menu gating (see that model's
        docstring) — hidden until an admin grants it via Settings ▸ User
        Menu Rights, same as any other app's menus.

        The old nested xmlids (pbi_dashboards_menu_root, menu_pbi_sales_dashboard)
        are intentionally no longer declared here; Odoo's standard module-
        upgrade cleanup removes their ir.ui.menu records on `-u` since they
        are no longer present in this module's data.

        noupdate="1" so this survives -u once an admin has (re)ordered or
        hidden it, consistent with every other dashboard module here.
    -->
    <data noupdate="1">

        <menuitem id="pbi_dashboards_app_root"
                  name="PBI Dashboards"
                  sequence="55"/>

        <!--
            "Loyalty Dashboards" — an intermediate container menu under
            PBI Dashboards, holding "Loyalty Analysis" (and any future
            loyalty-related boards). Governed by the same flat
            menu.access.rights gating as every level here (see the
            comment above): this container menu needs its own explicit
            grant row, same as the leaf action menu below.
        -->
        <menuitem id="menu_pbi_loyalty_dashboards"
                  name="Loyalty Dashboards"
                  parent="pbi_dashboards.pbi_dashboards_app_root"
                  sequence="30"/>

        <record id="action_pbi_loyalty_dashboard" model="ir.actions.client">
            <field name="name">Loyalty Analysis</field>
            <field name="tag">pbi_dashboards.loyalty_dashboard</field>
        </record>

        <menuitem id="menu_pbi_loyalty_analysis"
                  name="Loyalty Analysis"
                  parent="pbi_dashboards.menu_pbi_loyalty_dashboards"
                  sequence="10"
                  action="pbi_dashboards.action_pbi_loyalty_dashboard"/>

        <!--
            "Sales Analysis" — Report-1 (Amount) and Report-2 (Qty), each a
            Region -> City -> Main -> Main Sub -> Prod Group -> Product Sub
            Group -> Customer -> Transaction list drill-down, reading from
            v_pbi_sales_analysis (pbi_dashboards/models/sales_analysis_view.py),
            a view over the real ``bidata`` sales fact table. Nested under
            "Loyalty Dashboards" alongside Loyalty Analysis (moved there from
            being a standalone sibling of Sales Dashboard/Loyalty Dashboards).
        -->
        <record id="action_pbi_sales_analysis" model="ir.actions.client">
            <field name="name">Loyalty Customers Sales Analysis</field>
            <field name="tag">pbi_dashboards.sales_analysis_dashboard</field>
        </record>

        <menuitem id="menu_pbi_sales_analysis"
                  name="Loyalty Customers Sales Analysis"
                  parent="pbi_dashboards.menu_pbi_loyalty_dashboards"
                  sequence="20"
                  action="pbi_dashboards.action_pbi_sales_analysis"/>

        <!--
            "Sales Dashboards" — an intermediate container menu under PBI
            Dashboards, holding "Sales Dashboard" (KPI tiles + Sales Type
            Group charts, live from bidata directly — see
            pbi_dashboards/controllers/sales_kpi_main.py, tag
            pbi_dashboards.sales_kpi_dashboard) and "Sales Analysis" (the
            11-page report-style dashboard mirroring the client's monthly
            PPTX sales report, tag pbi_dashboards.sales_mail_dashboard).
            The original custom-OWL "Sales Dashboard"
            (action_pbi_sales_dashboard / tag pbi_dashboards.sales_dashboard,
            pbi_dashboards/static/src/js/sales_dashboard.js) was removed
            from this menu; its "Sales Dashboard" name was reassigned to the
            former "Sales Analysis" KPI-tiles leaf below, and that leaf's
            former name was in turn reassigned to the former "Sales Mail
            Content" leaf. "Sales Analysis" here is deliberately kept as a
            SEPARATE leaf from the "Sales Analysis" drill-down under Loyalty
            Dashboards above (same display name, different menu/action/data
            source) rather than merged or renamed — both are intentionally
            named "Sales Analysis" in different places.
        -->
        <menuitem id="menu_pbi_sales_dashboards"
                  name="Sales Dashboards"
                  parent="pbi_dashboards.pbi_dashboards_app_root"
                  sequence="10"/>

        <record id="action_pbi_sales_kpi_dashboard" model="ir.actions.client">
            <field name="name">Sales Dashboard</field>
            <field name="tag">pbi_dashboards.sales_kpi_dashboard</field>
        </record>

        <menuitem id="menu_pbi_sales_kpi_analysis"
                  name="Sales Dashboard"
                  parent="pbi_dashboards.menu_pbi_sales_dashboards"
                  sequence="10"
                  action="pbi_dashboards.action_pbi_sales_kpi_dashboard"/>

        <record id="action_pbi_sales_mail_dashboard" model="ir.actions.client">
            <field name="name">Sales Analysis</field>
            <field name="tag">pbi_dashboards.sales_mail_dashboard</field>
        </record>

        <menuitem id="menu_pbi_sales_mail_dashboard"
                  name="Sales Analysis"
                  parent="pbi_dashboards.menu_pbi_sales_dashboards"
                  sequence="20"
                  action="pbi_dashboards.action_pbi_sales_mail_dashboard"/>

        <!--
            "Sales Analysis - New" — sibling of "Sales Analysis" above, same
            17-page bidata-direct report data (own JSON route/PPTX-export/
            notes-import, see pbi_dashboards/controllers/sales_mail_main.py's
            _new-suffixed routes) but WITHOUT the Prev/Next/page-picker
            navigation: every page renders stacked, one after another, in
            the same order they're listed in the header over there (see
            sales_mail_dashboard_new.js/.xml/.css) instead of showing only
            one page at a time. Gated by its own menu grant, independent of
            "Sales Analysis", per this module's one-grant-per-leaf
            convention.
        -->
        <record id="action_pbi_sales_mail_dashboard_new" model="ir.actions.client">
            <field name="name">Sales Analysis - New</field>
            <field name="tag">pbi_dashboards.sales_mail_dashboard_new</field>
