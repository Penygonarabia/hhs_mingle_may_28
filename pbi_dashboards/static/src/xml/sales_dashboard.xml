<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="pbi_dashboards.sales_dashboard">
    <div class="pbi-sales-dashboard" t-ref="root" t-att-dir="isArabicUI() ? 'rtl' : 'ltr'">
      <div class="wrap">
        <header>
          <h1><t t-esc="t('BI Data Live — Sales Dashboard')"/></h1>
          <p><t t-esc="t('Source')"/>: <code>v_bidata_live</code> · <t t-esc="tDate('Jan 2023 – Oct 2025')"/></p>
        </header>

        <div class="filters">
          <div class="filter-row filter-row-inline">
            <div class="filter-group">
              <span class="filter-label"><t t-esc="t('Period')"/></span>
              <select class="filter-select" t-on-change="(ev) => this.selectYear(ev.target.value)">
                <t t-foreach="yearOptions" t-as="opt" t-key="opt.v">
                  <option t-att-value="opt.v" t-att-selected="opt.v === state.year ? true : undefined">
                    <t t-esc="tDate(opt.l)"/>
                  </option>
                </t>
              </select>
            </div>
            <div class="filter-group">
              <span class="filter-label"><t t-esc="t('Franchise')"/></span>
              <select class="filter-select" t-on-change="(ev) => this.selectFranchise(ev.target.value)">
                <t t-foreach="franchiseOptions" t-as="opt" t-key="opt.v">
                  <option t-att-value="opt.v" t-att-selected="opt.v === state.franchise ? true : undefined">
                    <t t-esc="t(opt.l)"/>
                  </option>
                </t>
              </select>
            </div>
            <div class="filter-group">
              <span class="filter-label"><t t-esc="t('Customer Type')"/></span>
              <select class="filter-select" t-on-change="(ev) => this.selectCustomerType(ev.target.value)">
                <t t-foreach="customerTypeOptions" t-as="opt" t-key="opt.v">
                  <option t-att-value="opt.v" t-att-selected="opt.v === state.customerType ? true : undefined">
                    <t t-esc="t(opt.l)"/>
                  </option>
                </t>
              </select>
            </div>
            <div class="filter-group">
              <span class="filter-label"><t t-esc="t('Region')"/></span>
              <select class="filter-select" t-on-change="(ev) => this.selectRegion(ev.target.value)">
                <t t-foreach="regionOptions" t-as="opt" t-key="opt.v">
                  <option t-att-value="opt.v" t-att-selected="opt.v === state.region ? true : undefined">
                    <t t-esc="t(opt.l)"/>
                  </option>
                </t>
              </select>
            </div>
          </div>
          <div class="filter-row export-actions">
            <span class="filter-label"><t t-esc="t('Export')"/></span>
            <div class="pill-filter">
              <button t-on-click="exportPdf"><t t-esc="t('Export PDF')"/></button>
              <button t-on-click="exportPptx"><t t-esc="t('Export PowerPoint')"/></button>
              <button t-on-click="() => this.refs.importNotesInput.el.click()"><t t-esc="t('Import Notes')"/></button>
              <input type="file" accept=".pptx" class="d-none" t-ref="importNotesInput" t-on-change="importNotes"/>
            </div>
          </div>
        </div>

        <div class="error-banner" t-if="state.error">
          <t t-esc="state.error"/>
        </div>

        <div class="dashboard" t-att-class="state.loading ? 'loading' : ''">
          <div class="pbi-kpi-row" t-ref="kpiRow"/>

          <div class="pbi-card">
            <h2 t-ref="trendTitle"><t t-esc="t('Monthly Sales vs Budget')"/></h2>
            <p class="subtitle" t-ref="trendSubtitle"><t t-esc="t('Amount by month')"/></p>
            <div class="chart-row">
              <div class="chart-col">
                <div class="pbi-legend" t-ref="trendLegend"/>
                <div t-ref="trendChart"/>
              </div>
              <div class="narrative" t-ref="trendNotes"/>
            </div>
          </div>

          <div class="pbi-card">
            <h2 t-ref="regionTitle"><t t-esc="t('Sales by Region')"/></h2>
            <p class="subtitle" t-ref="regionSubtitle"><t t-esc="t('Amount vs budget')"/></p>
            <div class="drill-breadcrumb" t-ref="regionBreadcrumb"/>
            <div class="chart-row">
              <div class="chart-col">
                <div class="pbi-legend" t-ref="regionLegend"/>
                <div t-ref="regionChart"/>
              </div>
              <div class="narrative" t-ref="regionNotes"/>
            </div>
          </div>

          <div class="pbi-card">
            <h2 t-ref="franchiseTitle"><t t-esc="t('Sales by Franchise')"/></h2>
            <p class="subtitle" t-ref="franchiseSubtitle"><t t-esc="t('Amount vs budget')"/></p>
            <div class="chart-row">
              <div class="chart-col">
                <div class="pbi-legend" t-ref="franchiseLegend"/>
                <div t-ref="franchiseChart"/>
              </div>
              <div class="narrative" t-ref="franchiseNotes"/>
            </div>
          </div>

          <div class="pbi-card">
            <h2 t-ref="customerTypeTitle"><t t-esc="t('Sales by Customer Type')"/></h2>
            <p class="subtitle" t-ref="customerTypeSubtitle"><t t-esc="t('Amount vs budget')"/></p>
            <div class="chart-row">
              <div class="chart-col">
                <div class="pbi-legend" t-ref="customerTypeLegend"/>
                <div t-ref="customerTypeChart"/>
              </div>
              <div class="narrative" t-ref="customerTypeNotes"/>
            </div>
          </div>

          <div class="pbi-card">
            <h2 t-ref="productTitle"><t t-esc="t('Top Product Groups')"/></h2>
            <p class="subtitle" t-ref="productSubtitle"><t t-esc="t('By sales amount, top 10')"/></p>
            <div class="chart-row">
              <div class="chart-col">
                <div class="pbi-legend" t-ref="productLegend"/>
                <div t-ref="productChart"/>
              </div>
              <div class="narrative" t-ref="productNotes"/>
            </div>
          </div>

          <div class="pbi-card">
            <h2 t-ref="salesmanTitle"><t t-esc="t('Top 10 Salesmen')"/></h2>
            <p class="subtitle" t-ref="salesmanSubtitle"><t t-esc="t('Sales vs budget, achievement %')"/></p>
            <div class="chart-row">
              <div class="chart-col">
                <div t-ref="salesmanTable"/>
              </div>
              <div class="narrative" t-ref="salesmanNotes"/>
            </div>
          </div>
        </div>

        <footer><t t-esc="t('My Dashboard')"/> &gt; <t t-esc="t('PBI Dashboards')"/> &gt; <t t-esc="t('Sales Dashboard')"/> — <t t-esc="t('live from')"/> v_bidata_live</footer>
      </div>
      <div class="pbi-tooltip" t-ref="tooltip"/>
    </div>
  </t>
</templates>
