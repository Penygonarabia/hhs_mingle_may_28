<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="pbi_dashboards.loyalty_dashboard">
    <div class="pbi-sales-dashboard pbi-loyalty-dashboard" t-ref="root" t-att-dir="isArabicUI() ? 'rtl' : 'ltr'">
      <div class="wrap">
        <header>
          <h1><t t-esc="t('Loyalty Analysis')"/></h1>
          <p><t t-esc="t('Source')"/>: <code>transaction_header</code> / <code>transaction_details</code></p>
        </header>

        <div class="filters">
          <div class="filter-row filter-row-inline">
            <div class="filter-group">
              <span class="filter-label"><t t-esc="t('Period')"/></span>
              <select class="filter-select" t-on-change="(ev) => this.selectPeriod(ev.target.value)">
                <t t-foreach="periodOptions" t-as="opt" t-key="opt.v">
                  <option t-att-value="opt.v" t-att-selected="opt.v === state.period ? true : undefined">
                    <t t-esc="t(opt.l)"/>
                  </option>
                </t>
              </select>
            </div>
            <div class="filter-group">
              <span class="filter-label"><t t-esc="t('Region')"/></span>
              <select class="filter-select" t-on-change="(ev) => this.selectRegion(ev.target.value)">
                <t t-foreach="regionOptions" t-as="opt" t-key="opt.v">
                  <option t-att-value="opt.v" t-att-selected="opt.v === state.region ? true : undefined">
                    <t t-esc="t(opt.l)"/>
                  </option>
                </t>
              </select>
            </div>
          </div>
          <div class="filter-row" t-if="state.period === 'custom'">
            <span class="filter-label"><t t-esc="t('Date Range')"/></span>
            <div class="date-range-inputs">
              <input type="date" t-att-value="state.dateFrom" t-on-change="(ev) => this.setDateFrom(ev.target.value)"/>
              <span><t t-esc="t('to')"/></span>
              <input type="date" t-att-value="state.dateTo" t-on-change="(ev) => this.setDateTo(ev.target.value)"/>
            </div>
          </div>
          <div class="filter-row" t-else="">
            <span class="filter-label"><t t-esc="t('Range')"/></span>
            <span class="resolved-range">
              <t t-esc="state.resolvedFrom"/> – <t t-esc="state.resolvedTo"/>
            </span>
          </div>
          <div class="filter-row export-actions">
            <span class="filter-label"><t t-esc="t('Export')"/></span>
            <div class="pill-filter">
              <button t-on-click="exportPdf"><t t-esc="t('Export PDF')"/></button>
            </div>
          </div>
        </div>

        <div class="error-banner" t-if="state.error">
          <t t-esc="state.error"/>
        </div>

        <div class="dashboard" t-att-class="state.loading ? 'loading' : ''">

          <div class="pbi-card">
            <h2 t-ref="tierTitle"><t t-esc="t('Number of customers per tier')"/></h2>
            <p class="subtitle" t-ref="tierSubtitle"><t t-esc="t('Region wise')"/></p>
            <div class="drill-breadcrumb" t-ref="tierBreadcrumb"/>
            <div class="pbi-legend" t-ref="tierLegend"/>
            <div t-ref="tierChart"/>
          </div>

          <div class="pbi-card">
            <h2 t-ref="pointsIssuedTitle"><t t-esc="t('Points issued')"/></h2>
            <p class="subtitle" t-ref="pointsIssuedSubtitle"><t t-esc="t('Region wise')"/></p>
            <div class="drill-breadcrumb" t-ref="pointsIssuedBreadcrumb"/>
            <div class="pbi-legend" t-ref="pointsIssuedLegend"/>
            <div t-ref="pointsIssuedChart"/>
          </div>

          <div class="pbi-card">
            <h2 t-ref="pointsRedeemedTitle"><t t-esc="t('Points redeemed')"/></h2>
            <p class="subtitle" t-ref="pointsRedeemedSubtitle"><t t-esc="t('Region wise')"/></p>
            <div class="drill-breadcrumb" t-ref="pointsRedeemedBreadcrumb"/>
            <div class="pbi-legend" t-ref="pointsRedeemedLegend"/>
            <div t-ref="pointsRedeemedChart"/>
          </div>

          <div class="pbi-card">
            <h2 t-ref="newUsersTitle"><t t-esc="t('Newly added users')"/></h2>
            <p class="subtitle" t-ref="newUsersSubtitle"><t t-esc="t('Region wise, for the selected period')"/></p>
            <div class="drill-breadcrumb" t-ref="newUsersBreadcrumb"/>
            <div class="pbi-legend" t-ref="newUsersLegend"/>
            <div t-ref="newUsersChart"/>
          </div>

          <div class="pbi-card">
            <h2><t t-esc="t('Promotion participation')"/></h2>
            <p class="subtitle"><t t-esc="t('Total loyalty customers vs. customers who used each promotion')"/></p>
            <div t-ref="promoParticipationTable"/>
          </div>

          <div class="pbi-card">
            <h2><t t-esc="t('Salesman wise promotion participation')"/></h2>
            <p class="subtitle"><t t-esc="t('Total loyalty customers vs. customers who used each promotion, by salesman')"/></p>
            <div t-ref="promoParticipationSalesmanTable"/>
          </div>

        </div>

        <footer><t t-esc="t('PBI Dashboards')"/> &gt; <t t-esc="t('Loyalty Dashboards')"/> &gt; <t t-esc="t('Loyalty Analysis')"/> — <t t-esc="t('live from')"/> transaction_header / transaction_details</footer>
      </div>
      <div class="pbi-tooltip" t-ref="tooltip"/>
    </div>
  </t>
</templates>
