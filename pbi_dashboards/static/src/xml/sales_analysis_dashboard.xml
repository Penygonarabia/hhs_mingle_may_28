<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="pbi_dashboards.sales_analysis_dashboard">
    <div class="pbi-sales-dashboard pbi-sales-analysis-dashboard" t-ref="root" t-att-dir="isArabicUI() ? 'rtl' : 'ltr'">
      <div class="wrap">
        <header>
          <h1><t t-esc="t('Sales Analysis')"/></h1>
          <p><t t-esc="t('Source')"/>: <code>bidata</code> · <t t-esc="t('Region -> City -> Main -> Main Sub -> Prod Group -> Product Sub Group -> Customer -> Transactions')"/></p>
        </header>

        <div class="filters">
          <div class="filter-row filter-row-inline">
            <div class="filter-group">
              <span class="filter-label"><t t-esc="t('Period')"/></span>
              <select class="filter-select" t-on-change="(ev) => this.selectPeriod(ev.target.value)">
                <t t-foreach="periodOptions" t-as="opt" t-key="opt.v">
                  <option t-att-value="opt.v" t-att-selected="opt.v === state.period ? true : undefined">
                    <t t-esc="t(opt.l)"/>
                  </option>
                </t>
              </select>
            </div>
          </div>
          <div class="filter-row" t-if="state.period === 'custom'">
            <span class="filter-label"><t t-esc="t('Date Range')"/></span>
            <div class="date-range-inputs">
              <input type="date" t-att-value="state.dateFrom" t-on-change="(ev) => this.setDateFrom(ev.target.value)"/>
              <span><t t-esc="t('to')"/></span>
              <input type="date" t-att-value="state.dateTo" t-on-change="(ev) => this.setDateTo(ev.target.value)"/>
            </div>
          </div>
          <div class="filter-row" t-else="">
            <span class="filter-label"><t t-esc="t('Range')"/></span>
            <span class="resolved-range">
              <t t-esc="state.resolvedFrom"/> – <t t-esc="state.resolvedTo"/>
            </span>
          </div>
        </div>

        <div class="error-banner" t-if="state.error">
          <t t-esc="state.error"/>
        </div>

        <div class="dashboard" t-att-class="state.loading ? 'loading' : ''">

          <div class="pbi-card">
            <h2><t t-esc="t('Report 1 — Sales by Amount')"/></h2>
            <p class="subtitle" t-ref="amountSubtitle"><t t-esc="t('Total Amount')"/></p>
            <div class="drill-breadcrumb" t-ref="amountBreadcrumb"/>
            <div t-ref="amountBody"/>
          </div>

          <div class="pbi-card">
            <h2><t t-esc="t('Report 2 — Sales by Qty')"/></h2>
            <p class="subtitle" t-ref="qtySubtitle"><t t-esc="t('Total Qty')"/></p>
            <div class="drill-breadcrumb" t-ref="qtyBreadcrumb"/>
            <div t-ref="qtyBody"/>
          </div>

        </div>

        <footer><t t-esc="t('PBI Dashboards')"/> &gt; <t t-esc="t('Sales Analysis')"/> — <t t-esc="t('live from')"/> bidata</footer>
      </div>
      <div class="pbi-tooltip" t-ref="tooltip"/>
    </div>
  </t>
</templates>
