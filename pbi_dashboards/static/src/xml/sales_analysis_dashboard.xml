<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="pbi_dashboards.sales_analysis_dashboard">
    <div class="pbi-sales-dashboard pbi-sales-analysis-dashboard" t-ref="root">
      <div class="wrap">
        <header>
          <h1>Sales Analysis</h1>
          <p>Source: <code>bidata</code> · Region -&gt; City -&gt; Main -&gt; Main Sub -&gt; Prod Group -&gt; Product Sub Group -&gt; Customer -&gt; Transactions</p>
        </header>

        <div class="filters">
          <div class="filter-row filter-row-inline">
            <div class="filter-group">
              <span class="filter-label">Period</span>
              <select class="filter-select" t-on-change="(ev) => this.selectPeriod(ev.target.value)">
                <t t-foreach="periodOptions" t-as="opt" t-key="opt.v">
                  <option t-att-value="opt.v" t-att-selected="opt.v === state.period ? true : undefined">
                    <t t-esc="opt.l"/>
                  </option>
                </t>
              </select>
            </div>
          </div>
          <div class="filter-row" t-if="state.period === 'custom'">
            <span class="filter-label">Date Range</span>
            <div class="date-range-inputs">
              <input type="date" t-att-value="state.dateFrom" t-on-change="(ev) => this.setDateFrom(ev.target.value)"/>
              <span>to</span>
              <input type="date" t-att-value="state.dateTo" t-on-change="(ev) => this.setDateTo(ev.target.value)"/>
            </div>
          </div>
          <div class="filter-row" t-else="">
            <span class="filter-label">Range</span>
            <span class="resolved-range">
              <t t-esc="state.resolvedFrom"/> – <t t-esc="state.resolvedTo"/>
            </span>
          </div>
        </div>

        <div class="error-banner" t-if="state.error">
          <t t-esc="state.error"/>
        </div>

        <div class="dashboard" t-att-class="state.loading ? 'loading' : ''">

          <div class="pbi-card">
            <h2>Report 1 — Sales by Amount</h2>
            <p class="subtitle" t-ref="amountSubtitle">Total Amount</p>
            <div class="drill-breadcrumb" t-ref="amountBreadcrumb"/>
            <div t-ref="amountBody"/>
          </div>

          <div class="pbi-card">
            <h2>Report 2 — Sales by Qty</h2>
            <p class="subtitle" t-ref="qtySubtitle">Total Qty</p>
            <div class="drill-breadcrumb" t-ref="qtyBreadcrumb"/>
            <div t-ref="qtyBody"/>
          </div>

        </div>

        <footer>PBI Dashboards &gt; Sales Analysis — live from bidata</footer>
      </div>
      <div class="pbi-tooltip" t-ref="tooltip"/>
    </div>
  </t>
</templates>
