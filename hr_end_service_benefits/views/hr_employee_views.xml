<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_end_service_benefit_employee_action" model="ir.actions.act_window">
            <field name="name">End Of Service Reward</field>
            <field name="res_model">hr.end.service.benefit</field>
            <!--<field name="view_type">form</field>-->
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_employee_id': [active_id], 'default_employee_id': active_id}</field>
            <field name="domain">[('employee_id','=',active_id)]</field>
        </record>
        <record id="view_employee_end_service_benefits_form" model="ir.ui.view">
            <field name="name">hr.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" help="End Of Service Rewards" icon="fa-money" invisible="end_service_benefits_count == 0" name="%(hr_end_service_benefits.view_hr_end_service_benefit_employee_action)d" type="action">
                        <field name="end_service_benefits_count" string="ES Rewards" widget="statinfo"/>
                    </button>
                </xpath>
                <!-- <xpath expr="//page[@name='personal_information']//group[8]" position="after">
                    <group string="Hiring Date" name="hiring_date">
                        <field name="hiring_date" required="1"/>
                    </group>
                </xpath> -->
                <xpath expr="//group[@name='identification_group']" position="before">
                    <!--  <xpath expr="//page[@name='personal_information']//group" position="inside"> -->
                    <group string="Hiring Date and Joining Date">
                        <field name="hiring_date" required="True"/>
                        <field name="joining_date" required="True"/>
                    </group>
                </xpath>
                <xpath expr="//field[@name='address_id']" position="replace">
                    <field context="{'supplier': 1,'default_supplier': 1,'show_address': 1,'default_type': 'private','form_view_ref': 'base.res_partner_view_form_private'}" name="address_id" options='{"always_reload": True, "highlight_first_line": True}'/>
                </xpath></field>
        </record>
    </data>
</odoo>
