<?xml version="1.0" encoding="utf-8" ?>
<odoo>
		<template id="employee_renewal_internal_layout">
            <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
              <t t-raw="0"/>
            </div>
        </template>

        <!-- Report Template -->
        <template id="report_employee_renewal_pdf">
            <t t-call="web.html_container">
                <t t-call="employee_document_renewal_report.employee_renewal_internal_layout" style="margin-top:0px;padding-top:0px;display:inline;">
                    <div class="header" t-att-style="report_header_style">
                        <div class="row mt32 mb32">
                            <div class="col-3 text-left" style="font:12px lucida-console,sans-serif !important;">
                                <span t-field="res_company.partner_id"/>
                                <br/>
                                <span t-field="res_company.partner_id.street"/>
                                <br/>
                                <span t-field="res_company.partner_id.street2"/>
                                <br/>
                                <span t-field="res_company.partner_id.city"/>
                                <br/>
                                <span t-field="res_company.partner_id.country_id"/>
                                <br/>
                                <span t-field="res_company.partner_id.vat"/>
                                <br/>
                            </div>
                            <div class="col-6">
                                <h2><center>Employee Documents Renewals Report</center></h2>

                            </div>
                            <div class="col-3 text-right " style="vertical-align:text-top">
               				    <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="max-height: 70px; min-height:70px; min-width: 200px; max-width: 200px;"/>
            			    </div>
                        </div>
                    </div>
                    <div class="page">
                    	
                    	<t>
                    		<t t-if="form_data['from_expiry_date'] and form_data['to_expiry_date']">
                    			From Expiry Date : <span t-esc="from_expiry_date"  > </span> <br/>To Expiry Date :<span t-esc="to_expiry_date"  > </span>
                    		</t>
                    		
                    		<t t-if="form_data['department_ids'] or form_data['sort_by']=='department'">
                    				<h4><center>Department Wise Search</center></h4>
                    		</t>
                    		<t t-if="form_data['job_title_ids'] or form_data['sort_by']=='job_title'">
                    			<h4><center>Job Wise Search</center></h4>
                    		</t>
                    		<t t-if="form_data['nationality_ids'] or form_data['sort_by']=='nationality'">
                    			<h4><center>Nation Wise Search</center></h4>
                    		</t>
                    		<t t-if="form_data['branch_location_ids'] or form_data['sort_by']=='branch_location'">
                    			<h4><center>Branch Location Wise Search</center></h4>
                    		</t>
                    		<t t-if="form_data['sort_by']=='employee_no'">
                    			<h4><center>Employee Number Wise Sort</center></h4>
                    		</t>
                    		
                    	</t>
                    	<br/>
                    
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr style="background-color:#464343;color:white;text-align:center">
                                    <th width="1%" style="vertical-align:text-top">#</th>
                                    <th width="5%" style="vertical-align:text-top">Emp.No</th>
                                    <th width="12%" style="vertical-align:text-top">Emp.Name</th>
                                    <th width="12%" style="vertical-align:text-top">Department</th>
                                     <th width="10%" style="vertical-align:text-top">Job Title</th>
                                    
                                    <th width="8%" style="vertical-align:text-top">Nationality</th>
                                    <th width="10%" style="vertical-align:text-top">Location</th>
                                    
                                    <th width="10%" style="vertical-align:text-top">Document Name</th>
                                    <th width="10%" style="vertical-align:text-top">Document Number</th>
                                     <th width="10%" style="vertical-align:text-top">Place of Issue</th>
                                    <th width="20%" style="vertical-align:text-top">Issue Date</th>
                                    <th width="20%" style="vertical-align:text-top">Expiry Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="counter" t-value="1"/>
                                <t t-set="sort_department" t-value="set()"/>
                                <t t-set="sort_job" t-value="set()"/>
                                <t t-set="sort_nation" t-value="set()"/>
                                <t t-set="sort_branch_location" t-value="set()"/>
                                
                                <t t-foreach="selection" t-as="renewal">
                                		
                                		<t t-if="form_data['sort_by']=='department' and renewal['dept_name'] not in sort_department ">
	                                		<tr style="background-color:#464343;color:white;text-align:center">
	                                			<td colspan="16" width="100%"><span t-esc="renewal['dept_name']"/></td>
           										 <t t-set="sort_department" t-value="sort_department | set([renewal['dept_name']])"/>	                                		</tr>
                                		</t>
                                		<t t-if="form_data['sort_by']=='job_title' and renewal['job_name'] not in sort_job">
                                			<tr style="background-color:#464343;color:white;text-align:center">
                                				<td colspan="16"><span t-esc="renewal['job_name']"/></td>
                                				<t t-set="sort_job" t-value="sort_job | set([renewal['job_name']])"/>
                                			</tr>
                                		
                                		</t>
                                		
                                		<t t-if="form_data['sort_by']=='nationality' and renewal['nation_name'] not in sort_nation ">
	                                		<tr style="background-color:#464343;color:white;text-align:center">
	                                			<td colspan="16" width="100%"><span t-esc="renewal['nation_name']"/></td>
           										 <t t-set="sort_nation" t-value="sort_nation | set([renewal['nation_name']])"/>	                                		</tr>
                                		</t>
                                		<t t-if="form_data['sort_by']=='branch_location' and renewal['work_location'] not in sort_branch_location">
                                			<tr style="background-color:#464343;color:white;text-align:center">
                                				<td colspan="16"><span t-esc="renewal['work_location']"/></td>
                                				<t t-set="sort_branch_location" t-value="sort_branch_location | set([renewal['work_location']])"/>
                                			</tr>
                                		
                                		</t>
                                			
	                                     <tr>
	                                        <td class="text-right"><span t-esc="counter"/></td>
	                                        <td><span t-esc="renewal['emp_no']"/></td>
	                                        <td><span t-esc="renewal['emp_name']"/></td>
	                                        <td><span t-esc="renewal['dept_name']"/></td>
	                                        <td><span t-esc="renewal['job_name']"/></td>
	                                        <td><span t-esc="renewal['nation_name']"/></td>
	                                       <td><span t-esc="renewal['work_location']"/></td>
	                                        <td><span t-esc="renewal['document_name']"/></td>
	                                        <td><span t-esc="renewal['document_number']"/></td>
	                                        <td><span t-esc="renewal['place_of_issue']"/></td>
	                                        <td><span t-esc="renewal['issue_date']"/></td>
	                                       <td><span t-esc="renewal['expiry_date']"/></td>
	                                    </tr>
	                                    <t t-set="counter" t-value="counter+1"/>
	                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div class="footer o_background_footer">
                        <div class="text-center">
                            <ul class="list-inline">
                                <li><strong>Printed by : </strong><span t-esc="request.env.user.name"/><span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')" style="padding-left:2em;"/></li>
                            </ul>
                            <div t-if="report_type == 'pdf'" class="text-muted">
                                Page:
                                <span class="page"/>
                                of
                                <span class="topage"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>
	



</odoo>