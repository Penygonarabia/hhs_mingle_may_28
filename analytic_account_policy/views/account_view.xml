<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_policy_form" model="ir.ui.view">
        <field name="name">account.account.analytic.policy.form</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <field name="deprecated" position="after">
                <field groups="analytic.group_analytic_accounting" name="analytic_account_policy"/></field></field>
    </record>
    <record id="view_account_analytic_policy_tree" model="ir.ui.view">
        <field name="name">account.account.analytic.policy.tree</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <field name="reconcile" position="after">
                <field groups="analytic.group_analytic_accounting" name="analytic_account_policy" widget="boolean_toggle"/></field></field>
    </record>
