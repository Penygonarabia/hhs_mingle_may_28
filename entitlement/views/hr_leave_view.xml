<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- explicit list view definition -->
        <record id="hr_leave_type_entitlement_view_form_inherit" model="ir.ui.view">
            <field name="name">hr.leave.type.entitlement.view.form.inherit</field>
            <field name="model">hr.leave.type</field>
            <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='allocation_requests']" position="after">
                    <group String="Transaction Code" name="accrued_transaction">
<!--                        <h4>-->
<!--                            Transaction Code-->
<!--                        </h4>-->
<!--                        <br/>-->
                        <field domain="[('code','=','ACL')]" name="transact_code_accrd_leave"/>
                        <field domain="[('code','=','TENC')]" name="transact_code_accrd_ticket"/>
                        <field domain="[('code','=','ADALL')]" name="transact_code_adv_payment"/>
                        <field name="prepare_payslip"/>
                        <field invisible="not code" name="monthly_carry_accrued_leave"/>
                        <field invisible="not code" name="full_accrued_leave"/>
                        <field name="thirty_days_flag"/>
                        <field invisible="not code" name="calendar_days_flag"/>
                    </group>
                </xpath></field>
        </record>
