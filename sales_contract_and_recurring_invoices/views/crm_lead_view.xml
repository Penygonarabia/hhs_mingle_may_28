    <record id="sale_crm_lead_form_view_inherit" model="ir.ui.view">
        <field name="name">sale.crm.lead.view.form.inherit.contract.and.recurring.invoices</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="sale_crm.crm_case_form_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_sale_quotation']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
             <xpath expr="//button[@name='action_view_sale_quotation']" position="after">
                <button class="oe_stat_button" type="object" name="view_amc_quotation" icon="fa-pencil-square-o" invisible="type == 'lead'">
                    <field name="amc_quotation_count" widget="statinfo" string="Quotations"/>
                </button>
            </xpath>
             <xpath expr="//button[@name='action_sale_quotations_new']" position="after">
                <button name="quotation_amc" string="New Quotation" type="object" class="oe_highlight" data-hotkey="w"/>
            </xpath>
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
