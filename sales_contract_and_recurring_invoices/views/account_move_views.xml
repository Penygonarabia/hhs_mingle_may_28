<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherited form view of account move -->
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.sales.contract.and.recurring.invoices</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='preview_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contract_origin" invisible="0"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="after">
                <field name="total_price"/>
                <field name="vat"/>
                <field name="vat_amt"/>
                <field name="total"/>

            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_total']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_uom_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='invoice_tab']/group[hasclass('oe_invoice_lines_tab')]"
                   position="replace">
                <field name="tax_totals" invisible="1"/>
                <group colspan="8"/>
                <group colspan="4" style="float:right;">
                    <field name="untaxed_amount" style="text-align:right" readonly="1" force_save="1"/>
                    <field name="vat_amount" style="text-align:right" readonly="1" force_save="1"/>
                    <field name="grand_total_amount" string="Grand Total" style="text-align:right" readonly="1"
                           force_save="1"/>
                    <field name="amount_due" string="Amount Due" style="text-align:right" readonly="1" force_save="1" invisible="1"/>

                </group>

            </xpath>
        </field>
    </record>
    <record id="view_move_tree_contract_tree" model="ir.ui.view">
        <field name="name">account.move.view.tree.inherit.sales.contract.and.recurring.invoices</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_untaxed_signed']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_total_in_currency_signed']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_total_signed']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_total_in_currency_signed']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_untaxed_signed']" position="after">
                <field name="untaxed_amount"/>
                <field name="vat_amount"/>
                <field name="grand_total_amount"/>
            </xpath>
        </field>
    </record>
</odoo>
