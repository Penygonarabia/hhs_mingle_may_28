<?xml version = "1.0" encoding = "utf-8"?>
<odoo>

	<record id = "contract_termination_wizard_form" model = "ir.ui.view">
		<field name = "name">contract.termination.wizard.form</field>
		<field name = "model">contract.termination.wizard</field>
		<field name = "arch" type = "xml">
			<form string="Terminate Contract">
				<group>
					<field name = "contract_id" readonly = "1"  force_save = "1" options = "{'no_open':True}"/>
					<field name = "termination_reason" required = "1"/>
				
				</group>
				<footer>
					
					<button name="action_confirm_wizard"
	                        string="Confirm"
	                        type="object"
	                        class="btn-primary"/>
	
	                <button string="Cancel"
	                        special="cancel"
	                        class="btn-secondary"/>
				</footer>
		
				
			</form>
		
			
		</field>
	
	</record>


</odoo>