     <template id="sales_contract_and_recurring_invoices.sales_contract_and_recurring_invoices_template_internal_layout">
            <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-raw="0"/>
            </div>
        </template>
     <template id="sales_contract_and_recurring_invoices_report_document">
         <t t-call="web.html_container">
             <t t-call="sales_contract_and_recurring_invoices.sales_contract_and_recurring_invoices_template_internal_layout">
                  <t t-foreach="docs" t-as="o">
                      <t t-if="o and 'company_id' in o">
                            <t t-set="company" t-value="o.company_id"></t>
                        </t>
                        <t t-if="not o or not 'company_id' in o">
                            <t t-set="company" t-value="res_company"></t>
                        </t>
                       <div class="header">
                           <div class="row mt32 mb32">
                                <div class="col-3" style="font:12px lucida-console,sans-serif !important;">
                                    <span t-esc="company.partner_id.name"/>
                                    <br/>
                                    <span t-esc="company.partner_id.street"/>
                                    <br/>
                                    <span t-esc="company.partner_id.street2"/>
                                    <br/>
                                    <span t-esc="company.partner_id.city"/>
                                    <br/>
                                    <span t-esc="company.partner_id.country_id.name"/>
                                    <br/>
                                    <span t-esc="company.partner_id.vat"/>
                                </div>
                                <div class="col-6">
                                    <h2 class="text-center">Subscription Contracts</h2>
                                </div>
                                <div class="col-3 text-right " style="vertical-align:text-top">
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)"
                                         style="max-height: 70px; min-height:70px; min-width: 200px; max-width: 200px;"/>
                                </div>
                            </div>
                       </div>
                       <div class="page">
                           <table class="table table-striped">
                        <tr>
                            <th>Customer:</th>
                            <td>
                                <t t-if="o.partner_id.name">
                                    <t t-esc="o.partner_id.name"/>
                                </t>
                            </td>
                            <th>Reference:</th>
                            <td>
                                <t t-if="o.reference">
                                    <t t-esc="o.reference"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <th>Recurring Period:</th>
                            <td>
                                <t t-if="o.recurring_period">
                                    <t t-esc="o.recurring_period"/>
                                    <t t-esc="o.recurring_period_interval"/>
                                </t>
                            </td>
                            <th>Company:</th>
                            <td>
                                <t t-if="o.company_id">
                                    <t t-esc="o.company_id.name"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <th>Start Date:</th>
                            <td>
                                <t t-if="o.date_start">
                                    <t t-esc="o.date_start"/>
                                </t>
                            </td>
                            <th>End Date:</th>
                            <td>
                                <t t-if="o.date_end">
                                    <t t-esc="o.date_end"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <th>Stage:</th>
                            <td>
                                <t t-if="o.state">
                                    <t t-esc="o.state"/>
                                </t>
                            </td>
                            <th>Date of Next Invoice:</th>
                            <td>
                                <t t-if="o.next_invoice_date">
                                    <t t-esc="o.next_invoice_date"/>
                                </t>
                            </td>
                        </tr>
                        </table>
                        <H3>Contract Lines</H3>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <h2>
                                            <th scope="col">Product</th>
                                        </h2>
                                        <h2>
                                            <th scope="col">Description</th>
                                        </h2>
                                        <h2>
                                            <th scope="col">Ordered Qty</th>
                                        </h2>
                                        <h2>
                                            <th scope="col">Unit Price</th>
                                        </h2>
                                        <h2>
                                            <th scope="col">Discount (%)</th>
                                        </h2>
                                        <h2>
                                            <th scope="col">Subtotal</th>
                                        </h2>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.contract_line_ids"
                                       t-as='res'>
                                        <tr>
                                            <td>
                                                <t t-esc="res.product_id.name"/>
                                            </td>
                                            <td>
                                                <t t-esc="res.description"/>
                                            </td>
                                            <td>
                                                <t t-esc="res.qty_ordered"/>
                                                <t t-esc='res.product_uom_id.name'/>
                                            </td>
                                            <td>
                                                <t t-esc="res.price_unit"
                                                   t-options="{'widget': 'monetary', 'display_currency': res.currency_id}"/>
                                            </td>
                                            <td>
                                                <t t-if="res.discount">
                                                    <t t-esc="res.discount"/>
                                                </t>
                                            </td>
                                            <td>
                                                <t t-esc="res.sub_total"
                                                   t-options="{'widget': 'monetary', 'display_currency': res.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div style="text-align: right; margin-top: 10px;">
                                    <span style="font-weight: bold; margin-right: 15px;">Total Amount:</span>
                                    <span t-esc="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </div>
                             <div class="col-12" t-if="o.note">
                                            <div style="font-size: 20px;" class="col-1">Terms and Conditions</div>
                                            <div class="col-11">
                                                <span style="font-size: 16px;" t-esc="o.note"/>
                                            </div>
                             </div>
                       </div>
                       <div class="footer o_background_footer">
                            <div class="text-center">
                                <ul class="list-inline">
                                    <li>
                                        <strong>Printed by :</strong>
                                        <span t-esc="request.env.user.name"/>
                                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"
                                              style="padding-left:2em;"/>
                                    </li>
                                </ul>
                                <div t-if="report_type == 'pdf'" class="text-muted">
                                    Page:
                                    <span class="page"/>
                                    of
                                    <span class="topage"/>
                                </div>
                            </div>
                        </div>
                  </t>
             </t>
         </t>
     </template>

      <template id="sales_contract_and_recurring_invoices_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="sales_contract_and_recurring_invoices.sales_contract_and_recurring_invoices_report_document"
                       t-lang="user.partner_id.lang"/>
                </t>
            </t>
        </template>

