<odoo>
    <!-- Report Template -->
    <template id="report_contract_document_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <h2>Contract Document</h2>
                <!-- <p><strong>Showroom:</strong> <t t-esc="doc.showroom_id.name"/></p>
                <p><strong>Promoter:</strong> <t t-esc="doc.promoter_id.name"/></p>
                <p><strong>Start Date:</strong> <t t-esc="doc.from_date"/></p>
                <p><strong>End Date:</strong> <t t-esc="doc.to_date"/></p> -->
            </t>
        </t>
    </template>

    <!-- Report Action -->
    <report
        id="action_report_contract_document"
        model="subscription.contracts"
        string="Contract Document"
        report_type="qweb-pdf"
        name="sales_contract_and_recurring_invoices.report_contract_document_template"
        file="sales_contract_and_recurring_invoices.report_contract_document_template"
    />
</odoo>




