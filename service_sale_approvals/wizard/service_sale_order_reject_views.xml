<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="service_sale_order_reject_view_form" model="ir.ui.view">
        <field name="name">service.sale.order.reject.view.form</field>
        <field name="model">service.sale.order.reject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="order_id" readonly="1" invisible="1"/>
                        <field name="reason"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Reject" name="action_reject_service_sale_order" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_service_sale_order_reject" model="ir.actions.act_window">
        <field name="name">Service Sale Order Reject</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">service.sale.order.reject</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_order_id': context.get('active_id')}</field>
    </record>
</odoo>
