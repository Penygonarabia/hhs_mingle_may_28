<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_menu_access_copy_wizard_form" model="ir.ui.view">
        <field name="name">menu.access.copy.wizard.form</field>
        <field name="model">menu.access.copy.wizard</field>
        <field name="arch" type="xml">
            <form string="Copy Menu Rights">
                <group>
                    <!-- no_open: hides the internal-link arrow that would jump
                         from this dialog to the raw res.users form. -->
                    <field name="source_user_id"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="target_user_ids" widget="many2many_tags"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_copy" type="object" string="Copy Rights"
                            class="btn-primary"
                            confirm="This overwrites every target user's menu access to exactly match the source user."/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_menu_access_copy_wizard" model="ir.actions.act_window">
        <field name="name">Copy Menu Rights</field>
        <field name="res_model">menu.access.copy.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_menu_access_copy_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
