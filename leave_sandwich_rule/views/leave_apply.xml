<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="leave_form_inherit" model="ir.ui.view">
            <field name="name">leave.form.inherit</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field invisible="1" name="set_notification"/>
                    <div invisible="set_notification == False">
                        Sandwich
                        leave is Active.
                    </div></field></field>
        </record>
        <!--  <record id="leave_sandwich_inherit" model="ir.ui.view">
            <field name="name">leave.sandwish.form.inherit</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="set_notification" invisible="1"/>
                    <div attrs="{'invisible':[('set_notification', '=', False)]}">Sandwich
                        leave is Active.
                    </div></field></field>
        </record> -->
        <record id="employee_form_sandwich_inherit" model="ir.ui.view">
            <field name="name">sandwich.leave</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='hr_settings']" position="inside">
                    <group>
                        <group name="sandwich_apply" string="Sandwich Leave">
                            <field name="sandwich" widget="boolean_toggle"/>
                            <field name="leave_notification"/>
                        </group>
                    </group>
                </xpath></field>
        </record>
        <record id="resource_calendar_inherit" model="ir.ui.view">
            <field name="name">sandwich.leave</field>
            <field name="model">resource.calendar</field>
            <field name="inherit_id" ref="resource.resource_calendar_form"/>
            <field name="arch" type="xml">
                <field name="tz" position="after">
                    <group groups="hr_holidays.group_hr_holidays_manager" name="main_info">
                        <label for="sandwich"/>
                        <div class="o_row">
                            <field name="sandwich" nolabel="1" widget="boolean_toggle"/>
                        </div>
                    </group></field></field>
        </record>
    </data>
</odoo>
