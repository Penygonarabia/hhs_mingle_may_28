<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_invoices_product_profit_wizard" model="ir.ui.view">
        <field name="name">sh.invoice.product.profit.wizard</field>
        <field name="model">sh.invoice.product.profit.wizard</field>
        <field name="arch" type="xml">
            <form string="Invoices Product Profit">
                <group>
                    <group>
                        <field name="sh_start_date"/>
                        <field name="sh_move_type" widget="radio"/>
                        <field invisible="report_by_customer == 'product' and report_by_vendor == 'product'" name="sh_partner_ids" options="{'no_create': True}" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="sh_end_date"/>
                        <field invisible="sh_move_type in ['in_invoice', 'in_refund']" name="report_by_customer" widget="radio"/>
                        <field invisible="sh_move_type in ['out_invoice', 'out_refund']" name="report_by_vendor" widget="radio"/>
                        <field invisible="report_by_customer == 'customer_report' and report_by_vendor == 'vendor_report'" name="sh_product_ids" widget="many2many_tags"/>
                        <field groups="base.group_multi_company" name="company_ids" options="{'no_create': True}" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button class="oe_highlight" icon="fa-print" name="print_report" string="Print" type="object"/>
                    or
                    <button class="oe_highlight" icon="fa-file-excel-o" name="print_xls_report" string="Print In XLS" type="object"/>
                    or
                    <button class="btn-default" special="cancel" string="Cancel"/>
                    <button class="oe_highlight" name="generate_report" string="Generate" type="object"/>
                </footer>
            </form></field>
    </record>
    <record id="sh_invoices_product_profit_tree_view" model="ir.ui.view">
        <field name="name">sh.invoice.product.profit.wizard.tree</field>
        <field name="model">sh.invoice.product.profit.wizard</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0" edit="0" limit="30" string="Product Profit">
                <field name="invoice_number" widget="none"/>
                <field name="invoice_date" widget="none"/>
                <field name="invoice_date_time" widget="none"/>
                <field invisible="1" name="invoice_time"/>
                <!--                      <field name="invoice_date_time" widget="none"  context="{'group_by': 'invoice_date_time:hour'}"/>
 -->
                <!--                     <field name="bill_date" widget="none" attrs="{'invisible':[('move_type','in',['out_invoice','out_refund'])]}"/>
 -->
                <field name="product_category" widget="none"/>
                <field name="account_analytic_id" widget="none"/>
                <field name="customer_name" widget="none"/>
                <!--                     <field name="vendor_name" widget="none"/>
 -->
                <field name="product_id" widget="none"/>
                <field class="text-right" name="product_quantity" sum="Total"/>
                <field class="text-right" name="product_cost" sum="Total"/>
                <field class="text-right" name="product_sales" sum="Total"/>
                <field class="text-right" name="tax_individual" sum="Total"/>
                <field class="text-right" name="untaxed_total" sum="Total"/>
                <field class="text-right" name="product_discount" sum="Total"/>
                <field class="text-right" name="product_profit" sum="Total"/>
                <!--                     <field name="product_margin" class="text-right"/>
 -->
            </tree></field>
    </record>
