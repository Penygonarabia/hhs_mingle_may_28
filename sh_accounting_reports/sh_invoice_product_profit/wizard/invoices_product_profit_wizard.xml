    <record id="view_invoice_product_profit_pivot" model="ir.ui.view">
        <field name="name">sh.invoice.product.profit.wizard.pivot</field>
        <field name="model">sh.invoice.product.profit.wizard</field>
        <field name="arch" type="xml">
            <pivot string="Invoice Product Profit">
                <field name="invoice_number"/>
                <field name="invoice_date"/>
                <field name="invoice_date_time"/>
                <field name="product_category"/>
                <field name="product_quantity" type="measure"/>
                <field name="product_cost" type="measure"/>
                <field name="product_sales" type="measure"/>
                <field name="tax_individual" type="measure"/>
                <field name="untaxed_total" type="measure"/>
                <field name="product_discount" type="measure"/>
                <field name="product_profit" type="measure"/>
                <!-- 	                    <field name="product_margin" type="measure"/>
 -->
            </pivot></field>
    </record>
    <record id="action_invoices_product_profit" model="ir.actions.act_window">
        <field name="name">Sales and Cost Analysis Report - Detail</field>
        <field name="res_model">sh.invoice.product.profit.wizard</field>
        <field name="view_id" ref="sh_invoices_product_profit_wizard"/>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem action="action_invoices_product_profit" id="sh_invoices_product_profit_report_menuitem" parent="account.account_reports_management_menu" sequence="100"/>
    <menuitem action="action_invoices_product_profit" id="menu_sales_summary_report_detail" name="Sales and Cost Analysis Report - Detail" parent="sale.menu_sale_report" sequence="6"/>
