<!-- 											<th style="border: 1px solid black;">Margin(%)</th>
 -->										</tr>
									</thead>
									<tbody class="invoice_tbody">
										<t t-foreach="move_dic_by_customers[customer]" t-as="move">
											<t t-set="sale_price" t-value="(move.get('sale_price',0.0)*move.get('qty',0.0) - move.get('sale_price',0.0)*move.get('qty',0.0)*move.get('discount')/100)" />
											<t t-set="cost_price" t-value="(move.get('cost',0.0)*move.get('qty',0.0))" />
											<t t-set="profit" t-value="((move.get('sale_price',0.0)*move.get('qty',0.0))-move.get('sale_price',0.0)*move.get('qty',0.0)*move.get('discount')/100) - (move.get('cost',0.0)*move.get('qty',0.0))" />
											<tr>
												<td style="border: 1px solid black;">
													<span t-esc="move.get('invoice_number','')" />
												</td>
												<td style="border: 1px solid black;">
													<span t-esc="move.get('invoice_date','')" t-options='{"widget": "date"}' />
												</td>
												<td style="border: 1px solid black;">
													<span t-esc="move.get('product_category','')" />
												</td>
												<td style="border: 1px solid black;">
													<span t-esc="move.get('analytic_account','')" />
												</td>
												
												<td style="border: 1px solid black;">
													<span t-esc="move.get('product','')" />
												</td>
												<td style="border: 1px solid black;">
													<span t-esc="'%.2f'%(move.get('qty',0.0))" />
												</td>
												<td style="border: 1px solid black;">
													<span t-esc="'%.2f'%(move.get('cost',0.0) * move.get('qty',0.0))" />
												</td>
												<td style="border: 1px solid black;">
													<span t-esc="'%.2f'%(move.get('sale_price',0.0) * move.get('qty',0.0))" />
												</td>
												<td style="border: 1px solid black;">
													<span t-esc="'%.2f'%(move.get('discount',0.0))" />
												</td>
												<td style="border: 1px solid black;">
