									<h4>Invoices Product Profit</h4>
								</b>
								<b>
									<span t-esc="date_start" t-options="{'widget': 'date'}" />
									To
									<span t-esc="date_end" t-options="{'widget': 'date'}" />
								</b>
							</div>
						</div>
					</div>
					<br />
					<t t-if="report_by == 'customer' or report_by == 'vendor'">
						<t t-if="move_dic_by_customers">
							<t t-foreach="move_dic_by_customers.keys()" t-as="customer">
								<center>
									<b>
										<span t-esc="customer" />
									</b>
								</center>
								<t t-set="total_cost" t-value="0" />
								<t t-set="total_sales_price" t-value="0" />
								<t t-set="total_profit" t-value="0" />
<!-- 								<t t-set="total_margin" t-value="0" />
 -->								<table class="table table-sm o_main_table table-bordered" style="table-layout: fixed; border: 1px solid black;" id="">
