		<field name="report_type">qweb-pdf</field>
		<field name="report_name">sh_accounting_reports.sh_invoices_product_profit_doc</field>
		<field name="print_report_name">'Invoices Product Profit'</field>
		<field name="paperformat_id" ref="sh_accounting_reports.paperformat_invoices_product_profit" />
	</record>
