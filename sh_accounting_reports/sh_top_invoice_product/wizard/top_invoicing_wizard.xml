<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_tip_top_invoicing_product_wizard_form_view" model="ir.ui.view">
        <field name="name">sh.tip.top.invoicing.product.wizard.form.view</field>
        <field name="model">sh.tip.top.invoicing.product.wizard</field>
        <field name="arch" type="xml">
            <form string="Top Invoicing Products">
                <group>
                    <group>
                        <field name="type" widget="radio"/>
                    </group>
                    <group/>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="no_of_top_item"/>
                        <field name="product_uom_qty"/>
                        <field name="sh_move_type" widget="radio"/>
                        <field groups="base.group_multi_company" name="company_ids" options="{'no_create': True}" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field invisible="type != 'compare'" name="date_compare_from" required="type == 'compare'"/>
                        <field invisible="type != 'compare'" name="date_compare_to" required="type == 'compare'"/>
                    </group>
                </group>
                <footer>
                    <button class="btn-primary" name="filter_top_invoicing_product" string="Filter" type="object"/>
                    <button class="btn-primary" name="print_top_invoicing_product_report" string="Print Report" type="object"/>
                    <button class="oe_highlight" name="print_top_invoicing_product_xls_report" string="Print Xls" type="object"/>
                    <button class="btn-default" special="cancel" string="Cancel"/>
                </footer>
            </form></field>
    </record>
    <record id="sh_tip_top_invoicing_product_wizard_action" model="ir.actions.act_window">
        <field name="name">Top Invoicing Products</field>
        <field name="res_model">sh.tip.top.invoicing.product.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="sh_tip_top_invoicing_product_wizard_form_view"/>
    </record>
</odoo>
