<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="sh_invoice_by_category_doc">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="oe_structure" />
                    <div class="row pt-4">
                        <div class="col-12 mx-auto">
                            <div class="text-center">
                            	<b>
                                    <h4>Invoices By Product Category</h4>
                                </b>
                                <b>
                                    <span t-esc="date_start" t-options="{'widget': 'date'}" />
                                    To
                                    <span t-esc="date_end" t-options="{'widget': 'date'}" />
                                </b>
                            </div>
                        </div>
                    </div>
                    <br />
                    <t t-if="category_move_dic">
                        <t t-foreach="category_move_dic.keys()" t-as="category">
                            <center>
                                <b>
                                    <span t-esc="category"/>
                                </b>
                            </center>
                            <table class="table table-sm o_main_table table-bordered" style="table-layout: fixed; border: 1px solid black;" id="">
                                <thead style="display: table-row-group;" class="thead-light">
                                    <tr style="border: 1px solid black;">
                                        <th style="border: 1px solid black;">Number</th>
                                        <th style="border: 1px solid black;">Date</th>
                                        <th style="border: 1px solid black;">Product</th>
                                        <th style="border: 1px solid black;">Qty</th>
                                        <th style="border: 1px solid black;">Price</th>
                                        <th style="border: 1px solid black;">Tax</th>
                                        <th style="border: 1px solid black;">Subtotal</th>
                                        <th style="border: 1px solid black;">Total</th>
                                    </tr>
                                </thead>
                                <t t-set="total_qty" t-value="0.0"/>
                                <t t-set="total_price" t-value="0.0"/>                              
                                <t t-set="total_tax" t-value="0.0"/>                              
                                <t t-set="total_subtotal" t-value="0.0"/>
                                <t t-set="total" t-value="0.0"/>
                                <t t-set="currency" t-value="False"/>
                                <tbody class="invoice_tbody">
                                	<t t-foreach="category_move_dic[category]" t-as="move">
                                		<t t-set="total_qty" t-value="total_qty + move.get('qty',0.0)"/>
                                        <t t-set="total_price" t-value="total_price + move.get('sale_price',0.0)"/>
                                        <t t-set="total_tax" t-value="total_tax + move.get('tax',0.0)"/>
                                        <t t-set="total_subtotal" t-value="total_subtotal + (move.get('qty','') * move.get('sale_price',0.0))"/>
                                        <t t-set="total" t-value="total_subtotal + total_tax"/>
                                        <t t-set="currency" t-value="request.env['res.currency'].sudo().browse(move.get('account_currency_id',False))"/>
	                                    <tr>
	                                        <td style="border: 1px solid black;">
	                                            <span t-esc="move.get('invoice_number','')"/>
	                                        </td>
	                                        <td style="border: 1px solid black;">
	                                            <span t-esc="move.get('invoice_date','')" t-options='{"widget": "date"}' />
	                                        </td>
	                                        <td style="border: 1px solid black;">
	                                            <span t-esc="move.get('product','')"/>
	                                        </td>
	                                        <td style="border: 1px solid black;">
	                                            <span t-esc="move.get('qty',0.0)"/>
	                                        </td>
	                                        <td style="border: 1px solid black;">
	                                            <span t-esc="move.get('sale_price',0.0)" t-options='{"widget": "monetary", "display_currency": currency}' />
	                                        </td>	
                                            <td style="border: 1px solid black;">
	                                            <span t-esc="move.get('tax',0.0)" t-options='{"widget": "monetary", "display_currency": currency}' />
	                                        </td>	                                        	                                        
	                                        <td style="border: 1px solid black;">
	                                            <span t-esc="move.get('qty','') * move.get('sale_price',0.0)" t-options='{"widget": "monetary", "display_currency": currency}' />
	                                        </td>
	                                        <td style="border: 1px solid black;">
	                                            <span t-esc="(move.get('qty','') * move.get('sale_price',0.0)) + move.get('tax',0.0)" t-options='{"widget": "monetary", "display_currency": currency}' />
	                                        </td>
	                                    </tr>
									</t>
                                    <tr>
                                        <td style="border: 1px solid black;">
                                        </td>
                                        <td style="border: 1px solid black;">
                                        </td>
										<td style="border: 1px solid black;">
											<strong>Total</strong>
                                        </td> 
                                        <td style="border: 1px solid black;">
                                            <span t-esc="'%.2f'%(total_qty)" />
                                        </td>  
                                        <td style="border: 1px solid black;">
                                            <span t-esc="'%.2f'%(total_price)" />
                                        </td>
                                        <td style="border: 1px solid black;">
                                            <span t-esc="'%.2f'%(total_tax)"/>
                                        </td>                                                                                
                                        <td style="border: 1px solid black;">
                                            <span t-esc="'%.2f'%(total_subtotal)" />
                                        </td> 
                                        <td style="border: 1px solid black;">
                                            <span t-esc="'%.2f'%(total)" />
                                        </td>                                     
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </t>
                </div>
            </t>
        </t>
    </template>
    <record id="paperformat_invoice_by_product_category" model="report.paperformat">
        <field name="name">Invoice By Product Category</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">60</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">55</field>
        <field name="dpi">90</field>
    </record>
    <record id="sh_invoice_by_category_action" model="ir.actions.report">
        <field name="name">Invoice By Product Category</field>
        <field name="model">report.sh_accounting_reports.sh_invoice_by_category_doc</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_accounting_reports.sh_invoice_by_category_doc</field>
        <field name="print_report_name">'Invoice By Product Category'</field>
        <field name="paperformat_id" ref="sh_accounting_reports.paperformat_invoice_by_product_category"/>
    </record>
</odoo>