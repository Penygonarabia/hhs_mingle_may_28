<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- wizard view with from_date and to_date -->
    <record id="sh_tci_top_customer_wizard_form" model="ir.ui.view">
        <field name="name">sh.tci.top.customer.wizard.form</field>
        <field name="model">sh.tci.top.customer.wizard</field>
        <field name="arch" type="xml">
            <form string="Top Customers">
                <group>
                    <group>
                        <field name="type" widget="radio"/>
                    </group>
                    <group/>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="no_of_top_item"/>
                    </group>
                    <group>
                        <field invisible="type != 'compare'" name="date_compare_from" required="type == 'compare'"/>
                        <field invisible="type != 'compare'" name="date_compare_to" required="type == 'compare'"/>
                    </group>
                    <group>
                        <field name="amount_total"/>
                        <field invisible="1" name="currency_id"/>
                        <field groups="base.group_multi_company" name="company_ids" options="{'no_create': True}" widget="many2many_tags"/>
                        <field name="sh_move_type" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button class="oe_highlight" default_focus="1" name="print_top_customer_report" string="Print" type="object"/>
                    <button class="oe_highlight" name="print_top_customer_xls_report" string="Print Xls" type="object"/>
                    <button class="btn-default" special="cancel" string="Cancel"/>
                </footer>
            </form></field>
    </record>
    <record id="sh_tci_top_customer_wizard_action" model="ir.actions.act_window">
        <field name="name">Top Customers/Vendors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.tci.top.customer.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sh_tci_top_customer_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_type">report</field>
    </record>
    <menuitem action="sh_tci_top_customer_wizard_action" id="sh_tci_top_customer_wizard_menuitem" parent="account.menu_finance_reports"/>
</odoo>
