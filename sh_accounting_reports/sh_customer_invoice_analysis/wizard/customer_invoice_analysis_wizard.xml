<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_customer_invoices_analysis_wizard" model="ir.ui.view">
        <field name="name">sh.invoices.analysis.wizard</field>
        <field name="model">sh.invoices.analysis.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer/Vendor Invoice Analysis">
                <group>
                    <group>
                        <field name="sh_start_date"/>
                        <field name="sh_status" widget="radio"/>
                        <field name="sh_partner_ids" options="{'no_create': True}" widget="many2many_tags"/>
                        <field groups="base.group_multi_company" name="company_ids" options="{'no_create': True}" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="sh_end_date"/>
                        <field name="report_by" widget="radio"/>
                        <field name="sh_move_type" widget="radio"/>
                        <field invisible="report_by == 'move'" name="sh_product_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button class="oe_highlight" icon="fa-print" name="print_report" string="Print" type="object"/>
                    or
                    <button class="oe_highlight" icon="fa-file-excel-o" name="print_xls_report" string="Print In XLS" type="object"/>
                    or
                    <button class="btn-default" special="cancel" string="Cancel"/>
                </footer>
            </form></field>
    </record>
    <record id="action_customer_invoice_analysis" model="ir.actions.act_window">
        <field name="name">Customer/Vendor Invoices Analysis</field>
        <field name="res_model">sh.invoices.analysis.wizard</field>
        <field name="view_id" ref="sh_customer_invoices_analysis_wizard"/>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem action="action_customer_invoice_analysis" id="sh_customer_invoices_analysis_report_menuitem" parent="account.menu_finance_reports"/>
</odoo>
