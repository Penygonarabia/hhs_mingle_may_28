<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- "Promoter Dashboards" container menu under PBI Dashboards root -->
        <menuitem id="menu_pbi_promoter_dashboards"
                  name="Promoter Dashboards"
                  parent="pbi_dashboards.pbi_dashboards_app_root"
                  sequence="25"/>

        <record id="action_pbi_promoters" model="ir.actions.client">
            <field name="name">Promoters</field>
            <field name="tag">pbi_dashboards.promoter_dashboard_promoters</field>
        </record>

        <menuitem id="menu_pbi_promoters"
                  name="Promoters"
                  parent="pbi_promoter_dashboards.menu_pbi_promoter_dashboards"
                  sequence="10"
                  action="pbi_promoter_dashboards.action_pbi_promoters"/>

        <record id="action_pbi_promoter_sales_comparison" model="ir.actions.client">
            <field name="name">Promoter - Sales Comparison</field>
            <field name="tag">pbi_dashboards.promoter_dashboard_promoter_sales_comparison</field>
        </record>

        <menuitem id="menu_pbi_promoter_sales_comparison"
                  name="Promoter - Sales Comparison"
                  parent="pbi_promoter_dashboards.menu_pbi_promoter_dashboards"
                  sequence="20"
                  action="pbi_promoter_dashboards.action_pbi_promoter_sales_comparison"/>
    </data>
</odoo>
