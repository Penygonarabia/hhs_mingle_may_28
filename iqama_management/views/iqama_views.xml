        <!-- Iqama Form View -->
        <record id="view_iqama_form" model="ir.ui.view">
            <field name="name">iqama.form</field>
            <field name="model">iqama.management</field>
            <field name="arch" type="xml">
                <form string="Iqama Form">
                    <sheet>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Iqama Tree View -->
        <record id="view_iqama_tree" model="ir.ui.view">
            <field name="name">iqama.tree</field>
            <field name="model">iqama.management</field>
            <field name="arch" type="xml">
                <tree string="Iqama List">
                    <field name="code"/>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <!-- Iqama Action -->
        <record id="action_iqama" model="ir.actions.act_window">
            <field name="name">Iqama Profession</field>
            <field name="res_model">iqama.management</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_iqama_tree"/>
        </record>
        <menuitem id="menu_iqama"
                  name="Iqama Profession"
                  parent="hr.menu_human_resources_configuration"
                  sequence="24"
                  action="action_iqama"
                  />

