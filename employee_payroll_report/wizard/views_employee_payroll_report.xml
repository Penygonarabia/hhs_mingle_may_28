<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_payroll_report_form" model="ir.ui.view">
        <field name="name">employee.payroll.report.wizard</field>
        <field name="model">employee.payroll.report</field>
        <field name="arch" type="xml">
            <form string="Employee Payroll Report">
                <group>
                    <group>
                        <div class="o_td_label" style="width:175px;">
                            <label for="employee_ids" string="Employee name"/>
                        </div>
                        <field name="employee_ids" nolabel="1" options="{'no_create': True, 'no_create_edit':True}" widget="many2many_tags"/>
                        <field name="department_ids" options="{'no_create': True, 'no_create_edit':True}" widget="many2many_tags"/>
                        <field name="job_title_ids" options="{'no_create': True, 'no_create_edit':True}" widget="many2many_tags"/>
                        <field name="nationality_ids" options="{'no_create': True, 'no_create_edit':True}" widget="many2many_tags"/>
                        <field name="branch_location_ids" options="{'no_create': True, 'no_create_edit':True}" widget="many2many_tags"/>
                        <field name="sort_by"/>
                    </group>
                    <group>
                        <div class="o_td_label" style="width:200px;">
                            <label for="from_date" string="From Date"/>
                        </div>
                        <field name="from_date" nolabel="1"/>
                        <field name="to_date" required="from_date == True"/>
                        <field name="structure_id"/>
                        <field invisible="1" name="company_id"/>
                    </group>
                </group>
                <footer>
                    <button class="oe_highlight" name="print_payroll_report" string="Print Excel" type="object"/>
                    <button class="btn-secondary" name="clear" special="cancel" string="Cancel"/>
                </footer>
            </form></field>
    </record>
    <record id="action_employee_payroll_report" model="ir.actions.act_window">
        <field name="name">Employee Payroll Report</field>
        <field name="res_model">employee.payroll.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_employee_payroll_report_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_employee_payroll_report"/>
        <field name="binding_type">report</field>
    </record>
    <menuitem id="menu_payroll_report_xlsx" name="Reports" parent="om_hr_payroll.menu_hr_payroll_root" sequence="200"/>
    <menuitem action="action_employee_payroll_report" id="menu_action_employee_payroll_report" name="Employee Payroll Report" parent="menu_payroll_report_xlsx" sequence="10"/>
</odoo>
