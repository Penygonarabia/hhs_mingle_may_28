<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
<!--                <app data-string="Hyperbill Settings" string="Hyperbill Settings" name="hyperpay_settings">-->
                <app data-string="Hyperbill Settings" string="Hyperbill Settings" name="hyperpay_settings"
                data-key="hyperbill_payments" logo="/hyperbill_payments/static/description/icon.png"
                groups="machine_repair_management.group_machine_repair_user">

                    <h2>Hyperbill Settings</h2>
                    <div class="row mt16 o_settings_container" id="hyperpay_connection_settings">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
                                    Enter Hyperbill API URL
                                </div>
                                <div class="content-group">
                                    <div class="mt16 row">
                                        <label for="hyperpay_url" string="API URL" class="col-xs-3 col-md-3 o_light_label"/>
                                        <field name="hyperpay_url"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
                                    Select API Environment
                                </div>
                                <div class="content-group">
                                    <div class="mt16 row">
                                        <label for="hyperpay_environment" string="Environment" class="col-xs-3 col-md-3 o_light_label"/>
                                        <field name="hyperpay_environment"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt16 o_settings_container" id="hyperpay_auth_settings">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
                                    Hyperbill Account Email
                                </div>
                                <div class="content-group">
                                    <div class="mt16 row">
                                        <label for="hyperpay_email" string="Email" class="col-xs-3 col-md-3 o_light_label"/>
                                        <field name="hyperpay_email"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
                                    Hyperbill Account Password
                                </div>
                                <div class="content-group">
                                    <div class="mt16 row">
                                        <label for="hyperpay_password" string="Password" class="col-xs-3 col-md-3 o_light_label"/>
                                        <field name="hyperpay_password" password="True"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt16 o_settings_container" id="hyperpay_token_settings">
                        <div class="col-xs-12 col-md-12 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
                                    API Authentication Token
                                </div>
                                <div class="content-group">
                                    <div class="mt16 row">
                                        <label for="hyperpay_token" string="API Token" class="col-xs-12 col-md-12 o_light_label"/>
                                        <field name="hyperpay_token" readonly="1" style="height: 80px; font-size: 12px; overflow-y: auto; word-break: break-all;"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt16 o_settings_container" id="hyperpay_token_expiry">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
                                    Token Expiration Date
                                </div>
                                <div class="content-group">
                                    <div class="mt16 row">
                                        <label for="hyperpay_date_expires" string="Token Expires" class="col-xs-3 col-md-3 o_light_label"/>
                                        <field name="hyperpay_date_expires" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                     <div class="row mt16 o_settings_container" id="hyperpay_actions">
                        <div class="col-xs-12 col-md-12 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="mt16 row">
                                        <button name="action_generate_token" type="object" string="Generate Token" class="btn btn-primary"/>
                                        <div class="text-muted mt4">
                                            Generate new authentication token using the provided credentials
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </app>
            </xpath>
        </field>
    </record>
</odoo>