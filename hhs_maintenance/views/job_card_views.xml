<?xml version = "1.0" encoding = "utf-8" ?>
<odoo>
	
	<record id = "project_task_inherit_product_information" model= "ir.ui.view">
		<field name = "name">project.task.product.inform</field>
		<field name = "model">project.task</field>
		<field name = "inherit_id" ref = "machine_repair_management.view_project_task_form"/>
		<field name = "arch" type = "xml">
		
			<xpath expr = "//group[@name='product_information']/field[@name='product_slno']" position = "before">
				<field name = "brand_id" readonly="inspection_started_status_check != True" placeholder=" " class="underline-empty" invisible="not project_related_amc_bool" options ="{'no_create':True,'no_edit':True,'no_open':True}"/>
                 <field name = "items_from_own_company_bool" invisible = "not project_related_amc_bool"/>
                 <field name = "model_id" readonly="inspection_started_status_check != True" placeholder=" " class="underline-empty" options ="{'no_create':True,'no_edit':True,'no_open':True}" invisible="items_from_own_company_bool" domain="[('brand_id', '=', brand_id)]"/>
               	<!--  <field name = "product_unit_type_ids" invisible="1" widget="many2many_tags"/> -->
                <field name = "product_product_model_id" string = "Model" invisible = "not items_from_own_company_bool" domain ="[('id','in',product_search_ids)]"/>
                <field name = "product_search_ids" widget = "many2many_tags" invisible = "1"/>
			</xpath>
			
		</field>
	</record>
	
	<record id = "project_task_mobile_view" model = "ir.ui.view">
		<field name = "name" >project.task.mobile.view.inherit</field>
		<field name = "model">project.task</field>
		<field name = "inherit_id" ref = "machine_repair_management.view_task_form_desktop_accordion"/>
		<field name = "arch" type = "xml">
			<xpath expr="//div[@id='Maintenance']//field[@name='product_slno']" position="before">
				<field name = "brand_id" readonly="state == 'closed'" placeholder=" " class="underline-empty" invisible="not project_related_amc_bool" options ="{'no_create':True,'no_edit':True,'no_open':True}"/>
                 <field name = "items_from_own_company_bool" invisible = "not project_related_amc_bool"/>
                 <field name = "model_id" readonly="state == 'closed'" placeholder=" " class="underline-empty" options ="{'no_create':True,'no_edit':True,'no_open':True}" invisible="items_from_own_company_bool" domain="[('brand_id', '=', brand_id)]"/>
               	<!--  <field name = "product_unit_type_ids" invisible="1" widget="many2many_tags"/> -->
                <field name = "product_product_model_id" string = "Model" invisible = "not items_from_own_company_bool" domain ="[('id','in',product_search_ids)]"/>
                <field name = "product_search_ids" widget = "many2many_tags" invisible = "1"/>
			
			</xpath>
			<xpath expr="//div[@id='Maintenance']//field[@name='brand']" position="attributes">
				<attribute name ="invisible">1</attribute>
			</xpath>
			<xpath expr="//div[@id='Maintenance']//field[@name='model']" position="attributes">
				<attribute name ="invisible">1</attribute>
			</xpath>
		
		</field>
		
	</record>

</odoo>
