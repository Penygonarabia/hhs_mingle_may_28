<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_maintenance_equipment_form" model="ir.ui.view">
        <field name="name">res.config.settings.maintenance.equipment.form.inherit</field>
        <field name="model">res.config.settings</field>
        <!-- <field name ="priority" eval="40"/> -->
        <field name="inherit_id" ref="machine_repair_management.res_config_settings_service_module_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='machine_repair_management']" position="inside">
                <h2>Contract</h2>
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_right_pane">
                        <div class="d-flex align-items-center" style="gap: 4px;">
                            <field name="maintenance_equipment_show"
                                   context="{'default_company_id': company_id}"
                                   style="margin: 0; padding: 0;"/>
                            <label for="maintenance_equipment_show" style="margin: 0; padding: 0;"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>