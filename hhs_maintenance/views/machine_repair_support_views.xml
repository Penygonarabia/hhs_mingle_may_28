<?xml version = "1.0" encoding = "utf-8" ?>
<odoo>
	
	<record id = "machine_repair_support_form_view_inherit" model="ir.ui.view">
		<field name = "name">machine.repair.support.tree.form</field>
		<field name = "model">machine.repair.support</field>
		<field name = "inherit_id" ref = "machine_repair_management.machine_repair_support_form_view"/>
		<field name = "arch" type = "xml">
		
			<xpath expr = "//field[@name = 'brand']" position = "before">
				 <field name = "brand_id" readonly="state == 'closed'" placeholder=" " class="underline-empty" invisible="not project_related_amc_bool"/>
                 <field name = "items_from_own_company_bool" invisible = "not project_related_amc_bool"/>
                 <field name = "model_id" readonly="state == 'closed'" placeholder=" " class="underline-empty" invisible="items_from_own_company_bool" domain="[('brand_id', '=', brand_id)]"/>
               	<!--  <field name = "product_unit_type_ids" invisible="1" widget="many2many_tags"/> -->
                <field name = "product_product_model_id" string = "Model" invisible = "not items_from_own_company_bool" domain ="[('id','in',product_search_ids)]"/>
                <field name = "product_search_ids" widget = "many2many_tags" invisible = "1"/>
				
			</xpath>
		
		</field>
	</record>

</odoo>