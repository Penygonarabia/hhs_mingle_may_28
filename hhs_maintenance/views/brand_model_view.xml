    <!--            <field name="model_id" options="{'no_create': True}"/>-->
    <!--        </xpath>-->
    <!--    </field>-->
    <!--</record>-->

    <!-- Menus under Configuration -->

    <menuitem id="menu_hhs_maintenance_brand" name="Brands" sequence="40"
              parent="maintenance.menu_maintenance_configuration" action="action_brand"/>
    <menuitem id="menu_hhs_maintenance_equipment_model_code" name="Equipment Model" sequence="50"
              parent="maintenance.menu_maintenance_configuration" action="action_equipment_model_code"/>
</odoo>
