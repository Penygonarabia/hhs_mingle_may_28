<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Custom group-row template for the Dashboard Rights list view.

        Replaces the entire d-flex header div so we fully control the
        "(count)" display without relying on adjacent text-node preservation.

        Grouped by user_role  → count = distinct users (Python read_group
                                already sets __count to that value).
                                Null role label → "Role Not Assigned Users"
                                (handled in getGroupDisplayName override).

        Grouped by user_id    → count = granted/total dashboards
                                group.aggregates.has_access_int = SUM granted
                                group.count = total dashboards for that user

        All other groupings   → default Odoo count.
    -->
    <t t-name="dashboard_rights.ListRenderer.GroupRow"
       t-inherit="web.ListRenderer.GroupRow"
       t-inherit-mode="primary">

        <xpath expr="//div[hasclass('d-flex') and hasclass('align-items-center')]"
               position="replace">
            <div class="d-flex align-items-center">

                <!-- Caret icon — unicode triangles to prevent FontAwesome load failures -->
                <span class="dr_group_caret me-1"
                      t-attf-style="--o-list-group-level: {{getGroupLevel(group)}}">
                    <t t-if="group.isFolded">▶</t>
                    <t t-else="">▼</t>
                </span>

                <!-- Name (bold) + count (muted) — like grouped_user_list.xml -->
                <t t-if="group.groupByField.name === 'user_id'">
                    <span class="dr_group_name_text" t-esc="getGroupDisplayName(group)"/>
                    <span class="dr_group_count_badge">
                        (<t t-esc="(group.aggregates.has_access_int || 0) + '/' + group.count"/>)
                    </span>
                </t>
                <t t-else="">
                    <span class="dr_group_name_text" t-esc="getGroupDisplayName(group)"/>
                    <span class="dr_group_count_badge">
                        (<t t-esc="group.count"/>)
                    </span>
                </t>

                <!-- Inline action buttons (unchanged) -->
                <div t-if="(groupByButtons[group.groupByField.name] and !group.isFolded and group.record.resId)"
                     class="o_group_buttons">
                    <t t-foreach="groupByButtons[group.groupByField.name]"
                       t-as="button"
                       t-key="button.id">
                        <t t-if="!evalInvisible(button.invisible, group.record)">
                            <t t-if="button.clickParams.type === 'edit'">
                                <button t-att-title="button.title"
                                        class="btn"
                                        t-on-click="() => this.editGroupRecord(group)"
                                        tabindex="-1">
                                    <i t-attf-class="fa fa-fw {{button.icon}} o_button_icon"/>
                                </button>
                            </t>
                            <t t-else="">
                                <ViewButton
                                    className="button.className"
                                    clickParams="button.clickParams"
                                    icon="button.icon"
                                    record="group.record"
                                    string="button.string"
                                    title="button.title"
                                    tabindex="'-1'"
                                />
                            </t>
                        </t>
                    </t>
                </div>

                <!-- Group pager (unchanged) -->
                <div t-if="showGroupPager(group)" t-on-click.stop="" class="ms-auto">
                    <Pager t-props="getGroupPagerProps(group)"/>
                </div>

            </div>
        </xpath>

    </t>

</templates>
