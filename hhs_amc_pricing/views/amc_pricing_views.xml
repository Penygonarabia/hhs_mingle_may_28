<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ====== TREE VIEW ====== -->
    <record id="view_amc_pricing_tree" model="ir.ui.view">
        <field name="name">amc.pricing.tree</field>
        <field name="model">amc.pricing</field>
        <field name="arch" type="xml">
            <tree string="AMC Price Calculation">
                <field name="name"/>
                <field name="category_id"/>
                <field name="brand_id"/>
                <field name="is_default"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ====== FORM VIEW ====== -->
    <record id="view_amc_pricing_form" model="ir.ui.view">
        <field name="name">amc.pricing.form</field>
        <field name="model">amc.pricing</field>
        <field name="arch" type="xml">
            <form string="AMC Price Calculation">
                <header>
                    <button name="action_calculate"
                            string="Populate List"
                            type="object"
                            class="btn-primary"
                            icon="fa-calculator"/>
                    <button name="action_create_copy"
                            string="Create a Copy"
                            type="object"
                            class="btn-secondary"
                            icon="fa-copy"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Template Name (must be unique)"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="category_id" readonly="0" options = "{'no_open':True,'no_create':True}"/>
                            <field name="brand_id" readonly="0" options = "{'no_open':True,'no_create':True}"/>
                            <field name="brand_name" invisible="1"/>
                            <field name="active"/>
                            <field name="is_default"/>
                        </group>
                        <group string="Units">
                            <field name="semi_comprehensive_units" readonly="1"/>
                            <field name="full_comprehensive_units" readonly="1"/>
                            <field name="total_units" readonly="1" class="fw-bold"/>
                        </group>
                    </group>

                    <separator string="Cost Summary"/>
                    <group>
                        <group string="Semi-Comprehensive">
                            <field name="semi_total_cost" readonly="1"/>
                            <field name="semi_cost_per_unit" readonly="1"/>
                        </group>
                        <group string="Full Comprehensive">
                            <field name="full_total_cost" readonly="1"/>
                            <field name="full_cost_per_unit" readonly="1"/>
                        </group>
                        <group string="Total">
                            <!-- <separator/> -->
                            <field name="total_cost"/>
                        </group>
                    </group>

                    <separator string="Material Cost"/>
                    <field name="line_ids">
                        <tree string="Spare Parts" editable="bottom"
                              decoration-info="is_full_comprehensive_only == True"
                              decoration-success="is_full_comprehensive_only == False">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"
                                   domain="[('product_category_id.name', '=', parent.brand_name)]"/>
                            <field name="is_full_comprehensive_only"/>
                            <field name="percent_to_use" widget="percentage"/>
                            <field name="qty" readonly="1" sum="Total"/>
                            <field name="std_unit_cost"/>
                            <field name="total_cost" sum="Total"/>
                        </tree>
                    </field>
                </sheet>
                <!-- Chatter can be added if mail module is available -->
            </form>
        </field>
    </record>

    <!-- ====== SEARCH VIEW ====== -->
    <record id="view_amc_pricing_search" model="ir.ui.view">
        <field name="name">amc.pricing.search</field>
        <field name="model">amc.pricing</field>
        <field name="arch" type="xml">
            <search string="AMC Price Calculation">
                <field name="name"/>
                <field name="category_id"/>
                <field name="brand_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Default Templates" name="default" domain="[('is_default', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Brand" name="group_brand" context="{'group_by': 'brand_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ====== ACTION ====== -->
    <record id="action_amc_pricing" model="ir.actions.act_window">
        <field name="name">AMC Price Calculation</field>
        <field name="res_model">amc.pricing</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_amc_pricing_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AMC Costing Template
            </p>
            <p>
                Define spare parts costing for Semi-Comprehensive and Full Comprehensive
                maintenance contracts.
            </p>
        </field>
    </record>

</odoo>
