<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Add 'Use for Contract' field to Product Category form -->
    <record id="view_product_category_form_inherit_amc" model="ir.ui.view">
        <field name="name">product.category.form.inherit.amc</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="allowed_is_contract"/>
            </xpath>
        </field>
    </record>

</odoo>
