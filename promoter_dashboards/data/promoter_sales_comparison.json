          "ks_data_calculation_type": "query",
          "ks_custom_query": "with target as (\n    select \n        st.showroom_id,\n        st.franchise_id,\n        st.group_id,\n        st.subgroup_id,\n        st.year::int as year,\n        st.month::int as month,\n        st.region,\n        st.city,\n        sum(st.target_qty::numeric) as target_qty\n    from sales_target st\n    group by st.showroom_id, st.franchise_id, st.group_id, st.subgroup_id, \n             st.year, st.month, st.region, st.city\n),\nactual as (\n    select \n        sa.showroom,\n        sa.product_category_id as franchise_id,\n        sa.group_id,\n        sa.subgroup_id,\n        sa.year,\n        sa.month,\n        sa.region_id,\n        sa.city_id,\n\t\tsa.date_time,\n        sum(sa.qty::numeric) as actual_qty\n    from promoter_showroom_sales sa\n    where sa.date_time between %(ks_start_date)s and %(ks_end_date)s\n\tgroup by sa.showroom, sa.product_category_id, sa.group_id, sa.subgroup_id, \n             sa.year, sa.month, sa.region_id, sa.city_id, sa.date_time\n)\nselect \n    coalesce(t.region, a.region_id::text) as region,\n    sum(coalesce(t.target_qty,0)) as total_target,\n    sum(coalesce(a.actual_qty,0)) as total_actual\nfrom target t\nleft join actual a\n    on t.showroom_id = a.showroom\n   and t.franchise_id = a.franchise_id\n   and t.group_id = a.group_id\n   and t.subgroup_id = a.subgroup_id\n   and t.year = a.year\n   and t.month = a.month\ngroup by coalesce(t.region, a.region_id::text)\nhaving sum(coalesce(a.actual_qty,0)) <> 0    -- exclude total_actual = 0\n   and sum(coalesce(t.target_qty,0)) <> 0    -- exclude total_target = 0\norder by region",
