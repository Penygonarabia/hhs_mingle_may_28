          "ks_data_calculation_type": "query",
          "ks_custom_query": "WITH target AS (\n    SELECT \n        st.showroom_id,\n        st.franchise_id,\n        st.group_id,\n        st.subgroup_id,\n        st.year::int AS year,\n        st.month::int AS month,\n        SUM(st.target_qty::numeric) AS target_qty\n    FROM sales_target st\n    GROUP BY st.showroom_id, st.franchise_id, st.group_id, st.subgroup_id, \n             st.year, st.month\n),\nactual AS (\n    SELECT \n        sa.showroom,\n        sa.product_category_id AS franchise_id,\n        sa.group_id,\n        sa.subgroup_id,\n        sa.year::int AS year,\n        sa.month::int AS month,\n\t\tsa.date_time AS sales_date,\n        SUM(sa.qty::numeric) AS actual_qty\n    FROM promoter_showroom_sales sa\n\tWHERE sa.date_time between %(ks_start_date)s and %(ks_end_date)s\n    GROUP BY sa.showroom, sa.product_category_id, sa.group_id, sa.subgroup_id, \n             sa.year, sa.month, sa.date_time\n)\nSELECT \n    rr.name AS region,\n    rc.name->>'en_US' AS city,\n    ps.name AS showroom,\n    COALESCE(SUM(t.target_qty), 0) AS total_target_qty,\n    COALESCE(SUM(a.actual_qty), 0) AS total_sales_qty,\n    COALESCE(SUM(a.actual_qty), 0) - COALESCE(SUM(t.target_qty), 0) AS variance,\n    CASE \n        WHEN COALESCE(SUM(t.target_qty), 0) = 0 THEN 0\n        ELSE ROUND(((COALESCE(SUM(a.actual_qty), 0) - SUM(t.target_qty))::numeric / NULLIF(SUM(t.target_qty), 0)) * 100, 2)\n    END AS variance_percent\nFROM target t\nleft JOIN actual a \n    ON t.showroom_id = a.showroom\n   AND t.franchise_id = a.franchise_id\n   AND t.group_id = a.group_id\n   AND t.subgroup_id = a.subgroup_id\n   AND t.year = a.year\n   AND t.month = a.month\nLEFT JOIN promoter_showroom ps \n    ON ps.id = COALESCE(t.showroom_id, a.showroom)\nLEFT JOIN res_region rr \n    ON rr.id = ps.region_id\nLEFT JOIN res_city rc\n    ON rc.id = ps.city\nGROUP BY \n    rr.name, rc.name->>'en_US', ps.name, COALESCE(t.year, a.year), COALESCE(t.month, a.month)\nHAVING SUM(COALESCE(a.actual_qty, 0)) <> 0\n   AND SUM(COALESCE(t.target_qty, 0)) <> 0\nORDER BY \n    rr.name, rc.name->>'en_US', ps.name, COALESCE(t.year, a.year), COALESCE(t.month, a.month)",
