        <record id="hr_kanban_view_employees_inherit" model="ir.ui.view">
            <field name="name">HR - Employess Kanban</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="replace">
                    <field name="name"/>
                    <field name="last_name"/>
                </xpath></field>
        </record>
        <record id="employee_no_list_view_add_inherit" model="ir.ui.view">
            <field name="name">hr.employee.tree.view</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree/field[@name='name']" position="before">
                    <field name="employee_no"/>
                </xpath>
                <xpath expr="//tree/field[@name='activity_ids']" position="attributes">
                    <attribute name="optional">
                        hide</attribute>
                </xpath>
                <xpath expr="//tree/field[@name='activity_date_deadline']" position="attributes">
                    <attribute name="optional">
                        hide</attribute>
                </xpath>
                
                <xpath expr="//tree/field[@name='parent_id']" position="after">
        			<field name="state" widget="badge" decoration-success="state == 'draft'" />
        		</xpath>
                
               
                <xpath expr="//tree/field[@name='company_id']" position="attributes">
                    <attribute name="optional">
                        hide</attribute>
                </xpath>
                <xpath expr="//tree" position="attributes">
                    <attribute name="default_order">
                        employee_no asc</attribute>
                </xpath></field>
        </record>
