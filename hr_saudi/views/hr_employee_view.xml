                </xpath>
                <xpath expr="//search/group" position="before">
                    <newline/>
                    <filter domain="[('is_saudi','=',True)]" name="Saudi" string="Saudi"/>
                    <filter domain="[('is_saudi','=',False)]" name="Non-Saudi" string="Non-saudi"/>
                </xpath></field>
        </record>
