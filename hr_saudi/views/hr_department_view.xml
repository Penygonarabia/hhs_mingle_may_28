<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!--
            Department
        -->
        <record id="view_form_hr_department_inherit" model="ir.ui.view">
            <field name="name">hr.department.form.inherit</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="before">
                    <field name="dept_code" required="1"/>
                </xpath>
                <field name="parent_id" position="before">
                    <field name="description"/>
                </field>
                <field name="name" position="after">
                    <field name="is_main_department"/>
                </field>
                <sheet position="inside">
<!--                    <group>-->
                        <separator string="Departments" colspan="4"/>
                        <field name="child_ids" nolabel="1" >
                            <tree editable="bottom" >
                                <field name="name"/>
<!--                                <field name="manager_id"/>-->
                            </tree>
                        </field>
<!--                    </group>-->
                </sheet>
<!--                Need refactoring-->
<!--                <field name="id" invisible="1"/>-->
<!--                <field name="parent_id" position="attributes">-->
<!--                    <attribute name="domain">[('id','!=',id)]</attribute>-->
<!--                </field>-->
            </field>
        </record>

<!--        Need refactoring-->
