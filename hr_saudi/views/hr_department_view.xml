        <!--
            Department Hierarchy
        -->
        <record id="view_tree_hr_department_tree_view" model="ir.ui.view">
            <field name="name">hr.department.tree.view</field>
            <field name="model">hr.department</field>
<!--            <field name="field_parent">child_ids</field>-->
            <field name="arch" type="xml">
                <tree string="Department Hierarchy">
                    <field name="dept_code"/>
                    <field name="name"/>
                    <field name="parent_id" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="action_hr_department_tree_view" model="ir.actions.act_window">
            <field name="name">Department Hierarchy</field>
            <field name="res_model">hr.department</field>
            <field name="domain">[('parent_id','=',False)]</field>
            <field name="view_id" ref="view_tree_hr_department_tree_view"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Click here to add new departments</p>
            </field>
        </record>

        <menuitem id="menu_hr_department_tree_view"
                  action="action_hr_department_tree_view"
                  parent="hr.menu_human_resources_configuration"
                  sequence="4"
                  />
        <record id="make_invisible" model="res.groups">

            <field name="name">Invisible</field>

        </record>
        <menuitem
                id="hr.menu_hr_department_kanban"
                action="hr.hr_department_kanban_action"
                parent="hr.menu_human_resources_configuration"
                groups="hr_saudi.group_hrm,hr_saudi.make_invisible"
                name="Departments" sequence="3"/>

