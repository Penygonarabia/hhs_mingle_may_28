<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record Rules: loaded after models are created -->
    <record id="rule_crm_commercial_lead_user" model="ir.rule">
        <field name="name">CRM Commercial Lead: Personal and Subordinate Leads</field>
        <field name="model_id" ref="model_crm_commercial_lead"/>
        <field name="domain_force">['|', ('assigned_id', '=', user.id), ('assigned_id.reporting_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('crm_commercial.group_crm_commercial_user'))]"/>
    </record>

    <record id="rule_crm_commercial_lead_manager" model="ir.rule">
        <field name="name">CRM Commercial Lead: Manager All Leads</field>
        <field name="model_id" ref="model_crm_commercial_lead"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('crm_commercial.group_crm_commercial_manager'))]"/>
    </record>

