<odoo>
    <!-- Quotation Excel Report Action -->
    <record id="action_report_quotation_xlsx" model="ir.actions.report">
        <field name="name">Export Quotation (Excel)</field>
        <field name="model">crm.commercial.quotation</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">crm_commercial.quotation_xlsx</field>
        <field name="report_file">crm_commercial.quotation_xlsx</field>
        <field name="binding_model_id" ref="crm_commercial.model_crm_commercial_quotation"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('crm_commercial.group_allow_export_quotation'))]"/>
    </record>

