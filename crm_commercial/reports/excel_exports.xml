<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quotation Excel Report Action -->
    <record id="action_report_quotation_xlsx" model="ir.actions.report">
        <field name="name">Export Quotation (Excel)</field>
        <field name="model">crm.commercial.quotation</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">crm_commercial.quotation_xlsx</field>
        <field name="report_file">crm_commercial.quotation_xlsx</field>
        <field name="binding_model_id" ref="crm_commercial.model_crm_commercial_quotation"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('crm_commercial.group_allow_export_quotation'))]"/>
    </record>

    <!-- Quotations list: Print Quotation (Excel) -->
    <!-- The report itself is not bound to a menu; the server action below puts it under "Actions". -->
    <record id="action_report_quotation_list_xlsx" model="ir.actions.report">
        <field name="name">Print Quotation (Excel)</field>
        <field name="model">crm.commercial.quotation</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">crm_commercial.quotation_list_xlsx</field>
        <field name="report_file">crm_commercial.quotation_list_xlsx</field>
        <field name="binding_model_id" eval="False"/>
        <field name="groups_id" eval="[(4, ref('crm_commercial.group_allow_export_quotation'))]"/>
    </record>

    <record id="action_server_quotation_list_xlsx" model="ir.actions.server">
        <field name="name">Print Quotation (Excel)</field>
        <field name="model_id" ref="crm_commercial.model_crm_commercial_quotation"/>
        <field name="binding_model_id" ref="crm_commercial.model_crm_commercial_quotation"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('crm_commercial.group_allow_export_quotation'))]"/>
        <field name="state">code</field>
        <field name="code">action = env.ref('crm_commercial.action_report_quotation_list_xlsx').report_action(records)</field>
    </record>

    <!-- Leads list: Print Leads - Excel -->
    <record id="action_report_lead_list_xlsx" model="ir.actions.report">
        <field name="name">Print Leads - Excel</field>
        <field name="model">crm.commercial.lead</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">crm_commercial.lead_list_xlsx</field>
        <field name="report_file">crm_commercial.lead_list_xlsx</field>
        <field name="binding_model_id" ref="crm_commercial.model_crm_commercial_lead"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
