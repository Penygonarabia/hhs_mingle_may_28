<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_commercial_quotation_tree" model="ir.ui.view">
        <field name="name">crm.commercial.quotation.tree</field>
        <field name="model">crm.commercial.quotation</field>
        <field name="arch" type="xml">
            <tree string="Commercial Quotations">
                <field name="region_id"/>
                <field name="city_id"/>
                <field name="assigned_id"/>
                <field name="project_name"/>
                <field name="name"/>
                <field name="date"/>
                <field name="revision_number"/>
                <field name="partner_id"/>
                <field name="total_amount" sum="Total Amount"/>
                <field name="delivered_value"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state in ('approved', 'partially_delivered')"
                       decoration-success="state in ('confirmed', 'delivered')"
                       decoration-danger="state in ('rejected', 'cancelled', 'expired')"/>
                <field name="warehouse_id" optional="hide"/>
                <field name="net_price" sum="Total Net Price" optional="hide"/>

            </tree>
        </field>
    </record>

    <record id="view_crm_commercial_quotation_form" model="ir.ui.view">
        <field name="name">crm.commercial.quotation.form</field>
        <field name="model">crm.commercial.quotation</field>
        <field name="arch" type="xml">
            <form string="Commercial Quotation">
                <header>
                    <button name="action_confirm" string="Confirm Order" type="object" class="btn-primary"
                            invisible="state not in ('draft', 'approved')"/>
                    <button name="action_copy_quotation" string="Copy Quotation" invisible="1" type="object"
                            class="btn-secondary"/>
                    <button name="action_revision" string="Create Revision" type="object" class="btn-warning"
                            invisible="state in ('cancelled', 'expired')"/>
                    <button name="action_recalculate" string="Recalculate Prices" type="object" class="btn-secondary"/>
                    <button name="action_close_quotation"
                            string="Close"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'confirmed'"
                            confirm="Are you sure you want to close this quotation?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,confirmed,delivered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object" class="oe_stat_button" icon="fa-usd"
                                invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo" string="Sale Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">

                        <h1>
                            <field name="name" readonly="1"/>
                            <span invisible="revision_number == 0">(Rev #
                                <field name="revision_number" readonly="1"/>
                                )
                            </span>
                        </h1>
                        <h2>
                            <field name="project_name" placeholder="Project Name..."/>
                        </h2>
                    </div>
                    <group string="Header Information">
                        <group>
                            <!--                            <field name="warehouse_id" domain="[('id','in',warehouse_ids)]"-->
                            <!--                                   options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>-->

                            <field name="is_warehouse_readonly" invisible="1"/>
                            <field name="is_description_readonly" invisible="1"/>
                            <field name="is_terms_readonly" invisible="1"/>

                            <field name="warehouse_id"
                                   domain="[('id', 'in', warehouse_ids)]"
                                   readonly="is_warehouse_readonly"
                                   options="{'no_open': True, 'no_create': True}"/>
                            <field name="warehouse_ids" widget="many2many_tags" invisible="1"
                                   readonly="is_warehouse_readonly"/>
                            <field name="quotation_type_id" options="{'no_create':True,'no_edit':True,'no_open':True}"
                                   readonly="is_warehouse_readonly"/>
                            <field name="quotation_type_code" invisible="True" readonly="is_warehouse_readonly"/>
                            <field name="lead_no" invisible="1" readonly="is_warehouse_readonly"/>
                            <field name="lead_id" invisible="quotation_type_code == '02'"
                                   readonly="is_warehouse_readonly"
                                   options="{'no_create':True,'no_edit':True,'no_open':True}"/>
                            <field name="partner_id" invisible="0" readonly="is_warehouse_readonly"
                                   options="{'no_create':True,'no_edit':True,'no_open':True}"/>
                            <field name="company_name" readonly="is_warehouse_readonly" options="{'no_create':True,'no_edit':True,'no_open':True}"/>
                            <field name="phone_number" readonly="is_warehouse_readonly" options="{'no_create':True,'no_edit':True,'no_open':True}"/>
                            <!--                            <field name="capacity" options="{'no_create':True,'no_edit':True,'no_open':True}"/>-->
                            <field name="to_name" readonly="is_warehouse_readonly"/>
                            <field name="email" readonly="is_warehouse_readonly"/>
                            <field name="phone" readonly="is_warehouse_readonly"/>
                            <field name="assigned_id" options="{'no_create':True,'no_edit':True,'no_open':True}"
                                   readonly="is_warehouse_readonly"/>
                            <field name="project_category_id"
                                   options="{'no_create':True,'no_edit':True,'no_open':True}"
                                   readonly="is_warehouse_readonly"/>
                            <field name="category_id" invisible="not show_product_category"
                                   domain="[('parent_id', '=', False)]"
                                   readonly="is_warehouse_readonly"/>
                            <field name="crm_product_category_ids" invisible="1" widget="many2many_tags"
                                   readonly="is_warehouse_readonly"/>
                            <field name="product_category_ids"
                                   domain="[('id','child_of',category_id),('use_for_crm_commercial', '=', True), ('exclude_category', '=', False)
                                   ,('id', '!=', category_id)]" readonly="is_warehouse_readonly" widget="many2many_tags"
                                   options="{'no_create':True,'no_edit':True,'no_open':True}"/>
                            <!--                            <field name="products_category_ids" domain="[('id','child_of',category_id),('use_for_crm_commercial', '=', True), ('exclude_category', '=', False)-->
                            <!--                                   ,('id', '!=', category_id)]" widget="many2many_tags"/>-->
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"
                                       readonly="is_warehouse_readonly"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"
                                       readonly="is_warehouse_readonly"/>
                                <field name="city_id" placeholder="City" class="o_address_city"
                                       domain="[('country_id', '=', country_id)]" readonly="is_warehouse_readonly"
                                       options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                <field name="state_id" class="o_address_state" placeholder="State"
                                       readonly="is_warehouse_readonly"
                                       options="{&quot;no_open&quot;: True}"
                                       domain="[('country_id', '=', country_id)]"/>
                                <field name="district" placeholder="District..."
                                       options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                       readonly="is_warehouse_readonly"/>
                                <field name="region_id" placeholder="Region..."
                                       options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                       readonly="is_warehouse_readonly"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"
                                       readonly="is_warehouse_readonly"/>
                                <field name="country_id" placeholder="Country" class="o_address_country"
                                       options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"
                                       readonly="is_warehouse_readonly"/>
                            </div>
                        </group>
                        <group>
                            <field name="date" readonly="is_warehouse_readonly"/>
                            <field name="expiry_date" readonly="is_warehouse_readonly"/>
                            <field name="expected_confirmation_date" readonly="is_warehouse_readonly"/>
                            <field name="project_expected_closure_date" readonly="is_warehouse_readonly"/>
                            <field name="developer" readonly="is_warehouse_readonly"/>
                            <field name="possibility_percent" readonly="is_warehouse_readonly"/>
                            <field name="project_status_id" options="{'no_create':True,'no_edit':True,'no_open':True}"/>
                            <field name="project_detail_status_id" readonly="is_warehouse_readonly"
                                   options="{'no_create':True,'no_edit':True,'no_open':True}"/>
                            <field name="consultant_id" options="{'no_create':True,'no_edit':True,'no_open':True}"
                                   readonly="is_warehouse_readonly"/>
                            <field name="tag_ids" widget="many2many_tags" readonly="is_warehouse_readonly"/>
                            <field name="ignore_for_reporting" readonly="is_warehouse_readonly"/>
                            <field name="show_vat_row_wise"/>
                            <field name="show_product_category" invisible="1"/>
                            <field name="allow_cost_rights" invisible="1"/>
                        </group>
                    </group>

                    <!-- <group string="Customer Address">
                        <group>
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city_id" placeholder="City" class="o_address_city" domain="[('country_id', '=', country_id)]"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options="{&quot;no_open&quot;: True}" domain="[('country_id', '=', country_id)]"/>
                                <field name="district" placeholder="District..."/>
                                <field name="region_id" placeholder="Region..."/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                            </div>
                        </group>
                        <group>

                        </group>
                    </group> -->

                    <!-- <group string="Customer Address">
                            <group>
                                <field name="street" placeholder="Street 1..."/>
                                <field name="street2" placeholder="Street 2..."/>
                                <field name="city_id" placeholder="City..." domain="[('country_id', '=', country_id)]"/>
                                <field name="city" invisible="1"/>
                                <field name="district" placeholder="District..."/>
                            </group>
                            <group>
                                <field name="region_id" placeholder="Region..."/>
                                <field name="state_id" placeholder="State..." domain="[('country_id', '=', country_id)]"/>
                                <field name="country_id" placeholder="Country..."/>
                                <field name="zip" placeholder="Zip..."/>
                            </group>
                        </group> -->

                    <notebook>
                        <page string="General (Material List)" name="general_tab">
                            <style>[name="line_ids"], [name="line_ids"] .o_list_renderer, [name="line_ids"]
                                .table-responsive, [name="line_ids"] .o_list_table {
                                height: auto !important;
                                min-height: unset !important;
                                flex: 0 0 auto !important;
                                } [name="line_ids"] .o_list_renderer, [name="line_ids"] .table-responsive {
                                overflow-y: hidden !important;
                                overflow-x: auto !important;
                                }
                            </style>
                            <div class="mb-2">
                                <button name="action_refresh_cost" string="Refresh Cost" type="object"
                                        class="btn-info mr-2"/>
                                <button name="action_open_import_material_list" string="Import Material List"
                                        type="object" class="btn-secondary"/>
                            </div>
                            <field name="line_ids" widget="section_and_note_one2many" readonly="state != 'draft'">
                                <tree editable="bottom" delete="state == 'draft'">
                                    <field name="is_warehouse_readonly" column_invisible="1"/>
                                    <field name="is_description_readonly" column_invisible="1"/>
                                    <field name="is_terms_readonly" column_invisible="1"/>
                                    <field name="is_default_discount_readonly" column_invisible="1"/>
                                    <field name="is_sales_price_readonly" column_invisible="1"/>
                                    <!--                                    <field name="is_warehouse_readonly" invisible="1"/>-->
                                    <control>
                                        <create name="add_product_control" string="Add a product"
                                                readonly="is_warehouse_readonly"
                                                invisible="parent.state != 'draft'"/>
                                        <create name="add_section_control" string="Add a section"
                                                context="{'default_display_type': 'line_section'}"
                                                readonly="is_warehouse_readonly"
                                                invisible="parent.state != 'draft'"/>
                                        <create name="add_note_control" string="Add a note"
                                                context="{'default_display_type': 'line_note'}"
                                                readonly="is_warehouse_readonly"
                                                invisible="parent.state != 'draft'"/>
                                    </control>
                                    <field name="sequence" widget="handle" readonly="is_warehouse_readonly"/>
                                    <field name="display_type" column_invisible="1" readonly="is_warehouse_readonly"/>
                                    <field name="sale_type_id" string="Sale Type" readonly="is_warehouse_readonly"/>
                                    <!--                                    <field name="show_product_category"-->
                                    <!--                                           column_invisible="0"/>-->

                                    <field name="product_group_id" readonly="False" domain="[('parent_id', '=', False)]"
                                           column_invisible="not parent.show_product_category"/>
                                    <!--                                    <field name="show_product_category" column_invisible="True"/>-->
                                    <!--                                    <field name="product_group_id" string="Product Category" context="{'show_code_only': True}" column_invisible="parent.show_product_category"/>-->
                                    <!-- <field name="product_group_id" string="Product Category" domain="[('use_for_crm_commercial', '=', True), ('parent_id', '=', False)]" context="{'show_code_only': True}"/> -->
                                    <field name="header_products_category_ids" column_invisible="1"/>

                                    <field name="product_category_id"
                                           string="Product Group"
                                           readonly="is_warehouse_readonly"
                                           domain="[('id', 'in', header_products_category_ids),
                ('use_for_crm_commercial', '=', True),
                ('exclude_category', '=', False)]"/>
                                    <!--                                    <field name="product_category_id" string="Product Group"-->
                                    <!--                                           readonly="is_warehouse_readonly"-->
                                    <!--                                           domain="[('use_for_crm_commercial', '=', True), ('exclude_category', '=', False), ('parent_id', 'child_of', product_group_id),-->
                                    <!--                                           ('id', '!=', product_group_id)] if product_group_id else [('id', '=', False)]"/>-->
                                    <field name="product_id" string="Part No / Product" readonly="is_warehouse_readonly"
                                           domain="[('categ_id', 'child_of', product_category_id)] if product_category_id else []"/>
                                    <field name="name" widget="section_and_note_text" string="Description / Section"
                                           optional="show" readonly="is_description_readonly"/>
                                    <field name="capacity" string="Capacity" readonly="is_warehouse_readonly"/>

                                    <field name="stock_qty" string="Stock" readonly="1"/>
                                    <field name="qty" string="Qty" readonly="is_warehouse_readonly"/>
                                    <field name="unit_cost" string="Unit Cost"
                                           column_invisible="not parent.allow_cost_rights"
                                           readonly="is_warehouse_readonly"/>
                                    <field name="special_support" string="Spl Spt" readonly="is_warehouse_readonly"/>
                                    <field name="sale_price" string="Sale Price" readonly="is_sales_price_readonly"/>
                                    <field name="discount_percent" string="Discount %"
                                           readonly="is_default_discount_readonly"/>
                                    <field name="dsi" string="DSI" readonly="1"
                                           column_invisible="not parent.allow_cost_rights"/>
                                    <field name="smc" string="SMC" readonly="1"
                                           column_invisible="not parent.allow_cost_rights"/>
                                    <field name="vat_amount" string="VAT" readonly="1"/>
                                    <field name="amount" string="Total" readonly="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_selling_price"/>
                                <field name="total_vat"/>
                                <field name="total_amount" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>


                        <page string="Additional Info &amp; Costing Summary" name="costing_tab">
                            <group string="Supplier &amp; Incentive Inputs">
                                <group>
                                    <field name="supplier_support_recording" readonly="state == 'closed'"/>
                                    <field name="dsi_type" readonly="state == 'closed'"/>
                                    <field name="dsi_percent" readonly="state == 'closed'"/>
                                </group>
                                <group>
                                    <field name="salesman_commission_percent" readonly="state == 'closed'"/>
                                    <field name="additional_discount_percent" readonly="state == 'closed'"/>
                                    <field name="promotion_percent" readonly="state == 'closed'"/>
                                </group>
                            </group>
                            <group string="Project Financial Summary">
                                <group>
                                    <field name="total_project_value" readonly="1"/>
                                    <field name="delivered_value" readonly="state == 'closed'"/>
                                    <field name="balance_value" readonly="1"/>
                                </group>
                                <group string="Costing &amp; Margin Analysis">
                                    <field name="total_selling_price" string="Total Selling Price (A)"
                                           readonly="state == 'closed'"/>
                                    <field name="total_cost" string="Total Cost (B)" readonly="state == 'closed'"/>
                                    <field name="total_supplier_support" string="Total Supplier Support (S)"
                                           readonly="state == 'closed'"/>
                                    <field name="total_dsi" string="Total DSI (C)" readonly="state == 'closed'"/>
                                    <field name="total_smc" string="Total SMC (D)" readonly="state == 'closed'"/>
                                    <field name="total_promo" string="Total Promo (E)" readonly="state == 'closed'"/>
                                    <field name="net_price" string="Net Price (X)" readonly="state == 'closed'"/>
                                    <field name="gross_margin" string="Gross Margin" readonly="state == 'closed'"/>
                                    <field name="gross_margin_percent" string="Gross Margin (%)"
                                           readonly="state == 'closed'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Payment Terms" name="payment_terms_tab">
                            <field name="payment_terms_tab" placeholder="Payment terms details..."
                                   readonly="state == 'closed' or is_terms_readonly"/>
                        </page>
                        <page string="Warranty Terms" name="warranty_terms_tab">
                            <field name="warranty_terms_tab" placeholder="Warranty terms details..."
                                   readonly="state == 'closed' or is_terms_readonly"/>
                        </page>
                        <page string="Salient Features" name="salient_features_tab">
                            <field name="salient_features_tab" placeholder="Salient features details..."
                                   readonly="state == 'closed' or is_terms_readonly"/>
                        </page>
                        <page string="Settings" name="settings_tab">
                            <field name="settings_tab" readonly="state == 'closed'"
                                   placeholder="System settings details..."/>
                        </page>
                        <page string="Reason for the loss of a project" name="reason_for_loss_project_tab">
                            <field name="reason_for_loss_project_tab"
                                   placeholder="Reason for the loss of a project details..."
                                   readonly="state == 'closed' or is_terms_readonly"/>
                        </page>
                        <page string="Audit Log" name="audit_tab">
                            <field name="audit_ids">
                                <tree create="false" delete="false">
                                    <field name="create_date" string="Timestamp" readonly="state == 'closed'"/>
                                    <field name="user_id" readonly="state == 'closed'"/>
                                    <field name="title" readonly="state == 'closed'"/>
                                    <field name="state" readonly="state == 'closed'"/>
                                    <field name="notes" readonly="state == 'closed'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_crm_commercial_quotation" model="ir.actions.act_window">
        <field name="name">Commercial Quotations</field>
        <field name="res_model">crm.commercial.quotation</field>
        <field name="view_mode">tree,form</field>

    </record>
</odoo>
