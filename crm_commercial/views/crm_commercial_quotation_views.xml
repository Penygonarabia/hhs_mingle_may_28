<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_commercial_quotation_tree" model="ir.ui.view">
        <field name="name">crm.commercial.quotation.tree</field>
        <field name="model">crm.commercial.quotation</field>
        <field name="arch" type="xml">
            <tree string="Commercial Quotations">
                <field name="name"/>
                <field name="revision_number"/>
                <field name="date"/>
                <field name="warehouse_id"/>
                <field name="partner_id"/>
                <field name="project_name"/>
                <field name="assigned_id"/>
                <field name="net_price" sum="Total Net Price"/>
                <field name="total_amount" sum="Total Amount"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state in ('approved', 'partially_delivered')" decoration-success="state in ('confirmed', 'delivered')" decoration-danger="state in ('rejected', 'cancelled', 'expired')"/>
            </tree>
        </field>
    </record>

    <record id="view_crm_commercial_quotation_form" model="ir.ui.view">
        <field name="name">crm.commercial.quotation.form</field>
        <field name="model">crm.commercial.quotation</field>
        <field name="arch" type="xml">
            <form string="Commercial Quotation">
                <header>
                    <button name="action_confirm" string="Confirm Order" type="object" class="btn-primary" invisible="state not in ('draft', 'approved')"/>
                    <button name="action_copy_quotation" string="Copy Quotation" type="object" class="btn-secondary"/>
                    <button name="action_revision" string="Create Revision" type="object" class="btn-warning" invisible="state in ('cancelled', 'expired')"/>
                    <button name="action_recalculate" string="Recalculate Prices" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,confirmed,delivered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object" class="oe_stat_button" icon="fa-usd" invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo" string="Sale Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">

                        <h1>
                            <field name="name" readonly="1"/>
                            <span invisible="revision_number == 0"> (Rev #<field name="revision_number" readonly="1"/>
)</span>
                        </h1>
                        <h2>
                            <field name="project_name" placeholder="Project Name..."/>
                        </h2>
                    </div>
                    <group string="Header Information">
                        <group>
                            <field name="warehouse_id" domain="[('id','in',warehouse_ids)]" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                            <field name="warehouse_ids" widget="many2many_tags" invisible="1" />
                            <field name="quotation_type_id" />
                            <field name="quotation_type_code" invisible="True"/>
                            <field name="lead_no" invisible="1"/>
                            <field name="lead_id" invisible="quotation_type_code == '02'"/>
                            <field name="partner_id" invisible="0"/>
                            <field name="to_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="assigned_id"/>
                            <field name="project_category_id"/>
                            <field name ="product_category_id"/>
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city_id" placeholder="City" class="o_address_city" domain="[('country_id', '=', country_id)]" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options="{&quot;no_open&quot;: True}" domain="[('country_id', '=', country_id)]"/>
                                <field name="district" placeholder="District..." options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                <field name="region_id" placeholder="Region..." options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                            </div>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="expiry_date"/>
                            <field name="expected_confirmation_date"/>
                            <field name="project_expected_closure_date"/>
                            <field name="developer"/>
                            <field name="possibility_percent"/>
                            <field name="project_status_id"/>
                            <field name="project_detail_status_id"/>
                            <field name="consultant_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="ignore_for_reporting"/>
                            <field name="show_vat_row_wise"/>
                        </group>
                    </group>

                    <!-- <group string="Customer Address">
                        <group>
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city_id" placeholder="City" class="o_address_city" domain="[('country_id', '=', country_id)]"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options="{&quot;no_open&quot;: True}" domain="[('country_id', '=', country_id)]"/>
                                <field name="district" placeholder="District..."/>
                                <field name="region_id" placeholder="Region..."/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                            </div>
                        </group>
                        <group>

                        </group>
                    </group> -->

                    <!-- <group string="Customer Address">
                            <group>
                                <field name="street" placeholder="Street 1..."/>
                                <field name="street2" placeholder="Street 2..."/>
                                <field name="city_id" placeholder="City..." domain="[('country_id', '=', country_id)]"/>
                                <field name="city" invisible="1"/>
                                <field name="district" placeholder="District..."/>
                            </group>
                            <group>
                                <field name="region_id" placeholder="Region..."/>
                                <field name="state_id" placeholder="State..." domain="[('country_id', '=', country_id)]"/>
                                <field name="country_id" placeholder="Country..."/>
                                <field name="zip" placeholder="Zip..."/>
                            </group>
                        </group> -->

                    <notebook>
                        <page string="General (Material List)" name="general_tab">
                            <style> [name="line_ids"], [name="line_ids"] .o_list_renderer, [name="line_ids"] .table-responsive, [name="line_ids"] .o_list_table {
                                        height: auto !important;
                                        min-height: unset !important;
                                        flex: 0 0 auto !important;
                                    } [name="line_ids"] .o_list_renderer, [name="line_ids"] .table-responsive {
                                        overflow-y: hidden !important;
                                        overflow-x: auto !important;
                                    }
                            </style>

                            <div class="mb-2">
                                <button name="action_refresh_cost" string="Refresh Cost" type="object" class="btn-info mr-2"/>
                                <button name="action_open_import_material_list" string="Import Material List" type="object" class="btn-secondary"/>
                            </div>
                            <field name="line_ids" widget="section_and_note_one2many">
                                <tree editable="bottom">
                                    <control>
                                        <create name="add_product_control" string="Add a product"/>
                                        <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                        <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                                    </control>
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type" column_invisible="1"/>
                                    <field name="sale_type_id" string="Sale Type"/>
                                    <field name="show_product_category" column_invisible="True"/>
                                    <field name="product_group_id" string="Product Category" context="{'show_code_only': True}" column_invisible="parent.show_product_category"/>
                                    <!-- <field name="product_group_id" string="Product Category" domain="[('use_for_crm_commercial', '=', True), ('parent_id', '=', False)]" context="{'show_code_only': True}"/> -->
                                    <field name="product_category_id" string="Product Group" domain="[('use_for_crm_commercial', '=', True), ('exclude_category', '=', False), ('parent_id', 'child_of', product_group_id), ('id', '!=', product_group_id)] if product_group_id else [('id', '=', False)]"/>
                                    <field name="product_id" string="Part No / Product" domain="[('categ_id', 'child_of', product_category_id)] if product_category_id else []"/>
                                    <field name="name" widget="section_and_note_text" string="Description / Section" optional="show"/>
                                    <field name="stock_qty" string="Stock" readonly="1"/>
                                    <field name="qty" string="Qty"/>
                                    <field name="unit_cost" string="Unit Cost"/>
                                    <field name="sale_price" string="Sale Price"/>
                                    <field name="discount_percent" string="Discount %"/>
                                    <field name="dsi" string="DSI" readonly="1"/>
                                    <field name="smc" string="SMC" readonly="1"/>
                                    <field name="special_support" string="Spl Spt"/>
                                    <field name="vat_amount" string="VAT" readonly="1"/>
                                    <field name="amount" string="Total" readonly="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_selling_price"/>
                                <field name="total_vat"/>
                                <field name="total_amount" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>


                        <page string="Additional Info &amp; Costing Summary" name="costing_tab">
                            <group string="Supplier &amp; Incentive Inputs">
                                <group>
                                    <field name="supplier_support_recording"/>
                                    <field name="dsi_type"/>
                                    <field name="dsi_percent"/>
                                </group>
                                <group>
                                    <field name="salesman_commission_percent"/>
                                    <field name="additional_discount_percent"/>
                                    <field name="promotion_percent"/>
                                </group>
                            </group>
                            <group string="Project Financial Summary">
                                <group>
                                    <field name="total_project_value" readonly="1"/>
                                    <field name="delivered_value"/>
                                    <field name="balance_value" readonly="1"/>
                                </group>
                                <group string="Costing &amp; Margin Analysis">
                                    <field name="total_selling_price" string="Total Selling Price (A)"/>
                                    <field name="total_cost" string="Total Cost (B)"/>
                                    <field name="total_supplier_support" string="Total Supplier Support (S)"/>
                                    <field name="total_dsi" string="Total DSI (C)"/>
                                    <field name="total_smc" string="Total SMC (D)"/>
                                    <field name="total_promo" string="Total Promo (E)"/>
                                    <field name="net_price" string="Net Price (X)"/>
                                    <field name="gross_margin" string="Gross Margin"/>
                                    <field name="gross_margin_percent" string="Gross Margin (%)"/>
                                </group>
                            </group>
                        </page>

                        <page string="Payment Terms" name="payment_terms_tab">
                            <field name="payment_terms_tab" placeholder="Payment terms details..."/>
                        </page>
                        <page string="Warranty Terms" name="warranty_terms_tab">
                            <field name="warranty_terms_tab" placeholder="Warranty terms details..."/>
                        </page>
                        <page string="Salient Features" name="salient_features_tab">
                            <field name="salient_features_tab" placeholder="Salient features details..."/>
                        </page>
                        <page string="Settings" name="settings_tab">
                            <field name="settings_tab" placeholder="System settings details..."/>
                        </page>
                        <page string="Audit Log" name="audit_tab">
                            <field name="audit_ids">
                                <tree create="false" delete="false">
                                    <field name="create_date" string="Timestamp"/>
                                    <field name="user_id"/>
                                    <field name="title"/>
                                    <field name="state"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_crm_commercial_quotation" model="ir.actions.act_window">
        <field name="name">Commercial Quotations</field>
        <field name="res_model">crm.commercial.quotation</field>
        <field name="view_mode">tree,form</field>

    </record>
</odoo>
