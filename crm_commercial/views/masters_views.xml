<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Generic Master Form View Template -->
        <!-- Customer Type -->
        <record id="view_crm_commercial_customer_type_tree" model="ir.ui.view">
            <field name="name">crm.commercial.customer.type.tree</field>
            <field name="model">crm.commercial.customer.type</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="action_crm_commercial_customer_type" model="ir.actions.act_window">
            <field name="name">Customer Types</field>
            <field name="res_model">crm.commercial.customer.type</field>
            <field name="view_mode">tree</field>
        </record>

        <!-- Project Category -->
        <record id="view_crm_commercial_project_category_tree" model="ir.ui.view">
            <field name="name">crm.commercial.project.category.tree</field>
            <field name="model">crm.commercial.project.category</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="action_crm_commercial_project_category" model="ir.actions.act_window">
            <field name="name">Project Categories</field>
            <field name="res_model">crm.commercial.project.category</field>
            <field name="view_mode">tree</field>
        </record>

        <!-- Quotation Type -->
        <record id="view_crm_commercial_quotation_type_tree" model="ir.ui.view">
            <field name="name">crm.commercial.quotation.type.tree</field>
            <field name="model">crm.commercial.quotation.type</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="action_crm_commercial_quotation_type" model="ir.actions.act_window">
            <field name="name">Quotation Types</field>
            <field name="res_model">crm.commercial.quotation.type</field>
            <field name="view_mode">tree</field>
        </record>

        <!-- Sale Type -->
        <record id="view_crm_commercial_sale_type_tree" model="ir.ui.view">
            <field name="name">crm.commercial.sale.type.tree</field>
            <field name="model">crm.commercial.sale.type</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="action_crm_commercial_sale_type" model="ir.actions.act_window">
            <field name="name">Sale Types</field>
            <field name="res_model">crm.commercial.sale.type</field>
            <field name="view_mode">tree</field>
        </record>

        <!-- Project Status -->
        <record id="view_crm_commercial_project_status_tree" model="ir.ui.view">
            <field name="name">crm.commercial.project.status.tree</field>
            <field name="model">crm.commercial.project.status</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="probability" string="Probability %"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>


        <record id="action_crm_commercial_project_status" model="ir.actions.act_window">
            <field name="name">Project Statuses</field>
            <field name="res_model">crm.commercial.project.status</field>
            <field name="view_mode">tree</field>
        </record>

        <!-- Project Detail Status -->
        <record id="view_crm_commercial_project_detail_status_tree" model="ir.ui.view">
            <field name="name">crm.commercial.project.detail.status.tree</field>
            <field name="model">crm.commercial.project.detail.status</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="action_crm_commercial_project_detail_status" model="ir.actions.act_window">
            <field name="name">Project Detail Statuses</field>
            <field name="res_model">crm.commercial.project.detail.status</field>
            <field name="view_mode">tree</field>
        </record>

        <!-- Consultant -->
        <record id="view_crm_commercial_consultant_tree" model="ir.ui.view">
            <field name="name">crm.commercial.consultant.tree</field>
            <field name="model">crm.commercial.consultant</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="action_crm_commercial_consultant" model="ir.actions.act_window">
            <field name="name">Consultants</field>
            <field name="res_model">crm.commercial.consultant</field>
            <field name="view_mode">tree</field>
        </record>

        <!-- Linked Products -->
        <record id="view_crm_commercial_linked_product_tree" model="ir.ui.view">
            <field name="name">crm.commercial.linked.product.tree</field>
            <field name="model">crm.commercial.linked.product</field>
            <field name="arch" type="xml">
                <tree string="Linked Products">
                    <field name="source_product_id" string="Source Part No"/>
                    <field name="linked_product_id" string="Linked Part No"/>
                    <field name="status" widget="badge" decoration-success="status == 'active'" decoration-danger="status == 'inactive'"/>
                </tree>
            </field>
        </record>

        <record id="view_crm_commercial_linked_product_form" model="ir.ui.view">
            <field name="name">crm.commercial.linked.product.form</field>
            <field name="model">crm.commercial.linked.product</field>
            <field name="arch" type="xml">
                <form string="Add New Catalog Link">
                    <sheet>
                        <group>
                            <group>
                                <field name="source_product_id" string="Source Part No" placeholder="Type part number to search..."/>
                                <field name="linked_product_id" string="Linked Part No" placeholder="Type part number to search..."/>
                                <field name="status" string="Status"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="action_crm_commercial_linked_product" model="ir.actions.act_window">
            <field name="name">Linked Products</field>
            <field name="res_model">crm.commercial.linked.product</field>
            <field name="view_mode">tree,form</field>
        </record>
</odoo>

