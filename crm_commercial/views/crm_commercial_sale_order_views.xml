<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_crm_commercial_sale_order_tree" model="ir.ui.view">
            <field name="name">crm.commercial.sale.order.tree</field>
            <field name="model">crm.commercial.sale.order</field>
            <field name="arch" type="xml">
                <tree string="Commercial Sale Orders" create="false">
                    <field name="name"/>
                    <field name="quotation_no"/>
                    <field name="partner_id"/>
                    <field name="project_name"/>
                    <field name="assigned_id"/>
                    <field name="date_order"/>
                    <field name="expiry_date"/>
                    <field name="expected_gross_margin"/>
                    <field name="actual_gross_margin"/>
                    <field name="total_amount" sum="Total Amount"/>
                    <field name="state" widget="badge" decoration-info="state == 'confirmed'" decoration-warning="state == 'partially_delivered'" decoration-success="state == 'delivered'" decoration-danger="state == 'cancelled'"/>
                </tree>
            </field>
        </record>

        <record id="view_crm_commercial_sale_order_form" model="ir.ui.view">
            <field name="name">crm.commercial.sale.order.form</field>
            <field name="model">crm.commercial.sale.order</field>
            <field name="arch" type="xml">
                <form string="Commercial Sale Order" create="false">
                    <header>
                        <button name="action_open_expiry_extension" string="Extend Expiry Date" type="object" class="btn-warning"/>
                        <field name="state" widget="statusbar" statusbar_visible="confirmed,partially_delivered,delivered"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                            <h2>
                                <field name="project_name" readonly="1"/>
                            </h2>
                        </div>
                        <group string="Order Header">
                            <group>
                                <field name="quotation_id" readonly="1"/>
                                <field name="quotation_no" readonly="1"/>
                                <field name="quotation_type_id" readonly="1"/>
                                <field name="partner_id" readonly="1"/>
                                <field name="to_name" readonly="1"/>
                                <field name="email" readonly="1"/>
                                <field name="phone" readonly="1"/>
                                <field name="warehouse_id" readonly="1"/>
                                <field name="assigned_id" readonly="1"/>
                                <field name="project_category_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="date_order" readonly="1"/>
                                <field name="expiry_date" readonly="1"/>
                                <field name="expected_gross_margin" readonly="1"/>
                                <field name="actual_gross_margin" readonly="1"/>
                                <field name="consultant_id" readonly="1"/>
                                <field name="developer" readonly="1"/>
                                <field name="project_status_id" readonly="1"/>
                                <field name="project_detail_status_id" readonly="1"/>
                                <field name="tag_ids" widget="many2many_tags" readonly="1"/>
                            </group>
                        </group>

                        <group string="Customer Address">
                            <group>
                                <field name="street" readonly="1"/>
                                <field name="street2" readonly="1"/>
                                <field name="city_id" readonly="1"/>
                                <field name="city" invisible="1"/>
                                <field name="district" readonly="1"/>
                            </group>
                            <group>
                                <field name="region_id" readonly="1"/>
                                <field name="state_id" readonly="1"/>
                                <field name="country_id" readonly="1"/>
                                <field name="zip" readonly="1"/>
                            </group>
                        </group>

                        <group string="Costing &amp; Totals Summary">
                            <group>
                                <field name="total_selling_price" readonly="1"/>
                                <field name="total_cost" readonly="1"/>
                                <field name="total_supplier_support" readonly="1"/>
                                <field name="total_dsi" readonly="1"/>
                                <field name="total_smc" readonly="1"/>
                            </group>
                            <group>
                                <field name="total_promo" readonly="1"/>
                                <field name="net_price" readonly="1"/>
                                <field name="total_vat" readonly="1"/>
                                <field name="total_amount" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Order Items" name="items_tab">
                                <field name="line_ids" readonly="1">
                                    <tree create="false" edit="false" delete="false">
                                        <field name="product_group_id" string="Group" readonly="1" context="{'show_code_only': True}"/>
                                        <field name="product_category_id" string="Category" readonly="1"/>
                                        <field name="product_id" string="Part No / Product" readonly="1"/>
                                        <field name="name" string="Description" optional="show" readonly="1"/>
                                        <field name="qty" string="Ordered Qty" readonly="1"/>
                                        <field name="delivered_qty" string="Delivered Qty" readonly="1"/>
                                        <field name="pending_qty" string="Pending Qty" readonly="1"/>
                                        <field name="unit_cost" string="Unit Cost" optional="hide" readonly="1"/>
                                        <field name="sale_price" string="Sale Price" readonly="1"/>
                                        <field name="discount_percent" string="Discount %" readonly="1"/>
                                        <field name="vat_amount" string="VAT" readonly="1"/>
                                        <field name="amount" string="Total Amount" readonly="1"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="Delivery Schedule" name="delivery_schedule_tab">
                                <field name="delivery_schedule_ids">
                                    <tree editable="bottom" create="false" delete="false">
                                        <field name="order_line_id" string="Order Item" readonly="1"/>
                                        <field name="product_id" string="Product" readonly="1"/>
                                        <field name="scheduled_date" string="Scheduled Date"/>
                                        <field name="qty_to_deliver" string="Qty to Deliver"/>
                                        <field name="delivered_qty" string="Delivered Qty"/>
                                        <field name="pending_qty" string="Pending Qty" readonly="1"/>
                                        <field name="status" string="Status" widget="selection"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="Audit Log" name="audit_tab">
                                <field name="audit_ids">
                                    <tree create="false" edit="false" delete="false">
                                        <field name="create_date" string="Timestamp"/>
                                        <field name="user_id"/>
                                        <field name="title"/>
                                        <field name="state"/>
                                        <field name="notes"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_crm_commercial_sale_order" model="ir.actions.act_window">
            <field name="name">Commercial Sale Orders</field>
            <field name="res_model">crm.commercial.sale.order</field>
            <field name="view_mode">tree,form</field>
        </record>
</odoo>

