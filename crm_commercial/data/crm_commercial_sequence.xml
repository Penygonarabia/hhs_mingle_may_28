<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_crm_commercial_lead" model="ir.sequence">
            <field name="name">CRM Commercial Lead Sequence</field>
            <field name="code">crm.commercial.lead</field>
            <field name="prefix">LEAD/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_crm_commercial_quotation" model="ir.sequence">
            <field name="name">CRM Commercial Quotation Sequence</field>
            <field name="code">crm.commercial.quotation</field>
            <field name="prefix">QUO/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_crm_commercial_sale_order" model="ir.sequence">
            <field name="name">CRM Commercial Sale Order Sequence</field>
            <field name="code">crm.commercial.sale.order</field>
            <field name="prefix">ORD/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
