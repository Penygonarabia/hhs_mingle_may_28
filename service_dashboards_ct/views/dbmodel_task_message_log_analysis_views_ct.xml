<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pivot View -->
    <record id="view_dbmodel_task_message_log_analysis_ct_pivot" model="ir.ui.view">
        <field name="name">dbmodel.task.message.log.analysis.ct.pivot</field>
        <field name="model">dbmodel.task.message.log.analysis.ct</field>
        <field name="arch" type="xml">
            <pivot string="Services Analysis" sample="1">
                <field name="region" type="row"/>
                <field name="task_date" interval="month" type="col"/>
                <field name="total_worked_hours" type="measure"/>
                <field name="technician_travel_hours" type="measure"/>
                <field name="onhold_hours" type="measure"/>
                <field name="task_count" type="measure"/>
                <field name="on_hold_task_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_dbmodel_task_message_log_analysis_ct_graph" model="ir.ui.view">
        <field name="name">dbmodel.task.message.log.analysis.ct.graph</field>
        <field name="model">dbmodel.task.message.log.analysis.ct</field>
        <field name="arch" type="xml">
            <graph string="Services Analysis" type="bar" sample="1">
                <field name="task_date" interval="month" type="row"/>
                <field name="task_count" type="measure"/>
                <field name="on_hold_task_count" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_dbmodel_task_message_log_analysis_ct_search" model="ir.ui.view">
        <field name="name">dbmodel.task.message.log.analysis.ct.search</field>
        <field name="model">dbmodel.task.message.log.analysis.ct</field>
        <field name="arch" type="xml">
            <search string="Search Services Analysis">
                <field name="task_id"/>
                <field name="user_id"/>
                <field name="region"/>
                <field name="city"/>
                <field name="status_transition"/>

                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="My Work Location" name="my_work_location" domain="[('is_user_work_location', '=', True)]"/>
                <filter string="My User Group" name="my_user_group" domain="[('is_my_user_group', '=', True)]"/>

                <group expand="0" string="Group By">
                    <filter string="Task Month" name="group_by_month" context="{'group_by':'task_date:month'}"/>
                    <filter string="Region" name="group_by_region" context="{'group_by':'region'}"/>
                    <filter string="City" name="group_by_city" context="{'group_by':'city'}"/>
                    <filter string="User" name="group_by_user" context="{'group_by':'user_id'}"/>
                    <filter string="Status Transition" name="group_by_status" context="{'group_by':'status_transition'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dbmodel_task_message_log_analysis" model="ir.actions.act_window">
        <field name="name">Services Analysis</field>
        <field name="res_model">dbmodel.task.message.log.analysis.ct</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="search_view_id" ref="view_dbmodel_task_message_log_analysis_ct_search"/>
        <field name="context">{'search_default_active': 1, 'search_default_group_by_month': 1}</field>
    </record>

</odoo>
