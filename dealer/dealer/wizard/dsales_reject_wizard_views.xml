<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsales_reject_wizard_form" model="ir.ui.view">
        <field name="name">dsales.reject.wizard.form</field>
        <field name="model">dsales.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Sales">
                <group>
                    <field name="reason" placeholder="Enter reason for rejection..."/>
                </group>
                <footer>
                    <button string="Confirm Reject" name="action_confirm_reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dsales_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Sales</field>
        <field name="res_model">dsales.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
