<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================
         FORM VIEW (Back-office Approval)
    ================================================================ -->
    <record id="view_dsales_showroom_invoice_form" model="ir.ui.view">
        <field name="name">dsales.showroom.invoice.form</field>
        <field name="model">dsales.showroom.invoice</field>
        <field name="arch" type="xml">
            <form string="Approve Shop Sales">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            invisible="state in ('approved','rejected')" class="oe_highlight"
                            groups="dealer.group_dealer_backoffice_user"/>
                    <button name="action_reject"  type="object" string="Reject"
                            invisible="state in ('approved','rejected')"
                            groups="dealer.group_dealer_backoffice_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <field name="dealer_id"          readonly="state != 'draft'"/>
                        <field name="dealer_showroom_id" readonly="state != 'draft'"/>
                        <field name="salesman_id"        readonly="state != 'draft'"/>
                        <field name="invoice_number"     readonly="state != 'draft'"/>
                        <field name="date_time"          readonly="state != 'draft'"/>
                    </group>

                    <!-- Reject Reason: shown for backoffice when approving/rejecting -->
                    <group 
                           groups="dealer.group_dealer_backoffice_user">
                        <field name="reject_reason" colspan="2"
                               placeholder="Enter rejection reason here (required for Reject)..."
                               readonly="state == 'rejected'"/>
                    </group>

                    <notebook>
                        <page string="Item Details">
                            <div class="row w-100 m-0">
                                <div class="col-12 col-md-8 p-0 pe-md-4">
                                    <field name="sale_line_ids" readonly="1" nolabel="1" class="w-100">
                                        <tree create="0" edit="0" delete="0">
                                            <field name="product_category_id" string="Category"/>
                                            <field name="product_group_id"    string="Group"/>
                                            <field name="product_subgroup_id" string="Sub Group"/>
                                            <field name="product_id"          string="Model"/>
                                            <field name="product_name"        string="Name"/>
                                            <field name="capacity"/>
                                            <field name="qty"/>
                                        </tree>
                                    </field>
                                </div>
                                <div class="col-12 col-md-4 p-0">
                                    <div style="font-size:15px;font-weight:bold;color: #070808ff;margin-top: 0px;margin-bottom: 10px;">Invoice Scan Copy</div>
                                    <field name="invoice_attachment"
                                           nolabel="1"
                                           widget="image"
                                           options="{'size': [512, 512]}"
                                           readonly="1"
                                           class="w-100"/>
                                </div>
                            </div>
                        </page>
                    </notebook>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids"         widget="mail_activity"/>
                    <field name="message_ids"          widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ================================================================
         TREE VIEW
    ================================================================ -->
<record id="view_dsales_showroom_invoice_tree" model="ir.ui.view">
    <field name="name">dsales.showroom.invoice.tree</field>
    <field name="model">dsales.showroom.invoice</field>
    <field name="arch" type="xml">
        <tree string="Approve Shop Sales">
            <field name="dealer_id"/>
            <field name="dealer_showroom_id"/>
            <field name="salesman_id"/>
            <field name="invoice_number"/>
            <field name="date_time"/>
            <field name="state"/>
        </tree>
    </field>
</record>

    <!-- ================================================================
         ACTION
    ================================================================ -->
    <record id="action_dsales_showroom_invoice_approve" model="ir.actions.act_window">
        <field name="name">Approve Shop Sales</field>
        <field name="res_model">dsales.showroom.invoice</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_dsales_showroom_invoice_tree"/>
        <!-- <field name="domain">[('state','in',['submitted','pending'])]</field> -->
    </record>

    <!-- ================================================================
         MENU
    ================================================================ -->
    <menuitem id="menu_dsales_showroom_invoice_approve"
              name="Approve Shop Sales"
              parent="dealer.menu_dealer_root"
              action="action_dsales_showroom_invoice_approve"
              sequence="25"
              groups="dealer.group_floor_sales_approval"/>

</odoo>
