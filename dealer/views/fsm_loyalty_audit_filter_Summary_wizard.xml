<odoo>
<record id="view_fsm_loyalty_audit_filter_wizard" model="ir.ui.view">
    <field name="name">fsm.loyalty.audit.filter.summary.wizard.form</field>
    <field name="model">fsm.loyalty.audit.filter.summary.wizard</field>
    <field name="arch" type="xml">
        <form string="Filter Loyalty Audits">
            <group>
                <field name="start_date"/>
                <field name="end_date"/>
            </group>
            <footer>
                <button string="Apply" type="object" name="apply_filter_summary" class="btn-primary"/>
                <button string="Cancel" special="cancel" class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>

<record id="action_fsm_loyalty_audit_filter_summary_wizard" model="ir.actions.act_window">
    <field name="name">Filter Loyalty Audits</field>
    <field name="res_model">fsm.loyalty.audit.filter.summary.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

         
    <!-- Menu -->
    <menuitem id="menu_fsm_loyalty_analysis_mob"
              name="Loyalty Points Summary"
              parent="menu_dealer_root"
              action="action_fsm_loyalty_audit_filter_summary_wizard"
              groups="dealer.group_dealer_user"
              sequence="100"/>
</odoo>
