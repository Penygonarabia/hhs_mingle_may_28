<odoo>
    <!-- Form View -->
    <record id="view_form_dealer_assignment" model="ir.ui.view">
        <field name="name">dsales.assignment.form</field>
        <field name="model">dsales.assignment</field>
        <field name="arch" type="xml">
            <form string="Dealer Assignment">
                <sheet>
                    <group>
                        <field name="dealer_id"
                               modifiers='{"readonly": [["active", "=", false]]}'
                               options="{'no_create_edit': true, 'no_open': true, 'no_create': true, 'no_edit': true}"/>
                        <field name="dealer_showroom_id"
                               domain="[('dealer_id', '=', dealer_id), ('sale_dealer_required', '=', True)]"
                               modifiers='{"readonly": [["active", "=", false]]}'
                               options="{'no_create_edit': true, 'no_open': true, 'no_create': true, 'no_edit': true}"/>
                        <field name="available_sale_dealer_ids" invisible="1"/>
                        <field name="sale_dealer_id" 
                               domain="[( 'id', 'in', available_sale_dealer_ids )]"
                               modifiers='{"readonly": [["active", "=", false]]}'/>
                        <field name="category_id"
                               modifiers='{"readonly": [["active", "=", false]]}'/>
                        <field name="from_date" modifiers='{"readonly": [["active", "=", false]]}'/>
                        <field name="to_date" modifiers='{"readonly": [["active", "=", false]]}'/>
                        <field name="dealer_conflict" invisible="1"/>
                    </group>

                    <group string="Shift 1">
                        <field name="shift1_from" style="width: 100px;" modifiers='{"readonly": [["active", "=", false]]}'/>
                        <field name="shift1_to" style="width: 100px;" modifiers='{"readonly": [["active", "=", false]]}'/>
                    </group>

                    <group string="Shift 2">
                        <field name="shift2_from" style="width: 100px;" modifiers='{"readonly": [["active", "=", false]]}'/>
                        <field name="shift2_to" style="width: 100px;" modifiers='{"readonly": [["active", "=", false]]}'/>
                    </group>

                    <group>
                        <field name="active" readonly="1"/>
                    </group>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_tree_dealer_assignment" model="ir.ui.view">
        <field name="name">dsales.assignment.tree</field>
        <field name="model">dsales.assignment</field>
        <field name="arch" type="xml">
            <tree string="Dealer Assignments">
                <field name="dealer_id"/>
                <field name="dealer_showroom_id"/>
                <field name="category_id"/>
                <field name="sale_dealer_id"/>
                <field name="from_date"/>
                <field name="to_date"/>
                <field name="shift1_from"/>
                <field name="shift1_to"/>
                <field name="shift2_from"/>
                <field name="shift2_to"/>
                <field name="active" readonly="1"/>
            </tree>
        </field>
    </record>

<record id="view_search_dealer_assignment" model="ir.ui.view">
    <field name="name">dsales.assignment.search</field>
    <field name="model">dsales.assignment</field>
    <field name="arch" type="xml">
        <search string="Dealer Assignments">
            <field name="dealer_id"/>
            <field name="dealer_showroom_id"/>
            <field name="sale_dealer_id"/>
            <field name="from_date"/>
            
            <separator/>
            
            <filter name="active_assignments" string="Active Assignments" domain="[('active','=',True)]"/>
            
            <group expand="0" string="Group By">
                <filter name="group_dealer" string="Dealer" context="{'group_by': 'dealer_id'}"/>
                <filter name="group_showroom" string="Showroom" context="{'group_by': 'dealer_showroom_id'}"/>
                <filter name="group_sale_dealer" string="Sale Dealer" context="{'group_by': 'sale_dealer_id'}"/>
            </group>
        </search>
    </field>
</record>

    <!-- Action -->
    <record id="action_dealer_assignment" model="ir.actions.act_window">
        <field name="name">Assign Salesman</field>
        <field name="res_model">dsales.assignment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="view_id" ref="view_tree_dealer_assignment"/>
        <field name="search_view_id" ref="view_search_dealer_assignment"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first dealer assignment.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_dealer_assignment_action"
              name="Assign Salesman"
              parent="menu_dealer_configuration"
              action="action_dealer_assignment" 
              groups="dealer.group_dealer_backoffice_user"
              sequence="30"/>
</odoo>
