<odoo>

    <!-- Product Template -->
    <record id="view_product_template_form_fsm_loyalty" model="ir.ui.view">
        <field name="name">product.template.form.fsm.loyalty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <field name="show_dealer_menu" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='uom_po_id']" position="before">
                <field name="fsm_loyalty_points" invisible="not show_dealer_menu"/>
                <field name="show_in_dealer_app" invisible="not show_dealer_menu"/>
                <field name="is_outdoor_unit" invisible="not show_dealer_menu"/>
                <field name="is_midea_brand" invisible="not show_dealer_menu"/>
            </xpath>

        </field>
    </record>


    <!-- Product Variant -->
    <record id="view_product_product_form_fsm_loyalty" model="ir.ui.view">
        <field name="name">product.product.form.fsm.loyalty</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <field name="show_dealer_menu" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='uom_po_id']" position="before">
                <field name="fsm_loyalty_points" invisible="not show_dealer_menu"/>
                <field name="show_in_dealer_app" invisible="not show_dealer_menu"/>
                <field name="is_outdoor_unit" invisible="not show_dealer_menu"/>
                <field name="is_midea_brand" invisible="not show_dealer_menu"/>
            </xpath>

        </field>
    </record>

</odoo>