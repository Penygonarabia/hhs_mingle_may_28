<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_form_dealer_showroom_sales" model="ir.ui.view">
        <field name="name">dsales.showroom.sales.form</field>
        <field name="model">dsales.showroom.sales</field>
        <field name="arch" type="xml">
            <form >
                <sheet>
                    <group class="deskvw">
                        <field name="dealer_id" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                        <field name="dealer_showroom_id" domain="[('dealer_id', '=', dealer_id),('sale_dealer_required','=',True)]" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                        <field name="dealer_assignment_id"
                               domain="[('dealer_id', '=', dealer_id), ('dealer_showroom_id', '=', dealer_showroom_id)]" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                    </group>
                    <group  class="deskvw">
                        <field name="date_time"/>
                        <field name="product_category_id" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                        <field name="group_id" domain="[('parent_id','=',product_category_id),('allowed_group_is_promoter','=',True)]" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                        <field name="subgroup_id" domain="[('parent_id','=',group_id),('allowed_group_is_promoter','=',True)]" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                        <field name="product_id" domain="[('product_sub_grouping_id', 'child_of', subgroup_id), ('use_for_promoter', '=', True)]" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                        <field name="size_id" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                        <field name="is_sales_return"/>
                        <field name="qty"/>   
                        <field name="invoice_id" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                        <field name="approval_state" readonly="1"/>
                        <field name="calculated_points" readonly="1"/>
                        <field name="multiplier_applied" readonly="1"/>
                        <field name="final_points" readonly="1"/>
                        <field name="fsm_loyalty_points" readonly="1"/>                     
                        <field name="notes" colspan="2"/>
                        <field name="user_id" invisible="1" force_save="1"/>
                        <field name="dealer_mobile_user_bool" invisible="1"/>
                        <field name="dealer_access_bool" invisible="1"/> 
                        <field name="current_latitude" invisible="1"/>
                        <field name="current_longitude" invisible="1"/>  
                        <field name = "work_center_location_id" invisible ="1"/>                     
                    </group>
                    <group class="mobvw">
                        <field name="date_time"/>
                        <field name="product_category_id" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                        <field name="group_id" domain="[('parent_id','=',product_category_id),('allowed_group_is_promoter','=',True)]" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                        <field name="subgroup_id" domain="[('parent_id','=',group_id),('allowed_group_is_promoter','=',True)]" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                        <field name="product_id" domain="[('product_sub_grouping_id', 'child_of', subgroup_id)]" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                        <field name="size_id" options="{'no_create_edit':True,'no_open':True,'no_create':True,'no_edit':True}"/>
                        <field name="is_sales_return"/>
                        <field name="qty"/>

                        <div style="font-size:15px;font-weight:bold;color: #070808ff;">Notes</div>
                        <div class="col-12" width="100%">
                            <field name="notes" class="o_field_text w-100" style="background-color: #f6fbfd; border-radius: 8px; padding: 6px;"/>
                        </div>
                        <div style="font-size:15px;font-weight:bold;color: #070808ff;">Attachments</div>
                        <div  width="70%" height="400px">
                       </div>
                        <field name="user_id" invisible="1" force_save="1"/>
                        <field name="dealer_mobile_user_bool" invisible="1"/>
                        <field name="dealer_access_bool" invisible="1"/>
                        <field name="current_latitude" invisible="1"/>
                        <field name="current_longitude" invisible="1"/> 
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity" groups="!dealer.group_dealer_sales_readonly"/>
                    <field name="message_ids" widget="mail_thread" groups="!dealer.group_dealer_sales_readonly"/>
                </div>
            </form>
        </field>
    </record>

    <!-- =========================
         TREE VIEW
    ========================== -->
    <!-- 🌿 Tree View -->
    <record id="view_tree_dealer_showroom_sales" model="ir.ui.view">
        <field name="name">dsales.showroom.sales.tree</field>
        <field name="model">dsales.showroom.sales</field>
        <!-- <field name="groups_id" eval="[(4, ref('dealer.group_dealer_backoffice_user')),(4, ref('dealer.group_dealer_user'))]"/> -->
        <field name="arch" type="xml">
            <tree string="Showroom Sales" js_class="dealer_showroom_sales_list_controller">
                <field name="dealer_id"/>
                <field name="dealer_showroom_id"/>
                <field name="user_id"/>
                <field name="date_time"/>
                <field name="product_category_id"/>
                <field name="group_id"/>
                <field name="subgroup_id"/>
                <field name="product_id"/>
                <field name="size_id"/>
                <field name="qty"/>
                <field name="invoice_id"/>
                <field name="approval_state"/>
                <field name="calculated_points"/>
                <field name="multiplier_applied"/>
                <field name="final_points"/>
                <field name="fsm_loyalty_points"/>
            </tree>
        </field>
    </record>

    <!-- 🔍 Search View -->
    <record id="view_search_dealer_showroom_sales" model="ir.ui.view">
        <field name="name">dsales.showroom.sales.search</field>
        <field name="model">dsales.showroom.sales</field>
        <field name="arch" type="xml">
            <search string="Search Showroom Sales">
                <field name="dealer_id" string="Dealer"/>
                <field name="dealer_showroom_id" string="Dealer Showroom"/>
                <field name="user_id" string="Salesman"/>
                <field name="product_category_id" string="Category"/>
                <field name="group_id" string="Group"/>
                <field name="subgroup_id" string="Sub Group"/>
                <field name="year"/>
                <field name="month"/>
                <separator/>
                <filter string="Has Notes" name="has_notes" domain="[('notes','!=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_dealer" string="Dealer" context="{'group_by': 'dealer_id'}"/>
                    <filter name="group_showroom" string="Dealer Showroom" context="{'group_by': 'dealer_showroom_id'}"/>
                    <filter name="group_sale_dealer" string="Salesman" context="{'group_by': 'user_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'product_category_id'}"/>
                    <filter name="group_group" string="Group" context="{'group_by': 'group_id'}"/>
                    <filter name="group_subgroup" string="Sub Group" context="{'group_by': 'subgroup_id'}"/>
                </group>
            </search>
        </field>
    </record>

<!-- Kanban View -->
<record id="view_kanban_dealer_showroom_sales_mobile" model="ir.ui.view">
    <field name="name">dsales.showroom.sales.kanban.edited</field>
    <field name="model">dsales.showroom.sales</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_small_column">
            <!-- Declare all fields used in the template -->
            <field name="dealer_id"/>
            <field name="date_time"/>
            <field name="product_category_id"/>
            <field name="group_id"/>
            <field name="subgroup_id"/>
            <field name="product_id"/>
            <field name="size_id"/>
            <field name="qty"/>
            <field name="notes"/>

            <templates>
                <t t-name="kanban-box">
                    <!-- Add 'oe_kanban_global_click' to make the card clickable -->
                    <div class="o_kanban_card oe_kanban_global_click">
                        <!-- Dealer Badge -->
                        <!-- <t t-if="record.dealer_id">
                            <span class="badge badge-info">
                                <t t-esc="record.dealer_id.value"/>
                            </span>
                        </t> -->

                        <div style="display:flex; justify-content:space-between; font-weight:bold; margin-top:2px;">
                            <div t-if="record.date_time">
                                <t t-esc="record.date_time.value"/>
                            </div>
                            <div t-if="record.qty" style="text-align:right;">
                                Qty: <t t-esc="record.qty.value"/>
                            </div>
                        </div>

                        <!-- Date & Time -->
                        <!-- <div t-if="record.date_time" style="font-weight:bold; margin-top: 2px;">
                            <t t-esc="record.date_time.value"/>
                        </div> -->

                        <!-- Product Details -->
                        <div style="display:flex; flex-wrap: wrap; margin-top: 2px;">
                            <t t-if="record.product_category_id"><t t-esc="record.product_category_id.value"/></t>
                            <t t-if="record.group_id"> - <t t-esc="record.group_id.value"/></t>
                            <t t-if="record.subgroup_id"> - <t t-esc="record.subgroup_id.value"/></t>
                            <t t-if="record.product_id"> - <t t-esc="record.product_id.value"/></t>
                            <t t-if="record.size_id"> - <t t-esc="record.size_id.value"/></t>
                        </div>
                        <!-- Quantity -->
                        <!-- <div style="font-weight:bold; text-align:right; margin-top: 2px;" t-if="record.qty">
                            Qty: <t t-esc="record.qty.value"/>
                        </div> -->

                        <!-- Notes Icon -->
                        <!-- <t t-if="record.notes and record.notes.raw_value">
                            <span class="fa fa-sticky-note" title="Has notes" style="margin-top:2px; color:orange;"/>
                        </t> -->
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>
       <record id="view_dealer_showroom_sales_form_inherit" model="ir.ui.view">
            <field name="name">dsales.showroom.sales.form.noduplicate</field>
            <field name="model">dsales.showroom.sales</field>
            <field name="inherit_id" ref="dealer.view_form_dealer_showroom_sales"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="attributes">
                    <attribute name="duplicate">0</attribute>
                </xpath>
            </field>
        </record>

    <!-- =========================
         ACTIONS
    ========================== -->
    <!-- Back-office: Review Sales -->
    <record id="action_dealer_showroom_sales" model="ir.actions.act_window">
        <field name="name">Review Shop Sales</field>
        <field name="res_model">dsales.showroom.sales</field>
        <field name="view_mode">tree,kanban,form,pivot</field>
        <field name="search_view_id" ref="view_search_dealer_showroom_sales"/>  
    </record>

    <!-- Mobile: Update Sales -->
    <record id="action_dealer_sales_mobile" model="ir.actions.act_window">
        <field name="name">Update Sales</field>
        <field name="res_model">dsales.showroom.invoice</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="dealer.view_kanban_dealer_showroom_invoice_mobile"/>
        <field name="domain">[('salesman_id', '=', uid)]</field>
        <field name="context">{'default_salesman_id': uid}</field>
    </record>


    <!-- =========================
         MENU ITEMS
    ========================== -->
    <!-- Back-office -->
    <menuitem id="menu_dealer_showroom_sales"
              name="Review Shop Sales"
              parent="menu_dealer_root"
              action="action_dealer_showroom_sales"
              groups="dealer.group_dealer_backoffice_user"
              sequence="20"/>

    <!-- Mobile -->
    <menuitem id="menu_dealer_sales_mobile"
              name="Update Sales"
              parent="menu_dealer_root"
              action="action_dealer_sales_mobile"
              groups="dealer.group_dealer_user"
              sequence="60"/>

</odoo>
