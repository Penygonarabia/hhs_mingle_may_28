                        </app>
                    </xpath>
        </field>
    </record> -->

<record id="view_res_config_settings_inherit_interface" model="ir.ui.view">
    <field name="name">res.config.settings.interface.mandatory</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">

        <xpath expr="//app[@name='machine_repair_management']" position="inside">
            <block title="Interface Settings">
                <setting>
                    <field name="make_interface_code_mandatory"/>
                </setting>
            </block>
        </xpath>

    </field>
</record>

</odoo>
