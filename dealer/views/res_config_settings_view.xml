<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dealer" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dealer</field>
        <field name="model">res.config.settings</field>

        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Dealer" string="Dealer" name="dealer_settings"
                     data-key="dealer" logo="/dealer/static/description/location_maker.png" >
        <!-- <field name="inherit_id" ref="machine_repair_management.res_config_settings_service_module_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside"> -->
            <!-- <xpath expr="//div[contains(@class,'settings_tab')]" position="inside"> -->
                <div class="app_settings_block" data-string="Dealer Settings" string="Dealer Settings">
                    <h2>Dealer Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="validate_geo_location"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="validate_geo_location"/>
                                <div class="text-muted">
                                    Enable this option to validate geo-location during dealer sales operations.
                                </div>
                            </div>
                               <!-- dealer WFO Radius -->
                               <div class="row mt16">
                                    <label for="dealer_wfo_radius"/>
                                    <field name="dealer_wfo_radius"/>
                               </div>                            
                            <div class="o_setting_box">
                            <div class="o_setting_left_pane">
                            <field name="show_dealer_menu"/>
                            </div>
                           <div class="o_setting_right_pane">
                                <label for="show_dealer_menu"/>
                                <div class="text-muted">
                                    Tick this to show or hide the Dealer menu in the backend.
                                </div>
                            </div>
                            </div>
                             <!-- dealer WFO Radius -->
                               <div class="row mt16">
                                    <label for="fsm_loyalty_point_value"/>
                                    <field name="fsm_loyalty_point_value"/>
                               </div>   
                        </div>
                    </div>
                    <h2>Floor Sales Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        <!-- General Promotion -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="gen_promo_required"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="gen_promo_required"/>
                                <div class="text-muted">Enable General Promotion Multiplier</div>
                                <div class="content-group" invisible="not gen_promo_required">
                                    <div class="row mt16">
                                        <label for="gen_promo_from" class="col-4 o_light_label"/>
                                        <field name="gen_promo_from" class="col-8"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="gen_promo_to" class="col-4 o_light_label"/>
                                        <field name="gen_promo_to" class="col-8"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="gen_promo_multiplier" class="col-4 o_light_label"/>
                                        <field name="gen_promo_multiplier" class="col-8"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Dealer Promotion -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="dealer_promo_required"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="dealer_promo_required"/>
                                <div class="text-muted">Enable Dealer Promotion Multiplier</div>
                                <div class="content-group" invisible="not dealer_promo_required">
                                    <div class="row mt16">
                                        <label for="dealer_promo_from" class="col-4 o_light_label"/>
                                        <field name="dealer_promo_from" class="col-8"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="dealer_promo_to" class="col-4 o_light_label"/>
                                        <field name="dealer_promo_to" class="col-8"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="dealer_promo_min_qty" class="col-4 o_light_label"/>
                                        <field name="dealer_promo_min_qty" class="col-8"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="dealer_promo_multiplier" class="col-4 o_light_label"/>
                                        <field name="dealer_promo_multiplier" class="col-8"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Filtering and Limits -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="filter_dealer_purchases"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="filter_dealer_purchases"/>
                                <div class="text-muted">Filter Items Based on Dealer Purchases</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Sales Limits</span>
                                <div class="text-muted">Limits for retail and dealer sales</div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="retailer_sales_limit" class="col-4 o_light_label"/>
                                        <field name="retailer_sales_limit" class="col-8"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="dealer_sales_limit" class="col-4 o_light_label"/>
                                        <field name="dealer_sales_limit" class="col-8"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
               </app>
            </xpath>
        </field>
    </record>

        <!-- <record id="res_config_settings_view_fsm_loyalty" model="ir.ui.view">
        <field name="name">res.config.settings.fsm.loyalty</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
