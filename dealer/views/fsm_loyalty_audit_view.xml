<odoo>
    <!-- Loyalty Audit Tree View -->
    <record id="view_fsm_loyalty_audit_tree" model="ir.ui.view">
        <field name="name">fsm.loyalty.audit.tree</field>
        <field name="model">fsm.loyalty.audit</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="reference"/>
                <field name="date_time"/>
                <field name="dealer_id"/>
                <field name="salesman_id"/>
                <field name="type"/>
                <field name="qty"/>
                <field name="loyalty_points"/>
                <field name="amount_paid"/>
                <field name="notes"/>
            </tree>
        </field>
    </record>

    <!-- Loyalty Audit Mobile View -->
    <record id="view_fsm_loyalty_audit_tree_mob" model="ir.ui.view">
        <field name="name">fsm.loyalty.audit.tree.mobil</field>
        <field name="model">fsm.loyalty.audit</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="date_time"/>
                <field name="loyalty_points"/>                
                <field name="type"/>
                <field name="qty"/>                
                <field name="amount_paid"/>
                <field name="notes"/>
                <field name="dealer_id"/>
            </tree>
        </field>
    </record>

    <!-- Search View for Loyalty Audit -->
    <record id="view_fsm_loyalty_audit_search" model="ir.ui.view">
        <field name="name">fsm.loyalty.audit.search</field>
        <field name="model">fsm.loyalty.audit</field>
        <field name="arch" type="xml">
            <search>
                <!-- Add search filters here -->
            </search>
        </field>
    </record>



    <!-- Action for Loyalty Audit (Mobile) -->
    <record id="action_fsm_loyalty_mob" model="ir.actions.act_window">
        <field name="name">Loyalty Points Statement</field>
        <field name="res_model">fsm.loyalty.audit</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_fsm_loyalty_audit_tree_mob"/>
        <field name="domain"> [('salesman_id', '=', uid)]</field>
    </record>

        <!-- Action for Loyalty Audit -->
    <record id="action_fsm_loyalty_audit" model="ir.actions.act_window">
        <field name="name">Loyalty Points Audit</field>
        <field name="res_model">fsm.loyalty.audit</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_fsm_loyalty_audit_tree"/>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_fsm_loyalty_audit" name="Loyalty Points Audit"
        parent="menu_dealer_root" action="action_fsm_loyalty_audit"
        groups="dealer.group_dealer_backoffice_user"
        sequence="40"/>

   
</odoo>