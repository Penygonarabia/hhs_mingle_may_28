<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dealer_sales_line_wizard_form" model="ir.ui.view">
        <field name="name">dealer.sales.line.wizard.form</field>
        <field name="model">dealer.sales.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Item">
                <group>
                    <field name="sales_id" invisible="1"/>
                    <field name="product_category_id" options="{'no_create_edit': True}" invisible="0"/>
                    <field name="product_group_id" options="{'no_create_edit': True}" invisible="0"/>
                    <field name="product_subgroup_id" options="{'no_create_edit': True}" invisible="0"/>
                    <field name="product_id" options="{'no_create_edit': True}" context="{'show_only_default_code': True, 'kanban_view_ref': 'dealer.view_kanban_product_product_code_only'}" domain="[('show_in_dealer_app', '=', True), ('product_tmpl_id.categ_id', 'child_of', product_subgroup_id if product_subgroup_id else (product_group_id if product_group_id else (product_category_id if product_category_id else 0)))]"/>
                    <field name="product_name" readonly="1"/>
                    <field name="capacity" readonly="1" invisible="1"/>
                    <field name="qty"/>
                    <field name="loyalty_points" readonly="1" invisible="1"/>
                </group>

                <footer>
                    <button name="action_add"
                            string="Submit"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>
</odoo>