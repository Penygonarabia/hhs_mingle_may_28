<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dealer_sales_line_wizard_form" model="ir.ui.view">
        <field name="name">dealer.sales.line.wizard.form</field>
        <field name="model">dealer.sales.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Item">
                <group>
                    <field name="sales_id" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <field name="product_category_id" domain="[('allowed_group_is_promoter','=',True), ('parent_id','=',False)]" options="{'no_create_edit': True, 'no_open': True, 'no_create': True}" readonly="state != 'draft'"/>
                    <field name="product_group_id" domain="[('parent_id', '!=', False), ('parent_id', '=', product_category_id), '|', ('parent_id.name', '!=', 'Midea'), ('allowed_group_is_promoter', '=', True)]" options="{'no_create_edit': True, 'no_open': True, 'no_create': True}" readonly="state != 'draft'"/>
                    <field name="product_subgroup_id" domain="[('parent_id', '!=', False), ('parent_id', '=', product_group_id)]" options="{'no_create_edit': True, 'no_open': True, 'no_create': True}" readonly="state != 'draft'"/>
                    <field name="target_category_id" invisible="1"/>
                    <field name="product_id" options="{'no_create_edit': True, 'no_open': True, 'no_create': True}" context="{'show_only_default_code': True, 'kanban_view_ref': 'dealer.view_kanban_product_product_code_only'}" domain="[('show_in_dealer_app', '=', True), ('product_tmpl_id.categ_id', 'child_of', target_category_id)]" readonly="state != 'draft'"/>
                    <field name="product_name" readonly="1"/>
                    <field name="capacity" readonly="1" invisible="1"/>
                    <field name="qty" readonly="state != 'draft'"/>
                    <field name="loyalty_points" readonly="1" invisible="1"/>
                </group>

                <footer>
                    <button name="action_add"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button string="Cancel"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>
</odoo>