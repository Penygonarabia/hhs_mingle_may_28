<odoo>
<record id="view_fsm_loyalty_audit_stmt_filter_wizard" model="ir.ui.view">
    <field name="name">fsm.loyalty.audit.stmt.filter.wizard.form</field>
    <field name="model">fsm.loyalty.audit.stmt.filter.wizard</field>
    <field name="arch" type="xml">
        <form string="Filter Loyalty Audits">
            <group>
                <field name="start_date"/>
                <field name="end_date"/>
            </group>
            <footer>
                <button string="Apply" type="object" name="apply_filter" class="btn-primary"/>
                <button string="Cancel" special="cancel" class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>

<record id="action_fsm_loyalty_audit_stmt_filter_wizard" model="ir.actions.act_window">
    <field name="name">Filter Loyalty Audits Statement</field>
    <field name="res_model">fsm.loyalty.audit.stmt.filter.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

 <menuitem id="menu_fsm_loyalty_audit_Wiz_mob" name="Loyalty Points Statement"
        parent="menu_dealer_root" action="action_fsm_loyalty_audit_stmt_filter_wizard"  
        groups="dealer.group_dealer_user"       
         sequence="90"/>
</odoo>
