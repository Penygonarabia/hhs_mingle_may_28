<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_purchase_order_form_inherit_approval" model="ir.ui.view">
        <field name="name">view.purchase.order.form.inherit.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_approval_reject_button" invisible="1"/>
                <field name="is_rejected" invisible="1"/>
                <field name="all_level_approved" invisible="1"/>
                <button string="Approve" name="action_approve" type="object" class="oe_highlight" invisible="not is_approval_reject_button or is_rejected or all_level_approved"/>
                <button string="Reject" name="action_reject" type="object" invisible="not is_approval_reject_button or is_rejected or all_level_approved" context="{'default_order_id': context.get('active_id')}"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="before">
                <field name="is_approval" invisible="1"/>
                <field name="suggested_ids" invisible="1" widget="many2many_tags" />
                <field name="purchase_approval_id" domain="[('id', 'in', suggested_ids)]" invisible="not is_approval" readonly="state not in ('draft','sent')and 0" options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//page[@name='purchase_delivery_invoice']" position="after">
                <page name="approval_info" string="Approval Info" invisible="not is_approval">
                        <group>
                        <group name="next_approval" string="Approval">
                            <field name="next_approval_level" readonly="1"/>
                            <field name="user_ids" widget="many2many_avatar_user" readonly="1"/>
                            <field name="group_ids" widget="many2many_tags" readonly="1"/>
                            <field name="approved_user_ids" widget="many2many_avatar_user" invisible='1' readonly="1"/>
                            <field name="current_waiting_approval_line_id" invisible="1" readonly="1"/>
                            <field name="current_approval_state" readonly="1" invisible="1"/>
                        </group>
                        <group name="rejection" string="Rejection">
                            <field name="reject_date" readonly="1"/>
                            <field name="rejected_user_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="reject_reason" readonly="1"/>
                        </group>
                    </group>
                    <field name="purchase_approved_ids" readonly="1" options="{'no_create':True,'no_create_edit':True}">
                        <tree readonly="1">
                            <field name="order_id" invisible="1"/>
                            <field name="purchase_approval_id" invisible="1"/>
                            <field name="approval_level"/>
                            <field name="user_ids"/>
                            <field name="group_ids"/>
                            <field name="state" widget="boolean_toggle" readonly="1"/>
                            <field name="approved_date"/>
                            <field name="approved_id" widget="many2one_avatar_user"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_purchase_my_approval" model="ir.actions.act_window">
        <field name="name">My Approval Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'quotation_only': True, 'my_approval': True}</field>
        <field name="domain">['|', ('user_ids', 'in', uid), ('is_display', '=', True), ('state', '=', 'waiting')]</field>
    </record>

    <record id="action_purchase_waiting_approval" model="ir.actions.act_window">
        <field name="name">Waiting Approval Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_my_quotation': 1}</field>
        <field name="domain">[('state', '=', 'waiting')]</field>
    </record>

    <menuitem id="menu_purchase_my_approval" name="My Approval" parent="purchase.menu_procurement_management" action="action_purchase_my_approval" sequence="50"/>
    <menuitem id="menu_purchase_waiting_approval" name="Waiting Approval" parent="purchase.menu_procurement_management" action="action_purchase_waiting_approval" sequence="60"/>
</odoo>
