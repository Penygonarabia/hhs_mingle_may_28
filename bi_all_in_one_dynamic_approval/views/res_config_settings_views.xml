<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="res_config_settings_view_form_dynamic_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dynamic.approval</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <h2>Approval Configurations</h2>
                <div class="row mt16 o_settings_container" id="approval_configuration_settings">
                    <div class="col-12 col-lg-6 o_setting_box" id="approval_configuration_settings">
                        <div class="o_setting_left_pane">
                            <field name="dynamic_approval"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="dynamic_approval"/>
                            <div class="text-muted">
                                Approval Based on minimum amount Total/Before Tax.
                            </div>
                            <div class="content-group" invisible="not dynamic_approval">
                                <field name="approval_type" class="mt-2" widget="radio" required="dynamic_approval"/>
                            </div>
                            <div class="text-muted" invisible="not dynamic_approval">
                                Approval Based on Your Choice Invoice/Bill.
                            </div>
                            <div class="content-group" invisible="not dynamic_approval">
                                <field name="group_access_for_invoice" class="mt-2" /><label for="group_access_for_invoice"/>
                            </div>
                            <div class="content-group" invisible="not dynamic_approval">
                               <field name="group_access_for_bill" class="mt-2" /><label for="group_access_for_bill"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>