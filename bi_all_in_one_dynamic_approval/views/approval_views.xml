<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="approval_form" model="ir.ui.view">
        <field name="name">approval.approval.form</field>
        <field name="model">approval.approval</field>
        <field name="arch" type="xml">
            <form string="Approval">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="minimum_amount"/>
                        <field name="is_sale_person" widget="boolean_toggle"/>
                    </group>
                    <notebook>
                        <page string="Approval Details">
                            <field name="approval_line_ids">
                                <tree>
                                    <field name="level"/>
                                    <field name="group_approve"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="approval_view_tree" model="ir.ui.view">
        <field name="name">approval.approval.view.tree</field>
        <field name="model">approval.approval</field>
        <field name="arch" type="xml">
            <tree string="Approval">
                <field name="name"/>
                <field name="minimum_amount"/>
                <field name="is_sale_person" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="approval_action_view" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">approval.approval</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="approval_menu" name="Approvals" parent="base.menu_users" action="approval_action_view" sequence="80"/>
</odoo>