<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="sale_order_approved_view_form" model="ir.ui.view">
        <field name="name">sale.order.approved.view.form</field>
        <field name="model">sale.order.approved</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="approval_level" readonly="1"/>
                            <field name="approval_level" readonly="1"/>
                            <field name="user_ids" readonly="1" widget="many2many_avatar_user"/>
                            <field name="group_ids" readonly="1" widget="many2many_avatar_user"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group>
                            <field name="approved_date" readonly="1"/>
                            <field name="approved_id" readonly="1"/>
                            <field name="order_id" readonly="1"/>
                            <field name="sale_approval_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>