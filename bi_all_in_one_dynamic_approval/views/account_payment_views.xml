<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_account_payment_form_inherit_approval" model="ir.ui.view">
        <field name="name">view.account.payment.form.inherit.approval</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_approval_reject_button" invisible="1"/>
                <field name="is_rejected" invisible="1"/>
                <field name="all_level_approved" invisible="1"/>
                <button string="Approve" name="action_approve" type="object" class="oe_highlight" invisible="not is_approval_reject_button or is_rejected or all_level_approved"/>
                <button string="Reject" name="action_reject" type="object" invisible="not is_approval_reject_button or is_rejected or all_level_approved" context="{'default_order_id': context.get('active_id')}"/>
            </xpath>
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="is_approval" invisible="1"/>
                <field name="suggested_ids" invisible="1" widget="many2many_tags" />
                <field name="payment_approval_id" domain="[('id', 'in', suggested_ids)]" invisible="not is_approval" readonly="state not in ('draft','sent')" options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
            <notebook>
                <page name="approval_info" string="Approval Info" invisible="not is_approval">
                    <group>
                        <group name="next_approval" string="Approval">
                            <field name="next_approval_level" readonly="1"/>
                            <field name="user_ids" widget="many2many_avatar_user" readonly="1"/>
                            <field name="group_ids" widget="many2many_tags" readonly="1"/>
                            <field name="approved_user_ids" widget="many2many_avatar_user" invisible='1' readonly="1"/>
                            <field name="current_waiting_approval_line_id" invisible="1" readonly="1"/>
                            <field name="current_approval_state" readonly="1" invisible="1"/>
                        </group>
                        <group name="rejection" string="Rejection">
                            <field name="reject_date" readonly="1"/>
                            <field name="rejected_user_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="reject_reason" readonly="1"/>
                        </group>
                    </group>
                    <field name="payment_approved_ids" readonly="1" options="{'no_create':True,'no_create_edit':True}">
                        <tree readonly="1">
                            <field name="order_id" invisible="1"/>
                            <field name="payment_approval_id" invisible="1"/>
                            <field name="approval_level"/>
                            <field name="user_ids"/>
                            <field name="group_ids"/>
                            <field name="state" widget="boolean_toggle" readonly="1"/>
                            <field name="approved_date"/>
                            <field name="approved_id" widget="many2one_avatar_user"/>
                        </tree>
                    </field>
                </page>
            </notebook>
            </xpath>
        </field>
    </record>

    <record id="action_payment_my_approval" model="ir.actions.act_window">
        <field name="name">My Approval Payments</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_payment_type': 'inbound','default_partner_type': 'customer', 'search_default_inbound_filter': 1,'default_move_journal_types': ('bank', 'cash'), 'my_approval': True}</field>
        <field name="domain">['|', ('user_ids', 'in', uid), ('is_display', '=', True), ('state', '=', 'waiting')]</field>
    </record>

    <record id="action_payment_waiting_approval" model="ir.actions.act_window">
        <field name="name">Waiting Approval Payments</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_payment_type': 'inbound','default_partner_type': 'customer', 'search_default_inbound_filter': 1,'default_move_journal_types': ('bank', 'cash')}</field>
        <field name="domain">[('state', '=', 'waiting')]</field>
    </record>

    <record id="action_vendor_payment_my_approval" model="ir.actions.act_window">
        <field name="name">My Approval Payments</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_payment_type': 'outbound','default_partner_type': 'supplier', 'search_default_outbound_filter': 1,'default_move_journal_types': ('bank', 'cash'), 'my_approval': True}</field>
        <field name="domain">['|', ('user_ids', 'in', uid), ('is_display', '=', True), ('state', '=', 'waiting')]</field>
    </record>

    <record id="action_vendor_payment_waiting_approval" model="ir.actions.act_window">
        <field name="name">Waiting Approval Payments</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_payment_type': 'outbound','default_partner_type': 'supplier', 'search_default_outbound_filter': 1,'default_move_journal_types': ('bank', 'cash')}</field>
        <field name="domain">[('state', '=', 'waiting')]</field>
    </record>

    <menuitem id="menu_payment_my_approval" name="My Payments Approval" parent="account.menu_finance_receivables" action="action_payment_my_approval" sequence="80"/>
    <menuitem id="menu_payment_waiting_approval" name="Waiting Payments Approval" parent="account.menu_finance_receivables" action="action_payment_waiting_approval" sequence="90"/>
    <menuitem id="menu_vendor_payment_my_approval" name="My Payments Approval" parent="account.menu_finance_payables" action="action_vendor_payment_my_approval" sequence="80"/>
    <menuitem id="menu_vendor_payment_waiting_approval" name="Waiting Payments Approval" parent="account.menu_finance_payables" action="action_vendor_payment_waiting_approval" sequence="90"/>
</odoo>
