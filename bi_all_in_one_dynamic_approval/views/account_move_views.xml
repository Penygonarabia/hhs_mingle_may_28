<odoo>
  <data>
    <record id="view_account_move_inherit_form" model="ir.ui.view">
      <field name="name">view_account_move_form</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_move_form"/>
      <field name="arch" type="xml">
        <xpath expr="//header" position="inside">
              <field name="is_approve_visible" invisible="1"/>
              <field name="is_approval_reject_button" invisible="1"/>
              <field name="is_rejected" invisible="1"/>
              <field name="all_level_approved" invisible="1"/>
              <button string="Approve" name="action_approve" type="object" class="oe_highlight" invisible="not is_approval_reject_button or is_rejected or all_level_approved"/>
              <button string="Reject" name="action_reject" type="object" invisible="not is_approval_reject_button or is_rejected or all_level_approved" context="{'default_order_id': context.get('active_id')}"/>
        </xpath>
        <xpath expr="//field[@name='invoice_date']" position="after">
            <field name="is_approval" invisible="1"/>
            <field name="is_visible" invisible="1"/>
            <field name="suggested_ids" invisible="1" widget="many2many_tags"/>
            <field name="invoice_approval_id" force_save="1" domain="[('id', 'in', suggested_ids)]"
                   invisible="not is_approval or not is_visible" readonly="state not in ('draft','sent') and 0"
                   options="{'no_create': True, 'no_create_edit': True}"/>
        </xpath>
        <xpath expr="//page[@id='other_tab_entry']" position="after">
            <page name="approval_info" string="Approval Info" invisible="is_approve_visible">
                <group>
                    <group name="next_approval" string="Approval">
                        <field name="next_approval_level" readonly="1"/>
                        <field name="user_ids" widget="many2many_avatar_user" readonly="1"/>
                        <field name="group_ids" widget="many2many_tags" readonly="1"/>
                        <field name="approved_user_ids" widget="many2many_avatar_user" invisible='1' readonly="1"/>
                        <field name="current_waiting_approval_line_id" invisible="1" readonly="1"/>
                        <field name="current_approval_state" readonly="1" invisible="1"/>
                    </group>
                    <group name="rejection" string="Rejection">
                        <field name="reject_date" readonly="1"/>
                        <field name="rejected_user_id" widget="many2one_avatar_user" readonly="1"/>
                        <field name="reject_reason" readonly="1"/>
                    </group>
                </group>
                <field name="invoice_approved_ids" readonly="1" options="{'no_create':True,'no_create_edit':True}">
                    <tree readonly="1">
                        <field name="order_id" invisible="1"/>
                        <field name="invoice_approval_id" invisible="1"/>
                        <field name="approval_level"/>
                        <field name="user_ids"/>
                        <field name="group_ids"/>
                        <field name="state" widget="boolean_toggle" readonly="1"/>
                        <field name="approved_date"/>
                        <field name="approved_id" widget="many2one_avatar_user"/>
                    </tree>
                </field>
            </page>
        </xpath>
      </field>
    </record>
      <record id="view_account_approve_move_tree" model="ir.ui.view">
        <field name="name">Waiting Approve </field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="/tree/field[@name='state']" position="replace">
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'" decoration-warning ="state == 'waiting'" decoration-danger="state == 'reject'" optional="show"/>
            </xpath>
        </field>
      </record>

      <record id="view_account_move_tree" model="ir.ui.view">
        <field name="name">Waiting Approve </field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="/tree/field[@name='state']" position="replace">
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'" decoration-warning ="state == 'waiting'" decoration-danger="state == 'reject'" optional="show"/>
            </xpath>
        </field>
      </record>
      <record id="view_bill_account_move_tree" model="ir.ui.view">
        <field name="name">Waiting Approvel </field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree" />
        <field name="arch" type="xml">
            <xpath expr="/tree/field[@name='state']" position="replace">
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'" decoration-warning ="state == 'waiting'" decoration-danger="state == 'reject'" optional="show"/>
            </xpath>
        </field>
      </record>
    <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'),('state', 'not in', ['waiting','reject'])]</field>
    </record>
      <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
            <field name="name">Bills</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="domain">[('move_type', '=', 'in_invoice'),('state', 'not in', ['waiting','reject'])]</field>
            <field name="context">{'default_move_type': 'in_invoice'}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a vendor bill
              </p><p>
                Create invoices, register payments and keep track of the discussions with your vendors.
              </p>
            </field>
        </record>
    <record id="action_waiting_invoice" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'),('state', '=', 'waiting')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
                 No Any Approval Penddings
          </p>
        </field>
    </record>

      <record id="action_my_approve_waiting_invoice" model="ir.actions.act_window">
        <field name="name">My Approve Invoice</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">['|',('user_ids', 'in', uid),('is_display', '=', True), ('state', '=', 'waiting'),('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice','my_approval': True}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
                 No Any Approval Penddings
          </p>
        </field>
    </record>

      <record id="action_waiting_bills" model="ir.actions.act_window">
            <field name="name">Bills</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="domain">[('move_type', '=', 'in_invoice'), ('state', '=', 'waiting')]</field>
            <field name="context">{'default_move_type': 'in_invoice'}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                 No Any Approval Penddings
              </p>
            </field>
        </record>
      <record id="action_bill_approval" model="ir.actions.act_window">
        <field name="name">My Approval Bills</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_move_type': 'in_invoice','my_approval': True}</field>
        <field name="domain">['|',('user_ids', 'in', uid),('is_display', '=', True), ('state', '=', 'waiting'),('move_type', '=', 'in_invoice')]</field>
    </record>

    <menuitem id="menu_invoice_my_approval" name="My Approval For Invoices" parent="account.menu_finance_receivables" action="action_my_approve_waiting_invoice" groups="bi_all_in_one_dynamic_approval.group_access_for_invoice" sequence="50"/>
    <menuitem id="menu_invoice_waiting_approval" name="Invoice Waiting Approval" parent="account.menu_finance_receivables" action="action_waiting_invoice" groups="bi_all_in_one_dynamic_approval.group_access_for_invoice" sequence="60"/>
    <menuitem id="menu_bill_my_approval" name="My Approval For Bills" parent="account.menu_finance_payables" action="action_bill_approval" groups="bi_all_in_one_dynamic_approval.group_access_for_bill" sequence="50"/>
    <menuitem id="menu_bill_waiting_approval" name="Bill Waiting Approval" parent="account.menu_finance_payables" action="action_waiting_bills" groups="bi_all_in_one_dynamic_approval.group_access_for_bill" sequence="60"/>
  </data>
</odoo>
