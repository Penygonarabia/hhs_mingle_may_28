<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="model_approval_form" model="ir.ui.view">
        <field name="name">model.approval.form</field>
        <field name="model">model.approval</field>
        <field name="arch" type="xml">
            <form string="Model Approval">
                <sheet>
                    <group>
                        <field name="model_id" options="{'no_open': True, 'no_create': True}"/>
                        <field name="approval_ids" options="{'no_open': True, 'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="model_approval_view_tree" model="ir.ui.view">
        <field name="name">model.approval.view.tree</field>
        <field name="model">model.approval</field>
        <field name="arch" type="xml">
            <tree string="Approval">
                <field name="model_id"/>
                <field name="approval_ids"/>
            </tree>
        </field>
    </record>
    <record id="model_approval_action_view" model="ir.actions.act_window">
        <field name="name">Approvals Configurations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">model.approval</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="approval_config_menu" name="Approvals Configurations" parent="base.menu_users" action="model_approval_action_view" sequence="70"/>
</odoo>