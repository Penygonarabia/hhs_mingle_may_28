                    </tr>
                    <tr>
                        <td colspan="2">Order approval information as below.</td>
                    </tr>
                </table>
                <table border="1" class="table table-bordered" style="width: 100%; border: 2px solid black;margin-top:15px;">
                    <tr>
                        <th>Level</th>
                        <th>Approver</th>
                        <th>Approved Date</th>
                        <th>Approved By</th>
                        <th>Status</th>
                    </tr>
                <t t-foreach="object.purchase_approved_ids" t-as="line">
                    <tr>
                        <td><t t-out = "line.approval_level"/></td>
                        <td>
                            <t t-if="line.user_ids">
                                <t t-esc="', '.join(map(lambda x: (x.name), line.user_ids))"/>
                            </t>
                            <t t-elif="line.group_ids">
                                <t t-esc="', '.join(map(lambda x: (x.name), line.group_ids))"/>
                            </t>
                            <t t-else="">False</t>
                        </td>
                        <td>
                            <t t-if="line.approved_date">
                                <t t-esc="line.approved_date"/>
                            </t>
                            <t t-else="">False</t>
                        </td>
                        <td>
                            <t t-if="line.approved_id">
                                <t t-esc="line.approved_id.name"/>
                            </t>
                            <t t-else="">False</t>
                        </td>
                        <td><t t-out="line.state"/></td>
                    </tr>
                </t>
                </table>
            </field>
        </record>

        <record id="approved_purchase_order_email_template" model="mail.template">
            <field name="name">Approved: Payment Mail</field>
            <field name="model_id" ref="bi_all_in_one_dynamic_approval.model_purchase_order"/>
            <field name="subject">{{object.name}} is Confirmed</field>
            <field name="email_from">"{{ object.env.user.company_id.name }}" &lt;{{ (object.env.user.company_id.email or user.email) }}&gt;</field>
            <field name="email_to">{{object.partner_id.email}}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                    <tr>
                        <td valign="top">
                            <div style="font-size: 13px; margin: 0px; padding: 0px;">
                                Dear <t t-out="object.partner_id.name"/>,<br/>
                            <br/>
                            Congrats! Your Order <strong><t t-out="object.name"/></strong> is confirmed successfully.
                            <br/>
                            <br/>
                                Thank you,
                            </div>
                        </td>
                    </tr>
                </table>
            </field>
        </record>

        <record id="reject_approval_email_template_purchase" model="mail.template">
            <field name="name">Reject: Payment Approval</field>
            <field name="model_id" ref="bi_all_in_one_dynamic_approval.model_purchase_order"/>
            <field name="subject">{{object.name}} is Rejected</field>
            <field name="email_from">"{{ object.env.user.company_id.name }}" &lt;{{ (object.env.user.company_id.email or user.email) }}&gt;</field>
            <field name="email_to">{{object.partner_id.email}}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                    <tr>
                        <td valign="top">
                            <div style="font-size: 13px; margin: 0px; padding: 0px;">
                                Dear <t t-out="object.partner_id.name"/>,<br/>
                            <br/>
                            Opps! Your Order <strong><t t-out="object.name"/></strong> was rejected Please try again or contact to admin.
                            <br/>
                            <br/>
                                Thank you,
                            </div>
                        </td>
                    </tr>
                </table>
            </field>
        </record>
    </data>
    
</odoo>