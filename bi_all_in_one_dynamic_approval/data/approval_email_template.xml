<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">
        <!-- sale mail template -->
        <record id="request_approval_email_template" model="mail.template">
            <field name="name">Request: Approval</field>
            <field name="model_id" ref="bi_all_in_one_dynamic_approval.model_sale_order"/>
            <field name="subject">{{object.name}} Request for Approval</field>
            <field name="email_from">"{{ object.env.user.company_id.name }}" &lt;{{ (object.env.user.company_id.email or user.email) }}&gt;</field>
            <field name="email_to">{{object.partner_id.email}}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                    <tr>
                        <td valign="top">
                            <div style="font-size: 13px; margin: 0px; padding: 0px;">
                                Dear <t t-out="object.partner_id.name"/>,<br/>
                            <br/>
                                Thank you for your intrest!
                            <br/>
                            <br/>
                            Congrats! Your order <strong><t t-out="object.name"/></strong> is generated successfully.
                            <br/>
                            Order Passing for approval.
                            <br/>
                            <br/>
                                Thank you,
                            </div>
                        </td>
                    </tr>
                </table>
            </field>
        </record>

        <record id="submit_for_approval_email_template" model="mail.template">
            <field name="name">Submit For Approval</field>
            <field name="model_id" ref="bi_all_in_one_dynamic_approval.model_sale_order"/>
            <field name="subject">Submit for Approval</field>
            <field name="email_from">"{{ object.env.user.company_id.name }}" &lt;{{ (object.env.user.company_id.email or user.email) }}&gt;</field>
            <field name="email_to">{{ object._get_user_emails() }}</field>
            <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0" width="400" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                    <tr>
                        <div style="font-size: 18px;"> Submit for Approval: <strong><t t-out="object.name"/></strong></div>
                    </tr>
                    <tr>
                        <td valign="top">
                            <div style="font-size: 13px; margin: 0px; padding: 0px;">
                                Dear Approvals,<br/>
                            <br/>
                                This is to inform you that the order is submitted for Approval.
                            <br/>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Sale Person</strong></td>
                        <td><t t-out="object.user_id.name"/></td>
                    </tr>
                    <tr>
                        <td><strong>Total Amount</strong></td>
                        <td><t t-out="object.amount_total"/></td>
                    </tr>
                    <tr>
                        <td><strong>Approval Level</strong></td>
                        <td><t t-out="object.sale_approval_id.name"/></td>
                    </tr>
                    <tr>
                        <td><strong>Minimum Amount</strong></td>
                        <td><t t-out="object.sale_approval_id.minimum_amount"/></td>
                    </tr>
                    <tr>
                        <td colspan="2">Order approval information as below.</td>
                    </tr>
                </table>
                <table border="1" class="table table-bordered" style="width: 100%; border: 2px solid black;margin-top:15px;">
                    <tr>
                        <th>Level</th>
                        <th>Approver</th>
                        <th>Approved Date</th>
                        <th>Approved By</th>
                        <th>Status</th>
                    </tr>
                <t t-foreach="object.sale_approved_ids" t-as="line">
                    <tr>
                        <td><t t-out = "line.approval_level"/></td>
                        <td>
                            <t t-if="line.user_ids">
                                <t t-esc="', '.join(map(lambda x: (x.name), line.user_ids))"/>
                            </t>
                            <t t-elif="line.group_ids">
                                <t t-esc="', '.join(map(lambda x: (x.name), line.group_ids))"/>
                            </t>
                            <t t-else="">False</t>
                        </td>
                        <td>
                            <t t-if="line.approved_date">
                                <t t-esc="line.approved_date"/>
                            </t>
                            <t t-else="">False</t>
                        </td>
                        <td>
                            <t t-if="line.approved_id">
                                <t t-esc="line.approved_id.name"/>
                            </t>
                            <t t-else="">False</t>
                        </td>
                        <td><t t-out="line.state"/></td>
                    </tr>
                </t>
                </table>
            </field>
        </record>

