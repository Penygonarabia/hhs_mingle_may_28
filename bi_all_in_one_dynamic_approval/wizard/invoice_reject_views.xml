<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="invoice_reject_view_form" model="ir.ui.view">
        <field name="name">invoice.reject.view.form</field>
        <field name="model">invoice.reject</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="order_id" readonly="1" invisible="1"/>
                        <field name="reason"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Reject" name="action_reject_invoice_order" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_invoice_reject" model="ir.actions.act_window">
        <field name="name">Invoice  Reject</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">invoice.reject</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_order_id': context.get('active_id')}</field>
    </record>
</odoo>
