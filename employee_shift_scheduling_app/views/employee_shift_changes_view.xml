<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_shift_changes_tree_view" model="ir.ui.view">
        <field name="name">employee.shift.changes.tree</field>
        <field name="model">employee.shift.changes</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="shift_id"/>
                <field name="allocation_id"/>
                <field name="user_id"/>
                <field name="state"/>
            </tree></field>
    </record>
    <record id="employee_shift_changes_form_view" model="ir.ui.view">
        <field name="name">employee.shift.changes.form</field>
        <field name="model">employee.shift.changes</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button class="oe_highlight" invisible="state not in ['draft']" name="action_process" string="Process" type="object"/>
                    <button class="oe_highlight" groups="hr.group_hr_manager" invisible="state not in ['process']" name="action_approve" string="Approve" type="object"/>
                    <button class="oe_highlight" invisible="state not in ['draft','process']" name="action_cancel" string="Cancel" type="object"/>
                    <field name="state" readonly="1" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name" readonly="1"/>
                        </h1>
                        <br/>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_open': True, 'no_create': True}" readonly="state == 'approve'" required="1"/>
                            <field domain="[('employee_id', '=', employee_id)]" name="allocation_id" options="{'no_open': True, 'no_create': True}" readonly="state == 'approve'" required="1"/>
                            <field name="shift_id" options="{'no_open': True, 'no_create': True}" readonly="state == 'approve'" required="1"/>
                        </group>
                        <group>
                            <field name="user_id" options="{'no_open': True, 'no_create': True}" required="1"/>
                            <field name="company_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                            <field domain="[('allocation_id', '=', allocation_id)]" name="workday_ids" options="{'no_open': True, 'no_create': True}" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note">
                            <field name="note" readonly="state == 'approve'"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field groups="base.group_user" name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form></field>
    </record>
    <record id="employee_shift_changes_search_view" model="ir.ui.view">
        <field name="name">employee.shift.changes.search</field>
        <field name="model">employee.shift.changes</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="shift_id"/>
                <field name="allocation_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <group expand="0" string="Group By">
                    <filter context="{'group_by':'shift_id'}" name="shift_id" string="Shift"/>
                    <filter context="{'group_by':'employee_id'}" name="employee_id" string="Employee"/>
                    <filter context="{'group_by':'allocation_id'}" name="allocation_id" string="Allocation"/>
                    <filter context="{'group_by':'state'}" name="state" string="state"/>
                </group>
            </search></field>
    </record>
    <record id="action_employee_shift_changes" model="ir.actions.act_window">
        <field name="name">Employee Shift Changes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.shift.changes</field>
        <field name="view_mode">tree,kanban,search,form</field>
    </record>
    <menuitem action="action_employee_shift_changes" id="main_menu_employee_shift_changes" name="Employee Shift Changes" parent="main_menu_employee_shift" sequence="6"/>
</odoo>
