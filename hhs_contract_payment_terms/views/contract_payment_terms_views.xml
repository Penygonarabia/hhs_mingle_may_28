<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit the Contracts form view to add a Payment Terms tab -->
    <record id="view_subscription_contracts_form_payment_terms" model="ir.ui.view">
        <field name="name">subscription.contracts.form.payment.terms</field>
        <field name="model">subscription.contracts</field>
        <field name="inherit_id" ref="sales_contract_and_recurring_invoices.subscription_contracts_view_form"/>
        <field name="arch" type="xml">

            <!-- Add the Payment Terms tab as the last tab in the notebook -->
           <xpath expr="//notebook/page[1]" position="after">
                <page string="Payment Terms" name="payment_terms_page">

                    <!-- Header Section: Contract Value & Frequency -->
                    <group>
                        <group>
                            <field name="annual_contract_value"
                                   string="Annual Contract Value (SAR)"
                                   readonly="1"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   invisible ="1"/>
                            <label for="annual_contract_value" string="(Including VAT)"
                                   class="text-muted"
                                   invisible = "1"/>
                        </group>
                        <group>
                            <field name="payment_frequency_text"
                                   readonly="1" nolabel="1"
                                   widget="char"
                                   invisible = "1"
                                   />
                        </group>
                    </group>

                    <!-- Generate Schedule Button -->
                    <div class="mb-3">
                        <button name="action_generate_payment_schedule"
                                type="object"
                                string="⟳ Generate Payment Schedule"
                                class="btn-primary"
                                confirm="This will regenerate the payment schedule. Continue?"
                                invisible="1"
                                
                                />
                    </div>

                    <!-- Payment Schedule Lines -->
                    <field name="payment_schedule_line_ids" nolabel="1">
                        <tree editable="bottom" decoration-success="state == 'paid'" create = "0" delete ="0"
                              decoration-info="state == 'invoiced'"
                              decoration-muted="state == 'pending'">
                            <field name="sequence" widget="handle"/>
                            <field name="name" string="Payment" force_save="1"/>
                            <field name="payment_date" string="Date" force_save="1"/>
                            <field name="amount" string="Amount (SAR)"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}" force_save="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="state" string="Status" widget="badge"
                                   decoration-success="state == 'paid'"
                                   decoration-info="state == 'invoiced'"
                                   decoration-warning="state == 'pending'" column_invisible="1"/>
                        </tree>
                    </field>

                    <!-- Late Payment Note -->
                    <!-- <separator string="Late Payment Policy"/> -->
                    <field name="late_payment_note" nolabel="1"
                           placeholder="Late payment terms and conditions..."
                           invisible = "1"
                           />
                </page>
            </xpath>

        </field>
    </record>
</odoo>
