<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_service_sale_order_form_inherit_pm_checklist" model="ir.ui.view">
        <field name="name">service.sale.order.form.inherit.pm.checklist</field>
        <field name="model">service.sale.order</field>
        <!-- MUST BE UNCOMMENTED -->
        <field name="inherit_id" ref="service_sale_approvals.view_service_order_form_inherit_approval"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='terms_of_execution']" position="after">
                <page name="pm_service_checklist" string="PM Service Check List" invisible= "job_task_id">
                    <!-- MUST WRAP IN pm_checklist_ids -->
                    <field name="pm_checklist_ids" nolabel="1">
                        <tree editable="bottom" create="0" delete="0" edit="1" default_order="service_type_id asc">
                            <field name="service_unit_type_id" readonly="1" force_save="1" invisible = "print_always_default"/>
                            <field name="unit_sub_type_id" readonly="1" force_save="1"/>
                            <field name="service_type_id" readonly="1" force_save="1"/>
                            <field name="is_selected" string="Yes/No"/>
                            <field name = "print_always_default"  column_invisible = "1"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>


