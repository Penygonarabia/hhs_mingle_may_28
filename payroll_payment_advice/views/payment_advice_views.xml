<?xml version="1.0"?>
<odoo>
	<record id="view_hr_payroll_advice_tree" model="ir.ui.view">
		<field name="name">hr.payroll.advice.tree.view</field>
		<field name="model">hr.payroll.advice</field>
		<field name="arch" type="xml">
			<tree string="Payroll Advice Tree">
				<field name="name" string = "Period Name" readonly="1" force_save='1'/>
				 
			     <field name="from_date"/>
			 
			</tree>
		</field>
	</record>

	<record id="view_hr_payroll_advice_form" model="ir.ui.view">
		<field name="name">hr.payroll.advice.form.view</field>
		<field name="model">hr.payroll.advice</field>
		<field name="arch" type="xml">
			<form string="Payroll Advice Form">
			<!-- <header>
                        <button string="Generate Employee info" name="action_date_done" type="object" 
                                class="oe_highlight"/>                     
                       
                    </header> -->
				<sheet>
				<group>
		        <group col = "2">				          
                       <field name="name" string = "Period Name" readonly="1" force_save='1'/>
                                               
			   </group>		
					<group col = "2">
			    		<field name="from_date"/>

			    		
					</group>
					
				</group>	
			   <group>	
					<notebook>
					    <page string = "Payment Information" class="oe_highlight">
<!-- 					         <field name = "payroll_advice_line_ids" style="pointer-events:none;">
 -->					      <field name = "payroll_advice_line_ids" readonly="1" force_save='1'>
					           <tree editable = "bottom">
					              <field name = "employee_number" width = "100px"/>
					             <field name="employee_resident_id"  width = "200px"/>
					              
					               <field name="bank_code"  width="150px"/>
					               <field name="bank_account_id"  width="225px"/>
<!-- 					               <field name="bank_ifsc"  width="100px"/>
 -->					               <field name = "employee_id"  width="150px"/>
					               <field name = "net_salary"  width="150px"/>	
					              <field name = "basic_salary"  width="100px"/>
					          	  <field name = "housing_allowance"  width="150px"/>
					              <field name = "other_earning"  width="100px"/>	
					              <field name = "deduction"  width="100px"/> 	
					              <field name = "regulatory" width = "150px" />
					              <field name ="remarks"  width="100px"/>             		              
					           					           
      					        </tree>
					              
					         </field>
					    </page>
					
					</notebook>
				</group>
			
			</sheet>	
			</form>
		</field>
		</record>

	<record id="action_view_hr_payroll_advice"  model="ir.actions.act_window">
		<field name="name">Payment Advice</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">hr.payroll.advice</field>
		<field name="view_mode">tree,form</field>
		<field name="context">{}</field>
		<field name="domain">[]</field>
	</record>
	
		
