<?xml version="1.0"?>
<odoo>
	<record id="view_payroll_advice_two_tree" model="ir.ui.view">
		<field name="name">payroll.advice.two.tree.view</field>
		<field name="model">payroll.advice.two</field>
		<field name="arch" type="xml">
			<tree string="Payroll Advice Two Tree">
				<field name="name" string = "Period Name" readonly="1" force_save='1'/>
			     <field name="from_date"/>
			</tree>
		</field>
	</record>

	<record id="view_payroll_advice_two_form" model="ir.ui.view">
		<field name="name">payroll.advice.two.form.view</field>
		<field name="model">payroll.advice.two</field>
		<field name="arch" type="xml">
			<form string="Payroll Advice Two">
				<sheet>
				<group>
		        <group col = "2">				          
                       <field name="name" string = "Period Name" readonly="1" force_save='1'/>
			   </group>		
					<group col = "2">
			    		<field name="from_date"/>
					</group>
				</group>	
			   <group>	
					<notebook>
					    <page string = "Payment Information" class="oe_highlight">
 					      <field name = "payroll_two_line_ids" readonly="1" force_save='1'>
					           <tree editable = "bottom">
					           	 <field name = "net_salary" width="50%"/>	
					           	  <field name = "bank_account_id" width="50%" />
					           	  <field name = "employee_id" width="50%"/>
					           	  <field name = "employee_beneficiary" width="50%" /> 
					           	  <field name = "employee_benefi" width="50%" /> 
					           	  <field name = "bank_name" width="50%"/>
					           	  <field name = "payment_description" width="50%"/>
					              <field name = "basic_salary"  width="50%"/>
					          	  <field name = "housing_allowance" width="50%"/>
					              <field name = "other_earning" width="50%" />	
					              <field name = "deduction" width="50%" /> 
					              <field name = "beneficiary_id" width="50%" /> 
					              
      					        </tree>
					         </field>
					    </page>
					</notebook>
				</group>
			</sheet>	
			</form>
		</field>
		</record>

	<record id="action_view_payroll_advice_two"  model="ir.actions.act_window">
		<field name="name">SAUDI ARABIAN INVESTMENT BANK</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">payroll.advice.two</field>
		<field name="view_mode">tree,form</field>
		<field name="context">{}</field>
		<field name="domain">[]</field>
	</record>
