<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id = "payment_advice_payroll.report_payroll_payment_pdf_two">
	  <t t-call = "web.external_layout" >
	     <t t-set = "doc" t-value = "doc" />
	
	   	<br/><br/><br/>
	   	
	   	<div>
	   		 	<p><strong><center>Payroll Payment Details</center></strong></p>	   	
	   	</div>
	  <br/><br/>
	    <div>
	    <table class = "table table-sm">
	    	<tr>
	    		<t t-set = "colspan" t-value = "5"/>
	  			 <td class = "text-center"><strong>Period Name : </strong></td>
	   			 <td class = "text-center"><strong>Date : </strong></td>	   			 
	    	</tr>
	        <tr>
	  			 <td class = "text-center"><t t-esc = "doc.name"></t></td>
	    		 <td class = "text-center"><t t-esc = "doc.from_date"></t></td>	 			    	
	    	</tr>	    
	    </table>
	    </div>	
	      <br/>	      
	      <div>
	  	<table class = "table table-sm o_main_table">	               
	                    <tr>	                 
	                        <t t-set = "colspan" t-value = "5"/>	                                    
	                         <th  class = "text-right">Net Salary</th> 
	                          <th  class = "text-right">Beneficiary Account</th>
	                           <th class = "text-right">Beneficiary Name 1</th>
	                           <th class = "text-right">Beneficiary Name 2</th>	                           
	                    	    <th class = "text-right">Beneficiary Name 3</th>
	                    	    <th class = "text-right">Beneficiary Bank</th>	                    	    
	                    	   <th class = "text-right">Payment Description (optional)</th>	                    	    	                           
	                            <th  class = "text-right">Basic Salary</th>
		                        <th  class = "text-right">Housing Allowance</th>
		                        <th  class = "text-right">Other Earnings</th>
		                        <th  class = "text-right">Deductions</th>
		                        <th class = "text-right">Beneficiary ID</th>	              
	                    </tr>
	                	  <t t-foreach = "doc.payroll_two_line_ids" t-as = "line">
	                    <tr>	                    
	                    	     <td class = "text-right"><t t-esc = "line.net_salary"/></td>
	                    	     <td class = "text-right"><span t-field = "line.bank_account_id"></span></td>
	                    	      <td class = "text-right"><span t-field = "line.employee_id.name"></span></td>
	                    	      <td class = "text-right"><span t-field = "line.employee_beneficiary"></span></td>
	                    	      <td class = "text-right"><span t-field = "line.employee_benefi"></span></td>
	                    	      <td class = "text-right"><span t-field = "line.bank_name"></span></td>
	                    	      <td class = "text-right"><span t-field = "line.payment_description"></span></td>
	            				<td class = "text-right"><span t-field = "line.basic_salary"></span></td>
	            				<td class = "text-right"><span t-field = "line.housing_allowance"/></td>
	            				<td class = "text-right"><span t-field = "line.other_earning"/></td>
	            				<td class = "text-right"><span t-field = "line.deduction"/></td>  
	            				<td class = "text-right"><span t-field = "line.beneficiary_id"></span></td>      					                   
	                    </tr>	      
	              </t>	  
	                </table>	                
	               </div> 	          
	  	<br/><br/>	
	  </t>
	</template>		
	<template id = "report_payroll_payment_pdf">
	    <t t-call = "web.html_container">
	        <t t-foreach = "docs" t-as = "doc">	       		 
	           	<t t-call = "payment_advice_payroll.report_payroll_payment_pdf_two" t-value = "doc" />	           	         
	        </t>
	    </t>
	</template>
	
	
	<template id = "payment_advice_payroll.report_payroll_payment_format_one_bank1">
	  <t t-call = "web.external_layout" >
