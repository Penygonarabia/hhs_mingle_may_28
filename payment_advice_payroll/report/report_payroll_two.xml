	                    </tr>
	               </t>
	          </table>
	       </div> 
	  	<br/><br/>
	  </t>
	</template>
	<template id = "report_payroll_payment_format_one">
	    <t t-call = "web.html_container">
	        <t t-foreach = "docs" t-as = "doc">
	           	<t t-call = "payment_advice_payroll.report_payroll_payment_format_one_bank1" t-value = "doc" />
	        </t>
	    </t>
	</template>
	
	
	
	<template id="payment_advice_payroll.report_payroll_payment1">
