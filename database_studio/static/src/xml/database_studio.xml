<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="database_studio.SaveDialog">
        <Dialog title="'Save query'" size="'md'">
            <div class="mb-2">
                <label class="form-label fw-bold">Name</label>
                <input type="text" class="form-control" t-ref="input"
                       placeholder="Name this query..."
                       t-model="state.name" t-on-keydown="onKeydown"/>
                <small class="text-muted">Saved to History and marked as favorite ★.</small>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="confirm">
                    <i class="fa fa-star me-1"/>Save
                </button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="database_studio.CloseTabDialog">
        <Dialog title="'Close query tab'" size="'md'">
            <div class="mb-2">
                <p>Save <b t-esc="props.tabName"/> before closing? Unsaved query text
                   will be lost.</p>
                <label class="form-label fw-bold">Name</label>
                <input type="text" class="form-control" t-ref="input"
                       placeholder="Name this query..."
                       t-model="state.name" t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; this.save()"/>
                <small class="text-muted">Saved to History and marked as favorite ★.</small>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="save">
                    <i class="fa fa-star me-1"/>Save &amp; close
                </button>
                <button class="btn btn-danger" t-on-click="discard">
                    Close without saving
                </button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="database_studio.ConvertTypeDialog">
        <Dialog title="isQuery ? 'Read these result columns as numbers' : 'Change field type to number'" size="'lg'">
            <div t-if="isQuery" class="sqlms-hint mt-0">
                These columns come from the query, not from a table, so there is nothing to
                alter. The query is rewritten to cast them instead — your data is untouched.
            </div>
            <div t-if="state.error" class="alert alert-danger" t-esc="state.error"/>
            <div class="mb-3">
                <label class="form-label fw-bold">Convert to</label>
                <select class="form-select" t-att-value="state.target"
                        t-on-change="onTargetChange"
                        t-att-disabled="state.converting">
                    <option t-foreach="targets" t-as="tgt" t-key="tgt.value"
                            t-att-value="tgt.value" t-att-selected="tgt.value === state.target"
                            t-esc="tgt.label"/>
                </select>
            </div>

            <div t-if="state.loading" class="sqlms-empty">Checking the column values…</div>
            <t t-else="">
                <table class="sqlms-grid sqlms-converttable" t-if="columns.length">
                    <thead>
                        <tr>
                            <th>Column</th>
                            <th>Current type</th>
                            <th class="text-end">Rows</th>
                            <th class="text-end">Blank → NULL</th>
                            <th class="text-end">Rounded</th>
                            <th>Not a number</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="columns" t-as="c" t-key="c.table + '.' + c.name"
                            t-att-class="{ 'sqlms-convert-skip': !c.convertible }">
                            <td><b t-esc="c.name"/> <span class="text-muted" t-esc="c.table"/></td>
                            <td t-esc="c.type"/>
                            <t t-if="c.convertible">
                                <td class="text-end" t-esc="c.total"/>
                                <td class="text-end" t-esc="c.blanks"/>
                                <td class="text-end" t-esc="c.fractional"/>
                                <td>
                                    <t t-if="c.bad">
                                        <span class="sqlms-convert-bad"><t t-esc="c.bad"/></span>
                                        <span class="text-muted">
                                            e.g. <t t-esc="c.samples.join(', ')"/>
                                        </span>
                                    </t>
                                    <t t-else="">—</t>
                                </td>
                            </t>
                            <t t-else="">
                                <td colspan="4" class="text-muted">skipped: <t t-esc="c.reason"/></td>
                            </t>
                        </tr>
                    </tbody>
                </table>

                <div t-if="!convertible.length and !state.error" class="alert alert-warning mt-2">
                    None of the picked columns can be converted.
                </div>
                <t t-else="">
                    <div t-foreach="state.report.warnings" t-as="w" t-key="w_index"
                         class="alert alert-warning mt-2 mb-1" t-esc="w"/>

                    <div t-if="badTotal" class="alert mt-2"
                         t-att-class="isQuery ? 'alert-warning' : 'alert-danger'">
                        <div>
                            <b><t t-esc="badTotal"/> value(s)</b> cannot be read as a number.
                            <t t-if="isQuery">
                                The rewritten query fails on them unless they are skipped.
                            </t>
                            <t t-else="">
                                The conversion fails unless they are cleared first.
                            </t>
                        </div>
                        <label class="d-block mt-2">
                            <input type="checkbox" t-att-checked="state.blankBad"
                                   t-on-change="onBlankBadChange"/>
                            <t t-if="isQuery">
                                Return those values as empty (NULL) instead — the stored
                                data is not touched.
                            </t>
                            <t t-else="">
                                Set those values to empty (NULL) before converting —
                                <b>this deletes them</b>.
                            </t>
                        </label>
                    </div>
                    <div t-if="roundTotal" class="sqlms-hint mt-2">
                        <t t-esc="roundTotal"/> value(s) have decimals and will be rounded
                        by this target type.
                    </div>
                    <div t-if="blankTotal" class="sqlms-hint mt-2">
                        <t t-esc="blankTotal"/> blank value(s) become NULL.
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-link btn-sm p-0" t-on-click="toggleSql">
                            <i class="fa" t-att-class="state.showSql ? 'fa-caret-down' : 'fa-caret-right'"/>
                            <t t-if="isQuery">The rewritten query</t>
                            <t t-else="">SQL that will run</t>
                        </button>
                        <pre t-if="state.showSql" class="sqlms-convertsql" t-esc="state.report.sql"/>
                    </div>
                </t>
            </t>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="confirm"
                        t-att-disabled="!canConvert">
                    <i class="fa fa-exchange me-1"/>
                    <t t-if="state.converting">Converting…</t>
                    <t t-elif="isQuery">Rewrite query (<t t-esc="convertible.length"/> column(s))</t>
                    <t t-else="">Convert <t t-esc="convertible.length"/> column(s)</t>
                </button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="database_studio.Analyser">
        <div class="sqlms-root" t-ref="rootEl">
            <!-- Left: objects -->
            <div class="sqlms-sidebar" t-ref="sidebarEl">
                <div class="sqlms-search">
                    <span class="sqlms-searchbox">
                        <i class="fa fa-search"/>
                        <input type="text" placeholder="Search table or view name..."
                               t-model="state.filter"/>
                        <button class="sqlms-searchbox-x" t-if="state.filter"
                                title="Clear the search" t-on-click="clearFilter">&#215;</button>
                    </span>
                    <button class="sqlms-hist-btn" title="Query history"
                            t-on-click="openHistory">
                        <i class="fa fa-history"/>
                    </button>
                </div>
                <div class="sqlms-searchmode">
                    <select t-model="state.searchMode" title="Search match mode">
                        <option value="contains">Any where</option>
                        <option value="start">Starts with</option>
                        <option value="end">Ends with</option>
                    </select>
                </div>
                <div class="sqlms-selbar" t-if="checkedCount">
                    <button class="btn btn-primary btn-sm" t-on-click="buildQuery">
                        <i class="fa fa-code-fork"/> Build query (<t t-esc="checkedCount"/>)
                    </button>
                    <button class="btn btn-link btn-sm" t-on-click="clearChecks">Clear</button>
                </div>
                <div class="sqlms-objects">
                    <!-- FAVOURITES -->
                    <div class="sqlms-group-title" t-on-click="toggleFavorites">
                        <i class="fa" t-att-class="state.showFavorites ? 'fa-caret-down' : 'fa-caret-right'"/>
                        <i class="fa fa-star"/> Favourites
                        <span class="sqlms-count" t-esc="filteredFavorites.length"/>
                    </div>
                    <ul class="sqlms-list" t-if="state.showFavorites">
                        <li t-if="!state.favorites.length" class="sqlms-favhint">
                            No favourites yet — click the ☆ on a table or view.
                        </li>
                        <li t-foreach="filteredFavorites" t-as="fav" t-key="fav.name"
                            t-att-class="{ 'sqlms-active': state.selected === fav.name }"
                            t-on-click="() => this.selectObject(fav.name, fav.type)">
                            <input type="checkbox" class="sqlms-check"
                                   t-att-checked="state.checked[fav.name]"
                                   t-on-click="(ev) => this.toggleCheck(fav.name, ev)"/>
                            <span class="sqlms-name" t-esc="fav.name"/>
                            <button class="sqlms-fav sqlms-fav-on" title="Remove from favourites"
                                    t-on-click="(ev) => this.toggleFavorite(fav.name, fav.type, ev)">
                                <i class="fa fa-star"/>
                            </button>
                            <button class="sqlms-insert" title="Insert into query"
                                    t-on-click="(ev) => this.insertObject(fav.name, ev)">
                                <i class="fa fa-code"/>
                            </button>
                        </li>
                    </ul>

                    <!-- TABLES -->
                    <div class="sqlms-group-title" t-on-click="toggleTables">
                        <i class="fa" t-att-class="state.showTables ? 'fa-caret-down' : 'fa-caret-right'"/>
                        <i class="fa fa-table"/> Tables
                        <span class="sqlms-count" t-esc="filteredTables.length"/>
                    </div>
                    <ul class="sqlms-list" t-if="state.showTables">
                        <li t-foreach="filteredTables" t-as="name" t-key="name"
                            t-att-class="{ 'sqlms-active': state.selected === name }"
                            t-on-click="() => this.selectObject(name, 'table')">
                            <input type="checkbox" class="sqlms-check"
                                   t-att-checked="state.checked[name]"
                                   t-on-click="(ev) => this.toggleCheck(name, ev)"/>
                            <span class="sqlms-name" t-esc="name"/>
                            <button class="sqlms-fav" t-att-class="{ 'sqlms-fav-on': isFavorite(name) }"
                                    t-att-title="isFavorite(name) ? 'Remove from favourites' : 'Add to favourites'"
                                    t-on-click="(ev) => this.toggleFavorite(name, 'table', ev)">
                                <i class="fa" t-att-class="isFavorite(name) ? 'fa-star' : 'fa-star-o'"/>
                            </button>
                            <button class="sqlms-insert" title="Insert into query"
                                    t-on-click="(ev) => this.insertObject(name, ev)">
                                <i class="fa fa-code"/>
                            </button>
                        </li>
                    </ul>

                    <!-- VIEWS -->
                    <div class="sqlms-group-title" t-on-click="toggleViews">
                        <i class="fa" t-att-class="state.showViews ? 'fa-caret-down' : 'fa-caret-right'"/>
                        <i class="fa fa-eye"/> Views
                        <span class="sqlms-count" t-esc="filteredViews.length"/>
                    </div>
                    <ul class="sqlms-list" t-if="state.showViews">
                        <li t-foreach="filteredViews" t-as="name" t-key="name"
                            t-att-class="{ 'sqlms-active': state.selected === name }"
                            t-on-click="() => this.selectObject(name, 'view')">
                            <input type="checkbox" class="sqlms-check"
                                   t-att-checked="state.checked[name]"
                                   t-on-click="(ev) => this.toggleCheck(name, ev)"/>
                            <span class="sqlms-name" t-esc="name"/>
                            <button class="sqlms-fav" t-att-class="{ 'sqlms-fav-on': isFavorite(name) }"
                                    t-att-title="isFavorite(name) ? 'Remove from favourites' : 'Add to favourites'"
                                    t-on-click="(ev) => this.toggleFavorite(name, 'view', ev)">
                                <i class="fa" t-att-class="isFavorite(name) ? 'fa-star' : 'fa-star-o'"/>
                            </button>
                            <button class="sqlms-insert" title="Insert into query"
                                    t-on-click="(ev) => this.insertObject(name, ev)">
                                <i class="fa fa-code"/>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="sqlms-resizer sqlms-resizer-x"
                 title="Drag to resize the list — double-click to reset"
                 t-on-pointerdown="(ev) => this.startResize(ev, 'sidebar')"
                 t-on-dblclick="() => this.resetResize('sidebar')">
                <span class="sqlms-resizer-grip"/>
            </div>

            <!-- Right: detail -->
            <div class="sqlms-main">
                <div class="sqlms-tabs">
                    <button t-att-class="{ 'sqlms-tab-active': state.activeTab === 'query' }"
                            t-on-click="() => this.setTab('query')">Query</button>
                    <button t-att-class="{ 'sqlms-tab-active': state.activeTab === 'fields' }"
                            t-on-click="() => this.setTab('fields')">Fields</button>
                    <button t-att-class="{ 'sqlms-tab-active': state.activeTab === 'mapping' }"
                            t-on-click="() => this.setTab('mapping')">Field Mapping</button>
                    <span class="sqlms-selected" t-if="state.selected">
                        <t t-esc="state.selectedType"/>: <b t-esc="state.selected"/>
                    </span>
                </div>

                <div class="sqlms-content">
                    <!-- FIELDS -->
                    <div t-if="state.activeTab === 'fields'" class="sqlms-pane">
                        <t t-if="!_fieldsTables().length and !state.fieldGroups.length">
                            <div class="sqlms-empty">
                                Click a table/view (or tick several) on the left to see its fields —
                                or execute a query and its own result columns show up here.
                            </div>
                        </t>
                        <t t-elif="state.loading">
                            <div class="sqlms-empty">Loading fields…</div>
                        </t>
                        <t t-else="">
                            <div class="sqlms-toolbar">
                                <button class="btn btn-primary btn-sm" t-on-click="buildFieldQuery"
                                        t-att-disabled="!pickedFieldCount or state.loading or hasDerivedPicks"
                                        t-att-title="hasDerivedPicks ? 'Result columns have no table to select from — pick columns of a table on the left to build a query' : 'Build a SELECT of the ticked fields (joining their tables when there is more than one)'">
                                    <i class="fa fa-magic"/> Build query
                                    <t t-if="pickedFieldCount">(<t t-esc="pickedFieldCount"/>)</t>
                                </button>
                                <button class="btn btn-secondary btn-sm"
                                        t-on-click="openConvertType"
                                        t-att-disabled="!pickedFieldCount or state.loading"
                                        t-att-title="hasDerivedPicks ? 'Rewrite the query so the ticked result column(s) come back as numbers' : 'Convert the ticked text column(s) to a numeric type'">
                                    <i class="fa fa-exchange"/> Text &#8594; number
                                </button>
                                <button class="btn btn-link btn-sm" t-if="pickedFieldCount"
                                        t-on-click="clearFieldPicks">
                                    Clear field selection
                                </button>
                                <button class="btn btn-secondary btn-sm" t-on-click="copyFields">
                                    <i class="fa fa-clipboard"/> Copy fields
                                </button>
                                <span class="sqlms-searchbox">
                                    <i class="fa fa-search"/>
                                    <input type="text" placeholder="Search field name..."
                                           t-model="state.fieldFilter"/>
                                    <button class="sqlms-searchbox-x" t-if="state.fieldFilter"
                                            title="Clear the field search"
                                            t-on-click="clearFieldFilter">&#215;</button>
                                </span>
                                <span class="sqlms-info">
                                    <t t-if="state.fieldFilter.trim()">
                                        <t t-esc="visibleFieldCount"/> of
                                        <t t-esc="fieldCount"/> field(s) match
                                    </t>
                                    <t t-else="">
                                        <t t-esc="fieldCount"/> field(s) in
                                        <t t-esc="state.fieldGroups.length"/> table(s)
                                    </t>
                                </span>
                                <span class="sqlms-info" t-if="pickedFieldCount">
                                    · <t t-esc="pickedFieldCount"/> picked,
                                    <t t-esc="groupedFieldCount"/> grouped,
                                    <t t-esc="orderedFieldCount"/> ordered
                                </span>
                            </div>
                            <div class="sqlms-hint" t-if="groupedFieldCount">
                                Grouping is on: the picked fields that are not grouped come back
                                as SUM (numeric) or COUNT(DISTINCT …), next to a COUNT(*).
                            </div>
                            <div class="sqlms-groupscroll">
                                <div t-if="!filteredFieldGroups.length" class="sqlms-empty">
                                    No field matches “<t t-esc="state.fieldFilter"/>”.
                                </div>
                                <div t-foreach="filteredFieldGroups" t-as="g" t-key="g.table"
                                     class="sqlms-fieldgroup">
                                    <div class="sqlms-group-title2"
                                         t-on-click="() => this.toggleFieldGroup(g.table)">
                                        <i class="fa" t-att-class="!state.collapsedGroups[g.table] ? 'fa-caret-down' : 'fa-caret-right'"/>
                                        <b t-esc="g.table"/>
                                        <span class="sqlms-derived-tag" t-if="g.derived"
                                              title="Columns of the last executed query, not of a table">
                                            from the query
                                        </span>
                                        <span class="sqlms-count" t-esc="g.fields.length"/>
                                        <label class="sqlms-allfields"
                                               t-on-click="(ev) => ev.stopPropagation()"
                                               title="Tick every field of this table">
                                            <input type="checkbox"
                                                   t-att-checked="allFieldsPicked(g)"
                                                   t-on-click="(ev) => this.toggleAllFields(g, ev)"/>
                                            all
                                        </label>
                                    </div>
                                    <div class="sqlms-grouptablewrap" t-if="!state.collapsedGroups[g.table]">
                                        <table class="sqlms-grid">
                                            <thead>
                                                <tr>
                                                    <th class="sqlms-pickcol" title="Include in the built query"/>
                                                    <th class="sqlms-pickcol">Group</th>
                                                    <th class="sqlms-pickcol">Order</th>
                                                    <th>Field name</th>
                                                    <th>Field type</th>
                                                    <th>Precision / Length</th>
                                                    <th>Nullable</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="g.fields" t-as="f" t-key="f.name"
                                                    t-att-class="{ 'sqlms-row-picked': isFieldPicked(g.table, f.name) }">
                                                    <td class="sqlms-pickcol">
                                                        <input type="checkbox"
                                                               t-att-checked="isFieldPicked(g.table, f.name)"
                                                               t-att-title="'Include ' + g.table + '.' + f.name + ' in the built query'"
                                                               t-on-click="(ev) => this.toggleFieldPick(g.table, f, ev)"/>
                                                    </td>
                                                    <t t-if="g.derived">
                                                        <td class="sqlms-pickcol"/>
                                                        <td class="sqlms-pickcol"/>
                                                    </t>
                                                    <t t-else="">
                                                        <td class="sqlms-pickcol">
                                                            <button class="sqlms-pickbtn"
                                                                    t-att-class="{ 'sqlms-pickbtn-on': isFieldGrouped(g.table, f.name) }"
                                                                    title="Group the built query by this field"
                                                                    t-on-click="(ev) => this.toggleFieldGroupBy(g.table, f, ev)">
                                                                <i class="fa fa-object-group"/>
                                                            </button>
                                                        </td>
                                                        <td class="sqlms-pickcol">
                                                            <button class="sqlms-pickbtn"
                                                                    t-att-class="{ 'sqlms-pickbtn-on': fieldOrderDir(g.table, f.name) }"
                                                                    title="Order the built query by this field (click again for descending, once more to drop it)"
                                                                    t-on-click="(ev) => this.cycleFieldOrder(g.table, f, ev)">
                                                                <i class="fa"
                                                                   t-att-class="fieldOrderDir(g.table, f.name) === 'desc' ? 'fa-sort-amount-desc' : (fieldOrderDir(g.table, f.name) === 'asc' ? 'fa-sort-amount-asc' : 'fa-sort')"/>
                                                            </button>
                                                        </td>
                                                    </t>
                                                    <td t-esc="f.name"/>
                                                    <td t-esc="f.type"/>
                                                    <td t-esc="f.precision"/>
                                                    <td t-esc="f.nullable"/>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- FIELD MAPPING -->
                    <div t-if="state.activeTab === 'mapping'" class="sqlms-pane">
                        <t t-if="!_mappingTables().length">
                            <div class="sqlms-empty">Select a table/view (or tick several) on the left, or write a query, to see the field mapping.</div>
                        </t>
                        <t t-elif="state.loading">
                            <div class="sqlms-empty">Loading field mapping…</div>
                        </t>
                        <t t-elif="state.mapping">
                            <div class="sqlms-toolbar">
                                <button class="btn btn-secondary btn-sm" t-on-click="copyMapping"
                                        t-if="state.mapping.rows.length">
                                    <i class="fa fa-clipboard"/> Copy mapping
                                </button>
                                <span class="sqlms-info">
                                    <t t-esc="state.mapping.rows.length"/> mapping(s) for
                                    <b t-esc="_mappingTables().join(', ')"/>
                                </span>
                            </div>
                            <div class="sqlms-tablewrap" t-if="state.mapping.rows.length">
                                <table class="sqlms-grid">
                                    <thead>
                                        <tr>
                                            <th>From table</th>
                                            <th>From column</th>
                                            <th/>
                                            <th>To table</th>
                                            <th>To column</th>
                                            <th>Via</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.mapping.rows" t-as="m" t-key="m_index">
                                            <td t-esc="m.from_table"/>
                                            <td t-esc="m.from_column"/>
                                            <td class="sqlms-arrow">&#8594;</td>
                                            <td t-esc="m.to_table"/>
                                            <td t-esc="m.to_column"/>
                                            <td>
                                                <span t-att-class="'sqlms-via sqlms-via-' + m.via"
                                                      t-esc="m.via"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="sqlms-unrelated" t-if="state.mapping.unrelated.length">
                                <div class="sqlms-unrelated-head">
                                    <i class="fa fa-exclamation-triangle"/>
                                    No relationship detected for these selected table(s).
                                    Their code/key columns are shown below — define a mapping under
                                    <b>Database Studio ▸ Relations</b> to join them.
                                </div>
                                <div class="sqlms-unrelated-item" t-foreach="state.mapping.unrelated"
                                     t-as="ut" t-key="ut">
                                    <b t-esc="ut"/>:
                                    <span class="sqlms-cand"
                                          t-esc="(state.mapping.candidates[ut] or []).join(', ') or 'no code/key-like columns'"/>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- QUERY -->
                    <div t-if="state.activeTab === 'query'" class="sqlms-pane sqlms-querypane">
                        <div class="sqlms-qtabs">
                            <div t-foreach="state.qtabs" t-as="qt" t-key="qt.id"
                                 class="sqlms-qtab"
                                 t-att-class="{ 'sqlms-qtab-active': qt.id === state.activeQtabId }"
                                 t-on-click="() => this.switchQtab(qt.id)">
                                <span class="sqlms-qtab-name" t-esc="qt.name" t-att-title="qt.fullName || qt.name"/>
                                <span class="sqlms-qtab-close" title="Close tab"
                                      t-on-click="(ev) => this.removeQtab(qt.id, ev)">&#215;</span>
                            </div>
                            <button class="sqlms-qtab-add" title="New query tab"
                                    t-on-click="addQtab">
                                <i class="fa fa-plus"/>
                            </button>
                            <div class="sqlms-tabmenu-wrap" t-if="state.qtabs.length > 1">
                                <button class="sqlms-qtab-add sqlms-qtab-closeall"
                                        title="Close query tabs…"
                                        t-on-click="toggleTabMenu">
                                    <i class="fa fa-window-close-o"/>
                                    <i class="fa fa-caret-down"/>
                                </button>
                                <t t-if="state.tabMenuOpen">
                                    <div class="sqlms-tabmenu-backdrop" t-on-click="closeTabMenu"/>
                                    <div class="sqlms-tabmenu">
                                        <div class="sqlms-tabmenu-head">Close query tabs</div>
                                        <button t-att-disabled="!otherQtabCount"
                                                t-on-click="closeOtherQtabs">
                                            Close all except this one
                                            <span class="sqlms-tabmenu-n" t-esc="otherQtabCount"/>
                                        </button>
                                        <button t-att-disabled="!leftQtabCount"
                                                t-on-click="closeQtabsToLeft">
                                            Close all to the left
                                            <span class="sqlms-tabmenu-n" t-esc="leftQtabCount"/>
                                        </button>
                                        <button t-att-disabled="!rightQtabCount"
                                                t-on-click="closeQtabsToRight">
                                            Close all to the right
                                            <span class="sqlms-tabmenu-n" t-esc="rightQtabCount"/>
                                        </button>
                                        <button t-att-disabled="!savedQtabCount"
                                                t-on-click="closeSavedQtabs"
                                                title="Tabs already in History close without asking">
                                            Close saved ones
                                            <span class="sqlms-tabmenu-n" t-esc="savedQtabCount"/>
                                        </button>
                                        <button t-on-click="closeAllQtabs">
                                            Close all
                                            <span class="sqlms-tabmenu-n" t-esc="state.qtabs.length"/>
                                        </button>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div class="sqlms-toolbar">
                            <button class="btn btn-primary btn-sm" t-on-click="() => this.runQuery(1, true)"
                                    t-att-disabled="state.loading">
                                <i class="fa fa-play"/> Execute
                            </button>
                            <button class="btn btn-secondary btn-sm" t-on-click="formatQuery">
                                <i class="fa fa-indent"/> Format
                            </button>
                            <button class="btn btn-secondary btn-sm" t-on-click="saveQuery">
                                <i class="fa fa-star"/> Save
                            </button>
                            <button class="btn btn-secondary btn-sm" t-on-click="copyQuery">
                                <i class="fa fa-clipboard"/> Copy query
                            </button>
                            <button class="btn btn-secondary btn-sm" t-on-click="clearQuery">
                                <i class="fa fa-eraser"/> Clear
                            </button>
                            <button class="btn btn-secondary btn-sm" t-if="state.execRange"
                                    t-on-click="clearExecHighlight"
                                    title="Remove the highlight marking the part of the query that was executed">
                                <i class="fa fa-eraser"/> Clear highlight
                            </button>
                            <t t-if="foldableCount">
                                <button class="btn btn-secondary btn-sm" t-on-click="foldAll"
                                        title="Collapse every statement">
                                    <i class="fa fa-compress"/> Fold all
                                </button>
                                <button class="btn btn-secondary btn-sm" t-on-click="unfoldAll"
                                        title="Expand every collapsed statement">
                                    <i class="fa fa-expand"/> Unfold all
                                </button>
                            </t>
                            <span class="sqlms-info">Tip: select part of the query to run only that; use the +/- icons in the left margin to fold a statement.</span>
                        </div>
                        <div class="sqlms-editor" t-ref="editorEl">
                            <div class="sqlms-gutter">
                                <div class="sqlms-gutter-inner" t-ref="queryGutter">
                                    <t t-foreach="sections" t-as="sec" t-key="sec.key">
                                        <span t-if="sec.foldable" class="sqlms-fold"
                                              t-att-style="'top:' + sec.top + 'px'"
                                              t-att-title="(sec.collapsed ? 'Expand' : 'Collapse') + ' statement ' + (sec.index + 1) + ' (' + sec.lineCount + ' lines)'"
                                              t-on-click="() => this.toggleSection(sec.index)">
                                            <i class="fa" t-att-class="sec.collapsed ? 'fa-plus-square-o' : 'fa-minus-square-o'"/>
                                        </span>
                                    </t>
                                </div>
                            </div>
                            <pre class="sqlms-highlight" t-ref="queryHighlight"/>
                            <textarea class="sqlms-textarea" t-ref="queryTextarea"
                                      spellcheck="false"
                                      placeholder="Type or paste a query..."
                                      t-on-input="onEditorInput"
                                      t-on-mousedown="clearExecHighlight"
                                      t-on-scroll="onEditorScroll"/>
                        </div>
                        <div class="sqlms-resizer sqlms-resizer-y"
                             title="Drag to resize the editor — double-click to reset"
                             t-on-pointerdown="(ev) => this.startResize(ev, 'editor')"
                             t-on-dblclick="() => this.resetResize('editor')">
                            <span class="sqlms-resizer-grip"/>
                        </div>
                        <t t-if="state.queryResult">
                            <div class="sqlms-toolbar">
                                <label class="sqlms-aggpick" t-if="state.queryResult.columns.length"
                                       title="Show a total under each selected column, computed over every row of the result — not just the page shown.">
                                    Totals:
                                    <select class="sqlms-aggselect" t-model="state.aggFunc">
                                        <option value="">None</option>
                                        <option value="sum">Sum</option>
                                        <option value="count">Count</option>
                                        <option value="avg">Average</option>
                                        <option value="min">Min</option>
                                        <option value="max">Max</option>
                                    </select>
                                </label>
                                <button class="btn btn-secondary btn-sm" t-on-click="copyResults"
                                        t-if="state.queryResult.columns.length"
                                        t-att-title="state.selectedCols.length ? ('Copy the ' + state.selectedCols.length + ' selected column(s)') : 'Copy the currently shown page as tab-separated text'">
                                    <i class="fa fa-clipboard"/> Copy
                                    <t t-if="state.selectedCols.length">(<t t-esc="state.selectedCols.length"/>)</t>
                                </button>
                                <button class="btn btn-link btn-sm" t-if="state.selectedCols.length"
                                        t-on-click="clearColumnSelection">
                                    Clear column selection
                                </button>
                                <button class="btn btn-secondary btn-sm" t-on-click="exportExcel"
                                        t-if="state.queryResult.columns.length"
                                        t-att-disabled="state.exporting"
                                        title="Export every row of this query's result to an Excel file">
                                    <i class="fa fa-file-excel-o"/> Export Excel
                                </button>
                                <span class="sqlms-info" t-if="state.queryResult.message"
                                      t-esc="state.queryResult.message"/>
                                <span class="sqlms-info" t-if="state.queryResult.columns.length">
                                    Click column headers to select; Alt+C copies the selected column(s).
                                </span>
                                <t t-if="state.queryResult.columns.length">
                                    <t t-call="database_studio.Pager">
                                        <t t-set="res" t-value="state.queryResult"/>
                                        <t t-set="go" t-value="(p) => this.runQuery(p)"/>
                                        <t t-set="busy" t-value="state.loading"/>
                                    </t>
                                </t>
                            </div>
                            <t t-if="state.queryResult.columns.length"
                               t-call="database_studio.ResultGrid">
                                <t t-set="res" t-value="state.queryResult"/>
                            </t>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- Reusable pager -->
    <t t-name="database_studio.Pager">
        <span class="sqlms-pager">
            <button class="btn btn-sm btn-light" t-att-disabled="res.page &lt;= 1 || busy"
                    t-on-click="() => go(1)" title="First">
                <i class="fa fa-angle-double-left"/>
            </button>
            <button class="btn btn-sm btn-light" t-att-disabled="res.page &lt;= 1 || busy"
                    t-on-click="() => go(res.page - 1)" title="Previous">
                <i class="fa fa-angle-left"/>
            </button>
            <span class="sqlms-pageinfo">
                Page <b t-esc="res.page"/> / <t t-esc="res.pages"/>
                (<t t-esc="res.total"/> rows)
            </span>
            <button class="btn btn-sm btn-light" t-att-disabled="res.page &gt;= res.pages || busy"
                    t-on-click="() => go(res.page + 1)" title="Next">
                <i class="fa fa-angle-right"/>
            </button>
            <button class="btn btn-sm btn-light" t-att-disabled="res.page &gt;= res.pages || busy"
                    t-on-click="() => go(res.pages)" title="Last">
                <i class="fa fa-angle-double-right"/>
            </button>
        </span>
    </t>

    <!-- Reusable result grid -->
    <t t-name="database_studio.ResultGrid">
        <div class="sqlms-tablewrap">
            <table class="sqlms-grid">
                <thead>
                    <tr>
                        <th class="sqlms-rownum">#</th>
                        <th t-foreach="res.columns" t-as="col" t-key="col_index"
                            class="sqlms-colhead"
                            t-att-class="{ 'sqlms-col-selected': state.selectedCols.includes(col_index) }"
                            title="Click to select this column (click again to deselect, click others to select several). Alt+C copies the selection."
                            t-on-click="(ev) => this.toggleColumn(col_index, ev)"
                            t-esc="col"/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="res.rows" t-as="row" t-key="row_index">
                        <td class="sqlms-rownum"
                            t-esc="(res.page - 1) * res.limit + row_index + 1"/>
                        <t t-foreach="row" t-as="val" t-key="val_index">
                            <td t-if="val === null" class="sqlms-null"
                                t-att-class="{ 'sqlms-col-selected': state.selectedCols.includes(val_index) }">NULL</td>
                            <td t-else=""
                                t-att-class="{ 'sqlms-col-selected': state.selectedCols.includes(val_index) }"
                                t-esc="val"/>
                        </t>
                    </tr>
                </tbody>
                <tfoot t-if="state.aggFunc and res.aggregates and res.aggregates.length">
                    <tr>
                        <td class="sqlms-rownum sqlms-aggcell"
                            t-att-title="aggLabel + ' over all ' + res.total + ' row(s)'"
                            t-esc="aggLabel"/>
                        <t t-foreach="res.columns" t-as="col" t-key="col_index">
                            <td class="sqlms-aggcell"
                                t-att-class="{ 'sqlms-col-selected': state.selectedCols.includes(col_index) }"
                                t-esc="aggValue(res, col_index)"/>
                        </t>
                    </tr>
                </tfoot>
            </table>
        </div>
    </t>
</templates>
