<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="get_products_from_setu_reports_form_view" model="ir.ui.view">
            <field name="name">get.products.from.adv.inv.rep.wizard.form</field>
            <field name="model">get.products.from.adv.inv.rep.wizard</field>
            <field name="arch" type="xml">
                <form string="Get Products">
                    <sheet>
                        <group>
                            <group>
                                <field name="report_type" required="1" widget="radio"/>
                            </group>
                        </group>
                        <group expand="0" invisible="not report_type" name="ABC" string="Filters">
                            <group expand="0" string="Choose dates to calculate sales">
                                <field name="start_date" required="report_type"/>
                                <field name="end_date" required="report_type"/>
                            </group>
                            <group expand="0" string="Choose sales category">
                                <field name="abc_analysis_type" required="report_type" widget="radio"/>
                            </group>
                        </group>
                        <group expand="0" invisible="not report_type" name="FSN" string="Filters">
                            <group expand="0" string="Choose dates to calculate sales">
                                <field name="start_date" required="report_type"/>
                                <field name="end_date" required="report_type"/>
                            </group>
                            <group expand="0" string="Choose movement type">
                                <field name="stock_movement_type" required="report_type" widget="radio"/>
                            </group>
                        </group>
                        <group expand="0" invisible="not report_type" name="XYZ" string="Filters">
                            <group expand="0" string="Choose stock value category">
                                <field name="inventory_analysis_type" required="report_type" widget="radio"/>
                            </group>
                            <group expand="0" string="">
                            </group>
                        </group>
                        <group>
                            <group expand="0" string="Products &amp; Categories">
                                <field name="product_category_ids" options="{'no_create_edit': True}" widget="many2many_tags"/>
                                <field name="product_ids" options="{'no_create_edit': True}" widget="many2many_tags"/>
                            </group>
                            <!--                            <group expand="0" string="Companies">-->
                            <!--                                <field name="company_ids" widget="many2many_tags"-->
                            <!--                                       options="{'no_create_edit': True}"/>-->
                            <!--                                 <field name="warehouse_ids" widget="many2many_tags" options="{'no_create_edit': True}" attrs="{'invisible':[('report_type','not in',('FSN','ABC'))]}"/>-->
                            <!--                            </group>-->
                        </group>
                    </sheet>
                    <footer>
                        <button class="oe_highlight" name="get_products_from_setu_reports" string="Set Products" type="object"/>
                    </footer>
                </form></field>
        </record>
        <record id="get_products_from_setu_reports_act_window" model="ir.actions.act_window">
            <field name="name">Get Products</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">get.products.from.adv.inv.rep.wizard</field>
            <!--            <field name="view_type">form</field>-->
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
