<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="inventory_count_report_wizard_form_view" model="ir.ui.view">
            <field name="name">inventory.count.report.form</field>
            <field name="model">inventory.count.report</field>
            <field name="arch" type="xml">
                <form string="Inventory Count">
                    <sheet>
                         <div style="margin-top:-15px;">
                            • Select the <strong>Location(s)</strong> and <strong>User(s)</strong> only if you want the data with specific location(s) and user(s).
                            <br/>
                            • Report will be generated based on selected <strong>Date Range</strong>.
                            Do not select the dates if you want all data report.
                         </div>
                        <group>
                            <group>
                                <field name="start_date"/>
                            </group>
                            <group>
                                <field name="end_date"/>
                            </group>
                        </group>
                        <group>
                            <group>
<!--                                <field name="warehouse_ids" widget="many2many_tags"/>-->
                                <field name="location_ids" options="{'no_create': True, 'no_create_edit':True}"
                                       widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="user_ids" options="{'no_create': True, 'no_create_edit':True}"
                                       string="Approvers" widget="many2many_tags" domain="[('share','=',False)]"/>
                            </group>
                        </group>

                    </sheet>
                    <footer>
                        <button name="generate_report" string="Generate" type="object" class="oe_highlight"/>
                        <button name = "pdf_report" string="Print Pdf" type = "object" class = "oe_highlight"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="inventory_count_report_tree_view" model="ir.ui.view">
            <field name="name">inventory.count.report.tree</field>
            <field name="model">inventory.count.report</field>
            <field name="arch" type="xml">
                <tree string="Inventory Count" create="0" edit="0" delete="0">
                    <field name="user_id" string="Responsible" widget="none"/>
                    <field name="count_id" widget="none"/>
                    <field name="product_id" widget="none"/>
                    <field name="location_id" widget="none"/>
                    <field name="warehouse_id" widget="none"/>
                    <field name="inventory_count_date" widget="none" string="Date"/>
                    <field name="theoretical_qty" widget="none"/>
                    <field name="counted_qty" widget="none"/>
                    <field name="discrepancy_qty" widget="none"/>
                </tree>
            </field>
        </record>

        <record id="inventory_count_report_wizard_act_window" model="ir.actions.act_window">
            <field name="name">Inventory Count</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">inventory.count.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <record id="inventory_count_report_act_window" model="ir.actions.act_window">
            <field name="name">Inventory Count</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">inventory.count.report</field>
            <field name="view_mode">tree</field>
            <field name="context">{'search_default_group_by_count_id':1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There are no Inventory Counts completed.
                </p>
            </field>
        </record>

     <record id="pdf_inventory_count_report" model="ir.actions.report">
            <field name="name">Inventory Count Report</field>
             <field name="model">inventory.count.report</field>
             <field name="report_type">qweb-pdf</field>
             <field name="report_name">setu_inventory_count_management.report_inventory_count_pdf</field>
             <field name="report_file">inventory_count_report</field>
             <field name="binding_model_id" ref="model_inventory_count_report"/>
            <field name = "binding_type">report</field>
        </record>


  	<template id="report_inventory_count_pdf">
        <t t-call="web.html_container">
        <t t-call="web.internal_layout">
        <div class="page">
            <div class="text-center">
                <h3> <t t-esc="report_head"/>Inventory Count Report</h3>
                <table>
                	<tr>
                	<td class="text-left">Start Date : <t t-esc="form_data['start_date']"/></td>
                	</tr>
                	<tr>
                	<td class="text-left">End Date : <t t-esc="form_data['end_date']"/></td>
                	</tr>

                </table>

            </div>
        </div>
     
               <div class="page">

                    <table class="table table-condensed">
                     	<t t-set="theoretical_qty_total" t-value="0.0"></t>
                     	<t t-set="counted_qty_total" t-value="0.0"></t>
                     	<t t-set="discrepancy_qty_total" t-value="0.0"></t>
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Name</th>
                                <th>Product</th>
                                <th>Location</th>
                                <th>Warehouse</th>
                                 <th>Inventory Count Date</th>
                                <th>Theoretical Quantity</th>
                                <th>Counted Quantity</th>
                                <th>Discrepancy Quantity</th>
                            </tr>
                        </thead>
                        <tbody>

                            <t t-foreach="selection" t-as="line">
                             <tr>
                             <td>
                          		  <strong><t t-esc="line_index+1"/></strong>
                        	</td>
                                  <td>
                                    <span t-esc="line['name']" />
                                </td>
                                <td>
                                    <span t-esc="line['product_id']" />
                                </td>
                                   <td>
                                    <span t-esc="line['location_id']" />
                                </td>
                                   <td>
                                    <span t-esc="line['warehouse_id']" />
                                </td>
                                   <td>
                                    <span t-esc="line['inventory_count_date']" />
                                   </td>
                                 <td>
                                    <span t-esc="line['qty_in_stock']" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                    <t t-set="theoretical_qty_total" t-value="theoretical_qty_total+line['qty_in_stock']"></t>
                               </td>
                                <td>
                                    <span t-esc="line['counted_qty']" t-options='{"widget": "float", "decimal_precision": "2"}' />
                                    <t t-set="counted_qty_total" t-value="counted_qty_total+line['counted_qty']"></t>
                                </td>
                                 <td>
                                    <span t-esc="line['is_discrepancy_found']" t-options='{"widget": "float", "decimal_precision": "2"}' />
                                     <t t-set="discrepancy_qty_total" t-value="discrepancy_qty_total+line['is_discrepancy_found']"></t>
                                 </td>
                             </tr>
                            </t>
                             <tr>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>

                                <td class="text-center"><b>Total</b></td>
                                <td>
                                    <b><span t-esc="theoretical_qty_total" t-options='{"widget": "float", "decimal_precision": "2"}' /></b>
                                </td>
                                <td>
                                    <b><span t-esc="counted_qty_total" t-options='{"widget": "float", "decimal_precision": "2"}' /></b>
                                </td>
                                <td>
                                    <b><span t-esc="discrepancy_qty_total" t-options='{"widget": "float", "decimal_precision": "2"}' /></b>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
                </t>               
          </t>
       
    </template>

        <record id="inventory_count_report_act_server" model="ir.actions.server">
            <field name="name">Inventory Count Discrepancy Report</field>
            <field name="model_id" ref="setu_inventory_count_management.model_inventory_count_report"/>
            <field name="state">code</field>
            <field name="code">action = model.generate_report()</field>
        </record>

        <record id="inventory_count_report_search_view" model="ir.ui.view">
            <field name="name">inventory.count.report.search</field>
            <field name="model">inventory.count.report</field>
            <field name="arch" type="xml">
                <search string="Inventory Count Report">
                    <field name="count_id" string="Name" filter_domain="['|','|','|',('count_id','ilike',self),
                    ('product_id','ilike',self),('location_id','ilike',self),('warehouse_id','ilike',self)]"/>
                    <field name="user_id"/>
<!--                    <field name="count_id"/>-->
                    <field name="product_id"/>
                    <field name="location_id"/>
                    <field name="warehouse_id"/>
                    <group expand="1" string="Group By">
                        <filter string="Inventory Count" name="group_by_count_id" domain="[]"
                                context="{'group_by':'count_id'}"/>
                        <filter string="Responsible" name="group_by_user_id" domain="[]"
                                context="{'group_by':'user_id'}"/>
                        <filter string="Warehouse" name="group_by_warehouse" domain="[]"
                                context="{'group_by':'warehouse_id'}"/>
                        <filter string="Location" name="group_by_location" domain="[]"
                                context="{'group_by':'location_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <menuitem name="Reporting"
                  groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                  id="setu_inventory_count_reports_menu"
                  parent="setu_inventory_count_management.setu_inventory_count_root" sequence="999"/>

        <menuitem name="Count Report"
                  id="inventory_count_report_menu"
                  parent="setu_inventory_count_management.setu_inventory_count_reports_menu"
                  action="setu_inventory_count_management.inventory_count_report_wizard_act_window"/>
    </data>
</odoo>
