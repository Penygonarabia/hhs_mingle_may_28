<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================
         USERS SETUP LIST VIEW — compact: user, status only
         ====================================================== -->
    <record id="view_dashboard_rights_users_list" model="ir.ui.view">
        <field name="name">dashboard.rights.users.list</field>
        <field name="model">dashboard.rights</field>
        <field name="arch" type="xml">
            <tree string="Users Setup"
                  js_class="dashboard_rights_list"
                  class="dr_rights_list_view"
                  create="0"
                  delete="0"
                  default_order="user_id">
                <field name="user_id" string="User" readonly="1"/>
                <field name="access_status" string="Status" readonly="1"/>
                <!-- invisible fields needed by JS -->
                <field name="has_access_int" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ======================================================
         SUMMARY LIST — plain, non-collapsing; used ONLY by the "Dashboards
         Granted" smart button on Rights Setup. view_dashboard_rights_list
         below is deliberately NOT reused here: its js_class="dashboard_rights_list"
         auto-collapses to one row per user whenever its "optional" columns
         are hidden — which is their default state — so it always shows a
         single row regardless of domain. Fine for the "By User" directory
         use case; wrong for "show me every one of this user's dashboards".
         ====================================================== -->
    <record id="view_dashboard_rights_summary_list" model="ir.ui.view">
        <field name="name">dashboard.rights.summary.list</field>
        <field name="model">dashboard.rights</field>
        <field name="arch" type="xml">
            <tree string="Dashboard Rights Summary"
                  create="0"
                  delete="0"
                  default_order="dashboard_top_menu_id, dashboard_id">
                <field name="dashboard_top_menu_id" string="Category" readonly="1"/>
                <field name="dashboard_id" readonly="1"/>
                <field name="has_access" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- ======================================================
         LIST (tree) VIEW — full view kept for other actions
         ====================================================== -->
    <record id="view_dashboard_rights_list" model="ir.ui.view">
        <field name="name">dashboard.rights.list</field>
        <field name="model">dashboard.rights</field>
        <field name="arch" type="xml">
            <tree string="Dashboard Rights"
                  js_class="dashboard_rights_list"
                  class="dr_rights_list_view"
                  create="0"
                  delete="0"
                  default_order="user_id, dashboard_id">
                <field name="user_id" readonly="1"/>
                <field name="dashboard_top_menu_id"
                       string="Category"
                       optional="hide"
                       readonly="1"/>
                <field name="dashboard_id"
                       optional="hide"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="has_access"
                       optional="hide"
                       widget="boolean_toggle"/>
                <field name="has_access_int" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ======================================================
         FORM VIEW — editing a single dashboard right record
         ====================================================== -->
    <record id="view_dashboard_rights_form" model="ir.ui.view">
        <field name="name">dashboard.rights.form</field>
        <field name="model">dashboard.rights</field>
        <field name="arch" type="xml">
            <form string="Dashboard Right">
                <sheet>
                    <!-- Screen usage hint — shown only in new mode (creating a record) -->
                    <div class="alert alert-info d-flex align-items-start gap-2 mb-3 py-2 px-3" role="alert" style="font-size:0.9rem;" invisible="id">
                        <i class="fa fa-info-circle mt-1" style="flex-shrink:0;"/>
                        <span>
                            Pick a <strong>User</strong> and a <strong>Dashboard</strong>, then toggle <strong>Has Access</strong>
                            to grant or revoke that user's access to the selected dashboard. For bulk updates across many
                            dashboards, use <strong>Manage User Rights</strong> instead.
                        </span>
                    </div>

                    <group>
                        <group string="User">
                            <field name="user_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group string="Dashboard">
                            <field name="dashboard_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="dashboard_top_menu_id"
                                   string="Category"
                                   readonly="1"/>
                            <field name="has_access"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================================================
         SEARCH VIEW
         ====================================================== -->
    <record id="view_dashboard_rights_search" model="ir.ui.view">
        <field name="name">dashboard.rights.search</field>
        <field name="model">dashboard.rights</field>
        <field name="arch" type="xml">
            <search string="Dashboard Rights">
                <field name="user_id"/>
                <field name="dashboard_id"/>
                <field name="dashboard_top_menu_id" string="Category"/>
                <filter name="filter_granted"
                        string="Granted"
                        domain="[('has_access', '=', True)]"/>
                <filter name="filter_revoked"
                        string="Revoked"
                        domain="[('has_access', '=', False)]"/>
                <separator/>
                <group expand="1" string="Group By">
                    <filter name="group_user"
                            string="User"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_category"
                            string="Category"
                            context="{'group_by': 'dashboard_top_menu_id'}"/>
                    <filter name="group_dashboard"
                            string="Dashboard"
                            context="{'group_by': 'dashboard_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ======================================================
         MAIN ACTIONS — tree + form, with various groupings
         ====================================================== -->
    <record id="action_dashboard_rights_list" model="ir.actions.act_window">
        <field name="name">Module Rights</field>
        <field name="res_model">dashboard.rights</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dashboard_rights_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dashboard_rights_form')})]"/>
        <field name="search_view_id" ref="view_dashboard_rights_search"/>
        <field name="context">{'unique_users_only': True}</field>
    </record>

    <!-- Legacy aliases kept so existing references still resolve -->
    <record id="action_dashboard_rights_grid" model="ir.actions.act_window">
        <field name="name">Users Setup</field>
        <field name="res_model">dashboard.rights</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dashboard_rights_users_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dashboard_rights_form')})]"/>
        <field name="search_view_id" ref="view_dashboard_rights_search"/>
        <field name="context">{'unique_users_only': True}</field>
    </record>

    <record id="action_dashboard_rights_by_category" model="ir.actions.act_window">
        <field name="name">Dashboard Rights (By Category)</field>
        <field name="res_model">dashboard.rights</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dashboard_rights_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dashboard_rights_form')})]"/>
        <field name="search_view_id" ref="view_dashboard_rights_search"/>
        <field name="context">{'search_default_group_category': 1}</field>
    </record>

    <record id="action_dashboard_rights_by_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard Rights (By Dashboard)</field>
        <field name="res_model">dashboard.rights</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dashboard_rights_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dashboard_rights_form')})]"/>
        <field name="search_view_id" ref="view_dashboard_rights_search"/>
        <field name="context">{'search_default_group_dashboard': 1}</field>
    </record>

    <record id="action_dashboard_rights_raw" model="ir.actions.act_window">
        <field name="name">Dashboard Rights (Raw)</field>
        <field name="res_model">dashboard.rights</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_dashboard_rights_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dashboard_rights_form')})]"/>
        <field name="search_view_id" ref="view_dashboard_rights_search"/>
    </record>

</odoo>
