<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dashboard_rights_copy_wizard_form" model="ir.ui.view">
        <field name="name">dashboard.rights.copy.wizard.form</field>
        <field name="model">dashboard.rights.copy.wizard</field>
        <field name="arch" type="xml">
            <form string="Copy Rights To Other Users">
                <div class="alert alert-info d-flex align-items-start gap-2 mb-3 py-2 px-3" role="alert" style="font-size:0.9rem;">
                    <i class="fa fa-info-circle mt-1" style="flex-shrink:0;"/>
                    <span>
                        Copies EVERYTHING the source user can currently see — dashboards, Quick
                        Access/Configuration items, and every Controlled Module menu — onto the
                        target user(s). Existing target rights are overwritten to match the source;
                        nothing else is touched.
                    </span>
                </div>
                <group>
                    <field name="source_user_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="copy_scope" widget="radio"/>
                    <field name="target_user_ids"
                           widget="many2many_tags"
                           invisible="copy_scope != 'users'"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_copy_rights"
                            string="Copy Rights"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dashboard_rights_copy_wizard" model="ir.actions.act_window">
        <field name="name">Copy Rights</field>
        <field name="res_model">dashboard.rights.copy.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dashboard_rights_copy_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
