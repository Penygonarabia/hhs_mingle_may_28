<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loyalty_invoice_process_result_form" model="ir.ui.view">
        <field name="name">loyalty.invoice.process.result.form</field>
        <field name="model">loyalty.invoice.process.result</field>
        <field name="arch" type="xml">
            <form string="Invoice Processing Result" create="false" edit="false">
                <sheet>
                    <!-- Summary Banner -->
                    <div class="alert alert-info" role="alert" style="border-radius:8px; padding: 16px 20px; margin-bottom:16px;">
                        <h4 style="margin:0 0 8px 0; font-size:16px; font-weight:700; color:#1a1a2e;">
                            &#x2705; Invoice Processing Completed
                        </h4>
                        <div style="display:flex; gap:40px; flex-wrap:wrap;">
                            <div style="text-align:center;">
                                <div style="font-size:28px; font-weight:800; color:#1a1a2e;">
                                    <field name="total_records" readonly="1" nolabel="1"/>
                                </div>
                                <div style="font-size:12px; color:#666; font-weight:600; text-transform:uppercase; letter-spacing:0.5px;">Total Processed</div>
                            </div>
                            <div style="text-align:center;">
                                <div style="font-size:28px; font-weight:800; color:#28a745;">
                                    <field name="success_count" readonly="1" nolabel="1"/>
                                </div>
                                <div style="font-size:12px; color:#666; font-weight:600; text-transform:uppercase; letter-spacing:0.5px;">Success</div>
                            </div>
                            <div style="text-align:center;">
                                <div style="font-size:28px; font-weight:800; color:#dc3545;">
                                    <field name="failed_count" readonly="1" nolabel="1"/>
                                </div>
                                <div style="font-size:12px; color:#666; font-weight:600; text-transform:uppercase; letter-spacing:0.5px;">Failed</div>
                            </div>
                        </div>
                    </div>

                    <!-- Two-column layout for Success / Failed -->
                    <div class="row">
                        <!-- Success Column -->
                        <div class="col-6" style="padding-right:8px;">
                            <div style="background:#f0fff4; border:1px solid #b2dfdb; border-radius:6px; padding:12px;">
                                <h5 style="color:#155724; margin:0 0 8px 0; font-size:13px; font-weight:700; border-bottom:1px solid #b2dfdb; padding-bottom:6px;">
                                    &#x2714; Success Invoice Numbers (<field name="success_count" readonly="1" nolabel="1" class="oe_inline"/>)
                                </h5>
                                <field name="success_invoices"
                                       readonly="1"
                                       nolabel="1"
                                       widget="text"
                                       style="height:350px; overflow-y:auto; font-family:monospace; font-size:12px; background:transparent; border:none; width:100%; padding:0; resize:none; color:#155724;"/>
                            </div>
                        </div>

                        <!-- Failed Column -->
                        <div class="col-6" style="padding-left:8px;">
                            <div style="background:#fff5f5; border:1px solid #f5c6cb; border-radius:6px; padding:12px;">
                                <h5 style="color:#721c24; margin:0 0 8px 0; font-size:13px; font-weight:700; border-bottom:1px solid #f5c6cb; padding-bottom:6px;">
                                    &#x2716; Failed Invoice Numbers (<field name="failed_count" readonly="1" nolabel="1" class="oe_inline"/>)
                                </h5>
                                <field name="failed_invoices"
                                       readonly="1"
                                       nolabel="1"
                                       widget="text"
                                       style="height:350px; overflow-y:auto; font-family:monospace; font-size:12px; background:transparent; border:none; width:100%; padding:0; resize:none; color:#721c24;"/>
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
