<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <!-- ========================================== -->
        <!-- LOYALTY POINTS PROCESSED LOG VIEWS         -->
        <!-- ========================================== -->

        <!-- Tree View -->
        <record id="view_loyalty_points_processed_log_tree" model="ir.ui.view">
            <field name="name">loyalty.points.processed.log.tree</field>
            <field name="model">loyalty.points.processed.log</field>
            <field name="arch" type="xml">
                <tree string="ERP Sync Logs" decoration-danger="type == 'error'" decoration-warning="type == 'warning'" decoration-info="type == 'info'" create="false" edit="false">
                    <field name="created_date_time" string="Date &amp; Time"/>
                    <field name="type" string="Status"/>
                    <field name="doc_type_label" string="Type"/>
                    <field name="doc_type" string="Doc Code" optional="hide"/>
                    <field name="warehouse" string="Warehouse"/>
                    <field name="reference" string="Reference"/>
                    <field name="error_message" string="Message"/>
                    <field name="sql_statement" optional="hide"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_loyalty_points_processed_log_form" model="ir.ui.view">
            <field name="name">loyalty.points.processed.log.form</field>
            <field name="model">loyalty.points.processed.log</field>
            <field name="arch" type="xml">
                <form string="Processed Log Detail" create="false" edit="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="created_date_time" readonly="1"/>
                                <field name="type" readonly="1" string="Status"/>
                                <field name="doc_type_label" readonly="1" string="Type"/>
                                <field name="doc_type" readonly="1" string="Doc Type Code"/>
                                <field name="warehouse" readonly="1"/>
                                <field name="reference" readonly="1"/>
                            </group>
                            <group>
                                <field name="quantity" string="Invoice Quantity" readonly="1"/>
                                <field name="regular_points" string="Regular Points" readonly="1"/>
                                <field name="promotion_points" string="Promotion Points" readonly="1"/>
                                <field name="total_price" string="Invoice Price" readonly="1"/>
                                <field name="total_discount" string="Discount Amount" readonly="1"/>
                                <field name="total_special_discount" string="Customer Spl Discount" readonly="1"/>
                                <field name="sales_value" string="Sales Value" readonly="1"/>
                                <field name="sql_statement" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_loyalty_points_processed_log_search" model="ir.ui.view">
            <field name="name">loyalty.points.processed.log.search</field>
            <field name="model">loyalty.points.processed.log</field>
            <field name="arch" type="xml">
                <search string="Search Processed Logs">
                    <field name="reference" string="Reference"/>
                    <field name="warehouse" string="Warehouse"/>
                    <field name="error_message" string="Log Content"/>
                    <filter string="Errors" name="type_error" domain="[('type', '=', 'error')]"/>
                    <filter string="Success" name="type_info" domain="[('type', '=', 'info')]"/>
                    <filter string="Invoice (01)" name="doc_type_01" domain="[('doc_type', '=', '01')]"/>
                    <filter string="Credit Note (02)" name="doc_type_02" domain="[('doc_type', '=', '02')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_by_status" context="{'group_by': 'type'}"/>
                        <filter string="Doc Type" name="group_by_doc_type" context="{'group_by': 'doc_type'}"/>
                        <filter string="Warehouse" name="group_by_warehouse" context="{'group_by': 'warehouse'}"/>
                        <filter string="Date" name="group_by_date" context="{'group_by': 'created_date_time'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action for Processed Logs -->
        <record id="action_loyalty_points_processed_log" model="ir.actions.act_window">
            <field name="name">ERP Invoice Processing Logs</field>
            <field name="res_model">loyalty.points.processed.log</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_loyalty_points_processed_log_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No logs found.
                </p>
                <p>
                    Logs from background or manual ERP invoice/credit note calculations will appear here.
                </p>
            </field>
        </record>


        <!-- ========================================== -->
        <!-- TRANSACTION HEADER SEARCH MORE TREE VIEW  -->
        <!-- ========================================== -->

        <record id="view_transaction_header_tree" model="ir.ui.view">
            <field name="name">transaction.header.tree</field>
            <field name="model">transaction.header</field>
            <field name="arch" type="xml">
                <tree string="Invoices">
                    <field name="trnh_no" string="Invoice No"/>
                    <field name="formatted_invoice_date" string="Invoice Date"/>
                    <field name="trnh_cstname" string="Customer Name"/>
                    <field name="trnh_cstno" string="Customer No"/>
                </tree>
            </field>
        </record>

        <!-- ========================================== -->
        <!-- LOYALTY INVOICE PROCESSOR WIZARD VIEW     -->
        <!-- ========================================== -->

        <record id="view_loyalty_invoice_processor_form" model="ir.ui.view">
            <field name="name">loyalty.invoice.processor.form</field>
            <field name="model">loyalty.invoice.processor</field>
            <field name="arch" type="xml">
                <form string="Process ERP Invoices">
                    <sheet>
                        <group>
                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </group>
                        </group>
                        <group>
                            <field name="invoice_ids" widget="many2many_tags" placeholder="Select specific invoices (leave empty to process all unprocessed in date range)"/>
                        </group>
                        <footer>
                            <button name="action_process_invoices" type="object" string="Process Invoices" class="btn-primary"/>
                            <button string="Cancel" class="btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Invoice Processor Wizard -->
        <record id="action_loyalty_invoice_processor" model="ir.actions.act_window">
            <field name="name">Process ERP Invoices</field>
            <field name="res_model">loyalty.invoice.processor</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>


        <!-- ========================================== -->
        <!-- MENUITEMS                                  -->
        <!-- ========================================== -->

        <!-- Manual processing button -->
        <menuitem
            id="menu_loyalty_invoice_processor"
            name="Process ERP Invoices"
            parent="hhs_loyalty_management.menu_loyalty_points_process"
            action="action_loyalty_invoice_processor"
            sequence="30"/>

        <!-- Error/Processing logs list -->
        <menuitem
            id="menu_loyalty_points_processed_log"
            name="ERP Sync Logs"
            parent="hhs_loyalty_management.menu_loyalty_points_process"
            action="action_loyalty_points_processed_log"
            sequence="35"/>
    </data>

</odoo>
