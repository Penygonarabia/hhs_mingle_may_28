<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_loyalty_points_adjustment_form" model="ir.ui.view">
        <field name="name">loyalty.points.adjustment.form</field>
        <field name="model">manual.promotional.points</field>
        <field name="arch" type="xml">
            <form string="Loyalty Points Adjustment" delete="0">

                <header>
                    <button name="action_process"
                            string="Process"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'processed'"/>

                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="reference" readonly="state == 'processed'"/>
                        <field name="transaction_date" readonly="state == 'processed'"/>
                        <field name="customer_id" readonly="state == 'processed'"
                               options="{'no_create': True,'no_create_edit': True,'no_open': True}"/>
                        <field name="adjustment_types" readonly="state == 'processed'"/>
                        <field name="reason_type_id" readonly="state == 'processed'"
                               options="{'no_create': True,'no_create_edit': True,'no_open': True}"/>
                        <field name="number_of_points" readonly="state == 'processed'"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_loyalty_points_adjustment_tree" model="ir.ui.view">
        <field name="name">loyalty.points.adjustment.tree</field>
        <field name="model">manual.promotional.points</field>
        <field name="arch" type="xml">
            <tree string="Loyalty Points Adjustment">
                <field name="reference"/>
                <field name="transaction_date"/>
                <field name="customer_id"/>
                <field name="adjustment_types"/>
                <field name="reason_type_id"/>
                <field name="number_of_points"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_loyalty_points_adjustment_search" model="ir.ui.view">
        <field name="name">loyalty.points.adjustment.search</field>
        <field name="model">manual.promotional.points</field>
        <field name="arch" type="xml">
            <search string="Search Loyalty Points Adjustment">
                <!-- Search Fields -->
                <field name="reference"/>
                <field name="customer_id"/>
                <field name="reason_type_id"/>
                <field name="adjustment_types"/>
                <field name="transaction_date"/>

                <!-- Filters -->
                <filter string="Addition"
                        name="filter_addition"
                        domain="[('adjustment_types', '=', 'addition')]"/>
                <filter string="Deduction"
                        name="filter_deduction"
                        domain="[('adjustment_types', '=', 'deduction')]"/>
                <!-- Group By -->
                <group expand="0" string="Group By">

                    <filter string="Customer"
                            name="group_customer"
                            context="{'group_by': 'customer_id'}"/>
                    <filter string="Reason Type"
                            name="group_reason"
                            context="{'group_by': 'reason_type_id'}"/>

                    <filter string="Transaction Date"
                            name="group_date"
                            context="{'group_by': 'transaction_date'}"/>

                </group>
            </search>

        </field>
    </record>

    <!-- Action window -->
    <record id="action_enter_manual_promotion_points" model="ir.actions.act_window">
        <field name="name">Loyalty Points Adjustment</field>
        <field name="res_model">manual.promotional.points</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Customer Tier
            </p>
            <p>
                Manage tiers based on loyalty points to categorize your Customer.
            </p>
        </field>
    </record>

    <!-- Enters Menu -->
    <menuitem
            id="menu_loyalty_points_enters"
            name="Entries"
            parent="menu_loyalty_points_root"
            sequence="1"
            groups="hhs_loyalty_management.group_loyalty_program_user"/>

    <!-- Enter Manual Promotional Points Submenu -->
    <menuitem
            id="menu_enter_manual_promotion"
            name="Loyalty Points Adjustment"
            parent="menu_loyalty_points_enters"
            action="action_enter_manual_promotion_points"
            sequence="25"/>


</odoo>