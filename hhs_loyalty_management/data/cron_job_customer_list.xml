<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_customer_list_report_email" model="ir.cron">
        <field name="name">Customer List Report Email</field>

        <field name="model_id"
               ref="model_customer_list_report_wizard"/>

        <field name="state">code</field>
        <field name="code">
            model.cron_send_customer_list_email()
        </field>

        <!-- Every 1 Week -->
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>

        <field name="numbercall">-1</field>
        <field name="active">True</field>

    </record>
</odoo>