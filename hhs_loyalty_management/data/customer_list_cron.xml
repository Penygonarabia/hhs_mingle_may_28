<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Weekly Cron: Send Customer List Email every Monday at 8:00 AM -->
    <record id="ir_cron_send_customer_list_email" model="ir.cron">
        <field name="name">Loyalty: Weekly Customer List Email</field>
        <field name="model_id" ref="model_customer_list_report_wizard"/>
        <field name="state">code</field>
        <field name="code">
# Create a temporary wizard instance and send the email
wizard = env['customer.list.report.wizard'].create({})
wizard.action_send_customer_list_email()
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
        <!-- Run every Monday at 08:00 AM -->
        <field name="nextcall">2026-06-09 02:30:00</field>
    </record>

</odoo>
