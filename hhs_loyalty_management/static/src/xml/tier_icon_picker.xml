<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="hhs_loyalty_management.TierIconPicker" owl="1">
        <div class="tier_icon_picker_wrapper">

            <!-- Readonly Mode: plain icon matching Customer Tier screen -->
            <t t-if="props.readonly">
                <t t-set="iconData" t-value="getSelectedIcon()"/>
                <div t-if="iconData"
                     style="display:flex; flex-direction:column; align-items:center; justify-content:center; cursor:default; pointer-events:none;">
                    <i t-attf-class="fa {{ iconData.fa_icon }}"
                       t-attf-style="color: {{ iconData.color }}; font-size: 52px; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.15));"/>
                    <span t-esc="iconData.name"
                          t-attf-style="color: {{ iconData.color }}; font-size: 11px; font-weight: 800; margin-top: 6px; text-transform: uppercase; letter-spacing: 0.8px;"/>
                </div>
            </t>

            <!-- Edit Mode: show all icons as clickable cards -->
            <t t-else="">
                <div class="tier_icon_grid" style="display:flex; flex-wrap:wrap; gap:10px; padding:4px;">
                    <t t-if="state.icons.length === 0">
                        <span class="text-muted fst-italic">
                            No icons configured. Go to <strong>Configuration → Tier Icons</strong> to add icons.
                        </span>
                    </t>
                    <t t-foreach="state.icons" t-as="icon" t-key="icon.id">
                        <div t-attf-class="tier_icon_option {{ value === icon.id ? 'selected' : '' }}"
                             t-on-click="() => this.selectIcon(icon)"
                             t-att-title="icon.name">
                            <i t-attf-class="fa {{ icon.fa_icon }}"
                               t-attf-style="color: {{ icon.color }}; font-size: 24px;"/>
                            <div class="tier_icon_name" t-esc="icon.name"/>
                        </div>
                    </t>
                </div>
            </t>

        </div>
    </t>
</templates>
