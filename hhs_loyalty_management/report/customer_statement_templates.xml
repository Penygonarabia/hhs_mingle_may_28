<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="customer_account_statement_print_document_template_internal_layout">
        <div class="article">
            <t t-out="0"/>
        </div>
    </template>
    <template id="customer_statement_report">
        <t t-call="web.html_container">
            <t t-foreach="customers_data" t-as="c_data">
                <t t-set="customer" t-value="c_data['customer']"/>
                <t t-set="opening_balance" t-value="c_data['opening_balance']"/>
                <t t-set="transactions" t-value="c_data['transactions']"/>
                <t t-set="total_regular" t-value="c_data['total_regular']"/>
                <t t-set="total_bonus" t-value="c_data['total_bonus']"/>
                <t t-set="grand_total" t-value="c_data['grand_total']"/>
                <t t-call="hhs_loyalty_management.customer_account_statement_print_document_template_internal_layout">
                    <div class="header" t-att-style="report_header_style">
                        <div class="row mt32 mb32">
                            <div class="col-4 text-left">
                                <img src="hhs_loyalty_management/static/src/img/HHS_Header_Left.png" alt="img"
                                     style="height: 120px; width: 350px; "/>
                            </div>
                            <div class="col-4 text-center " style="vertical-align:text-top">
                                <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)"
                                     style="max-height: 100px; min-height:100px; min-width: 200px; max-width: 200px;"/>
                            </div>
                            <div class="col-4 text-right " style="vertical-align:text-top;text-align:right">
                                <img src="hhs_loyalty_management/static/src/img/HHS_Header_Right.png" alt="img"
                                     style="height: 120px; width: 350px;"/>
                            </div>
                        </div>
                    </div>

                    <style>
                        .header {
                        margin: 0 !important;
                        padding: 0 !important;
                        }

                        .page {
                        margin-top: 0 !important;
                        padding-top: 0 !important;
                        }
                    </style>
                    <p style="page-break-before:always;" t-if="not c_data_first"/>
                    <div class="page">
                        <div class="row">
                            <div class="col-12 text-center">
                                <h2><strong>Customer Loyalty Point Statement</strong></h2>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-5">
                                <div class="row">
                                    <div class="col-4"><strong>Customer Code:</strong></div>
                                    <div class="col-8"><span t-field="customer.ref"/></div>
                                </div>
                                <div class="row">
                                    <div class="col-4"><strong>Customer Details:</strong></div>
                                    <div class="col-8"><span t-field="customer.name"/></div>
                                </div>
                                <div class="row">
                                    <div class="col-4"><strong>Customer Address:</strong></div>
                                    <div class="col-8">
                                        <span t-if="customer.state_id">
                                            <span t-field="customer.state_id.name"/> Region<br/>
                                        </span>
                                        <span t-if="customer.city">
                                            <span t-field="customer.city"/> City<br/>
                                        </span>
                                        <span t-field="customer.street"/>
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-4"><strong>Email:</strong></div>
                                    <div class="col-8"><span t-field="customer.email"/></div>
                                </div>
                                <div class="row">
                                    <div class="col-4"><strong>Mobile No:</strong></div>
                                    <div class="col-8"><span t-field="customer.mobile"/></div>
                                </div>
                            </div>
                            <div class="col-2 text-center" style="display: flex; flex-direction: column; justify-content: center; align-items: center; padding-top: 15px;">
                                <div t-if="customer.tier_icon" style="display: flex; flex-direction: column; align-items: center;">
                                    <i t-attf-class="fa #{customer.tier_icon.fa_icon}" t-attf-style="color: #{customer.tier_icon.color}; font-size: 48px; filter: drop-shadow(0px 2px 4px rgba(0,0,0,0.15));"/>
                                    <div t-field="customer.tier_name" t-attf-style="font-size: 11px; font-weight: bold; color: #{customer.tier_icon.color}; text-transform: uppercase; margin-top: 6px; letter-spacing: 0.5px;"/>
                                </div>
                            </div>
                            <div class="col-5" style="padding-left: 50px;">
                                <div class="row">
                                    <div class="col-6"><strong>Statement Date:</strong></div>
                                    <div class="col-6"><span t-esc="print_date.split(' ')[0]"/></div>
                                </div>
                                <div class="row">
                                    <div class="col-6"><strong>Period:</strong></div>
                                    <div class="col-6"><t t-esc="period_display"/></div>
                                </div>
                                <div class="row">
                                    <div class="col-6"><strong>Salesman:</strong></div>
                                    <div class="col-6"><span t-field="customer.user_id.name"/></div>
                                </div>
                                <div class="row">
                                    <div class="col-6"><strong>Tier Name:</strong></div>
                                    <div class="col-6"><span t-field="customer.tier_name"/></div>
                                </div>
                                <div class="row">
                                    <div class="col-6"><strong>Required to Reach Next Tier:</strong></div>
                                    <div class="col-6"><span t-esc="c_data['required_points']"/></div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <table class="table table-sm table-bordered border-dark">
                                    <thead style="background-color: #f2f2f2;">
                                        <tr>
                                            <th class="text-center align-middle"><strong>Date</strong></th>
                                            <th class="text-center align-middle"><strong>Reference</strong></th>
                                            <th class="text-center align-middle"><strong>Type</strong></th>
                                            <th class="text-center align-middle"><strong>Regular Points</strong></th>
                                            <th class="text-center align-middle"><strong>Bonus Points</strong></th>
                                            <th class="text-center align-middle"><strong>Total Points</strong></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Opening Balance -->
                                        <tr style="background-color: #f9f9f9; font-weight: normal;">
                                            <td colspan="3" class="text-end">Opening Balance</td>
                                            <td class="text-end">
                                                <span t-esc="opening_balance['regular']"
                                                      t-options='{"widget": "float", "precision": 0}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="opening_balance['bonus']"
                                                      t-options='{"widget": "float", "precision": 0}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="opening_balance['total']"
                                                      t-options='{"widget": "float", "precision": 0}'/>
                                            </td>
                                        </tr>

                                        <!-- Transaction Rows -->
                                        <t t-foreach="transactions" t-as="line">
                                            <tr style="font-weight: normal;">
                                                <td>
                                                    <span t-field="line.transaction_date"
                                                          t-options='{"widget": "date","format": "dd-MM-yyyy"}'/>
                                                </td>
                                                <td>
                                                    <span t-field="line.transaction_no"/>
                                                </td>
                                                <td>
                                                    <!--                                                <span t-if="line.reason_type">-->
                                                    <!--                                                    <span t-field="line.reason_type"/>-->
                                                    <!--                                                </span>-->
                                                    <span t-if="line.adjustment_type">
                                                        <span t-field="line.adjustment_type"/>
                                                    </span>
                                                    <span t-else="">
                                                        <span t-field="line.transaction_type"/>
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <t t-if="line.transaction_type == 'redeem'">-</t>
                                                    <span t-field="line.regular_points"
                                                          t-options='{"widget": "float", "precision": 0}'/>
                                                </td>
                                                <td class="text-end">
                                                    <t t-if="line.transaction_type == 'redeem'">-</t>
                                                    <span t-field="line.bonus_points"
                                                          t-options='{"widget": "float", "precision": 0}'/>
                                                </td>
                                                <td class="text-end">
                                                    <t t-if="line.transaction_type == 'redeem'">-</t>
                                                    <span t-field="line.total_points"
                                                          t-options='{"widget": "float", "precision": 0}'/>
                                                </td>
                                            </tr>
                                        </t>

                                        <!-- Totals -->
                                        <tr style="background-color: #f2f2f2; font-weight: normal;">
                                            <td colspan="3" class="text-end">Closing Balance:</td>
                                            <td class="text-end">
                                                <span t-esc="total_regular"
                                                      t-options='{"widget": "float", "precision": 0}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="total_bonus"
                                                      t-options='{"widget": "float", "precision": 0}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="grand_total"
                                                      t-options='{"widget": "float", "precision": 0}'/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
                <div class="footer" style="margin:0; padding:0; border-top: 1px solid #002060;">
                    <div class="row" style="margin:0; padding:0;">
                        <div class="col-12" style="margin:0; padding:0;">
                            <img src="hhs_loyalty_management/static/src/img/JobCard_Footer_img.png"
                                 style="width:100%;"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
