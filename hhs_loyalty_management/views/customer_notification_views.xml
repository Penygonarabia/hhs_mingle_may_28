<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_customer_notification_form" model="ir.ui.view">
        <field name="name">customer.notification.form</field>
        <field name="model">customer.notification</field>
        <field name="arch" type="xml">
            <form string="Customer Notification">
                <header>
                    <button name="action_send_notification" type="object" string="Send Notification" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Notification Title/Subject (English)..." readonly="state == 'sent'"/>
                        </h1>
                        <h2 style="margin-top: 10px;">
                            <field name="name_ar" placeholder="Notification Title/Subject (Arabic)..." readonly="state == 'sent'" style="direction: rtl; text-align: right; font-size: 1.5rem; color: #666;"/>
                        </h2>
                    </div>
                    
                    <group>
                        <group string="Audience Filters">
                            <field name="is_promotion_selected" invisible="1"/>
                            <field name="promotion_ids" widget="many2many_tags" readonly="state == 'sent'"/>
                            <field name="promotion_start_date" readonly="1" invisible="not is_promotion_selected"/>
                            <field name="promotion_end_date" readonly="1" invisible="not is_promotion_selected"/>
                            <field name="active_loyalty_only" readonly="is_promotion_selected or state == 'sent'"/>
                            <label for="salesman_ids" string="Sync Salesmen" class="oe_inline"/>
                            <button name="action_sync_salesmen" type="object" string="Refresh Salesman List" class="oe_link"/>
                            <field name="partner_ids" widget="many2many_tags" readonly="is_promotion_selected or state == 'sent'" force_save="1" domain="active_loyalty_only and [('activate_loyalty_feature', '=', True)] or []"/>
                            <field name="tier_ids" widget="many2many_tags" readonly="is_promotion_selected or state == 'sent'" force_save="1"/>
                            <field name="salesman_ids" widget="many2many_tags" readonly="is_promotion_selected or state == 'sent'"/>
                            <label for="activation_date_from" string="Activation Date Range"/>
                            <div class="o_row">
                                <field name="activation_date_from" placeholder="From" readonly="is_promotion_selected or state == 'sent'"/>
                                <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="Arrow"/>
                                <field name="activation_date_to" placeholder="To" readonly="is_promotion_selected or state == 'sent'"/>
                            </div>
                        </group>
                        
                        <group string="Output Medium">
                            <field name="send_email" readonly="state == 'sent'"/>
                            <field name="send_sms" readonly="state == 'sent'"/>
                            <field name="send_whatsapp" readonly="state == 'sent'"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Message Content (English)" name="message_content">
                            <div>
                                <field name="notes" class="oe-bordered-editor" placeholder="Type your English message here..." options="{'style-inline': true, 'collaborative': true}" readonly="state == 'sent'"/>
                            </div>
                        </page>
                        <page string="Message Content (Arabic)" name="message_content_ar">
                            <div>
                                <field name="notes_ar" class="oe-bordered-editor" placeholder="Type your Arabic message here..." options="{'style-inline': true, 'collaborative': true}" readonly="state == 'sent'" style="direction: rtl; text-align: right;"/>
                            </div>
                        </page>
                        <page string="Attachments" name="attachments">
                            <group>
                                <field name="attachment_ids" widget="many2many_binary" string="Attach Files" readonly="state == 'sent'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_customer_notification_tree" model="ir.ui.view">
        <field name="name">customer.notification.tree</field>
        <field name="model">customer.notification</field>
        <field name="arch" type="xml">
            <tree string="Customer Notifications">
                <field name="name"/>
                <field name="create_date" string="Created On"/>
                <field name="send_email"/>
                <field name="send_sms"/>
                <field name="send_whatsapp"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'sent'"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_customer_notification" model="ir.actions.act_window">
        <field name="name">Customer Notifications</field>
        <field name="res_model">customer.notification</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Customer Notification!
            </p>
            <p>
                Use this screen to broadcast messages to loyalty customers via Email, SMS, and WhatsApp based on filters.
            </p>
        </field>
    </record>

    <!-- General Notifications Menu -->
    <menuitem id="menu_general_notifications_root"
              name="General Notifications"
              parent="hhs_loyalty_management.menu_loyalty_points_root"
              sequence="45"/>

    <menuitem id="menu_customer_notifications"
              name="Customer Notifications"
              parent="menu_general_notifications_root"
              action="action_customer_notification"
              sequence="10"/>

</odoo>
