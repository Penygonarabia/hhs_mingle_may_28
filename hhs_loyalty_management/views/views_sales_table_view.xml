<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_loyalty_sales_table_tree" model="ir.ui.view">
        <field name="name">loyalty.sales.table.view.tree</field>
        <field name="model">loyalty.sales.table.view</field>
        <field name="arch" type="xml">
            <tree string="Sales Table View" create="0" edit="0" delete="0">
                <field name="trnh_region" optional="show"/>
                <field name="trnh_city" optional="show"/>
                <field name="trnh_sman" optional="show"/>
                <field name="trnh_cstno" optional="show"/>
                <field name="trnh_cstname" optional="show"/>
                <field name="trnh_cstmobile" optional="show"/>
                <field name="tier_name" optional="show"/>
                <field name="trnh_type" optional="show"/>
                <field name="trnh_whouse" optional="show"/>
                <field name="trnh_no" optional="show"/>
                <field name="trnh_date" optional="show"/>
                <field name="trnd_slno" optional="show"/>
                <field name="trnd_group" optional="show"/>
                <field name="trnd_part" optional="show"/>
                <field name="trnd_desc" optional="show"/>
                <field name="qty" sum="Total Qty" optional="show" widget="integer"/>
                <field name="net_sales" sum="Total Net Sales" optional="hide"/>
                <field name="net_sales_with_vat" sum="Total Net Sales (VAT)" optional="hide"/>
                <field name="clph_promoref" optional="show"/>
                <field name="clph_points" sum="Total Regular Points" optional="show"/>
                <field name="clph_bonuspoint" sum="Total Bonus Points" optional="show"/>
                <field name="total_points" sum="Total Points" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_loyalty_sales_table_pivot" model="ir.ui.view">
        <field name="name">loyalty.sales.table.view.pivot</field>
        <field name="model">loyalty.sales.table.view</field>
        <field name="arch" type="xml">
            <pivot string="Sales Table View" sample="1">
                <field name="trnh_date" type="row" interval="month"/>
                <field name="trnh_type" type="col"/>
                <field name="qty" type="measure"/>
                <field name="clph_points" type="measure"/>
                <field name="clph_bonuspoint" type="measure"/>
                <field name="total_points" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_loyalty_sales_table_search" model="ir.ui.view">
        <field name="name">loyalty.sales.table.view.search</field>
        <field name="model">loyalty.sales.table.view</field>
        <field name="arch" type="xml">
            <search string="Search Sales Table View">
                <field name="trnh_no"/>
                <field name="trnh_cstno"/>
                <field name="trnh_cstname"/>
                <field name="trnh_sman"/>
                <field name="trnd_part"/>
                <field name="activate_loyalty_feature"/>
                <separator/>
                <filter string="Loyalty Active (Yes)" name="loyalty_active" domain="[('activate_loyalty_feature', '=', True)]"/>
                <filter string="Loyalty Active (No)" name="loyalty_inactive" domain="[('activate_loyalty_feature', '=', False)]"/>
                <group expand="1" string="Group By">
                    <filter string="Region" name="group_by_region" context="{'group_by':'trnh_region'}"/>
                    <filter string="City" name="group_by_city" context="{'group_by':'trnh_city'}"/>
                    <filter string="Salesman" name="group_by_sman" context="{'group_by':'trnh_sman'}"/>
                    <filter string="Customer No" name="group_by_cstno" context="{'group_by':'trnh_cstno'}"/>
                    <filter string="Customer Name" name="group_by_customer" context="{'group_by':'trnh_cstname'}"/>
                    <filter string="Customer Mobile" name="group_by_mobile" context="{'group_by':'trnh_cstmobile'}"/>
                    <filter string="Tier" name="group_by_tier" context="{'group_by':'tier_name'}"/>
                    <filter string="Transaction Type" name="group_by_type" context="{'group_by':'trnh_type'}"/>
                    <filter string="Warehouse" name="group_by_warehouse" context="{'group_by':'trnh_whouse'}"/>
                    <filter string="Transaction No" name="group_by_trnh_no" context="{'group_by':'trnh_no'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by':'trnh_date'}"/>
                    <filter string="Product Group" name="group_by_group" context="{'group_by':'trnd_group'}"/>
                    <filter string="Product No" name="group_by_part" context="{'group_by':'trnd_part'}"/>
                    <filter string="Product Description" name="group_by_desc" context="{'group_by':'trnd_desc'}"/>
                    <filter string="Promo Ref" name="group_by_promo" context="{'group_by':'clph_promoref'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_loyalty_sales_table_view" model="ir.actions.act_window">
        <field name="name">Sales Table View</field>
        <field name="res_model">loyalty.sales.table.view</field>
        <field name="view_mode">tree,pivot</field>
        <field name="search_view_id" ref="view_loyalty_sales_table_search"/>
    </record>

    <!-- Menu Item under Loyalty Points -> Reports -->
    <!-- Assuming parent menu id is 'menu_loyalty_points_reports' or similar. We need to check __manifest__ or views for exact menu id. -->
    <menuitem id="menu_loyalty_sales_table_view"
              name="Sales Table View"
              parent="hhs_loyalty_management.menu_loyalty_reports_root" 
              action="action_loyalty_sales_table_view"
              sequence="50"/>

</odoo>
