<odoo>

    <!-- Tree View -->
    <record id="view_loyalty_audit_view_tree" model="ir.ui.view">
        <field name="name">loyalty.audit.view.tree</field>
        <field name="model">loyalty.audit.view</field>
        <field name="arch" type="xml">
            <tree string="Loyalty Audit View" create="0" edit="0" delete="0" export_xlsx="1">
                <field name="work_center_group_name"/>
                <!--                <field name="work_center_group_id"/>-->
                <!--                <field name="region_id"/>-->
                <field name="city"/>
                <!--                <field name="salesman_code"/>-->
                <!--                <field name="salesman_id"/>-->
                <!--                <field name="partner_id"/>-->
                <field name="salesman_name"/>
                <field name="customer_code"/>
                <field name="customer_name"/>
                <field name="mobile"/>
                <field name="tier_name"/>
                <field name="transaction_type"/>
                <field name="warehouse"/>
                <field name="transaction_no"/>
                <field name="transaction_date"/>
                <field name="regular_points"/>
                <field name="bonus_points"/>
                <field name="total_points"/>
                <field name="redemption_points"/>
                <field name="expired_points"/>
                <field name="net_total_points"/>
                <field name="reason_name"/>
                <field name="adjustment_type"/>
                <field name="status"/>
                <field name="remarks"/>
                <field name="created_by" optional="hide"/>
                <field name="created_date" optional="hide"/>
                <field name="modified_by" optional="hide"/>
                <field name="modified_date" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_loyalty_audit_view_pivot" model="ir.ui.view">
        <field name="name">loyalty.audit.view.pivot</field>
        <field name="model">loyalty.audit.view</field>
        <field name="arch" type="xml">
            <pivot string="Loyalty Audit View" disable_linking="True">

                <!-- Default hierarchy -->
                <field name="tier_name" type="row"/>
                <field name="work_center_group_name" type="row"/> <!-- Region -->
                <field name="city" type="row"/>
                <field name="customer_name" type="row"/>
                <field name="salesman_name" type="row"/>

                <field name="transaction_date" interval="month" type="col"/>

                <field name="regular_points" type="measure"/>
                <field name="bonus_points" type="measure"/>
                <field name="total_points" type="measure"/>
                <field name="redemption_points" type="measure"/>
                <field name="expired_points" type="measure"/>
                <field name="net_total_points" type="measure"/>

            </pivot>
        </field>
    </record>
