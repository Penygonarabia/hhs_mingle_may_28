    <!-- Search View -->
    <record id="view_loyalty_audit_view_search" model="ir.ui.view">
        <field name="name">loyalty.audit.view.search</field>
        <field name="model">loyalty.audit.view</field>
        <field name="arch" type="xml">
            <search string="Search Loyalty Audit">
                <field name="customer_name"/>
                <field name="customer_code"/>
                <field name="transaction_no"/>
                <field name="mobile"/>
                <field name="region_id"/>
                <field name="salesman_id"/>

                <filter string="Today" name="today"
                        domain="[('transaction_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('transaction_date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter string="This Week" name="this_week"
                        domain="[('transaction_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('transaction_date', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('transaction_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter string="Last Month" name="last_month"
                        domain="[('transaction_date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01')), ('transaction_date', '&lt;', context_today().strftime('%Y-%m-01'))]"/>
                <!-- Default Grouping Filter -->
                <!--                <filter string="Default Grouping"-->
                <!--                        name="group_default"-->
                <!--                        context="{-->
                <!--                        'group_by': [-->
                <!--                            'tier_name',-->
                <!--                            'work_center_group_name',-->
                <!--                            'city',-->
                <!--                            'customer_name'-->
                <!--                        ]-->
                <!--                }"/>-->

                <separator/>
                <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Approved" name="approved" domain="[('status', '=', 'approved')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status', '=', 'cancel')]"/>

                <group expand="0" string="Group By">
                    <filter string="Tier" name="group_by_tier" context="{'group_by': 'tier_name'}"/>
                    <filter string="City" name="group_by_city" context="{'group_by':'city'}"/>
                    <filter string="Region" name="group_by_region" context="{'group_by': 'work_center_group_name'}"/>
                    <filter string="Salesman" name="group_by_salesman" context="{'group_by': 'salesman_name'}"/>
                    <filter string="Customer" name="group_by_customer" context="{'group_by': 'customer_name'}"/>
                    <!--                    <filter string="Warehouse" name="group_by_warehouse" context="{'group_by': 'warehouse'}"/>-->
                    <filter string="Transaction Type" name="group_by_transaction_type"
                            context="{'group_by': 'transaction_type'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Transaction Date" name="group_by_transaction_date"
                            context="{'group_by': 'transaction_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_loyalty_audit_view" model="ir.actions.act_window">
        <field name="name">Loyalty Audit View</field>
        <field name="res_model">loyalty.audit.view</field>
        <field name="view_mode">tree,pivot</field>
        <field name="search_view_id" ref="view_loyalty_audit_view_search"/>
        <field name="context">
            'pivot_measures': ['tier_name','work_center_group_name','city','customer_name'],
            'disable_pivot_expand': True,
            'disable_pivot_filters': True,
            'disable_pivot_download': True
        </field>
        <!--        <field name="context">{'search_default_group_by_transaction_date': 1}</field>-->
    </record>

    <!-- Menu Item -->
    <menuitem
            id="menu_loyalty_audit_view"
            name="Loyalty Audit View"
            parent="menu_loyalty_points_enters"
            action="action_loyalty_audit_view"
            sequence="30"
            groups="hhs_loyalty_management.group_loyalty_program_user"/>

</odoo>
