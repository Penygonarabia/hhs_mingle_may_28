<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Wizard Form View
    ================================================================ -->
    <record id="view_loyalty_points_summary_wizard_form" model="ir.ui.view">
        <field name="name">loyalty.points.summary.wizard.form</field>
        <field name="model">loyalty.points.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Loyalty Points Summary">
                <group>
                    <group string="Date Range">
                        <field name="from_date"/>
                        <field name="to_date"/>
                    </group>
                    <group string="Filters">
                        <field name="customer_status" widget="radio"/>
                        <field name="show_redeemed_only"/>
                    </group>
                </group>
                <group>
                    <field
                        name="customer_ids"
                        widget="many2many_tags"
                        options="{'no_create': True, 'no_open': True}"
                        string="Customers"
                        colspan="2"
                    />
                </group>
                <footer>
                    <button
                        name="action_generate_excel"
                        string="Download Excel"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Wizard Action
    ================================================================ -->
    <record id="action_loyalty_points_summary_wizard" model="ir.actions.act_window">
        <field name="name">Loyalty Points Summary</field>
        <field name="res_model">loyalty.points.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ================================================================
         Menu Item (under existing Loyalty Reports root)
    ================================================================ -->
    <menuitem
        id="menu_loyalty_points_summary_wizard"
        name="Loyalty Points Summary"
        parent="menu_loyalty_reports_root"
        action="action_loyalty_points_summary_wizard"
        sequence="60"
        groups="hhs_loyalty_management.group_loyalty_program_user"
    />

</odoo>
