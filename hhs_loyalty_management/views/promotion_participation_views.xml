<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Promotion Participation Views
         ============================================================ -->

    <!-- Tree View -->
    <record id="view_loyalty_promotion_participation_tree" model="ir.ui.view">
        <field name="name">loyalty.promotion.participation.tree</field>
        <field name="model">loyalty.promotion.participation</field>
        <field name="arch" type="xml">
            <tree string="Promotion Participation" create="0" edit="0" delete="0" export_xlsx="1">
                <field name="promotion_reference"/>
                <field name="promotion_name"/>
                <field name="partner_id" optional="show"/>
                <field name="tier_id" optional="show"/>
                <field name="date" optional="hide"/>
                <field name="no_of_active_customers" sum="Total Active Customers" optional="show"/>
                <field name="utilized_customers" sum="Total Utilized Customers" optional="show"/>
                <field name="utilized_transactions" sum="Total Utilized Transactions" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_loyalty_promotion_participation_pivot" model="ir.ui.view">
        <field name="name">loyalty.promotion.participation.pivot</field>
        <field name="model">loyalty.promotion.participation</field>
        <field name="arch" type="xml">
            <pivot string="Promotion Participation" disable_linking="True">
                <field name="promotion_name" type="row"/>
                <field name="no_of_active_customers" type="measure"/>
                <field name="utilized_customers" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_loyalty_promotion_participation_search" model="ir.ui.view">
        <field name="name">loyalty.promotion.participation.search</field>
        <field name="model">loyalty.promotion.participation</field>
        <field name="arch" type="xml">
            <search string="Search Promotion Participation">
                <field name="promotion_reference"/>
                <field name="promotion_name"/>
                <field name="partner_id"/>
                <field name="tier_id"/>
                <field name="date"/>
                <filter string="Promotion" name="group_by_name" context="{'group_by': 'promotion_name'}"/>
                <filter string="Customer" name="group_by_customer" context="{'group_by': 'partner_id'}"/>
                <filter string="Tier" name="group_by_tier" context="{'group_by': 'tier_id'}"/>
                <filter string="Month" name="group_by_date" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_loyalty_promotion_participation" model="ir.actions.act_window">
        <field name="name">Promotion Participation</field>
        <field name="res_model">loyalty.promotion.participation</field>
        <field name="view_mode">tree,pivot</field>
        <field name="search_view_id" ref="view_loyalty_promotion_participation_search"/>
        <field name="context">{'search_default_group_by_name': 1}</field>
    </record>


    <!-- ============================================================
         Salesman Wise Promotion Participation Views
         ============================================================ -->

    <!-- Tree View -->
    <record id="view_loyalty_salesman_promotion_participation_tree" model="ir.ui.view">
        <field name="name">loyalty.salesman.promotion.participation.tree</field>
        <field name="model">loyalty.salesman.promotion.participation</field>
        <field name="arch" type="xml">
            <tree string="Salesman Wise Promotion Participation" create="0" edit="0" delete="0" export_xlsx="1">
                <field name="promotion_reference"/>
                <field name="promotion_name"/>
                <field name="salesman_name"/>
                <field name="partner_id" optional="show"/>
                <field name="tier_id" optional="show"/>
                <field name="region_id" optional="hide"/>
                <field name="city" optional="hide"/>
                <field name="date" optional="hide"/>
                <field name="no_of_active_customers" sum="Total Active Customers" optional="show"/>
                <field name="utilized_customers" sum="Total Utilized Customers" optional="show"/>
                <field name="utilized_transactions" sum="Total Utilized Transactions" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_loyalty_salesman_promotion_participation_pivot" model="ir.ui.view">
        <field name="name">loyalty.salesman.promotion.participation.pivot</field>
        <field name="model">loyalty.salesman.promotion.participation</field>
        <field name="arch" type="xml">
            <pivot string="Salesman Wise Promotion Participation" disable_linking="True">
                <field name="promotion_name" type="row"/>
                <field name="salesman_name" type="row"/>
                <field name="no_of_active_customers" type="measure"/>
                <field name="utilized_customers" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_loyalty_salesman_promotion_participation_search" model="ir.ui.view">
        <field name="name">loyalty.salesman.promotion.participation.search</field>
        <field name="model">loyalty.salesman.promotion.participation</field>
        <field name="arch" type="xml">
            <search string="Search Salesman Wise Promotion Participation">
                <field name="promotion_reference"/>
                <field name="promotion_name"/>
                <field name="salesman_name"/>
                <field name="partner_id"/>
                <field name="tier_id"/>
                <field name="region_id"/>
                <field name="city"/>
                <field name="date"/>
                <filter string="Promotion" name="group_by_promotion" context="{'group_by': 'promotion_name'}"/>
                <filter string="Salesman" name="group_by_salesman" context="{'group_by': 'salesman_name'}"/>
                <filter string="Customer" name="group_by_customer" context="{'group_by': 'partner_id'}"/>
                <filter string="Tier" name="group_by_tier" context="{'group_by': 'tier_id'}"/>
                <filter string="Region" name="group_by_region" context="{'group_by': 'region_id'}"/>
                <filter string="City" name="group_by_city" context="{'group_by': 'city'}"/>
                <filter string="Month" name="group_by_date" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_loyalty_salesman_promotion_participation" model="ir.actions.act_window">
        <field name="name">Salesman Wise Promotion Participation</field>
        <field name="res_model">loyalty.salesman.promotion.participation</field>
        <field name="view_mode">tree,pivot</field>
        <field name="search_view_id" ref="view_loyalty_salesman_promotion_participation_search"/>
        <field name="context">{'search_default_group_by_promotion': 1, 'search_default_group_by_salesman': 1}</field>
    </record>


    <!-- ============================================================
         Menu Items
         ============================================================ -->

    <menuitem
        id="menu_loyalty_promotion_participation"
        name="Promotion Participation"
        parent="menu_loyalty_reports_root"
        action="action_loyalty_promotion_participation"
        sequence="20"
        groups="hhs_loyalty_management.group_loyalty_program_user"/>

    <menuitem
        id="menu_loyalty_salesman_promotion_participation"
        name="Salesman Wise Promotion Participation"
        parent="menu_loyalty_reports_root"
        action="action_loyalty_salesman_promotion_participation"
        sequence="21"
        groups="hhs_loyalty_management.group_loyalty_program_user"/>

</odoo>
